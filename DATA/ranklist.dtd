<?xml version="1.0" encoding="UTF-8"?>
<!--
 XML Document Type Definition for Rank lists
 -->

<!ELEMENT ranklist (rank+)>
<!ATTLIST ranklist version CDATA #FIXED "1.1">

<!ELEMENT rank	(british,american,french,german)>
<!ATTLIST rank	level	CDATA					#REQUIRED
		type	(enlisted | officer | command | staff)	#REQUIRED
		>

<!ELEMENT british (ground,air,navy)>
<!ATTLIST british country CDATA "1">
<!ELEMENT american (ground,air,navy)>
<!ATTLIST american country CDATA "2">
<!ELEMENT french (ground,air,navy)>
<!ATTLIST french country CDATA "3">
<!ELEMENT german (ground,air,navy)>
<!ATTLIST german country CDATA "4">

<!ELEMENT ground (#PCDATA)>
<!ATTLIST ground branch CDATA "1">
<!ELEMENT air (#PCDATA)>
<!ATTLIST air branch CDATA "2">
<!ELEMENT navy (#PCDATA)>
<!ATTLIST navy branch CDATA "3">

