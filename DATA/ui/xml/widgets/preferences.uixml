						 	onclick="showColorPicker(this.id)"/>
				</panel>
				<script>
					<!--
					
					// INIT FUNCTIONS
					
					function resetHud()
					{
						soundPlayClick();
						
						addPreference("hudvisible", Preference.UINT, 2, true);
						addPreference("iconmode", Preference.SINT, 0, true);
						addPreference('view.gameinfo.visible', Preference.BOOL, false, false);
						addPreference('view.readout.visible', Preference.BOOL, false, false);
						addPreference('view.current-orders.visible', Preference.BOOL, true, false);
						addPreference('view.persona.visible', Preference.BOOL, true, false);
						addPreference('view.primary.visible', Preference.BOOL, true, false);
						addPreference('view.secondary.visible', Preference.BOOL, true, false);
						addPreference('view.chat.visible', Preference.BOOL, true, false);
						addPreference('view.kenny.visible', Preference.BOOL, true, false);
						addPreference('hud.minimap.mode', Preference.UINT, 0, false);
						addPreference('hud.alerts.show', Preference.BOOL, true, false);
						addPreference("hud.alerts.textmode", Preference.SINT, 0, false);
						
						initHudModes(findview("hudModeList").mgr);
						initIconModes(findview("iconModeList").mgr);
					}
					
					function initHudModes(list)
					{
							var options	= new Array("hide", "show");
							var current = getPreference("hudvisible", Preference.UINT, 1, true);
							
							if(current == 1)
								current = 2;
							
							list.clearRows(true);
							list.addOption(getlocstring("widgets.prefs.groups.hud.mode.hide"), 0, current);
							list.addOption(getlocstring("widgets.prefs.groups.hud.mode.show"), 2, current);
							list.hideList();
					}
					
					function initIconModes(list)
					{
							var options	= new Array("namerank", "vehtype", "none");
							var current = getPreference("iconmode", Preference.SINT, 0, true);
							
							list.clearRows(true);
							
							for(var i = 0; i < options.length; i++)
									list.addOption(getlocstring("widgets.prefs.groups.hud.icons." + options[i]), i, current);
							
							list.hideList();
					}
					
					// SET FUNCTIONS
					
					function selectIconMode(dbclick)
					{
							addPreference("iconmode", Preference.SINT, findview("iconModeList").mgr.data, true);
					}
					
					function selectHudMode(dbclick)
					{
							addPreference("hudvisible", Preference.UINT, findview("hudModeList").mgr.data, true);
					}
							
					-->
				</script>
			</tab>
