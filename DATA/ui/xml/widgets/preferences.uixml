						 	style="background-color: #0000FF; border-color: #ffffff; border-size: 1;"
						 	onshow="this.setstyleproperty('background-color', getPreference(this.id, Preference.UINT, '#00FF00', true))"
						 	onclick="showColorPicker(this.id)"/>
						<caption label="&widgets.prefs.groups.hud.ppos.nok;" x="25" height="20" width="150" rtop="50" style="color: #e9e3d9ff;"/>
