						<caption label="&widgets.prefs.groups.hud.custom.primary;" x="20" height="20" width="150" rtop="120" style="color: #e9e3d9ff;"/>
						<view width="150" height="15" rtop="120" rright="10">
							<radiobutton label="&widgets.prefs.enabled;" x="5" y="0" width="70" height="15"
								style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
								onclick="addPreference('view.primary.visible', Preference.BOOL, true, false);"
								onshow="this.value = getPreference('view.primary.visible', Preference.BOOL, true, false);"/>
							<radiobutton label="&widgets.prefs.disabled;" y="0" width="70" height="15" rright="5" 
								style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
								onclick="addPreference('view.primary.visible', Preference.BOOL, false, false);"
