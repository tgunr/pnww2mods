								onclick="addPreference('view.secondary.visible', Preference.BOOL, false, false);"
								onshow="this.value = !getPreference('view.secondary.visible', Preference.BOOL, true, false);"/>
						</view>
						<caption label="&widgets.prefs.groups.hud.custom.chat;" x="20" height="20" width="150" rtop="170" style="color: #e9e3d9ff;"/>
