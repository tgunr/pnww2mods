				<caption label="&widgets.prefs.groups.shadows.flying;" x="20" height="20" rright="0" rtop="260" style="color: #e9e3d9ff;"
					tip="&widgets.prefs.groups.shadows.flying.tip;"/>
				<view id="shadows-planes" width="150" height="15" rtop="260" rright="10">
					<radiobutton label="&widgets.prefs.enabled;" x="5" y="0" width="70" height="15"
						style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
						onclick="setShadow('planes', true);"
						onshow="this.value = getShadow('planes');"/>
					<radiobutton label="&widgets.prefs.disabled;" y="0" width="70" height="15" rright="5" 
						style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
						onclick="setShadow('planes', false);"
						onshow="this.value = !getShadow('planes');"/>
				</view>
				-->
				<script>
					<!--
					
					var bits = new Object();
					
					bits['terrain'] 	= 1;
					bits['objects'] 	= 2;
					bits['vehicles'] 	= 4;
					bits['grass'] 		= 8;
					bits['cockpits'] 	= 16;
					bits['corpses'] 	= 32;
					bits['planes'] 		= 64;
					
					var fullShadows = 0;
					var shadowInit	= false;
					
					for(var t in bits) 
						fullShadows = fullShadows | bits[t];
					
					// INIT FUNCTIONS
					function setShadow(type, on, update)
					{
						var flags 	= getPreference('shadowreceivers', Preference.UINT, fullShadows, true);
						var bit 	= bits[type];
						
						if(on)
						{
							flags = (flags | bit);
							
							if(type != 'terrain')
							{
								flags = (flags | bits['terrain']);
								updateShadow("terrain", true);
							}
						}
						else
						{
							flags = (flags & ~bit);
							
							if(type == 'terrain')
							{
								for(var t in bits) 
									updateShadow(t, false);
								
								flags = 0;
							}
						}
	
						if(update == true)
							updateShadow(type, on);
						
						addPreference('shadowreceivers', Preference.UINT, flags, true);
					}
					
					function updateShadow(type, on)
					{
						return;
						/* these are hidden for now
						var child = null;
						var view = window.findview("shadows-" + type);
						
						if(view != null)
						{
							child = view.getchild(0);
							if(child.value != on) child.value = on;
							
							child = view.getchild(1);
							if(child.value != !on) child.value = !on;
						}
						*/
					}
					
					// combined
					function getShadow(type)
					{
						var flags 	= getPreference('shadowreceivers', Preference.UINT, fullShadows, true);
						var bit 	= bits[type];
						
						return ((flags & bit) > 0) ? true : false;
					}
					
					// INIT FUNCTIONS
					function initShadows(list)
					{
						list.clearRows(true);
						
						var selection 	= 0;
						var options 	= new Array("loc.ui.24", "loc.ui.23", "loc.ui.22");
						var current 	= getPreference("app.shadows", Preference.UINT, 2, false);
						
						for(var i = 0; i < options.length; i++)
						{
							if(i == current)
								selection = i;
							
							list.addItem(getlocstring(options[i]), i, false);
						}
						
						list.clickList(false, selection);
						list.hideList();
						
						shadowInit = true;
					}
					
					// SET FUNCTIONS
					
					function selectShadows(dbclick)
					{
						var curValue = getPreference("app.shadows", Preference.UINT, 2, false);
						var newValue = findview("shadowList").mgr.data;
						
						if(newValue != curValue)
						{
							addPreference("app.shadows", Preference.UINT, newValue, false);
						}
						
						addPreference("shadowsizeselect", Preference.SINT, ((newValue == 0) ? 0 : 6), true);
						
						if(shadowInit)
						{
							// update checkboxes
							switch(newValue)
							{
								case 0:
									setShadow("terrain", false); // all off
									setShadow("vehicles", true, true);
									setShadow("corpses", true, true);
									break;
								case 1:
									setShadow("terrain", false); // all off
									setShadow("vehicles", true, true);
									setShadow("corpses", true, true);
									setShadow("grass", true, true);
									setShadow("cockpits", true, true);
									break;
								case 2:
									for(var t in bits)
										setShadow(t, true, true);
									break;
								default:
									consoleprint("New shadow value is " + newValue + "\n");
									break;
							}
						}
					}
					
					-->
				</script>	
			</tab>
