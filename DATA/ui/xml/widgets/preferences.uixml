						</view>
						<caption label="&widgets.prefs.groups.hud.custom.minimap;" x="20" height="20" width="150" rtop="195" style="color: #e9e3d9ff;"/>
						<view width="150" height="15" rtop="195" rright="10">
							<radiobutton label="&widgets.prefs.enabled;" x="5" y="0" width="70" height="15"
								style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
								onclick="addPreference('view.kenny.visible', Preference.BOOL, true, false);"
								onshow="this.value = getPreference('view.kenny.visible', Preference.BOOL, true, false);"/>
							<radiobutton label="&widgets.prefs.disabled;" y="0" width="70" height="15" rright="5" 
								style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
								onclick="addPreference('view.kenny.visible', Preference.BOOL, false, false);"
								onshow="this.value = !getPreference('view.kenny.visible', Preference.BOOL, true, false);"/>
						</view>
				</panel>
				<panel label="&widgets.prefs.groups.hud.custom.minimap.settings;" align="center" x="10" height="70" rright="10" rtop="280"
						style="color: #3e5248; border-color: #3e5248; border-size: 1; font-size: -1;"
						tip="&widgets.prefs.groups.hud.custom.minimap.settings.tip;">
						<caption label="&widgets.prefs.groups.hud.custom.minimap.zoom;" x="25" height="20" width="150" rtop="25" style="color: #e9e3d9ff;"/>
						<caption label="&widgets.prefs.groups.hud.custom.minimap.zoom.lowest;" x="190" height="20" width="40" rtop="25" style="color: #e9e3d9ff; font-size: -1;" acceptmouseclick="false"/>
						<slider width="120" height="15" rtop="25" rright="70" minvalue="0" maxvalue="1"
							style="thumb-off-color: #3e5248;"
							onshow="this.value = getSliderPreference('hud.minimap.scale', Preference.FLOAT, 1, false, 1, .005)"
							onclick="addSliderPreference('hud.minimap.scale', Preference.FLOAT, this.value, false, 1, .005)"/>
						<caption label="&widgets.prefs.groups.hud.custom.minimap.zoom.highest;" height="20" width="40" rtop="25" rright="20" style="color: #e9e3d9ff; font-size: -1;" align="right" acceptmouseclick="false"/>
				</panel>
