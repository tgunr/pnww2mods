<?xml version="1.0"?>
<!DOCTYPE uixml SYSTEM "loc://ui.dtd"> 
<view x="0" y="0" width="930" height="460" onshow="initPreferences()"> <!--  onhide="savePreferences()" -->
	<!-- include file="classes/ListControl.uixml"/ -->
	<include file="classes/TreeControl2.uixml"/>
	<include file="classes/DDListControl.uixml"/>
	<include file="classes/Preference.uixml"/>
	<view id="left-pane" x="18" y="18" width="444" height="411">
		<caption label="&widgets.prefs.groups;" x="10" height="20" width="425" rtop="10" style="font-size: +2; color: #BFE2CE;"/>
		<image x="10" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="20"/>
		<view x="10" width="425" height="15" rtop="32">
			<caption x="0" y="0" width="425" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"/>
		</view>
		<list id="groupList" x="10" y="35" width="425" height="327" style="color: #FFFFFF"
			 onselect="groupList.clickList(false)" ondblselect="groupList.clickList(true)"/>
		<panel label="&widgets.prefs.list;" align="center" x="10" y="10" height="80" rright="10"
				style="color: #3e5248; border-color: #3e5248; border-size: 1; font-size: -1;">
			<button x="40" y="25" height="25" width="140" label="&widgets.prefs.discard;"
				style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -3; color: #FFFFFF;"
				onclick="clickDiscardChanges()" onupdate="updatePrefsButton(this)"
				onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"
				tip="&widgets.prefs.discard;"/>
			<button y="25" height="25" width="140" rright="40" label="&widgets.prefs.save;"
				style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -3; color: #FFFFFF;"
				onclick="clickSavePrefs()" onupdate="updatePrefsButton(this)"
				onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"
				tip="&widgets.prefs.save;"/>
		</panel>
	</view>
	<include file="widgets/divider.uixml"/>
	<view id="right-pane" x="468" y="18" width="444" height="411">
		<tabview id="prefsGroups" x="0" y="0" rright="0" rtop="0" acceptmouseclick='false'>
			<tab x="0" y="0" rright="0" rtop="0" showtab='false' acceptmouseclick='false'>
				<caption x="10" height="20" width="425" rtop="10" style="font-size: +2; color: #BFE2CE;"
					onshow="this.label = getlocstring('widgets.prefs.groups.game')"/>
				<image x="10" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="20"/>
				<panel label="&widgets.prefs.groups.game.presets;" align="center" x="10" height="160" rright="10" rtop="50"
						style="color: #3e5248; border-color: #3e5248; border-size: 1; font-size: -1;">
						<text x="25" width="200" rtop="30" y="25" style="color: #e9e3d9ff;" onshow="this.text = getlocstring('widgets.prefs.groups.game.presets.description')"/>
						<button height="25" width="150" rright="25" rtop="30" label="&widgets.prefs.groups.game.presets.quality;"
							style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -3; color: #FFFFFF;"
							onclick="clickPreferencePreset(0)" onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
						<button height="25" width="150" rright="25" rtop="70" label="&widgets.prefs.groups.game.presets.balanced;"
							style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -3; color: #FFFFFF;"
							onclick="clickPreferencePreset(1)" onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
						<button height="25" width="150" rright="25" rtop="110" label="&widgets.prefs.groups.game.presets.performance;"
							style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -3; color: #FFFFFF;"
							onclick="clickPreferencePreset(2)" onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
				</panel>
				<caption id="langCaption" label="&widgets.prefs.groups.game.language;" x="20" height="20" width="150" rtop="220" style="color: #e9e3d9ff;"/>
				<caption id="langList" height="20" width="150" rtop="220" rright="20"
					onshow="if(!this.mgr) new DDListControl(this, selectLanguage, 80, true); initLanguages(this.mgr);"
				 	onclick="this.mgr.toggleList()" onhide="this.mgr.hideList()"
				 	style="color: #BFE2CE; border-color: #3e5248; border-size: 1;">
				 	 <image rright="5" rtop="5" src="ui/textures/map-scaledown-off.bmp" width="10" height="10" acceptmouseclick="false"/>
				</caption>
				<caption label="&widgets.prefs.groups.game.lowmemory;" x="20" height="20" rright="0" rtop="250" style="color: #e9e3d9ff;"
					tip="&widgets.prefs.groups.game.lowmemory.tip;"/>
				<view id="lowMemorySystem" width="150" height="15" rtop="250" rright="10">
					<radiobutton label="&widgets.prefs.enabled;" x="5" y="0" width="70" height="15"
						style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
						onclick="addPreference('lowmemory', Preference.BOOL, true, true);"
						onshow="this.value = getPreference('lowmemory', Preference.BOOL, false, true);"/>
					<radiobutton label="&widgets.prefs.disabled;" y="0" width="70" height="15" rright="5" 
						style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
						onclick="addPreference('lowmemory', Preference.BOOL, false, true);"
						onshow="this.value = !getPreference('lowmemory', Preference.BOOL, false, true);"/>
				</view>
				<caption label="&widgets.prefs.groups.game.credits;" x="20" height="20" rright="0" rtop="280" style="color: #e9e3d9ff;"
					tip="&widgets.prefs.groups.game.credits.tip;"/>
				<view id="showCredits" width="150" height="15" rtop="280" rright="10">
					<radiobutton label="&widgets.prefs.enabled;" x="5" y="0" width="70" height="15"
						style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
						onclick="addPreference('app.showcredits', Preference.BOOL, true, false);"
						onshow="this.value = getPreference('app.showcredits', Preference.BOOL, true, false);"/>
					<radiobutton label="&widgets.prefs.disabled;" y="0" width="70" height="15" rright="5" 
						style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
						onclick="addPreference('app.showcredits', Preference.BOOL, false, false);"
						onshow="this.value = !getPreference('app.showcredits', Preference.BOOL, true, false);"/>
				</view>
				<script>
					<!-- 
							
					// INIT FUNCTIONS
					
					function initLanguages(list)
					{
						var options 	= game.settings.languages;
						var current		= getPreference('language', Preference.UINT, 0, true);
						
						list.clearRows(true);
						
						if(game.ostype == "mac")
						{
							list.addOption(getlocstring("widgets.prefs.na"), -1, -1);
						}
						else
						{
							if(game.region == 5) // china
							{
								list.addOption(getlocstring("widgets.prefs.groups.game.language." + options[game.region]), game.region, game.region);
							}
							else
							{
								for(var i = 0; i < options.length - 1; i++)
									list.addOption(getlocstring("widgets.prefs.groups.game.language." + options[i]), i, current);
							}
						}
						
						list.hideList();
					}
					
					function initFontSizes(list)
					{
						var options		= new Array(9, 10, 11, 12);
						var current		= getPreference('fontsize', Preference.UINT, 11, true);
						
						list.clearRows(true);
						
						for(var i = 0; i < options.length; i++)
							list.addOption(options[i], options[i], current);
						
						list.hideList();
					}
					
					// SET FUNCTIONS
					function selectLanguage(dbclick)
					{
						var list = findview("langList");
						
						if(list.mgr.data >= 0)
							addPreference("language", Preference.UINT, list.mgr.data, true);
					}
					
					function selectFontSize(dbclick)
					{
						consoleprint("Clicking fontsize....\n");
						addPreference("fontsize", Preference.UINT, findview("fontSizeList").mgr.data, true);
					}
					
					-->
				</script>
			</tab>
			<tab x="0" y="0" rright="0" rtop="0" showtab='false' acceptmouseclick='false'>
				<caption x="10" height="20" width="425" rtop="10" style="font-size: +2; color: #BFE2CE;"
					onshow="this.label = getlocstring('widgets.prefs.groups.connection')"/>
				<image x="10" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="20"/>
				<caption label="&widgets.prefs.groups.connection.network;" x="20" height="20" rright="0" rtop="40" style="color: #e9e3d9ff;"
					tip="&widgets.prefs.groups.connection.network.tip;"/>
				<caption id="routeList" height="20" width="150" rtop="40" rright="20"
					onshow="if(!this.mgr) new DDListControl(this, selectRoute, 50, true); initRoutes(this.mgr);"
				 	onclick="this.mgr.toggleList()" onhide="this.mgr.hideList()"
				 	style="color: #BFE2CE; border-color: #3e5248; border-size: 1;">
				 	 <image rright="5" rtop="5" src="ui/textures/map-scaledown-off.bmp" width="10" height="10" acceptmouseclick="false"/>
				</caption>
				<caption label="&widgets.prefs.groups.connection.vislimit;" x="20" height="20" rright="0" rtop="70" style="color: #e9e3d9ff;"
					tip="&widgets.prefs.groups.connection.vislimit.tip;"/>
				<caption id="visList" height="20" width="150" rtop="70" rright="20"
					onshow="if(!this.mgr) new DDListControl(this, selectVis, 50, true); initVis(this.mgr);"
				 	onclick="this.mgr.toggleList()" onhide="this.mgr.hideList()"
				 	style="color: #BFE2CE; border-color: #3e5248; border-size: 1;">
				 	 <image rright="5" rtop="5" src="ui/textures/map-scaledown-off.bmp" width="10" height="10" acceptmouseclick="false"/>
				</caption>
				<!--
				<caption label="&widgets.prefs.groups.connection.netcode2;" x="20" height="20" rright="0" rtop="100" style="color: #e9e3d9ff;"
					tip="&widgets.prefs.groups.connection.netcode2.tip;"/>
				<view width="150" height="15" rtop="100" rright="10">
					<radiobutton label="&widgets.prefs.enabled;" x="5" y="0" width="70" height="15"
						style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
						onclick="addPreference('app.usenetcode2', Preference.BOOL, true, false);"
						onshow="this.value = getPreference('app.usenetcode2', Preference.BOOL, false, false);"/>
					<radiobutton label="&widgets.prefs.disabled;" y="0" width="70" height="15" rright="5" 
						style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
						onclick="addPreference('app.usenetcode2', Preference.BOOL, false, false);"
						onshow="this.value = !getPreference('app.usenetcode2', Preference.BOOL, false, false);"/>
				</view>
				-->
				<script>
					<!-- 
							
					// INIT FUNCTIONS
					function initRoutes(list)
					{
						var options		= new Array("best", "primary", "secondary");
						var current		= getPreference('usenetworkroute', Preference.SINT, 0, true);
						
						list.clearRows(true);
						
						for(var i = 0; i < options.length; i++)
							list.addOption(getlocstring("widgets.prefs.groups.connection.network." + options[i]), i, current);
						
						list.hideList();
					}
					
					function selectRoute(dbclick)
					{
						addPreference("usenetworkroute", Preference.SINT, findview("routeList").mgr.data, true);
					}
					
					function initVis(list)
					{
						var options	= new Array("low", "medium", "high");
						var current = getPreference("visplayerlimit", Preference.SINT, 2, true);
						
						list.clearRows(true);
						
						for(var i = 0; i < options.length; i++)
								list.addOption(getlocstring("widgets.prefs.groups.connection.vislimit." + options[i]), i + 1, current);
						
						list.hideList();
					}
					
					// SET FUNCTIONS
					
					function selectVis(dbclick)
					{
						addPreference("visplayerlimit", Preference.SINT, findview("visList").mgr.data, true);
					}
					
					-->
				</script>
			</tab>
			<tab x="0" y="0" rright="0" rtop="0" showtab='false' acceptmouseclick='false'>
				<caption label="&widgets.prefs.groups.video;" x="10" height="20" width="425" rtop="10" style="font-size: +2; color: #BFE2CE;"/>
				<image x="10" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="20"/>
				<caption label="&widgets.prefs.groups.video.card;" x="20" height="20" rright="0" rtop="50" style="color: #e9e3d9ff;"
					tip="&widgets.prefs.groups.video.card.tip;"/>
				<caption id="videoList" height="20" width="150" rtop="50" rright="20"
					onshow="if(!this.mgr) new DDListControl(this, selectVideo, 75, true); initVideo(this.mgr);"
				 	onclick="this.mgr.toggleList()" onhide="this.mgr.hideList()"
				 	style="color: #BFE2CE; border-color: #3e5248; border-size: 1;">
				 	 <image rright="5" rtop="5" src="ui/textures/map-scaledown-off.bmp" width="10" height="10" acceptmouseclick="false"/>
				</caption>
				<caption label="&widgets.prefs.groups.video.resolution;" x="20" height="20" rright="0" rtop="90" style="color: #e9e3d9ff;"
					tip="&widgets.prefs.groups.video.resolution.tip;"/>
				<caption id="resolutionList" height="20" width="150" rtop="90" rright="20"
				 	onclick="if(this.mgr) this.mgr.toggleList()" onhide="if(this.mgr) this.mgr.hideList()"
				 	style="color: #BFE2CE; border-color: #3e5248; border-size: 1;">
				 	 <image rright="5" rtop="5" src="ui/textures/map-scaledown-off.bmp" width="10" height="10" acceptmouseclick="false"/>
				</caption>
				<caption label="&widgets.prefs.groups.video.vertsync;" x="20" height="20" rright="0" rtop="130" style="color: #e9e3d9ff;"
					tip="&widgets.prefs.groups.video.vertsync.tip;"/>
				<view id="vertSyncOptions" width="150" height="15" rtop="130" rright="10">
					<radiobutton label="&widgets.prefs.enabled;" x="5" y="0" width="70" height="15"
						style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
						onclick="addPreference('enablevsync', Preference.BOOL, true, true);"
						onshow="this.value = getPreference('enablevsync', Preference.BOOL, false, true);"/>
					<radiobutton label="&widgets.prefs.disabled;" y="0" width="70" height="15" rright="5" 
						style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
						onclick="addPreference('enablevsync', Preference.BOOL, false, true);"
						onshow="this.value = !getPreference('enablevsync', Preference.BOOL, false, true);"/>
				</view>
				<script>
					<!-- 
							
					// INIT FUNCTIONS
					var videoCards = game.settings.videocards;
					
					// INIT FUNCTIONS
					function initVideo(list)
					{
						list.clearRows(true);
						
						if(videoCards.length > 0)
						{
							var defaultCard = 0;
							var current 	= getPreference("video", Preference.STRING, null, true);
							
							for(var i = 0; i < videoCards.length; i++)
							{
								if(videoCards[i].id == current)
									defaultCard = i;
								
								list.addItem(videoCards[i].name, videoCards[i], false);
							}
							
							list.clickList(false, defaultCard);
						}
						
						list.hideList();
					}
					
					function initResolutions(list)
					{
						var card 	= findview("videoList").mgr.data;
						var options	= videoCards[card.index].modes;
						var current = getPreference('resolution', Preference.STRING, "1024x768x32", true);
						
						list.clearRows(true);
						
						for(var i = 0; i < options.length; i++)
								list.addOption(options[i], options[i], current);
						
						list.hideList();
					}
					
					// SET FUNCTIONS
					
					function selectVideo(dbclick)
					{
						var curValue = getPreference("video", Preference.STRING, null, true);
						var newValue = findview("videoList").mgr.data.id;
						
						//consoleprint("Video Card curValue is " + curValue + "\n");
						//consoleprint("Video Card newValue is " + newValue + "\n");
						
						if(newValue != curValue)
							addPreference("video", Preference.STRING, newValue, true);
						
						var resView = findview("resolutionList");
						var resMgr	= resView.mgr;
						
						if(resMgr == null)
								resMgr = new DDListControl(resView, selectResolution, 75, true);
						
						initResolutions(resMgr);
					}
					
					function selectResolution(dbclick)
					{
						addPreference("resolution", Preference.STRING, findview("resolutionList").mgr.data, true);
					}
					
					function setGammaColor(color, value)
					{
						addSliderPreference(color, Preference.FLOAT, value, true, 2, 0);
						
						if(getPreference('ui.lockgammasliders', Preference.BOOL, false, false))
						{
							var colors = new Array('gammared','gammagreen','gammablue');
							
							for(var i = 0; i < colors.length; i++)
							{
								if(color != colors[i])
								{
									addSliderPreference(colors[i], Preference.FLOAT, value, true, 2, 0);
									findview(colors[i] + "-slider").value = value;
								}
							}									
						}
					}
					
					function mouseclickhack()
					{
					  return false;
					}
							
					-->
				</script>				
			</tab>
