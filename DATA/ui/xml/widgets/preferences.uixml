				<script>
					<!-- 
					var soundCards = game.settings.soundcards;
					
					// INIT FUNCTIONS
					function initAudio(list)
					{
						list.clearRows(true);
						
						if(game.ostype == "mac")
						{
							list.addOption(getlocstring("widgets.prefs.na"), -1, -1);
						}
						else if(soundCards.length > 0)
						{
							var defaultCard = 0;
							var current 	= getPreference("sound", Preference.STRING, null, true);
							
							for(var i = 0; i < soundCards.length; i++)
							{
								if(soundCards[i].id == current)
									defaultCard = i;
								
								list.addItem(soundCards[i].name, soundCards[i], false);
							}
							
							list.clickList(false, defaultCard);
						}
						
						list.hideList();
					}
					
					// combined
					function initAudioSystem(list)
					{
						var options		= new Array("hardware", "software", "disabled");
						var enabled 	= getPreference("bsoundenable", Preference.BOOL, true, true);
						var enable3d 	= getPreference("b3dsoundenable", Preference.BOOL, false, true);
						var current		= 0;
						
						if(!enable3d && enabled)
								current = 1;
						else if(!enabled)
								current = 2;
						
						list.clearRows(true);
						
						if(game.ostype == "mac")
						{
							list.addOption(getlocstring("widgets.prefs.na"), -1, -1);
						}
						else
						{								
							for(var i = 0; i < options.length; i++)
								list.addOption(getlocstring("widgets.prefs.groups.sound.system." + options[i]), i, current);
						}
						
						list.hideList();
					}
					
					function initAudioMax(list)
					{
						var options	= new Array(16, 32, 64, 128);
						var current = getPreference("maxnumbersounds", Preference.UINT, 16, true);
						
						list.clearRows(true);
						
						for(var i = 0; i < options.length; i++)
								list.addOption(options[i] + " " + getlocstring('widgets.prefs.groups.sound.maxsounds.sounds'), options[i], current);
						
						list.hideList();
					}
					
					function initAmbience(list)
					{
						var options	= new Array("frequent", "infrequent", "disabled");
						var current = getPreference("ambientlevel", Preference.SINT, 0, true);
						
						list.clearRows(true);
						
						for(var i = 0; i < options.length; i++)
								list.addOption(getlocstring("widgets.prefs.groups.sound.ambient." + options[i]), i, current);
						
						list.hideList();
					}
					
					// SET FUNCTIONS
					
					function selectAudio(dbclick)
					{
						var list = findview("audioList");
						
						if(list.mgr.data != null)
							addPreference("sound", Preference.STRING, list.mgr.data.id, true);
					}
					
					function selectAudioSystem(dbclick)
					{
						var selected = findview("audioSystemList").mgr.data;
						
						if(selected < 0)
							return;
						
						switch(selected)
						{
							case 0:
								addPreference("bsoundenable", Preference.BOOL, true, true);
								addPreference("b3dsoundenable", Preference.BOOL, true, true);
								break;
							case 1:
								addPreference("bsoundenable", Preference.BOOL, true, true);
								addPreference("b3dsoundenable", Preference.BOOL, false, true);
								break;
							default:
								addPreference("bsoundenable", Preference.BOOL, false, true);
								addPreference("b3dsoundenable", Preference.BOOL, false, true);
								break;
						}
					}
					
					function selectAudioMax(dbclick)
					{
							addPreference("maxnumbersounds", Preference.UINT, findview("audioMaxList").mgr.data, true);
					}
					
					function selectAmbience(dbclick)
					{
							addPreference("ambientlevel", Preference.SINT, findview("ambienceList").mgr.data, true);
					}
							
					-->
				</script>			
			</tab>
