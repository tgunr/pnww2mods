				<caption label="&widgets.prefs.groups.ui.fontsize;" x="20" height="20" width="150" rtop="50" style="color: #e9e3d9ff;"/>
				<caption id="fontSizeList" height="20" width="150" rtop="50" rright="20"
					onshow="if(!this.mgr) new DDListControl(this, selectFontSize, 65, true); initFontSizes(this.mgr);"
				 	onclick="this.mgr.toggleList()" onhide="this.mgr.hideList()"
				 	style="color: #BFE2CE; border-color: #3e5248; border-size: 1;">
				 	 <image rright="5" rtop="5" src="ui/textures/map-scaledown-off.bmp" width="10" height="10" acceptmouseclick="false"/>
