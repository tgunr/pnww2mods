						tip="&widgets.prefs.groups.hud.windows.reset.tip;">
						<caption label="&widgets.prefs.groups.hud.windows.reset;" x="20" height="20" width="150" rtop="22" style="color: #e9e3d9ff;"/>
						<button height="25" width="150" rright="15" rtop="20" label="&widgets.prefs.groups.hud.windows.reset.button;"
							style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -3; color: #FFFFFF;"
							onclick="resetHud()" onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
