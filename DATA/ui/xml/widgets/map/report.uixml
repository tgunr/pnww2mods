<?xml version="1.0"?>
 
<window id="report" x="0" y="0" width="1024" height="768"  viewportwidth="1024" viewportheight="768" aspectalign="center"
	style="background-color: #00000077;" layer="100">
	<include file="lib/common.uixml"/>
	<view width="390" height="250" style="background-color: #00000088; 
							border-sides: ui/textures/hud/border_side.bmp;
							border-corner: ui/textures/hud/border_corner.bmp;
							border-width: 4;
							border-height: 4;" moveondrag="yes">
		<caption label="${widgets.map.waypoints.contact}" x="10" width="300" height="20" rtop="8" style="font-size: +1; color: #BFE2CE;"/>
		<image x="10" width="330" height="12" rtop="20" src="ui/textures/test/horiz_underline.bmp"/>
		
		<caption id="contact-type" x="10" width="200" height="20" rtop="30" maxlength="128" style="font-size: -1; color: #FFFFFF;"/>
		<text id="wp-notes" x="10" y="45" width="180" rtop="50" acceptsfocus="true" style="background-color: #FFFFFF22;  color: #e9e3d9;"/>
			
		<view x="200" y="40" rright="20" rtop="30" rright="10">
			<caption label="${widgets.map.context.waypoints.add.report.type}" x="5" height="20" rright="5" rtop="0" maxlength="128"
				style="font-size: -1; color: #FFFFFF;"/>				
			<radiobutton label="${widgets.map.waypoints.contact.infantry}" x="5" rright="5" height="15" rtop="30"
				style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
				onclick="setWaypointType('troop')" onshow="this.value = true;"/>
			<view class="contacticon"  x="105" height="15" width="15" rtop="30" index="8" style="color: #FF0000;"/>
			<radiobutton label="${widgets.map.waypoints.contact.armor}" x="5" rright="5" height="15" rtop="45"
				style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
				onclick="setWaypointType('land')"/>
			<view class="contacticon"  x="105" height="15" width="15" rtop="45" index="2" style="color: #FF0000;"/>
			<radiobutton label="${widgets.map.waypoints.contact.airforce}" x="5" rright="5" height="15" rtop="60"
				style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
				onclick="setWaypointType('air')"/>
			<view class="contacticon"  x="105" height="15" width="15" rtop="60" index="0" style="color: #FF0000;"/>
			<radiobutton label="${widgets.map.waypoints.contact.shipping}" x="5" rright="5" height="15" rtop="75"
				style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
				onclick="setWaypointType('sea')"/>
			<view class="contacticon"  x="105" height="15" width="15" rtop="75" index="1" style="color: #FF0000;"/>	
			<radiobutton label="${widgets.map.waypoints.contact.gun}" x="5" rright="5" height="15" rtop="90"
				style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
				onclick="setWaypointType('gun')"/>
			<view class="contacticon"  x="105" height="15" width="15" rtop="90" index="3" style="color: #FF0000;"/>
			<radiobutton label="${widgets.map.waypoints.contact.truck}" x="5" rright="5" height="15" rtop="105"
				style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
				onclick="setWaypointType('truck')"/>
			<view class="contacticon"  x="105" height="15" width="15" rtop="105" index="4" style="color: #FF0000;"/>
			<radiobutton label="${widgets.map.waypoints.contact.danger}" x="5" rright="5" height="15" rtop="120"
				style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
				onclick="setWaypointType('danger')"/>
			<view class="contacticon"  x="105" height="15" width="15" rtop="120" index="5" style="color: #FF0000;"/>
			<radiobutton label="${widgets.map.waypoints.contact.unknown}" x="5" rright="5" height="15" rtop="135"
				style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
				onclick="setWaypointType('unknown')"/>
			<view class="contacticon"  x="105" height="15" width="15" rtop="135" index="6" style="color: #FF0000;"/>
		</view>
		<button id="popup-no" x="30" y="10" width="150" height="25" label="${popup.cancel}" onclick="addReport(false)"
			style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
			onmouseenter="if(this.enabled) this.setstyleproperty('color', '#FFFF00')" onmouseexit="this.setstyleproperty('color', '#FFFFFF')"/>
		<button id="popup-yes" x="190" y="10" width="150" height="25" label="${popup.ok}" onclick="addReport(true)"
			style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
			onmouseenter="if(this.enabled) this.setstyleproperty('color', '#FFFF00')" onmouseexit="this.setstyleproperty('color', '#FFFFFF')"/>
	</view>
	<script>
		<!--
		
		var wpMap 	= null;
		var wpType 	= null;
		var wpX 	= null;
		var wpY 	= null;
		
		function initReportPopup(map, type, x, y)
		{
			wpMap 	= map;
			wpType 	= type;
			wpX 	= x;
			wpY 	= y;
			setCRLabel();
		}
		
		function setWaypointType(type)
		{
			wpType = type;
			setCRLabel();
		}

		function setCRLabel()
		{
			var header = findview("contact-type");
			
			if(header != null)
			{
				if(wpType == "troop")
					header.label = getlocstring('widgets.map.waypoints.contact.infantry');
				else if(wpType == "land")
					header.label = getlocstring('widgets.map.waypoints.contact.armor');
				else if(wpType == "air")
					header.label = getlocstring('widgets.map.waypoints.contact.airforce');
				else if(wpType == "sea")
					header.label = getlocstring('widgets.map.waypoints.contact.shipping');
				else if(wpType == "gun")
					header.label = getlocstring('widgets.map.waypoints.contact.gun');
				else if(wpType == "truck")
					header.label = getlocstring('widgets.map.waypoints.contact.truck');
				else if(wpType == "danger")
					header.label = getlocstring('widgets.map.waypoints.contact.danger');
				else if(wpType == "unknown")
					header.label = getlocstring('widgets.map.waypoints.contact.unknown');
			}
		}
		
		function addReport(confirm)
		{
			soundPlayClick();
			
			if(confirm)
			{
				var wpNotes	= findview("wp-notes").text;
				wpMap.addwaypoint(wpType, wpX, wpY, "", wpNotes);
			}
			
			window.close();
		}
		
		-->
	</script>
</window>
