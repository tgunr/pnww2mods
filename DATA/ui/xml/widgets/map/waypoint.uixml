<?xml version="1.0"?>
 
<window id="waypoint" x="0" y="0" width="1024" height="768"  viewportwidth="1024" viewportheight="768" layer="100" aspectalign="center">
	<include file="lib/common.uixml"/>
	<view id="waypoint-popup" width="390" height="250" style="background-color: #00000088; 
							border-sides: ui/textures/hud/border_side.bmp;
							border-corner: ui/textures/hud/border_corner.bmp;
							border-width: 4;
							border-height: 4;" moveondrag="yes">
		<caption label="${widgets.map.waypoints.create}" x="10" width="320" height="20" rtop="8" style="font-size: +1; color: #BFE2CE;"/>
		<image x="10" width="330" height="12" rtop="20" src="ui/textures/test/horiz_underline.bmp"/>
		
		<caption label="${widgets.map.waypoints.name}" x="10" y="191" width="320" height="20" style="font-size: -1; color: #FFFFFF;"/>
		<textcontrol id="wp-name" x="10" y="175" height="15" width="200" acceptsfocus="true" maxlength="8" style="background-color: #FFFFFF22;  color: #e9e3d9;" onmousedown="this.text = ''"/>
		
		<caption label="${widgets.map.waypoints.notes}" x="10" y="146" width="200" height="20" maxlength="128" style="font-size: -1; color: #FFFFFF;"/>
		<text id="wp-notes" x="10" y="45" height="100" width="200" acceptsfocus="true" style="background-color: #FFFFFF22;  color: #e9e3d9;"/>
			
		<view x="220" y="40" rright="20" rtop="40">
			<caption label="${widgets.map.context.waypoints.add.waypoint.type}" x="5" height="20" rright="5" rtop="0" maxlength="128"
				style="font-size: -1; color: #FFFFFF;"/>
			<image id="rally-img" x="115" height="15" width="15" rtop="30" src="ui/textures/waypoint.bmp" style="color: #0000FF;"/>
			<radiobutton id="rally-button" label="${widgets.map.waypoints.add.rally}" x="5" rright="5" height="15" rtop="30"
				style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
				onclick="setWaypointType('rally')" onshow="this.value = true;"/>
			<image id="attack-img" x="115" height="15" width="15" rtop="50" src="ui/textures/waypoint.bmp" style="color: #FF0000;"/>
			<radiobutton id="attack-button" label="${widgets.map.waypoints.add.attack}" x="5" rright="5" height="15" rtop="50"
				style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
				onclick="setWaypointType('attack')"/>
			<view class="contacticon" id="mortar-img"  x="115" height="15" width="15" rtop="70" index="7" style="color: #FF0000;"/>
			<radiobutton id="mortar-button" label="${widgets.map.waypoints.add.mortar}" x="5" rright="5" height="15" rtop="70"
				style="color: #ffffff; font-size: -1; control-on: ui/textures/map-checkbox-on.bmp; control-off: ui/textures/map-checkbox-off.bmp;"
				onclick="setWaypointType('mortar')"/>
		</view>
		
		<button id="popup-no" x="30" y="10" width="150" height="25" label="${popup.cancel}" onclick="addWaypoint(false)"
			style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
			onmouseenter="if(this.enabled) this.setstyleproperty('color', '#FFFF00')" onmouseexit="this.setstyleproperty('color', '#FFFFFF')"/>
		<button id="popup-yes" x="190" y="10" width="150" height="25" label="${popup.ok}" onclick="addWaypoint(true)"
			style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
			onmouseenter="if(this.enabled) this.setstyleproperty('color', '#FFFF00')" onmouseexit="this.setstyleproperty('color', '#FFFFFF')"/>
	</view>
	<script>
		<!--
		
		var wpMap 	= null;
		var wpType 	= null;
		var wpX 	= null;
		var wpY 	= null;
		
		function initWaypointPopup(map, type, x, y)
		{
			wpMap 	= map;
			wpType 	= type;
			wpX 	= x;
			wpY 	= y;
			
			findview("wp-name").text = map.getnexthandle(type);
			
		}
		
		function isMissionLeader()
		{		
			cprint("In isMissionLeader()...");
			
			if(game.online)
			{
				var client = game.player.client;
								
				if(client.ismissionleader())
					return true;	
			}
			
			return false;
		}
		
		function setWaypointType(type)
		{
			consoleprint("Setting wp type to: " + type + "\n");
			wpType = type;
			findview("wp-name").text = wpMap.getnexthandle(type);
			consoleprint("Setting wp type to: " + type + "\n");
		}
		
		function addWaypoint(confirm)
		{
			soundPlayClick();			
			
			if(confirm)
			{
				var badRE	= /[^\w]/;
				var wpName	= findview("wp-name").text;
				var wpNotes	= findview("wp-notes").text;
				
				wpName = wpName.replace(badRE, "");
				wpMap.addwaypoint(wpType, wpX, wpY, wpName, wpNotes);
			}
			
			window.close();
		}
		
		-->
	</script>
</window>
