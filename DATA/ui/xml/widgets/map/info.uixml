<?xml version="1.0"?>
<!DOCTYPE uixml SYSTEM "loc://ui.dtd">
<view id="map-info" x="1" y="1" rright="1" height="16" style="background-color: #00000088;"
	onload="if(!this.mgr) new MapInfo(this, null, false)" onshow="this.mgr.showInfo()" onupdate="this.mgr.updateInfo()">
	<!-- origin -->
	<view x="0" y="0" width="215" height="16" tip="&widgets.map.info.origin.tip;">
		<caption label="&widgets.map.info.origin.title;" x="1" y="1" width="215" height="14" acceptmouseclick="false"
			style="font-size: -1; color: #BFE2CE;"/>
		<caption id="map-info-origin" x="60" width="155" height="12" rtop="2"
			style="font-size: -1; color: #FFFFFF;" onclick="this.mgr.clickInfo('origin')"/>
	</view>
	<!-- target -->
	<view x="220" y="0" width="215" height="16"	tip="&widgets.map.info.target.tip;">
		<caption label="&widgets.map.info.target.title;" x="1" y="1" width="215" height="14" acceptmouseclick="false"
			style="font-size: -1; color: #BFE2CE;"/>
		<caption id="map-info-target" x="65" width="155" height="12" rtop="2"
			style="font-size: -1; color: #FFFFFF;" onclick="this.mgr.clickInfo('target')"/>
	</view>
	<!-- player lat/lon -->
	<view x="440" y="0" width="215" height="16" tip="&widgets.map.info.me.tip;">
		<caption label="&widgets.map.info.me.title;" x="1" y="1" width="215" height="14" acceptmouseclick="false"
			style="font-size: -1; color: #BFE2CE;"/>
		<caption id="map-info-playerpos" x="100" width="120" height="12" rtop="2"
			style="font-size: -1; color: #FFFFFF;" onclick="this.mgr.clickInfo('player')"/>
	</view>
	<!-- mouse lat/lon -->
	<view x="660" y="0" width="215" height="16" tip="&widgets.map.info.mouse.tip;">
		<caption label="&widgets.map.info.mouse.title;" x="1" y="1" width="215" height="14" acceptmouseclick="false"
			style="font-size: -1; color: #BFE2CE;"/>
		<caption id="map-info-mousepos" x="100" width="120" height="12" rtop="2"
		 style="font-size: -1; color: #FFFFFF;" acceptmouseclick="false"/>
	</view>
</view>

