<?xml version="1.0"?>
<!DOCTYPE uixml SYSTEM "loc://ui.dtd"> 
<view id="hud-scenario" class="target" x="0" y="0" width="1024" height="768" layer="-10" acceptsmouse='false'
	onshow="initHUDObject(this, updateHUDCallback)" acceptsmouseclick='false'>
	<include file="lib/hud.uixml"/>
	<view x="0" y="0" height="15" width="80">
		<view id="bullet" x="38" y="5" height="5" width="5" style="background-color: #FF000088;"/>
		<text id="display" x="50" y="0" height="15" rright="0" acceptsmouseclick='false'
			style="color: #FFFFFF;"/>
	</view>
<script>
	<!--
	
	var bullet = null;
	
	function updateHUDCallback(placement, distance, alpha)
	{
		if(bullet == null && display != null)
		{
			var p = display.parent;
			bullet = parent.findview("bullet");
		}
		
		if(display == null || bullet == null)
			return;
	
		if(alpha == 0)
		{
			if(display.visible)
				display.visible = false;
			
			if(bullet.visible)
				bullet.visible = false;
		}
		else
		{
			if(!display.visible)
				display.visible = true;
				
			if(!bullet.visible)
				bullet.visible = true;
			
			var acolor = 255 * alpha;
			var bg = 128 * alpha;
			
			display.setstyleproperty("color", color + acolor.toString(16));
			bullet.setstyleproperty("color", color + acolor.toString(16));
			
			var newLabel = "";
			
			if(label != null)
				newLabel = (placement == 0) ? label : label.charAt(0);
			
			if(distance >= 0 && placement == 0)
			{
				if(label != null)
					newLabel += ": ";
				
				newLabel += distance + "m";
			}
			
			display.text = newLabel;
			
			if(!game.scenario)
				display.resizetotext();
		}
	}
	
	-->
</script>
</view>

