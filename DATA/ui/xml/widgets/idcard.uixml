<?xml version="1.0"?>
 
<view id="id-card" x="5" y="640" width="200" height="120" style="background-image: ui/textures/test/idcard.bmp;" onupdate="updateIDCard()"
	tip="${widgets.idcard.tip}">
	
	<caption x="10" height="15" width="200" rtop="6" style="font-size: -2; color: #000000ff;" label="${widgets.idcard.status}:"/>
	<caption id="id-dutystatus" height="15" width="200" rright="20" rtop="6" style="color: #000000ff; font-size: -1;" label="${widgets.idcard.duty}" align="right"/>	
	
	<caption id="id-persona" x="10" height="15" width="170" rtop="20" style="font-size: -2; color: #000000ff;"/>
	<caption id="id-brigade" x="20" height="15" width="160" rtop="35" style="font-size: -2; color: #000000ff;"/>
	<caption id="id-division" x="20" height="15" width="160" rtop="48" style="font-size: -2; color: #000000ff;"/>
	
	<caption x="10" height="12" width="200" rtop="65" style="font-size: -2; color: #000000ff;" label="${widgets.idcard.name}:"/>
	<caption id="id-handle" x="10" height="12" rright="20" rtop="65" style="font-size: -2; color: #000000ff;" align="right"/>
	
	<caption x="10" height="12" width="200" rtop="75" style="font-size: -2; color: #000000ff;" label="${widgets.idcard.rank}:"/>
	<image id="id-rank-lock" x="0" width="10" height="10" rtop="75" src="ui/textures/lock.dds" style="color: #FF0000;"/>
	<caption id="id-rank" x="10" height="12" rright="20" rtop="75" style="font-size: -2; color: #000000ff;" align="right"/>
	
	<caption x="10" height="12" width="200" rtop="85" style="font-size: -2; color: #000000ff;" label="${widgets.idcard.progress}:"/>
	<caption id="id-progression" x="10" height="12" rright="20" rtop="85" style="font-size: -2; color: #000000ff;" align="right"/>
	
	<script>
		<!--
		
		var idPersona 		= findview("id-persona");
		var idHandle 		= findview("id-handle");
		var idRank 			= findview("id-rank");
		var idRankLock		= findview("id-rank-lock");
		var idProgression 	= findview("id-progression");
		var idBrigade 		= findview("id-brigade");
		var idDivision 		= findview("id-division");
		var idDutyStatus 	= findview("id-dutystatus");
		var idTimer			= new CycleTimer(1000);
		
		function updateIDCard()
		{
			if(idTimer.run())
			{
				var myClient	= game.player.client;
				var myPersona 	= myClient.persona;
				
				if(myPersona != null)
				{
					var myBrigade			= myPersona.brigade;
					var oicBrigade			= myClient.oicof;
					
				 	idPersona.label 		= getCountryBranch(myPersona.country, myPersona.branch, 1);
					idHandle.label 			= myClient.handle;
					idRank.label 			= (myPersona.rank.level > 0) ? myPersona.rank.name: "n/a";
					idRankLock.visible		= myPersona.rank.locked;
					idProgression.label 	= myPersona.rankpercent + "% ";
					idBrigade.label 		= (myBrigade.id > 0) ? myBrigade.name: "";
					idDivision.label 		= (myBrigade.id > 0) ? myBrigade.division: "";
					idDutyStatus.label 		= (oicBrigade != null) ? getlocstring("widgets.idcard.oic"): getlocstring("widgets.idcard.duty");
					
					var idCard 	= idPersona.parent;
					var idTip	= getlocstring("widgets.idcard.tip");
					
					if(idRankLock.visible)
					{
						idRankLock.x = (idRank.x + idRank.width) - idRank.stringlength - 5 - idRankLock.width;
						idTip += "\n\n";
						idTip += getlocstring("persona.details.ranklock");
					}
					
					idCard.settip(idTip);
					
					//consoleprint("Use max rank is set to: " + useMaxRank + "\n");
				}
				else
				{
					showIDCard(false);
				}
			}
		}
		
		function showIDCard(flag)
		{
			findview("id-card").visible = flag;
		}
		
		-->
	</script>
</view>
