<?xml version="1.0"?>
 
<tab id="tutorials" label="  ${tutorials.tab}  " x="0" y="0" width="930" height="460" tip="${tutorials.tab.tip}">
	<include file="lib/tutorial.uixml"/>
	<include file="classes/TreeControl2.uixml"/>
	<include file="classes/CycleTimer.uixml"/>
	<view id="left-pane" x="18" y="18" width="444" height="411">
		<view x="10" y="10" width="425" rtop="10">
			<caption label="${tutorials.select}" x="0" rtop="10" height="20" width="400" style="font-size: +2; color: #BFE2CE;"/>
			<image x="0" rtop="20" src="ui/textures/test/horiz_underline.bmp" width="425" height="12"/>
			<list id="tutorialTree" x="0" y="5" width="425" rtop="32" style="color: #e9e3d9ff;"
				onselect="tutorialTree.clickTree(false)" ondblselect="tutorialTree.clickTree(true)">
				<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
			</list>
		</view>
	</view>
	<include file="widgets/divider.uixml"/>
	<view id="right-pane" x="468" y="18" width="444" height="411">
		<view x="10" y="10" width="425" rtop="17">
			<caption id="tut-header" x="0" height="20" width="400" rtop="2" style="font-size: +2; color: #BFE2CE;"/>
			<image x="0" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="12"/>
			<text id="tut-body" x="5" height="200" rright="5" rtop="26" acceptfocus="no" style="color: #e9e3d9ff;"/>
			<panel id="tut-info" label="${tutorials.info}" align="center" x="0" y="10" height="100" rright="0"
				style="color: #3e5248; border-color: #3e5248; border-size: 1; font-size: -1;">
				<caption label="${tutorials.status}:" x="20" height="15" rright="20" rtop="20" style="color: #e9e3d9ff;"/>
				<caption id="tut-status" x="20" height="15" rright="20" rtop="20" style="color: #e9e3d9ff;" align="right"/>
				<caption label="${tutorials.prereq}:" x="20" height="15" rright="20" rtop="40" style="color: #e9e3d9ff;"/>
				<caption id="tut-prereq" x="20" height="15" rright="20" rtop="40" style="color: #e9e3d9ff;" align="right"/>
				<caption label="${tutorials.prereqstatus}:" x="20" height="15" rright="20" rtop="60" style="color: #e9e3d9ff;"/>
				<caption id="tut-prereqstatus" x="20" height="15" rright="20" rtop="60" style="color: #e9e3d9ff;" align="right"/>
			</panel>
			<!-- button id="tut-reset-button" label="TOGGLE STATUS" y="5" width="150" height="30" x="0"
				onclick="resetTutorialDisplay();"
				style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; color: #FFFFFF; font-size: -3;"
				onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/ -->
			<!-- button id="tut-start-button" label="${tutorials.start}" y="5" width="150" height="30" rright="0"
				onclick="startTutorial()" onupdate="this.enabled = updateStartTutorial()"
				style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; color: #FFFFFF; font-size: -3;"
				onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"
				tip="${widgets.template.next.tip}"/ -->
			<!--
			<button id="tut-reset-button" label="TOGGLE STATUS" y="5" width="150" height="30" rright="0"
				onclick="toggleTutorialStatus();"
				style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; color: #FFFFFF; font-size: -3;"
				onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
			-->
		</view>
	</view>
	<script>
		<!--
		
		var tutorialTree	= new TreeControl("tutorialTree", selectTutorial, formatTutorial);
		var tutorial		= null;
		var tutRequirement	= null;
		var tutHeader		= findview("tut-header");
		var tutBody			= findview("tut-body");
		var tutInfo			= findview("tut-info");
		var tutBestNode		= -1;
		
		game.player.client.onspawnerror = onSpawnDenied;
		
		function initTutorials()
		{
			cprint("Checking whether to skip graduation: " + game.globals.skipgraduation + "\n");
			
			if(game.globals.skipgraduation != true)
				TutCheckGraduation();
			
			game.globals.skipgraduation = false;
			game.ongraduated = redrawTree;
			
			if(!tutorialTree.initTree())
			{
				var root = TutGetContent("tutorials");
				
				if(root)
				{
					var links = root.links;
					
					for(var i = 0; i < links.length; i++)
					{
						var link 	= links[i];
						var branch	= (link.type == "directory") ? true: false;
						var node	= initTutorial(new TreeNode(link.path, link.path, 1, branch, link.title));
						
						if(isPersonaTutorial(node))
						{
							if(branch)
								node.expand();
							
							tutorialTree.addNode(node);
						}
					}
				}
				
				tutorialTree.setColorText(null);
				tutorialTree.drawTree();
				
				tutorialTree.findNodes(bestSelection);
				
				if(tutBestNode >= 0)
					tutorialTree.clickTree(false, tutBestNode);
			}
		}
		
		function bestSelection(node)
		{
			if(tutBestNode >= 0) return;
			
			if(!node.branch)
			{
				var status = TutGetStatus(node.content);
				
				if(status == "open")
				{
					tutBestNode = node.row;
					cprint("Found best row: " + tutBestNode + "\n");
				}
			}
		}
		
		function isPersonaTutorial(node)
		{
			if(node.content != null && node.content.country != null)
				return (node.content.country == game.player.client.country.id);
			
			return true;
		}
		
		function selectTutorial()
		{
			var node = tutorialTree.selectedNode();
			
			initTutorial(node);
			
			if(node.content != null)
			{
				//game.chatprint("Selected tutorial has content!");
				setTutorial(node.content);
			}
		}
		
		function initTutorial(node)
		{
			cprint("Node is " + node + "\n");
			
			if(node != null && !node.initNode())
			{
				cprint("INITING NODE!!!\n");
				
				if(node.content == null)
					node.content = TutGetContent(node.data);
				
				if(node.content != null && node.branch)
				{
					var links = node.content.links;
					var level = node.level + 1;
					
					for(var i = 0; i < links.length; i++)
					{
						var link 	= links[i];
						var branch	= (link.type == "directory") ? true: false;
						var child 	= initTutorial(new TreeNode(link.path, link.path, level, branch, link.title));
						
						if(isPersonaTutorial(child))
							node.addNode(child);
					}
					
					node.expand();
				}
			}
			
			return node;
		}
		
		function formatTutorial(tree, node)
		{
			var row 	= "";
			var name	= tree.list.id;
			var width	= tree.getWidth() - 15;
			var indent 	= tree.indent * node.level;
			var color 	= "#e9e3d9ff";

			if(node.branch)
			{
				var content 	= node.content;
				var status 		= TutGetStatus(content);
				var scolor		= TutGetStatusColor(status);
				var sloc		= (status != "") ? getlocstring("tutorials." + status): "";
				
				row = "\
<view id='" + htmlencode(node.id) + "' width='" + width + "' height='16' aspectalign='left'\
	onmouseenter='" + name + ".mouseEnter(this)' onmouseexit='" + name + ".mouseExit(this)'>\
	<caption id='branch_title' x='5' y='0' rright='1' height='16' style='color: " + color + "; '\
		label='" + htmlencode(node.description) + "'/>\
	<caption x='" + (indent + tree.indent) + "' y='0' rright='1' height='16' style='color: " + scolor + "; ' label='" + sloc + "' align='right'/>\
</view>";
			}
			else
			{
				var content  	= node.content;
				var status 		= TutGetStatus(content);
				var scolor		= TutGetStatusColor(status);
				var sloc		= (status != "") ? getlocstring("tutorials." + status): "";
				var lock		= '<image x="' + (indent - 12) + '" y="2" src="ui/textures/lock.dds" width="12" height="12" style="color: #FF0000;"/>';
				
				if(content.checkstate != "true" || game.player.client.state.cantrain)
					lock = "";
				
				cprint("Tutorial Status is " + status + "\n");
				
				row = "\
<view id='" + htmlencode(node.id) + "' width='" + width + "' height='16' aspectalign='left'\
	onmouseenter='" + name + ".mouseEnter(this)' onmouseexit='" + name + ".mouseExit(this)'>\
	" + lock + "\
	<caption x='" + indent + "' y='0' width='" + (width - indent) + "' height='16' style='color: " + color + "; ' label='" + htmlencode(node.description) + "'/>\
	<caption x='" + indent + "' y='0' width='" + (width - indent) + "' height='16' style='color: " + scolor + "; ' label='" + sloc + "' align='right'/>\
</view>";
			}

			return row;
		}
		
		function setTutorial(content)
		{
			tutorial 		= (content != null && content.handler != null && content.handler != "") ? content: null;
			tutRequirement 	= null;
			
			//if(content != null)
			//	game.chatprint("We have a tutorial set!");
			
			if(content != null)
			{
				tutHeader.label = content.title.toUpperCase();
				tutBody.text 	= content.brief;
				
				if(tutorial == null)
				{
					tutInfo.visible = false;
				}
				else
				{
					tutInfo.visible = true;
					
					var status 			= tutInfo.findview("tut-status");
					var prereq 			= tutInfo.findview("tut-prereq");
					var prereqstatus 	= tutInfo.findview("tut-prereqstatus");
					var requires 		= TutGetContent(tutorial.requires, true);
					
					TutSetStatusView(requires, prereq, prereqstatus);
					TutSetStatusView(tutorial, null, status);
				}
			}
			
			if(tutorial != null && !TutIsComplete(tutorial))
				tutRequirement = TutGetNextRequirement(tutorial.requires);
		}
		
		function startTutorial()
		{
			if(tutorial == null)
				return;
			
			if(TutIsComplete(tutorial) && tutorial.limited == "true")
			{
				//if(tutorial.limited == "true")
					showOk(getlocstring("tutorials.limited"));
				//else
					//showConfirm(getlocstring("tutorials.alreadycompleted"), doTutorial);
			}
			else
			{
				doTutorial(true);
			}
		}
		
		function toggleTutorialStatus()
		{
			if(tutorial != null)
			{
				var complete = !TutIsComplete(tutorial);
				
				// toggle the status
				TutSetCompleted(tutorial, complete);
				
				if(tutorial.handler == "basic")
				{
					var basics = tutorial.links;
					
					for(var i = 0; i < basics.length; i++)
					{
						var link = basics[i];
						
						if(link == null || link.type == "directory")
							continue;
						
						TutSetCompleted(getcontent(link.path), complete);
					}
					
					if(complete)
						showOk(getVariableLocString('tutorials.graduation', tutorial.title));
				}
				else
				{
					TutCheckGraduation();
				}
				
				// redraw the tree
				tutorialTree.drawTree();
			}
		}
		
		function doTutorial(ok)
		{
			if(ok && tutorial)
			{
				if(tutRequirement != null)
					showConfirm(getVariableLocString("tutorials.hasrequirement", tutRequirement.title), doRequirement);
				else
					TutShowBrief(tutorial, TutStart, true);
			}
		}
		
		function doRequirement(ok)
		{
			if(ok && tutRequirement)
				TutShowBrief(tutRequirement, TutStart, true);
		}
		
		function updateStartTutorial()
		{
			/*
			if(tutorial == null)
			{
				game.chatprint("Tutorial is null!");
			}
			else
			{
				game.chatprint("Tutorial " + tutorial.key + " is of type " + tutorial.type + "!");
			}
			*/
			
			return (tutorial != null && tutorial.type == 'file' && TutGetStatus(tutorial) != "slocked") ? true: false;
		}
		
		function redrawTree()
		{
			tutorialTree.drawTree(1);
			selectTutorial();
		}
		
		function onSpawnDenied(code)
		{
			cprint("Processing Spawn Denied Code: " + code + "\n");
			showOk(getlocstring('mission.spawn.denied' + code));
			TutSetInstance(1);
		}
		
		-->
	</script>
</tab>
