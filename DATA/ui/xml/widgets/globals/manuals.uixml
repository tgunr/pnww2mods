<?xml version="1.0"?>

<tab id="manuals" label="  ${widgets.manuals.mantab}  " x="0" y="0" width="930" height="460" align="right"
	onshow="initManuals(true)" tip="${widgets.globals.manuals.tip}">
	<view id="left-pane" x="18" y="18" width="444" height="411">
		<view x="10" y="10" width="425" rtop="10">
			<caption label="${widgets.manuals.mantab.select}" x="0" rtop="10" height="20" width="400" style="font-size: +2; color: #BFE2CE;"/>
			<image x="0" rtop="20" src="ui/textures/test/horiz_underline.bmp" width="425" height="12"/>
			<list id="manualTree" x="0" y="5" width="425" rtop="32" style="color: #e9e3d9ff;"
				onselect="manualTree.clickTree(false)" ondblselect="manualTree.clickTree(true)">
				<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
			</list>
		</view>
	</view>
	<include file="widgets/divider.uixml"/>
	<view id="right-pane" x="468" y="18" width="444" height="411">
		<view x="10" y="10" width="425" rtop="17">
			<caption id="manuals-header" label="${widgets.manuals.mantab.read}" x="0" height="20" width="400" rtop="2" style="font-size: +2; color: #BFE2CE;"/>
			<image x="0" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="12"/>
			<text id="base" x="0" y="0" width="425" rtop="26" acceptfocus="no" style=" color: #e9e3d9ff;"/>
		</view>
	</view>
	<script>
		<!--
		
		var manualTree		= new TreeControl("manualTree", selectManual);
		var base			= findview("base");
		var header			= findview("manuals-header");
		var handlers		= new Object();
		var manual			= null;
		
		function initManuals(effects)
		{
			//consoleclear();
			resetManual(false);
			
			if(effects)
				soundPlayShuffle(); 
			
			if(!game.ingame)
				setHelp(getlocstring('widgets.manuals.mantab.help'));
			
			if(!manualTree.initTree())
			{
				var root = game.getcontent("manuals");
				
				if(root)
				{
					var links = root.links;
					
					for(var i = 0; i < links.length; i++)
					{
						var link 	= links[i];
						var branch	= (link.type == "directory") ? true: false;
						
						manualTree.addNode(new TreeNode(link.path, link.path, 1, branch, link.title));
					}
				}
				
				manualTree.drawTree();
			}
		}
		
		function selectManual(node)
		{
			var node = manualTree.selectedNode();
			
			if(!node.initNode())
			{
				consoleprint("INITING NODE!!!\n");
				
				var content = game.getcontent(node.data);
				
				if(content != null && node.branch)
				{
					var links = content.links;
					var level = node.level + 1;
					
					for(var i = 0; i < links.length; i++)
					{
						var link 	= links[i];
						var branch	= (link.type == "directory") ? true: false;
						
						node.addNode(new TreeNode(link.path, link.path, level, branch, link.title));
					}
				}
				
				node.content = content;
			}
			
			if(node.content != null)
				setManual(node.content);
			else
				setDefaultManual('widgets.manuals.mantab.default');
		}
		
		function loadManual(path)
		{
			setManual(game.getcontent(path));
		}
		
		function resetManual(all)
		{
			for(var h in handlers)
			{
				if(all || handlers[h].type != manual.type) 
					handlers[h].visible = false;
			}
		}
		
		function setManual(content)
		{
			setDefaultManual(null);
			
			manual 			= null;
			base.text 		= "";
			header.label 	= ""; //getlocstring('widgets.manuals.mantab.read');
			
			if(content != null)
			{
				if(content.title != null && content.title != "")
					header.label = content.title.toUpperCase();
				else
					header.label = getlocstring('widgets.manuals.mantab.read');
				
				if(handlers[content.handler] == null)
					handlers[content.handler] = (content.handler != null && content.handler != "") ? load(content.handler, base): load("handlers/default", base);
				
				manual = handlers[content.handler];
				
				if(manual)
				{
					manual.setContent(content, base);
					manual.visible = true;
				}
			}
			else
			{
				setDefaultManual('widgets.manuals.mantab.default');
			}
		}
		
		function setDefaultManual(key)
		{
			resetManual(true);
			base.text = (key != null) ? getlocstring(key): " ";
		}
		
		-->
	</script>
</tab>

