		function doSquadCommand(command, targetted)
		{
			if(targetted)
			{
				var squaddie = squadMemberList.data;
				
				if(squaddie == null)
				{
					showOk(getlocstring('common.squads.details.notarget'));
					return;
				}
				
				command += " " + squaddie.handle;
			}
			
			if(command == "/recruit")
			{
				var callsign = findview("squad-recruit-callsign").text;
				
				if(callsign.length == 0)
				{
					showOk(getlocstring('common.squads.details.norecruit'));
					return;
				}
				
				command += " " + callsign;
			}
			
			consoleprint("Running squad command: " + command + "\n");
			
			game.player.client.sendchatmessage(command);
		}
		
		function showRecruiters()
		{
			soundPlayClick();
			
			if(game.player.client.requestrecruiters(game.settings.language) && game.player.client.recruiters.length > 0)
				load('recruitment').initRecruitment(doSquadRecruited);	
			else
				showOk(getlocstring('common.squads.recruitment.none'));
		}
		
		function doSquadRecruited(recruited)
		{
			if(recruited && !game.ingame)
				window.close();
		}

		//-->
	</script>
</tab>