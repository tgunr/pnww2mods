<?xml version="1.0"?>

<view id="content" x="0" y="0" width="425" height="358" viewportwidth="1024" viewportheight="768" aspectalign="left"
	onshow="showContent(this)">
	<include file="lib/content.uixml"/>
	<view x="0" height="15" rright="0" rtop="0">
		<caption x="0" y="0" width="72" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
			label="${content.ranks.level}"/>
		<caption x="75" y="0" width="107" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
			label="${content.ranks.army}"/>
		<caption x="185" y="0" width="107" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
			label="${content.ranks.airforce}"/>
		<caption x="295" y="0" width="127" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
			label="${content.ranks.navy}"/>
	</view>
	<list id="display" x="0" y="0" rright="0" rtop="20" followall="yes" style=" color: #e9e3d9ff;">
		<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
	</list>
	<script>
		<!--
		
		type = "handlers/ranks";
		
		function showContent(viewer)
		{
			showViewer(viewer);
			
			var list	= viewer.findview("display");
			var ranks 	= content.body.split("\n");
			
			//consoleprint("Content is " + content.body + "\n");
			
			list.clearrows();
			
			for(var i = 0; i < ranks.length; i++)
			{
				var rank 	= ranks[i];
				
				rank.replace(/^(\s|\t)+/, "");
				rank.replace(/(\s|\t)+$/, "");
				
				var details = rank.split("\|");
				
				//consoleprint("Processing rank " + rank + " with " + details.length + " details\n");
				
				if(details.length == 5)
				{
					//consoleprint("Looks like a valid rank\n");
					
					addRankHeader(list, details[0]);
					
					var row = "\
<view width='400' height='20' aspectalign='left'>\
	<caption x='7' y='3' width='14' height='14' class='rankicon' rank='" + details[0] + "'/>\
	<caption x='25' y='2' width='45' height='16' style='background-color: #ffffff11; color: #e9e3d9ff; ' label='"+ htmlencode(details[1]) +"' align='center'/>\
	<caption x='75' y='2' width='105' height='16' style='background-color: #ffffff11; color: #e9e3d9ff; ' label='"+ htmlencode(details[2]) +"'/>\
	<caption x='185' y='2' width='105' height='16' style='background-color: #ffffff11; color: #e9e3d9ff; ' label='"+ htmlencode(details[3]) +"'/>\
	<caption x='295' y='2' width='105' height='16' style='background-color: #ffffff11; color: #e9e3d9ff; ' label='"+ htmlencode(details[4]) +"'/>\
</view>";
					list.addrow(row, null);
				}
			}
		}
		
		function addRankHeader(list, level)
		{
			//consoleprint("Checking header at level " + level + "\n");
			
			var header = "";
			
			switch(level)
			{
				case "0":
					header = getlocstring('content.ranks.enlisted');
					break;
				case "5":
					header = getlocstring('content.ranks.ncos');
					break;
				case "8":
					header = getlocstring('content.ranks.officers');
					break;
				case "13":
					header = getlocstring('content.ranks.command');
					break;
			}
			
			if(header != "")
			{
				//consoleprint("Found header " + header + "\n");
				
				var row = "\
<view width='425' height='30'>\
	<caption x='5' ropt='2' width='425' height='20' label='" + header + "' style='color: #ffffff; font-size: +2;'/>\
</view>";
				list.addrow(row, null);
			}
		}
		
		-->
	</script>
</view>


