<?xml version="1.0"?>
<!DOCTYPE uixml SYSTEM "loc://ui.dtd"> 
<view id="content" x="0" y="0" width="425" height="358" viewportwidth="1024" viewportheight="768" aspectalign="left"
	onshow="showContent(this)">
	<include file="lib/content.uixml"/>
	<view id="movie-frame" x="45" y="85" width="330" height="250" style="background-color: #3e5248;">
		<text x="50" y="50" rright="50" rtop="50" style="color: #ffffff;"
			onshow="this.text = getlocstring('content.movies.unavailable')"/>
	</view>
	<view class="movie" id="movie-display" x="50" y="90" width="320" height="240" viewportwidth="1024" viewportheight="768"/>
	<view id="movie-controls" y="15" x="50" rright="5" height="30">
		<button id="reset-button" x="40" y="0" height="25" width="110" label="&content.movies.rewind;" align="center"
			style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #FFFFFF;"
			onclick="soundPlayClick(); if(movie) movie.rewind(); setButtonLabel();" onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
		<button id="play-button" x="190" y="0" height="25" width="110" label="&content.movies.play;" align="center"
			style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #FFFFFF;"
			onclick="soundPlayClick(); togglePlay()" onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
		</view>
	<script>
		<!--
		
		type = "handlers/movie";
		
		var movie	= null;
		var play 	= null;
		
		function showContent(viewer)
		{
			showViewer(viewer);
			
			movie 	= viewer.findview("movie-display");
			play	= viewer.findview("play-button");
			
			movie.load(content.body);
			movie.visible = false;
		}
		
		function togglePlay()
		{
			if(movie)
			{
				// play toggles between play and pause
				movie.play();
				setButtonLabel();
			}
		}
		
		function setButtonLabel()
		{
			if(movie)
			{
				if(movie.playing)
					play.label = getlocstring('content.movies.pause');
				else
					play.label = getlocstring('content.movies.play');
			}
		}
		
		-->
	</script>
</view>


