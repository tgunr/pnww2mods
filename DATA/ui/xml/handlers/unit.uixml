<?xml version="1.0"?>
<!DOCTYPE uixml SYSTEM "loc://ui.dtd"> 
<view id="content" x="0" y="0" width="425" height="358" viewportwidth="1024" viewportheight="768" aspectalign="left"
	onshow="showContent(this)">
	<include file="lib/content.uixml"/>
	<!-- caption id="unit-title" x="10" rtop="10" width="175" height="15" style="color: #ffffff; font-size: +3;"/ -->
	<text id="unit-brief" x="10" rtop="10" width="175" height="180" acceptsfocus="no" style="color: #e9e3d9; "/>
	<image id="unit-image" width="200" height="150" rright="10" rtop="10" style="border-color: #BFE2CE;"/>
	<text id="unit-body" x="10" y="10" rright="20" height="180" acceptsfocus="no" style="border-size-right: 10; color: #e9e3d9; ">
		<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
	</text>
	<script>
		<!--
		
		type = "handlers/unit";
		
		function showContent(viewer)
		{
			showViewer(viewer);
			
			var brief 	= viewer.findview("unit-brief");
			var body 	= viewer.findview("unit-body");
			var image 	= viewer.findview("unit-image");
			
			brief.text 	= content.brief;
			body.text 	= content.body;
			body.scrollto(0);
			image.src	= "ui/textures/vehicles/" + content.image + ".bmp";
		}
		
		-->
	</script>
</view>


