		function recruitmentMouseEnter(row)
		{
			row.findview("recruitment-panel").setstyleproperty("border-color", "#ffff00");
		}
		
		function recruitmentMouseExit(row)
		{
			if(recruitmentList.row == null || row.id != recruitmentList.selected)
				row.findview("recruitment-panel").setstyleproperty("border-color", "#3e5248");
		}
		
		function recruiterSelected(oldrow, newrow)
		{
			if(oldrow != null)
				oldrow.findview("recruitment-panel").setstyleproperty("border-color", "#3e5248");
			
			newrow.findview("recruitment-panel").setstyleproperty("border-color", "#ffff00");
		}
		
		function selectRecruiter(dblclick)
		{
			// do hilights
			
			if(dblclick)
				acceptRecruitment(true);
		}
		
		function acceptRecruitment(recruited)
		{
			var recruiter = recruitmentList.data;
			
		 	soundPlayClick();
		 	
			if(recruited && recruiter != null)
			{
				// join needs to block until a squad control result of join is caught
				// by then the invite will have been sent
				// join returns true if result is accept, false otherwise
				if(recruiter.join())
				{
					// don't move them if they are already in game
					if(!game.ingame)
					{
						var invite = game.player.client.missioninvite;
						
						if(invite)
						{
							var country	= invite.country;
							var branch	= invite.branch;
							var brigade	= invite.brigade;
							var mission	= invite.mission;
							
							doMissionInviteJump(country, branch, brigade, mission, true);
						}
					}
					
					// onrecruiter event shows an ok popup letting the user know
				}
				else
				{
					recruited = false;
					showOk(getlocstring("common.squads.recruitment.failure"));
				}
			}
			
			if(callback != null)
				callback(recruited);
			
			// close this window
			window.close();
		}
		
		-->
	</script>
</window>

