<?xml version="1.0"?>
 <viewport id="hud" x="0" y="0" width="1024" height="768" viewportwidth="1024" viewportheight="768"
	onload="initHud(this)" onupdate="updateHud(this)">
	<include file="lib/common.uixml"/>
	<include file="classes/Objectives.uixml"/>
	<include file="classes/ListControl.uixml"/>
	<include file="classes/RowBuilder.uixml"/>
	
	<!-- include our default hud -->
	<include file="widgets/hud.uixml"/>
	
	<caption id="game-timer" x="0" width="100" height="20" y="200" fontshadowx=".08" fontshadowy="-.08"
		style="color: #FFFFFF; font-size: +10;" moveondrag="yes" ondrag="saveCustomPosition(this)" align="center"/>
	
	<view id="objectives" width="500" height="24" rtop="10" rright="300" moveondrag="yes" acceptmouseclick="true"
		onshow="if(!this.mgr) this.mgr = new ObjectivesManager(this)" ondrag="saveCustomPosition(this)"/>
	
	<view id="kills" y="6" width="275" height="105" rright="2" aspectlimit="width"
		style="background-color: #00000088; 
			border-top: ui/textures/hud/header.bmp;
			border-sides: ui/textures/hud/border_side.bmp;
			border-corner: ui/textures/hud/border_corner.bmp;
			border-top-corner: ui/textures/hud/header_corner.bmp; 
			border-width: 2;
			border-size-top: 1;
			border-size-bottom: 2;" moveondrag="yes"
		ondrag="saveCustomPosition(this)">
		<list id="killList" x="2" y="2" rright="2" rtop="2"/>
	</view>
	
	<!-- COMPASS -->
	<!-- view id="compass" width="110" height="110" rright="6" rtop="200" aspectlimit="width"
			moveondrag="yes" acceptmouseclick="true" followall="true">
		<view class="compass" src="ui/textures/compass_bg.bmp" x="5" y="5" width="100" height="100" frame="no" aspectlimit="width"/>
		<caption label="N" x="0" height="10" rright="0" rtop="0" style="font-size: -1; color: #BFE2CE;"
			acceptmouseclick="false" align="center"/>
		<caption label="S" x="0" y="0" height="10" rright="0" style="font-size: -1; color: #BFE2CE;"
			acceptmouseclick="false" align="center"/>
		<caption label="E" height="10" width="10" rright="0" rtop="52" style="font-size: -1; color: #BFE2CE;"
			acceptmouseclick="false" align="right"/>
		<caption label="W" x="0" height="10" width="10" rtop="52" style="font-size: -1; color: #BFE2CE;"
			acceptmouseclick="false" align="left"/>
	</view -->
		
	<!-- HUD SETUP -->
	<script>
		<!--
		
		// scenario specific
		var objectives					= new Object();
		var gameCycleTimer 		= new CycleTimer(1000);
		var gameTime					= -1;
		var gameTimeState			= 0;
		
		var killList							= new ListControl(findview("killList"));
		var objectives					= findview("objectives");
		
		objectives.mgr					= new ObjectivesManager(objectives);
	
		var friendlycolor		= game.settings.friendlycolor;
		var enemycolor			= game.settings.enemycolor;
		var neutralcolor		= game.settings.missioncolor;
		var currentcolor		= neutralcolor;
		
		function initHud(hud)
		{
			if(hudInited)
				return;
			
			initDefaultHud(hud);
			
			updateHud(hud);
			
			if(game.globals.kills == null)
				game.globals.kills	 = new Array();
			
			SetTimer(gameTime);
			
			initKillList();
		}
		
		function setupHUD(mode)
		{
			setupDefaultHUD(mode);
			
			// restore position and visibility
			var flags = 2 | 8;
			
			if(mode == 1)
			{
				game.restoresettings(views["game-timer"], flags);
				game.restoresettings(views["objectives"], flags);
				game.restoresettings(views["kills"], flags);
			}
			else
			{
				// orders - center top
				views["objectives"].x = window.width/2 - views["objectives"].width/2;
				views["objectives"].y = window.height - views["objectives"].height - 6;
				game.savesettings(views["objectives"], flags);
				
				// game timer - lower center
				views["game-timer"].x = window.width/2 - views["game-timer"].width/2;
				views["game-timer"].y = views["objectives"].y - views["game-timer"].height - 6;
				game.savesettings(views["game-timer"], flags);
		
				// building info - bottom right above city info
				setViewMetrics(views["kills"], true, window.width - 6 - views["kills"].width, 6);
				game.savesettings(views["kills"], flags);
			}
		}
		
		function updateHud(hud)
		{
			updateDefaultHud(hud);
			
			// update our objectives
			if(views["objectives"] && views["objectives"].mgr)
				views["objectives"].mgr.Update();
			
			if(views["game-timer"].visible && gameTime >= 0 && gameCycleTimer.run())
				SetTimer(gameTime - 1);
		}
		
		function OnMessage(loc, color)
		{
			var message = getlocstring(loc);
			
			if(message.charAt(0) == "?")
				message = loc;
			
			addGameAlert(11, message, color);
		}
		
		function OnKill(msg, isFriendly)
		{
			if(game.globals.kills == null)
				return;
			
			
			
			if(isFriendly == null)
				currentcolor = neutralcolor;
			else if(isFriendly == -1)
				currentcolor = enemycolor;
			else if(isFriendly == 0)
				currentcolor = neutralcolor;
			else if(isFriendly == 1)
				currentcolor = friendlycolor;

			var killMsg = [msg, currentcolor];
			
			game.globals.kills.unshift(killMsg);
			
			if(game.globals.kills.length > 10)
				game.globals.kills.pop();			
			
			initKillList();
		}
		
		function SetTimer(seconds)
		{
			gameTime = parseInt(seconds);
			
			if(views["game-timer"] == null)
				return;
			
			if(gameTime < 0)
			{
				setVisibility("game-timer", false);
			}
			else
			{
				var formatted = "";
				
				if(gameTime < 60)
				{
					if(gameTime < 10)
						formatted = ":0" + gameTime;
					else
						formatted = ":" + gameTime;
						
						gameTimeState = (gameTimeState == 0) ? 1 : 0;
				}
				else
				{
					var fminutes = parseInt(gameTime / 60);
					var fseconds = parseInt(gameTime % 60);
					
					if(fseconds < 10)
						formatted =  fminutes + ":0" + fseconds;
					else
						formatted =  fminutes + ":" + fseconds;
					
					gameTimeState = 0;
				}
				
				setVisibility("game-timer", true);
				setProperty("game-timer", "label", formatted);
				
				/*
				var cx = views["game-timer"].x + (views["game-timer"].width * .5);
				var cy = views["game-timer"].y + (views["game-timer"].height * .5);
				
				views["game-timer"].resizetotext();
				views["game-timer"].x = cx - views["game-timer"].width/2;
				views["game-timer"].y = cy - views["game-timer"].height/2;
				*/
				
				// make it 
				if(gameTimeState == 0)
					views["game-timer"].setstyleproperty("color", "#FFFFFF");
				else
					views["game-timer"].setstyleproperty("color", "#FF0000");
			}
		}
		
		function AddObjective(type, name, loc, icon)
		{
			cprint("Adding objective " + type + "/" + name + "/" + loc + "/" + icon);
			objectives.mgr.AddObjective(type, name, loc, icon);
		}
		
		function UpdateObjective(name, arg1, arg2)
		{
			cprint("Updating objective " + name + "/" + arg1 + "/" + arg2);
			objectives.mgr.UpdateObjective(name, arg1, arg2);
		}
		
		function initKillList()
		{
			// game.globals.kills[i] = killMsg = [msg, color]
			killList.clearRows(false);
			
			if(game.globals.kills.length > 0)
			{
				for(var i = 0; i < game.globals.kills.length; i++)
				{
					var rb = new RowBuilder(killList.list, "row" + i, 0, 0, 0, 16);
					
					rb.fontsize	= "-2";
					rb.color 	= game.globals.kills[i][1];
					rb.bgcolor 	= null;
					
					rb.addAttribute("aspectalign", "left");
					rb.addColumn(game.globals.kills[i][0], 1);
					
					killList.addRow(null, rb.build());
				}
			}
			
			killList.postInit();
		}
		
		-->
	</script>
</viewport>

