<?xml version="1.0"?>
 
<window id="despawn" x="0" y="0" width="1024" height="768" viewportwidth="1024" viewportheight="768" modal="true"
	style="background-color: #00000077;" layer="100" aspectalign="center" onshow="initDespawnPopup(this)" onupdate="updateSpawnList()">
	<include file="lib/popup.uixml"/>
	<include file="lib/sound.uixml"/>
	<include file="lib/scenarios.uixml"/>
	<include file="lib/scenariodata.uixml"/>
	<include file="classes/TreeControl2.uixml"/>
	<include file="classes/CycleTimer.uixml"/>
	<include file="classes/VehicleManager.uixml"/>
	<include file="classes/VehicleClass.uixml"/>
	<include file="classes/ViewBuilder.uixml"/>
	<include file="classes/TextBuilder.uixml"/>
	<include file="classes/ImageBuilder.uixml"/>
	<include file="classes/RowBuilder.uixml"/>
	<view id="despawn-viewer" width="450" height="500" rtop="150" moveondrag="yes"
		  		style="background-color: #00000088;
							border-sides: ui/textures/hud/border_side.bmp;
							border-corner: ui/textures/hud/border_corner.bmp;
							border-width: 4;
							border-height: 4;">
		<tabview id="aar-tab" x="0" y="0" rright="0" rtop="0">
			<tab x="0" y="0" rright="0" rtop="0" showtab='false'>
				<view x="10" width="425" height="400" rtop="12">
					<caption id="forces-header" x="0" height="20" width="425" rtop="0" style="font-size: +2; color: #BFE2CE; tooltip: widgets/tooltips/supplytip.uixml;"/>
					<image x="0" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="10"/>
					<view x="0" width="425" height="15" rtop="22">
						<caption x="0" y="0" height="15" rright="0" style="background-color: #BFE2CE44;  color: #BFE2CE;" label="UNITS"/>
					</view>
					<list id="spawnTree" x="0" width="425" height="300" rtop="40" onselect="spawnTree.clickTree(false)" ondblselect="spawnTree.clickTree(true)"/>
				</view>
			</tab>
			<!--
			<tab x="0" y="0" rright="0" rtop="0" showtab='false'>
				<view id="members-block" x="10" width="425" height="380" rtop="12">
					<caption id="players-header" x="0" height="20" width="400" rtop="0" style="font-size: +2; color: #BFE2CE;"/>
					<image x="0" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="12"/>
					<list id="memberList" x="0" y="20" rtop="40" rright="0">
						<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
					</list>
				</view>
			</tab>
			-->
		</tabview>
		<text id="popup-caption" x="10" rtop="10" height="50" width="330" acceptfocus="no" acceptsmouseclick="false" style=" color: #FFFFFF;"
			followtop="true"/>
		<button id="popup-close" width="15" height="15" rtop="10" rright="10" followtop="true" onclick="doPopupClose()"
			style="control-on: ui/textures/test/exit_on.bmp; control-off: ui/textures/test/exit_off.bmp;"
			tip="${popup.quit}"/>
		<button id="popup-no" x="20" y="10" width="100" height="30" label="${popup.cancel}" onclick="doDespawnAction(false)"
			style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
			onmouseenter="if(this.enabled) this.setstyleproperty('color', '#FFFF00')" onmouseexit="this.setstyleproperty('color', '#FFFFFF')"/>
		<button id="respawn" x="0" y="10" width="100" height="30" label="RESPAWN" onclick="selectSpawnable(true)" onshow="centerViewX(this)"
			style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
			onmouseenter="if(this.enabled) this.setstyleproperty('color', '#FFFF00')" onmouseexit="this.setstyleproperty('color', '#FFFFFF')"/>
		<button id="popup-yes" y="10" width="100" height="30" rright="10" label="DESPAWN" onclick="doDespawnAction(true)"
			style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
			onmouseenter="if(this.enabled) this.setstyleproperty('color', '#FFFF00')" onmouseexit="this.setstyleproperty('color', '#FFFFFF')"/>
	</view>
	<script>
		<!--
		
		var client 				= game.player.client;
		var listTimer			= new CycleTimer(1000);
		var spawnTree 	= new TreeControl("spawnTree", selectSpawnable, formatSpawnable, isSelectable);
		var respawnBtn	= findview("respawn");
		var flagPath			= "";
		
		function initDespawnPopup(win)
		{
			flagPath = scenarioFlag(client.persona.country.id);
			initSpawnables();
		}
		
		function doDespawnAction(despawn, respawn)
		{
			if(respawn == null)
				respawn = false;
			
			if(popupCallback != null)
				popupCallback(despawn, respawn);
			
			doPopupFree();
		}
		
		function updateSpawnList()
		{
			if(listTimer.run() && doMemberUpdate)
			{
				initSpawnables();
				doMemberUpdate = false;
			}
		}
		
		function selectSpawnable(action)
		{
			var node = spawnTree.selectedNode();
			
			if(node != null && !node.branch)
			{
				respawnBtn.enabled = true;
				
				if(action)
				{
					var index = spawnTree.selectedData();
					
					if(index != null)
					{
						var vehicle = vehicles[index];
						
						// this call
						if(vehicle.spawnable == "spawnable")
						{
							game.globals.scenariovehicle = index;
							game.setplayerdata("weapon", vehicle.type.weapkey);
							game.setplayerdata("ready", "true");
							doDespawnAction(true, true);
						}
						else
						{
							showOk(vehicle.spawnable);
							respawnBtn.enabled = false;
						}
					}
				}
			}
			else
			{
				respawnBtn.enabled = false;
			}
		}
		
		// -->
	</script>
</window>
