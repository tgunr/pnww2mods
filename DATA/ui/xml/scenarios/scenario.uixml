<?xml version="1.0"?>
<!DOCTYPE uixml SYSTEM "loc://ui.dtd">
<window id="scenarios/scenario" x="0" y="0" width="1024" height="768" viewportwidth="1024" viewportheight="768" onshow="initWin()" onupdate="doForwardTimer()">
