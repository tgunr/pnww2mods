<?xml version="1.0"?>
<!DOCTYPE uixml SYSTEM "loc://ui.dtd">
<window id="scenarios/lobby" x="0" y="0" width="1024" height="768" viewportwidth="1024" viewportheight="768" onshow="initLobby()" onupdate="updateLobby()">
	<include file="lib/common.uixml"/>
	<include file="lib/scenarios.uixml"/>
	<include file="widgets/template.uixml"/>
	<include file="classes/ListControl.uixml"/>
	<include file="classes/TreeControl2.uixml"/>
	<include file="classes/CycleTimer.uixml"/>
	<include file="classes/ViewBuilder.uixml"/>
	<include file="classes/TextBuilder.uixml"/>
	<include file="classes/ImageBuilder.uixml"/>
	<tabview id="body" x="43" y="140" width="930" height="450" ontab="quickhelp()" style="color: #BFE2CE;
						background-color: #000000BB; 
						border-top-corner: ui/textures/test/body_ul.bmp;
						border-bottom-corner: ui/textures/test/body_br.bmp;
						border-sides: ui/textures/test/body_sides.bmp;
						border-top: ui/textures/test/body_top.bmp;
						border-bottom: ui/textures/test/body_bottom.bmp;
						control-on-endcap:  ui/textures/test/body_tab_cap_on.bmp;
						control-on-back:  ui/textures/test/body_tab_filler_on.bmp;
						control-off-endcap: ui/textures/test/body_tab_cap.bmp;
						control-off-back: ui/textures/test/body_tab_filler.bmp;
						control-on-color: #FFFFCE;
						border-width: 16;
						border-height: 16;">
		<tab label="  ${online.campaign}  " x="0" y="0" width="930" height="460"
			onshow="tplTab(); loadWin('persona', true);" tip="${persona.selecttab.tip}"/>
		<tab label="  ${online.scenarios}  " x="0" y="0" width="930" height="460"
			onshow="setHelp(getlocstring('online.scenarios.help')); tplTab()" tip="${online.scenarios.tip}">
			<view id="left-pane" x="18" y="23" width="444" height="411">
				<!-- weapon selection -->
				<view x="10" width="425" height="400" rtop="12">
					<caption id="forces-header" label="${online.scenarios.list}" x="0" height="20" width="425" rtop="0"
						style="font-size: +2; color: #BFE2CE; tooltip: widgets/tooltips/supplytip.uixml;"/>
					<image x="0" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="10"/>
					<view x="0" width="425" height="15" rtop="22">
						<caption x="0" y="0" height="15" rright="0" style="background-color: #BFE2CE44;  color: #BFE2CE;" label="MAPS"/> <!-- width="190" -->
					</view>
					<list id="instanceTree" x="0" width="425" height="300" rtop="40" onselect="instanceTree.clickTree(false)" ondblselect="instanceTree.clickTree(true)"/>
				</view>
				<caption label="* ${online.scenarios.create}" x="30" y="0" height="20" rright="10" 
						style="color: #BFE2CE; tooltip: widgets/tooltips/supplytip.uixml;"/>
			</view>
			<include file="widgets/divider.uixml"/>
			<view id="right-pane" x="468" y="23" width="444" height="411">
				<view id="scenario-map" class="mapview" acceptsfocus="no" minscale=".03" maxscale="1.5" scale=".75"
					x="10" y="10" rright="10" rtop="30" sx="18" sy="235"
					onload="if(!this.mgr) new MapManager(this, true)" onshow="this.mgr.onShow()" 
					onupdate="this.mgr.onUpdate()" onclick="this.mgr.onClick()" ondblclick="this.mgr.onDblClick()"
					ondrag="this.mgr.onDrag()" onmouseenter="this.mgr.onMouseEnter()" onmouseexit="this.mgr.onMouseExit()"
					onrightclick="this.mgr.onRightClick()"
					style="tooltip: widgets/tooltips/maptip.uixml;">
					<layer type="texture" id="default-64-tex" minscale="0" maxscale="64" enabled="true" orign="-26x210" rowcolsize="1x1" cellsize="64x64"/>
					<layer type="icon" id="icons" minscale="1" maxscale="8" enabled="true"/>
					<layer type="icon" id="rendered" minscale="0" maxscale="1" enabled="true"/>
					<layer type="terrainobj" id="terrainobj" minscale="0" maxscale=".5" enabled="true"/>
					<layer type="hclinks" id="hclinks" minscale="0" maxscale="20" enabled="true"/>
					<layer type="strat" id="strat" minscale="0" maxscale="20" enabled="true">
						<filter name="showcivilian" value="no"/>
						<filter name="showbrigdes" value="no"/>
						<filter name="showarmy" value="yes"/>
						<filter name="showairforce" value="yes"/>
						<filter name="shownavy" value="yes"/>
						<filter name="showdepots" value="yes"/>
						<filter name="showcpnames" value="yes"/>
						<filter name="showfacnames" value="no"/>
						<filter name="showflags" value="yes"/>
						<filter name="showicons" value="yes"/>
						<filter name="fadeupdate" value="no"/>
						<filter name="fadefrontline" value="yes"/>
						<filter name="cptextcolor" value="#FFFF00"/>
						<filter name="factextcolor" value="#FFFFFF"/>
						<filter name="seltextcolor" value="#00FF00"/>
						<filter name="factextsize" value="12"/>
						<filter name="cptextsize" value="12"/>
						<filter name="showclutter" value="no"/>
						<filter name="cluttercutoff" value=".2"/>
					</layer>
				</view>
			</view>
		</tab>
		<include file="widgets/globals/settings.uixml"/>
	</tabview>
	<!-- include file="widgets/infobar.uixml"/ -->
	<script>
		<!--
		
		cprint(">>> STARTING LOBBY PAGE\n");
		
		var client 				= game.player.client;
		var mapView		= findview("scenario-map");
		var updateTimer	= new CycleTimer(3000);
		var scenarios		= loadRoot();
		var instanceTree 	= new TreeControl("instanceTree", selectInstance, formatInstance, isSelectable);
		var initialized		= false;
		
		var running			= new Object();
		var rootNodes		= new Array();
		var categories 		= new Object();
		
		/***************** COMMON FUNCTIONS *******************/
		
		function doForward()
		{
			var instance = running[instanceTree.selectedData()];
			
			if(instance != null)
				joinInstance(instance.description);
		}
		
		function initLobby(win)
		{
			var campaignPlay 	= (game.arena("campaign_play") != "false") ? true : false;
			var scenarioPlay 		= (game.arena("scenarios_play") != "false") ? true : false;
			
			// on this page always default to the second tab
			var body = findview("body");
			if(body) body.value = 1;
			
			if(!campaignPlay)
			{
				var body = findview("body");
				if(body) body.showtab(0, false);
			}
			else if(!scenarioPlay)
			{
				loadWin("persona", true);
			}
			
			var chat = game.findview("chat");
			if(chat != null)
			{
				chat.x = window.width/2 - chat.width/2;
				chat.y = 10;
			}
			
			showIDCard(false);
			showChat(true);
			
			setHelp(getlocstring('scenario.help'));
			
			//setBack('combat.back');
			setForward('combat.forward');
			setForwardEnabled(false);
			
			backButton.visible = false;
			//forwardButton.visible = false;
			
			quickhelp();
			
			game.globals.scenario = null;
			
			client.onpersonas = onPersonas;
			client.requestpersonalist();
		}
		
		function initInstanceTree()
		{
			if(scenarios == null)
				return;
			
			var preopen	= null;
			
			// add our categories
			for(var i = 0; i < scenarios.links.length; i++)
			{
				var content 	= game.getcontent(scenarios.links[i].path);
				if(content == null) continue;
				
				cprint("Adding category " + content.title);
				
				var node = new TreeNode(content.category, content.category, 1, true, content.title.toUpperCase());
				
				if(preopen == null)
					preopen = node; // open the first node
				
				// add it to our tree
				instanceTree.addNode(node, toggleNode);
				
				// save a reference by category
				categories[node.data] = node;
				
				// might not need this
				rootNodes[rootNodes.length] = node;
				
				// add our new scenario links
				addNewScenarioNodes(node);
			}
			
			if(preopen)
				preopen.expand();
			
			instanceTree.setColorText(false);
		}
		
		function initInstances()
		{
			if(!instanceTree.initTree())
				initInstanceTree();
			
			// reset our running list of instances 
			running = new Object();
			
			// clear the children under each category
			for(var c in categories)
			{
				// remember our creation node
				var newNode = categories[c].findNode("new." + c);
				
				// reset our children
				categories[c].children = new Array();
				
				// re-add our creation node
				categories[c].addNode(newNode);
			}
			
			// some temp vars
			var instances = client.instances;
			
			// now for each category, add our instances
			for(var i = 0; i < instances.length; i++)
			{
				var instance = instances[i];
				if(instance == null) continue;
				
				var category = instance.description.category;
				var id = instance.description.id;
				
				categories[category].addNode(new TreeNode(id, id, 2, false));
				
				running[id] = instance;
			}
			
			//for(var i = 0; i < rootNodes.length; i++)
			//	rootNodes[i].children = rootNodes[i].children.sort(sortNodes);
				
			//cprint("Drawing tree!");
			
			instanceTree.drawTree();
		}
								
		function isSelectable(node)
		{
			return true;
		}
		
		function addNewScenarioNodes(categoryNode)
		{
			if(categoryNode == null)
				return;
			
			var categoryID		= categoryNode.data;
			var newNode 		= categoryNode.addNode(new TreeNode("new." + categoryID, categoryID, 2, true, "Create a new instance ..."));
			var category 		= loadCategory(categoryID);
			
			if(category == null)
				return;
			
			for(var i = 0; i < category.links.length; i++)
			{
				cprint("Trying new scenario " + categoryID + "/" + i);
				
				var scenario = loadScenario(categoryID, i);
				if(scenario == null) continue;
				
				var id = newNode.id + "." + i;
				
				cprint("Adding new scenario " + id + "/" + newNode.description);
				
				newNode.addNode(new TreeNode(id, i, 3, false, scenario.title));
			}
		}
		
		function getOpenCategory()
		{
			for(var c in categories)
			{
				if(categories[c].open)
					return categories[c];
			}
			
			return null;
		}
		
		function toggleNode(node)
		{
			if(!node.open)
			{
				for(var i = 0; i < rootNodes.length; i++)
				{
					if(rootNodes[i].open && rootNodes[i].id != node.id)
						rootNodes[i].open = false;
				}
			}
		}
		
		function formatInstance(tree, node)
		{
			var name				= tree.list.id;
			var indent 			= tree.indent * node.level;
			var mouseenter	= name + ".mouseEnter(this)";
			var mouseexit		= name + ".mouseExit(this)";
			var id					= node.id.split("."); 
			
			if(node.branch)
			{
				var icon 			= (node.open) ? tree.collapseIcon: tree.expandIcon;
				var label			= node.description;
				
				cprint("Formatting tree node " + label);
				
				var row = new ViewBuilder(tree.list, node.id, 0, 0, 0, 16);
				
				if(id[0] != "new")
				{
					var expander = row.addBuilder(new ImageBuilder(row, "image", icon, indent, 3, 10, 10));
					expander.addAttribute("onclick", name + ".clickTree(true, " + tree.count + ")");
				}
				
				var caption = row.addBuilder(new TextBuilder(row, "title", "caption", label, (indent + tree.indent), 0, 0, 16));
				
				row.addAttribute("aspectalign", "left");
				row.addAttribute("onmouseenter", mouseenter);
				row.addAttribute("onmouseexit", mouseexit);
				
				caption.addStyle("color", "#e9e3d9ff");
				
				return row.build();			
			}
			else
			{
				var label 		= "[unknown]";
				var color 		= "#00FF00";
				
				if(id[0] == "new")
				{
					label = node.description; //.toUpperCase();
					color = "#e9e3d9ff";
				}
				else if(node.data != null)
				{
					var instance			= running[node.data];
					var description		= instance.description;
					var content			= loadScenario(description.category, description.type);
					label						= content.title;
					
					label += " axis=" + instance.axis;
					label += " allies=" + instance.allies;
					
					if(instance.running)
						label += " running";
				}
				
				indent += tree.indent;
				
				//cprint("Formatting tree instance " + label);
				
				var row 				= new ViewBuilder(tree.list, node.id, 0, 0, 0, 16);
				var caption			= row.addBuilder(new TextBuilder(row, "title", "caption", label, indent, 0, -indent, 16));
				
				row.addAttribute("aspectalign", "left");
				row.addAttribute("onmouseenter", mouseenter);
				row.addAttribute("onmouseexit", mouseexit);
				
				caption.addStyle("color", color);
				
				return row.build();
			}
		}
		
		function selectInstance(action)
		{
			//cprint("Instance selected with " + action);
			
			setForwardEnabled(false);
			
			var node = instanceTree.selectedNode();

			if(node != null && node.data != null)
			{
				/*
				var content = look up content
				
				if(content.target && mapView != null)
				{
					var parts 	= content.target.split(",");
					var x 		= parseFloat(parts[0]);
					var y 		= parseFloat(parts[1]);
					var scale	= (content.scale != null) ? parseFloat(content.scale) : mapView.scale ;
					var pan	= true;
					
					mapView.mgr.setCenterMe(false);
					mapView.mgr.setPosition(mapView.getposition(x, y), pan, scale);
					mapView.mgr.MapToSync();
				}
				*/
			}
			
			cprint("Selected node is " + ((node != null) ? node.id : ""));
			
			if(node != null && !node.branch)
			{
				//cprint("Selected node is " + ((node != null) ? node.id : ""));
				
				var id = node.id.split(".");
				
				if(id[0] == "new")
				{
					if(action)
					{
						// create a new instance
						createInstance(id[1], id[2]);
						
						// collapse the creation node upon create
						if(node.parentNode != null)
							node.parentNode.toggle();
					}
				}
				else
				{
					// join an existing instance
					var instance = running[node.data];
					var bestSide = client.persona.country.side;
					var scenario = loadScenario(instance.description.category, instance.description.type);
					
					if(instance.axis > instance.allies)
						bestSide = 1;
					else if(instance.allies > instance.axis)
						bestSide = 2;
						
					if(!selectTeam(scenario, bestSide))
						return;
						
					setForwardEnabled(true);
					
					if(action && !joinInstance(instance.description))
						joinLobby();
				}
			}
		}
		
		function updateLobby()
		{
			if(initialized && updateTimer.run())
			{
				var category = 0;
				
				for(var i = 0; i < rootNodes.length; i++)
				{
					if(rootNodes[i].open)
					{
						category = rootNodes[i].id;
						break;
					}
				}
				
				if(category > 0)
					client.listinstances(category, 0, "");
				
				initInstances();
			}
		}
		
		function onPersonas()
		{
			// personas have been requested from the host
			// set our instance to the campaign instance
			// set our persona to german army
			client.selectinstance(scenarios.category, 0, 4, 1);
			
			cprint("Lobby personas called!");
			
			initialized = true;
		}
		
		-->
	</script>
</window>
