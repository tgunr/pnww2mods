<?xml version="1.0"?>
<!DOCTYPE uixml SYSTEM "loc://ui.dtd">
<window id="scenarios/lobby" x="0" y="0" width="1024" height="768" viewportwidth="1024" viewportheight="768"
	onshow="initLobby()" onupdate="updateLobby()" aspectalign="center">
	<include file="lib/common.uixml"/>
	<include file="lib/scenarios.uixml"/>
	<include file="widgets/template_ra.uixml"/>
	<include file="classes/ListControl.uixml"/>
	<include file="classes/TreeControl2.uixml"/>
	<include file="classes/CycleTimer.uixml"/>
	<include file="classes/ViewBuilder.uixml"/>
	<include file="classes/TextBuilder.uixml"/>
	<include file="classes/ImageBuilder.uixml"/>
	<include file="classes/RowBuilder.uixml"/>
	<tabview id="body" x="43" y="140" width="930" height="450" ontab="doBodyTab()" style="color: #BFE2CE;
						background-color: #000000BB; 
						border-top-corner: ui/textures/test/body_ul.bmp;
						border-bottom-corner: ui/textures/test/body_br.bmp;
						border-sides: ui/textures/test/body_sides.bmp;
						border-top: ui/textures/test/body_top.bmp;
						border-bottom: ui/textures/test/body_bottom.bmp;
						control-on-endcap:  ui/textures/test/body_tab_cap_on.bmp;
						control-on-back:  ui/textures/test/body_tab_filler_on.bmp;
						control-off-endcap: ui/textures/test/body_tab_cap.bmp;
						control-off-back: ui/textures/test/body_tab_filler.bmp;
						control-on-color: #FFFFCE;
						border-width: 16;
						border-height: 16;">
		<tab label="  ${online.ra}  " x="0" y="0" width="930" height="460"
			onshow="showList()" tip="${scenarios.help}">
			<view id="left-pane" x="18" y="23" width="444" height="411">
				<!-- weapon selection -->
				<view id="instance-block" x="10" width="425" height="400" rtop="12">
					<caption label="${scenarios.list}" x="0" height="20" width="425" rtop="0"
						style="font-size: +2; color: #BFE2CE; tooltip: widgets/tooltips/supplytip.uixml;"/>
					<image x="0" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="10"/>
					<list id="instanceList" x="0" width="425" height="300" rtop="40" onselect="instanceList.clickList(false)" ondblselect="instanceList.clickList(true)"/>
				</view>
				<button id="create-button" x="10" y="0" width="120" height="30" label="${online.ra.create}" onclick="loadWin('scenarios/create',true)"
					style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
					onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
				<button id="quick-button" x="100" y="0" width="120" height="30" label="${online.ra.quick}" onclick="selectInstance(true)"
					style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
					onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)" onshow="centerViewX(this)"/>
				<button id="join-button" y="0" width="120" height="30" rright="10" label="${online.ra.join}" onclick="selectInstance(true)"
					style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
					onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
			</view>
			<include file="widgets/divider.uixml"/>
			<view id="right-pane" x="468" y="23" width="444" height="411">
				<caption id="instance-name" label="${online.ra.create}" x="10" height="20" rright="10" rtop="12"
						style="font-size: +2; color: #BFE2CE; tooltip: widgets/tooltips/supplytip.uixml;"/>
				<image src="ui/textures/test/horiz_underline.bmp" x="10" rright="10" height="12" rtop="22"/>
				<view id="instance-map" class="scenimage" src="map.bmp" acceptsfocus="no" x="20" width="400" height="192" rtop="50"
					style="border-color: #BFE2CE; border-size: 1;"/>
				<text id="instance-description" x="20" y="10" rright="20" rtop="260" style="font-size: +1; color: #FFFFFFBB;" value="${online.ra.create}"/>
			</view>
		</tab>
		<include file="widgets/globals/settings.uixml"/>
	</tabview>
	<!-- include file="widgets/infobar.uixml"/ -->
	<script>
		<!--
		
		cprint(">>> STARTING LOBBY PAGE\n");
		
		var client 				= game.player.client;
		var instName		= findview("instance-name");
		var instMap			= findview("instance-map");
		var instDesc			= findview("instance-description");
		var createBtn		= findview("create-button");
		var quickBtn			= findview("quick-button");
		var joinBtn			= findview("join-button");
		var updateTimer	= new CycleTimer(3000);
		var scenarios		= loadRoot();
		var instanceList	= new ListControl(findview("instanceList"), selectInstance);
		var running			= new Array();
		var initialized		= false;
		
		/***************** COMMON FUNCTIONS *******************/
		
		function doForward()
		{
			selectInstance(true);
		}
		
		function doBack()
		{
			if(campaignPlay())
				loadWin("online", true);
		}
		
		function initLobby(win)
		{
			var chat = game.findview("chat");
			if(chat != null)
			{
				chat.x = window.width/2 - chat.width/2;
				chat.y = 10;
			}
			
			showIDCard(false);
			showChat(true);
			
			setHelp(getlocstring('scenarios.help'));
			
			setBack('online.back');
			setForward('scenarios.forward');
			setForwardEnabled(false);
			forwardButton.visible = false;
			
			if(!campaignPlay())
				backButton.visible = false;
			
			initHeaders(findview("instance-block"));
			
			quickhelp();
			
			game.globals.scenario = null;
			
			client.onpersonas = onPersonas;
			client.requestpersonalist();
		}
		
		function initHeaders(p)
		{
		 	var rb = new RowBuilder(p, "scenarios-header", 0, -22, 0, 15);
		 	
		 	rb.addColumn("scenarios.list.id", .15);
		 	rb.addColumn("scenarios.list.map", .4);
		 	rb.addColumn("scenarios.list.type", .1, "center");
		 	rb.addColumn("scenarios.list.status", .15, "center");
		 	rb.addColumn("scenarios.list.players", .1, "center");
		 	rb.addColumn("scenarios.list.squad", .1, "center");
		 	
		 	p.addview(rb.build());
		}
		
		function initInstances()
		{
			// reset our running list of instances 
			running = new Array();
			
			quickBtn.enabled = false;
			joinBtn.enabled = false;
			
			// some temp vars
			var instances = client.instances;
			
			// now for each category, add our instances
			for(var i = 0; i < instances.length; i++)
			{
				var instance = instances[i];
				if(instance == null) continue;
				
				var content = loadScenario(instance.description.category, instance.description.type);
				if(content == null) continue;
				
				var scenario = new Object();
				
				scenario.id				= instance.description.id;
				scenario.content 		= content;
				scenario.instance 	= instance;
				
				running.push(scenario);
			}
			
			// now sort our running instances
			// running = running.sort(sortScenarios);
			
			// now update our visible list
			instanceList.clearRows(false);
			
			if(running.length > 0)
			{
				for(var i = 0; i < running.length; i++)
				{
					var scenario 	= running[i];
					var content 		= scenario.content;
					var instance 	= scenario.instance;
					var id				= instance.description.id;
					var players		= instance.axis + instance.allies;
					
					var team1max	= parseInt(content.team1max);
					if(isNaN(team1max)) team1max = MAX_SIDE_PLAYERS;
					
					var team2max	= parseInt(content.team2max);
					if(isNaN(team2max)) team2max = MAX_SIDE_PLAYERS;
					
					var rb = new RowBuilder(instanceList.list, "row" + i, 0, 0, 0, 16);
					
					rb.color 		= "#e9e3d9";
					rb.bgcolor 	= null;
					
					rb.addAttribute("aspectalign", "left");
					//rb.addAttribute("onmouseenter", mouseenter);
					//rb.addAttribute("onmouseexit", mouseexit);
					
					rb.addColumn("#" + id, .15);
					rb.addColumn(content.title, .4);
					
					if(instance.description.category == 501)
						rb.addColumn("DM", .1, "center");
					else if(instance.description.category == 502)
						rb.addColumn("CTF", .1, "center");
					else if(instance.description.category == 503)
						rb.addColumn("OBJ", .1, "center");
					
					if(players < team1max + team2max)
						rb.addColumn("scenarios.list.status.running", .15, "center");
					else
						rb.addColumn("scenarios.list.status.full", .15, "center");
					
					rb.addColumn(players, .1, "center");
					rb.addChatIcon("squad", .1, 12, .5);
					
					var xml = rb.build();
					
					cprint("xml = " + xml);
					
					instanceList.addRow(scenario, rb.build());
				}
				
				quickBtn.enabled = true;
				joinBtn.enabled = true;
			}
			
			instanceList.postInit();
		}
		
		function selectInstance(action)
		{
			cprint("Select instance called: " + instanceList.data);
			
			setForwardEnabled(false);
			
			var scenario = instanceList.data;
			if(scenario == null) return;
			
			setForwardEnabled(true);
			
			cprint("Found instance " + instanceList.data);
			
			scenario.content.instance = scenario.instance;
			
			// update our description
			instName.label = scenario.content.title.toUpperCase();
			instDesc.text = scenario.content.brief;
			instMap.src = "scenarios/terrain/" + scenario.content.terrain + "/map.bmp";
			
			if(action)
			{
				if(!canJoinScenario(scenario.content))
				{
					showOk(lastScenarioError);
					return;
				}
				
				if(!selectTeam(scenario.content))
				{
					showOk(lastScenarioError);	
					return;
				}
				
				var instance = scenario.instance;
				
				if(!joinInstance(instance.description, false))
				{
					showOk("Failed to join instance!");
					joinLobby();
				}
			}
		}
		
		function updateLobby()
		{
			// list
			if(initialized && updateTimer.run())
			{
				// grab all instances
				client.listinstances(0, 0, "");
				
				// update our visible list
				initInstances();
			}
		}
		
		function onPersonas()
		{
			// personas have been requested from the host
			// set our instance to the campaign instance
			// set our persona to german army
			client.selectinstance(scenarios.category, 0, 4, 1);
			
			cprint("Lobby personas called!");
			
			initialized = true;
		}
		
		function showList()
		{
			setHelp(getlocstring('scenarios.help'));
			tplTab();
			setForward('scenarios.forward');
			selectInstance(false);
		}
		
		-->
	</script>
</window>
