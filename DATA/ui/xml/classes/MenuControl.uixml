<script>

	<include file="classes/MenuItem.uixml"/>

	<!--

	function MenuControl(id, x, y, width, height, hindent, vindent, items, onclick, ondraw)
	{
		this.setManager = function(child)
		{
			child.menuMgr = this;
			return child;
		}

		this.addMenuItems = function(parent, items)
		{
		 	if(items != null)
		 	{
				for(var i = 0; i < items.length; i++)
			 	{
				 	var item = items[i];
				 	var menu = this.addMenuItem(parent, item);

				 	// recursively add submenus
				 	this.addMenuItems(menu, item.items);
			 	}
		 	}
		 	else
		 	{
			 	consoleprint("Tried to set menu items, but items was null\n");
		 	}
		}

		this.addMenuItem = function(parent, item)
		{
		 	var menu = null;

		 	if(item.creator != null)
		 	 	menu = item.creator(this, parent, item);
		 	else
			 	menu = parent.addmenu(this.createMenu(item.label), item.data);

		 	return this.setManager(menu);
		}

		this.clickMenu = function(item, dblclick)
		{
		 	var onclick = this.onclick;

		 	if(item != null && onclick != null)
		 		onclick(item, dblclick);
		}

		this.hideMenu = function()
		{
		 	this.root = null;
		}

		this.closeMenu = function()
		{
		 	if(this.root != null)
		 		this.root.close();
		}

		// We're not currently using the actual icon capability.
		// This is a hack to fix a Mac CTD in 1.34.6+
		// Originating programmer: Brian "Shef" Shef
		this.createMenu = function(label, iconL1, iconL2, iconR1, iconR2)
		{
			cprint("In MenuControl.createMenu(...)");
		 	var desc = "";
			
			if(iconL1 == null && iconL2 == null && iconR1 == null && iconR2 == null)		// No icons
			{
				desc += '<ctxmenu label="' + htmlencode(label) + '" x="0" y="0"';
				desc += ' width="' + this.width + '" height="' + this.height + '"';
				desc += ' hindent="' + this.hindent + '" vindent="' + this.vindent + '"';
				desc += ' style="color: #FFFFFF; background-color: #000000; border-color: #FFFFFF;"';
				desc += ' onmouseenter="this.setstyleproperty(\'color\',\'#FFFF00\')"'
				desc += ' onmouseexit="this.setstyleproperty(\'color\',\'#FFFFFF\')"/>';
			}		
			else if(iconL1 != null && iconL2 != null && iconR1 == null && iconR2 == null)	// 2 left icons
			{
				var adjustedWidth = this.width + 37;
				desc += '<ctxmenu label="' + htmlencode(label) + '" x="0" y="0" ';
				desc += ' width="' + adjustedWidth + '" height="' + this.height + '"';
				desc += ' hindent="' + this.hindent + '" vindent="' + this.vindent + '"';
				desc += ' style="color: #FFFFFF; background-color: #000000; border-color: #FFFFFF; border-size-left: 37;"';
				desc += ' onmouseenter="this.setstyleproperty(\'color\',\'#FFFF00\')"'
				desc += ' onmouseexit="this.setstyleproperty(\'color\',\'#FFFFFF\')"> \n';				
					desc += iconL1;
					desc += iconL2;
				//desc += '<caption label="' + htmlencode(label) + '" x="30" y="0" rright="0" height="' + this.height + '" style="color: #FFFFFF" acceptmouseclick="false"';
				//desc += ' onmouseenter="this.setstyleproperty(\'color\',\'#FFFF00\')"';
				//desc += ' onmouseexit="this.setstyleproperty(\'color\',\'#FFFFFF\')" /> \n';
				desc += ' <ctxmenu />';

			}
			else																			// Default to no icons
			{
				cprint("CreateMenu default to no icons");
				desc += '<ctxmenu label="' + htmlencode(label) + '" x="0" y="0"';
				desc += ' width="' + this.width + '" height="' + this.height + '"';
				desc += ' hindent="' + this.hindent + '" vindent="' + this.vindent + '"';
				desc += ' style="color: #FFFFFF; background-color: #000000; border-color: #FFFFFF;"';
				desc += ' onmouseenter="this.setstyleproperty(\'color\',\'#FFFF00\')"'
				desc += ' onmouseexit="this.setstyleproperty(\'color\',\'#FFFFFF\')"/>';
			}

			return desc;
		}

	 	consoleprint("New right click menu\n");

		// lets set the callbacks
		this.onclick 	= onclick;
		this.ondraw 	= ondraw;

		var currentRoot = findview(id);

		if(currentRoot != null)
			currentRoot.close();

		// methods
 	 	this.root = this.setManager(window.addmenu('<ctxmenu id="' + id + '" x="0" y="0" width="1" height="1" onhide="this.menuMgr.hideMenu()"/>'));

 	 	if(this.root == null)
 	 		consoleprint("Warning, root menu not created!\n");

 	 	// position it
 	 	this.root.screenx	= x;
 	 	this.root.screeny 	= y;
		
		this.clickx		= x;
		this.clicky		= y;
 	 	this.width		= width;
 	 	this.height 	= height;
 	 	this.hindent	= hindent;
 	 	this.vindent	= vindent;

		// add the submenus
		this.addMenuItems(this.root, items);

		//consoleprint("Showing menu!\n");

		// show the menu
	 	this.root.visible = true;

		consoleprint("Menu init done!\n");
	}

	//MenuControl.ROOT_MENU = '<ctxmenu id="menu_root" x="0" y="0" width="1" height="1" onhide="this.mgr.hideMenu()"/>';
	//MenuControl.CHILD_MENU = '<ctxmenu x="0" y="0" width="1" height="1" onclick="this.mgr.clickMenu(this, false)" ondblclick="this.mgr.clickMenu(this, true)"/>';

	-->
</script>
