<script>
	<!--
	
	function MapInfo(widget)
	{
		// base class
		var self 				= new MapControl(widget);
		
		// members
		self.infoTimer 			= new CycleTimer(200);
		self.wpTimer 			= new CycleTimer(10000);
		
		self.infoPlayerView		= self.setManager("map-info-playerpos");
		self.infoMouseView 		= self.setManager("map-info-mousepos");
		self.waypointList 		= new ListControl(self.setManager("map-waypoints-list"));
		
		self.setManager("map-info-brigade-zoom");
		self.setManager("map-info-origin-zoom");
		self.setManager("map-info-target-zoom");
		self.setManager("map-info-playerpos-zoom");
		
		// methods
		self.showInfo = function()
		{
			var widget 		= this.widget;
			var client 		= game.player.client; 
			var mission 	= client.currentmission;
			var brigade		= client.brigade;
			
			var brigadeView = widget.findview("map-info-brigade");
			var originView 	= widget.findview("map-info-origin");
			var targetView 	= widget.findview("map-info-target");
			
			if(brigade != null)
				brigadeView.label = brigade.name;
			else
				brigadeView.label = getlocstring('widgets.map.info.none');
					
			if(mission != null)
			{
				originView.label 	= mission.origin.name;
				targetView.label 	= mission.target.name;
			}
			else
			{
				originView.label 	= getlocstring('widgets.map.info.na');
				targetView.label 	= getlocstring('widgets.map.info.na');
			}
			
			this.updateInfo();
		}
		
		self.updateInfo = function()
		{
			var map = this.map;
			var mgr	= map.mgr;
			
			if(map)
			{
				if(this.infoTimer.run())
				{
					this.infoPlayerView.label 	= (game.ingame) ? mgr.getLatLon(game.player.position): getlocstring('widgets.map.info.na');
					this.infoMouseView.label 	= (map.mgr.mousein) ? mgr.getLatLon(map.mouseposition): getlocstring('widgets.map.info.na');
				}
				
				if(this.wpTimer.run())
					this.drawWaypoints();
			}
		}
		
		self.clickInfo = function(what)
		{
			soundPlayClick();
			
			var client 		= game.player.client;
			var mission 	= client.currentmission;
			
			if(what == "brigade")
			{
				if(client.brigade && client.brigade.home)
					this.map.mgr.setSelection(client.brigade.home);
			}
			else if(what == "origin" && mission != null)
			{
				this.map.mgr.setSelection(mission.origin);
			}
			else if(what == "target" && mission != null)
			{
				this.map.mgr.setSelection(mission.target);
			}
			else if(what == "player" && game.ingame)
			{
				this.map.mgr.setPosition(game.player.position);
			}
		}
		
		self.drawWaypoints = function()
		{
			var map				= this.map;
			var waypoints 		= map.waypoints;
			var reports			= map.reports;
			var list			= this.waypointList;
			var empty			= true;
			
			list.clearRows(true);
			
			for(var i = 0; i < waypoints.length; i++)
			{
				var waypoint = waypoints[i];
				
				var row = "\
<view id='" + htmlencode(waypoint.name) + "' x='2' width='153' height='13' aspectalign='left'\
	onmouseenter='this.mouseEnter(this)' onmouseexit='this.mouseExit(this)'>\
	<caption x='5' y='0' width='100' height='13' style='color: #e9e3d9ff; font-size: -1;' label='" + htmlencode(waypoint.displayname) + "' tip='" + htmlencode(waypoint.notes) + "'/>\
</view>";
				
				var rowview = list.addRow(waypoint, row);
				
				rowview.mouseEnter 	= list.mouseEnter;
				rowview.mouseExit 	= list.mouseExit;
				
				if(waypoint.active)
					list.clickList(false, i);
				
				empty = false;
			}
			
			for(var i = 0; i < reports.length; i++)
			{
				var report 	= reports[i];
				var name	= (report.shared && report.local) ? "C?": report.displayname;
				
				var row = "\
<view id='" + report.name + "' x='2' width='153' height='13' aspectalign='left'\
	onmouseenter='this.mouseEnter(this)' onmouseexit='this.mouseExit(this)'>\
	<caption x='5' y='0' width='100' height='13' style='color: #e9e3d9ff; font-size: -1;' label='" + name + "' tip='" + report.notes + "'/>\
</view>";
				
				var rowview = list.addRow(report, row);
				
				rowview.mouseEnter 	= list.mouseEnter;
				rowview.mouseExit 	= list.mouseExit;
				
				if(report.active)
					list.clickList(false, waypoints.length + i);
				
				empty = false;
			}
		
			if(empty)
			{
				var row = "\
<view id='empty' x='2' width='153' height='13' aspectalign='left'>\
	<caption x='5' y='0' width='100' height='13' style='color: #e9e3d9ff; font-size: -1;' label='" + getlocstring('widgets.map.info.none') + "'/>\
</view>";
				
				var rowview = list.addRow(null, row);
			}
		}
		
		self.selectWaypoint = function()
		{
			this.waypointList.clickList(false);
			
			var waypoint 	= this.waypointList.list.selecteddata;
			var map			= this.map;	
			
			if(waypoint != null && map != null)
			{
				map.setactivewaypoint(waypoint);
				
				if(game.ingame || player.client.currentmission.amleader)
					map.mgr.setPosition(waypoint.position);
			}
		}
		
		self.showInfo();
		
		return self;
	}
	
	-->
</script>
