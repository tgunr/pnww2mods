<script>
	<!--
	
	function MapDetails(widget)
	{
		// base class
		var self = new MapControl(widget);
		
		self.hoverTimer = new CycleTimer(250);
		self.target 	= (game.online && game.player.client.brigade != null) ? game.player.client.brigade.home: null;
		self.hover 		= null;
		
		self.facilityList 	= new ListControl(self.setManager('map-facilities-list'));
		self.brigadeList 	= new ListControl(self.setManager('map-brigades-list'));
		
		self.setManager('map-details-cp-zoom');
		
		// members
		self.onCPSelected = function(mgr)
		{
			var selected = mgr.selection;
			
			if(selected != null && (this.target == null || selected.name != this.target.name))
			{
				this.target = selected;
				this.setCP(selected);
			}
		}
		
		self.onUpdate = function(mgr)
		{
			if(this.hoverTimer.run())
			{
				var over = this.map.overobject;
				
				if(over)
				{
					var stratObject = over.stratobject;
					
					if(this.hover == null || this.hover.name != stratObject.name)
					{
						this.hover = stratObject;
						this.setCP(stratObject);
					}
				}
				else
				{
					if(this.hover != null && this.hover.name != this.target.name)
						this.setCP(this.target);
					
					this.hover = null;
				}
			}
		}
		
		self.setCP = function(target)
		{
			if(target)
			{
				var caption = this.widget.findview("map-details-cp");
				var image	= this.widget.findview("map-details-cp-flag"); 
				
				caption.label 	= target.name.toUpperCase();
				image.src		= this.getCountryIcon(target);
				
				this.drawFacilities(target);
				this.drawBrigades(target);
			}
		}
		
		self.drawFacilities = function(target)
		{
			var list = this.facilityList;
			
			list.clearRows(true);
			
			if(target)
			{
				var map				= this.map;
				var facilities 		= target.children;
				
				for(var i = 0; i < facilities.length; i++)
				{
					var facility 	= facilities[i];
					var icon		= this.getCountryIcon(facility);
					
					var row = "\
<view id='map-facility-" + i + "' x='2' width='153' height='13'\
	onmouseenter='this.mgr.facilityList.mouseEnter(this)' onmouseexit='this.mgr.facilityList.mouseExit(this)'\
	tip='" + htmlencode(facility.name) + "' aspectalign='left'>\
	<image src='" + icon + "' x='5' y='-2' width='12' height='12'/>\
	<caption x='20' y='0' rright='0' height='13' style='color: #e9e3d9ff; font-size: -2;' label='" + htmlencode(facility.name) + "'/>\
</view>";
					
					this.setManagerByWidget(list.addRow(facility, row));
				}
			}
			else
			{
				var row = "\
<view id='empty' x='2' width='153' height='13' aspectalign='left'>\
	<caption x='5' y='0' width='153' height='13' style='color: #e9e3d9ff; font-size: -1;' label='None'/>\
</view>";
				
				var rowview = list.addRow(null, row);
			}
		}
		
		self.drawBrigades = function(target)
		{
			var list = this.brigadeList;
			
			list.clearRows(true);
			
			if(target)
			{
				var map				= this.map;
				var targetCP		= target;
				
				while(targetCP && targetCP.stratclass != "cp")
					targetCP = targetCP.parent;
				
				var brigades 	= targetCP.brigades.sort(MapDetails.SortUnits);
				var current 	= 0;
				
				for(var i = 0; i < brigades.length; i++)
				{
					var brigade 	= brigades[i];
					var division	= (brigade.isbrigade) ? brigade.parent: brigade; 
					var row		= "";
					
					if(current == 0 || division.id != current)
					{
						row = "\
<view id='map-division-" + i + "' x='2' width='153' height='13'  aspectalign='left'\
	onmouseenter='this.mgr.brigadeList.mouseEnter(this)' onmouseexit='this.mgr.brigadeList.mouseExit(this)'\
	tip='" + htmlencode(division.name) + "'>\
	<caption x='5' y='0' width='153' height='13' style='color: #e9e3d9ff; font-size: -2;' label='" + htmlencode(division.name) + "'/>\
</view>";
						
						this.setManagerByWidget(list.addRow(division, row));
						current 			= division.id;
					}
					
					if(brigade.isbrigade)
					{
						row = "\
<view id='map-brigade-" + i + "' x='2' width='153' height='13' aspectalign='left'\
	onmouseenter='this.mgr.brigadeList.mouseEnter(this)' onmouseexit='this.mgr.brigadeList.mouseExit(this)'\
	tip='" + htmlencode(brigade.name) + "'>\
	<caption x='25' y='0' width='133' height='13' style='color: #e9e3d9ff; font-size: -2;' label='" + htmlencode(brigade.name) + "'/>\
</view>";
					}
					else
					{
						row = "\
<view id='map-divisionhq-" + i + "' x='2' width='153' height='13' aspectalign='left'\
	onmouseenter='this.mgr.brigadeList.mouseEnter(this)' onmouseexit='this.mgr.brigadeList.mouseExit(this)' tip='Division HQ'>\
	<caption x='25' y='0' width='133' height='13' style='color: #e9e3d9ff; font-size: -2;' label='Division HQ'/>\
</view>";
					}
					
					this.setManagerByWidget(list.addRow(brigade, row));
				}
			}
			else
			{
				var row = "\
<view id='empty' x='2' width='153' height='13' aspectalign='left'>\
	<caption x='5' y='0' width='153' height='13' style='color: #e9e3d9ff; font-size: -1;' label='None'/>\
</view>";
				
				var rowview = list.addRow(null, row);
			}
		}
		
		self.selectBrigade = function()
		{
			consoleprint("CLICKING BRIGADE LIST\n");
			
			this.brigadeList.clickList(false);
			
			var map	= this.map;	
			
			if(map != null)
			{
				consoleprint("Found brigade map\n");
				map.mgr.setSelection(this.brigadeList.data.home, false);
				map.sethclinks(this.brigadeList.data);
				//map.scale = 1;
			}
		}
		
		self.selectFacility = function()
		{
			this.facilityList.clickList(false);
			
			var facility	= this.facilityList.list.selecteddata;
			var map			= this.map;	
			
			if(facility != null && map != null)
			{
				map.mgr.setPosition(facility.position);
				//map.scale = .0625;
			}
		}
		
		self.zoomToTarget = function()
		{
			soundPlayClick();
			this.map.mgr.setSelection(this.target);
		}
		
		self.getCountryIcon = function(target)
		{
			if(target && target.country)
			{
				var code = (target.stratclass == "building") ? target.parent.country.code: target.country.code;
				
				if(code == "UK")
					return "ui/uidata/icons/cp/british/briticonflag1.bmp";
				else if(code == "FR")
					return "ui/uidata/icons/cp/french/frenchiconflag1.bmp";
				else if(code == "DE")
					return "ui/uidata/icons/cp/german/germaniconflag1.bmp";
			}
			
			return "";
		}
		
		self.map.mgr.addExtHook('onCPSelected', self);
		//self.map.mgr.addExtHook('onUpdate', self);
		
		if(self.target)
			self.setCP(self.target); 
		
		return self;
	}
	
	/**************** STATIC CLASS METHODS ********************/
	
	MapDetails.SortUnits = function sortBrigades(a,b)
	{
		if(a.divisionid == b.divisionid)
		{
			// sort on division name
			if(a.name < b.name)
				return -1;
			else if(a.name > b.name)
				return 1;
		}
		else
		{
			// sort on brigade name
			if(a.division < b.division)
				return -1;
			else if(a.division > b.division)
				return 1;
		}
		
		return 0;
	}
	
	-->
</script>
