		function discardChangedPreferences()
		{
			showOk(getlocstring('widgets.prefs.discarded'));
			resetPreferences();
		}
		
		function addPreference(name, type, value, isglobal)
		{
			soundPlayClick();
			consoleprint("Adding " + name + ": " + value + "\n");
			
			var current = getPreference(name, type, null, isglobal);
			
			if(value != current)
				PENDING_PREFS[name] = new Preference(name, type, value, isglobal);
		}
		
		function getPreference(name, type, value, isglobal)
		{
			consoleprint("Getting " + name + ": ");
			
			var current = null;
			
			if(PENDING_PREFS[name] != null)
				current = PENDING_PREFS[name].value;
			else
				current = (isglobal) ? game.settings[name]: game.getpref(name, type);
			
			if(current == null)
				current = value;
			
			consoleprint(current + "\n");
			
			return current;
		}
		
		function getPreferenceAsBool(name, type, value, isglobal, check)
		{
			return (getPreference(name, type, value, isglobal) == check) ? true: false;
		}
		
		function addSliderPreference(name, type, value, isglobal, max, min)
		{
			consoleprint("Adding slider preference for " +  name + " as " + value + "\n");
			
			if(max == null) max = 1;
			if(min == null) min = 0;
			
			addPreference(name, type, min + ((max - min) * value), isglobal);
		}
		
		function getSliderPreference(name, type, value, isglobal, max, min)
		{
			if(max == null) max = 1;
			if(min == null) min = 0;
			
			return (min + getPreference(name, type, value, isglobal))/max;
		}
	
		Preference.BOOL 	= 0;
		Preference.UINT 	= 1;
		Preference.SINT 	= 2;
		Preference.LONG 	= 3;
		Preference.FLOAT 	= 4;
		Preference.DOUBLE = 5;
		Preference.STRING = 6;
	
