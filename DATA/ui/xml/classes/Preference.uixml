	<!--
	
		function Preference(name, type, value, isglobal)
		{
			this.name 		= name;
			this.type 		= type;
			this.value 		= value;
			this.isglobal	= (isglobal != null) ? isglobal: false;
			
			this.update = function()
			{
				if(this.isglobal)
				{
					if(this.value != game.settings[this.name])
						game.settings[this.name] = this.value;
				}
				else
				{
					if(this.value != game.getpref(this.name, this.type))
						game.setpref(this.name, this.type, this.value);
				}
			}
			
			return this;
		}
	
		// preference management
		var PENDING_PREFS = new Object();
		
		function savePreferences()
		{
			for(var p in PENDING_PREFS)
					PENDING_PREFS[p].update();
			
			if(game.settings.restartneeded)
				showOk(getlocstring('widgets.prefs.changed'));

			resetPreferences();
		}
		
		function resetPreferences()
		{
			PENDING_PREFS = new Object();
		}
		
