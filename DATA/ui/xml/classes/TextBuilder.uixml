<script>

	<include file="classes/ViewBuilder.uixml"/>

	<!--
	
	function TextBuilder(par, id, type, text, x, y, w, h)
	{
		var self = new ViewBuilder(par, id, x, y, w, h);
		
		self.type = type;
		
		if(type == "caption")
			self.addAttribute("label", htmlencode(text));
		else
			self.addAttribute("text", htmlencode(text));
		
		return self;
	}
	
	-->
</script>
