<script>
	<!--
	
	function MirrorView(t, x, y, p, b)
	{
		// members
		this.target		= t;
		this.startx		= x;
		this.starty		= y;
		this.pause		= p;
		this.bgpad		= b;
		this.start		= 0;
		
		// methods
		this.update = function()
		{
			if(this.target && this.view)
			{
				if(this.delay())
					return true;
				
				if(this.move())
					return true;
			}
			
			return false;
		}
		
		this.init = function()
		{
			if(this.target)
			{
				var mx = this.startx - this.target.width/2;
				var my = this.starty - this.target.height/2;
				var mw = this.target.width;
				var mh = this.target.height;
				
				this.start 	= (new Date()).getTime();
				this.view	= window.addview('<mirror id="mirrorview" x="' + mx + '" y="' + my + '" width="' + mw + '" height="' + mh + '" src="' + this.target.name + '" layer="1"/>');
				
				this.view.modal			= false;
				this.view.acceptsmouse	= false;
				this.view.width 		= this.target.width;
				this.view.height 		= this.target.height;
				this.view.x 			= (game.screenwidth/2) - (this.view.width/2);
				this.view.y 			= (game.screenheight/2) - (this.view.height/2);
				
				//consoleprint("Dimensions set to " + this.view.x + "," + this.view.y + "," + this.view.width + "," + this.view.height + "\n");
				
				if(this.bgpad > 0)
				{
					this.bg	= window.addview('<view id="bgmirrorview" x="0" y="0" width="1" height="1" style="background-color: #000000AA;"/>');
					//consoleprint("Adding bg " + this.bg.x + "," + this.bg.y + "," + this.bg.width + "," + this.bg.height + "\n");
					
					this.bg.modal			= false;
					this.bg.acceptsmouse 	= false;
					this.bg.x 				= this.view.x - this.bgpad;
					this.bg.y 				= this.view.y - this.bgpad;
					this.bg.width 			= this.target.width + (this.bgpad * 2);
					this.bg.height 			= this.target.height + (this.bgpad * 2);
				}
			}
		}
		
		this.delay = function()
		{
			//this.view.width = this.target.width;
			//this.view.height = this.target.height;
			
			if(this.bg)
			{
				this.bg.x = this.view.x - this.bgpad;
				this.bg.y = this.view.y - this.bgpad;
			}
			
			var now = new Date();
			
			return (now.getTime() < (this.start + this.pause));
		}
		
		this.move = function()
		{
			//this.view.width = this.target.width;
			//this.view.height = this.target.height;

			// calculate center x,y
			var wcx = this.view.screenx + this.view.width/2;
			var wcy = this.view.screeny + this.view.height/2;
			var vcx = this.target.screenx + this.target.width/2;
			var vcy = this.target.screeny + this.target.height/2;
			
			// calculate the direction
			var dirx = (wcx - vcx) * -1;
			var diry = (wcy - vcy) * -1;
			
			// get the length
			var len = Math.sqrt((dirx * dirx) + (diry * diry));
			
			if(len <= 1)
			{
				//consoleprint("Length is " + len + ", killing!\n");
				this.kill();
				return false;
			}
			
			// normalize it
			dirx /= len;
			diry /= len;
			
			// calculate move distance
			var dist = 1 + (len * .1);
			
			//consoleprint("Length is " + len + ", distance is " + dist + "!\n");
			
			// calculate the next position
			wcx += dirx * dist;
			wcy += diry * dist;
			
			//consoleprint("Height is " + this.view.height + "\n");
			
			// move the view to the position
			this.view.x = wcx - this.view.width/2;
			this.view.y = wcy - this.view.height/2;
			
			if(this.bg)
			{
				this.bg.x = this.view.x - this.bgpad;
				this.bg.y = this.view.y - this.bgpad;
			}
			
			return true;
		}
		
		this.kill = function()
		{
			if(this.view) this.view.close();
			if(this.bg)	this.bg.close();
			
			this.target = null;
			this.view = null;
			this.bg = null;
		}
		
		this.init();
	}
	
	-->
</script>
