<script>
	
	<include file="classes/CycleTimer.uixml"/>

	<!--
	
	function FadeView(name, duration)
	{
		// members
		this.view			= window.findview(name);
		this.view.visible 	= false;
		this.duration		= duration;
		this.start			= 0;
		this.timer			= new CycleTimer(50);
		
		// methods
		this.update = function()
		{
			if(this.view && this.start > 0 && this.timer.run())
			{
				var now = (new Date()).getTime();
				var diff = now - this.start;
				
				if(diff <= this.duration)
				{
					var opacity = (this.duration - diff) / this.duration;
					var color = game.getrgbcolor(255 * opacity, 0, 0);
					
					if(color != null)
						this.view.setstyleproperty("color", "#FFFFFF" + color.rhex);
				}
				else
				{
					this.view.visible = false;
					this.start = 0;
				}
			}
		}
		
		this.init = function(message)
		{
			this.view.text = message;
			this.view.resizetotext();
			this.view.x = (game.screenwidth / 4) - this.view.width/2;
			this.view.y = (game.screenheight/2) - this.view.height/2;
			this.view.visible = true;
			this.view.setstyleproperty("color", "#FFFFFF");
			this.start = (new Date()).getTime();
		}
	}
	
	-->
</script>
