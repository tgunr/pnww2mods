<script>
	<!--
	
	function TutorialStep(n, g, s, c, h)
	{
		this.name			= n;
		this.goal			= g;
		this.step			= s;
		this.complete		= false;
		this.reminded		= 0;
		this.GetLocString	= c;
		this.SetHilite		= h;
		this.nextReminder	= (new Date()).getTime() + 1200000;
		
		this.LocKey = function(ender)
		{
			return this.goal + "." + this.step + "." + ender;
		}
		
		this.IsGoal = function()
		{
			return (this.step == 0) ? true: false;
		}
		
		this.IsComplete = function()
		{
			return this.complete;
		}
		
		this.IsModal = function()
		{
			return this.modal;
		}
		
		this.IsValid = function()
		{
			var label = this.GetLabel();
			return (label != "") ? true: false;
		}
		
		this.HasHilite = function()
		{
			return (this.GetHilite() != "") ? true: false;
		}
		
		/*
		this.InitHilite = function()
		{
			var hiliter = game.findview("hilite");
			
			if(this.HasHilite())
			{
				if(hiliter == null)
					hiliter = game.load("hilite");
				
				hiliter.hilite(this.GetHilite());
			}
			else
			{
				if(hiliter != null)
					hiliter.visible = false;
			}
		}
		*/
		
		this.Complete = function()
		{
			/*
			if(this.HasHilite())
			{
				var hiliter = game.findview("hilite");
				if(hiliter != null) hiliter.visible = false;
			}
			*/
			
			//soundPlayBump();
			//game.playsound("sounds/ding5.wav", 1, 0.05);
			this.complete = true;
		}
		
		this.GetPopupMessage = function()
		{
			return this.GetLocString(this.LocKey("popup"), true);
		}
		
		this.GetHilite = function()
		{
			return this.GetLocString(this.LocKey("hilite"), true);
		}
		
		this.GetLabel = function()
		{
			return this.GetLocString(this.LocKey("label"), true);
		}
		
		this.GetAlerts = function()
		{
			var alerts = new Array();
			
			var newAlert = this.CreateAlert("alert");
			if(newAlert != null) alerts.push(newAlert);
			
			for(var i = 0; i < 10; i++)
			{
				newAlert = this.CreateAlert("alert" + i);
				if(newAlert != null) alerts.push(newAlert);
			}
			
			if(alerts.length)
				alerts[alerts.length - 1].canexpire = false;
			
			return alerts;
		}
		
		this.GetCameraEvents = function(id)
		{
			consoleprint("Looking for camera events for " + id + "\n");
			var events = new Array();
			
			for(var i = 0; i < 6; i++)
			{
				var name = id + ".camera" + ((i > 0) ? i: "");
				var event = this.GetLocString(name, true);
				
				if(event != "")
				{
					consoleprint("Added camera event: " + event + "\n");
					events.push(event);
				}
			}
			
			return events;
		}
		
		this.GetReminderAlert = function()
		{
			var now = (new Date()).getTime();
			
			if(now >= this.nextReminder)
			{
				this.nextReminder = now + 20000;
				return this.CreateAlert("reminder");
			}
			
			return null;
		}
		
		this.GetCompletionAlert = function()
		{
			return this.CreateAlert("complete");
		}
		
		this.CreateAlert = function(locKey, modal)
		{
			var id 		= this.LocKey(locKey);
			var message = this.GetLocString(id);
			var alert 	= (message != null) ? new TutorialAlert(id, message, this.SetHilite): null;
			
			if(alert != null)
				alert.camEvent = this.GetLocString(id + ".camera", true);
			
			return alert;
		}
	}
	
	function TutorialGoal(n, g, c, h)
	{
		var self = new TutorialStep(n, g, 0, c, h);
		self.steps = new Array();
		return self;
	}
	
	function TutorialAlert(id, m, h)
	{
		this.id				= id;
		this.message 		= m.text;
		this.hilite			= m.hilite;
		this.sethilite		= h;
		this.view			= null;
		this.minduration	= 3000;
		this.modduration	= 1000 * 120; // how long to wait for modal alerts
		this.expires 		= (m.modal) ? -1 : 0;
		this.canexpire		= true;
		this.modal			= m.modal; 
		this.pause			= m.pause;
		
		this.Show = function(view, position)
		{
			this.view 			= view;
			this.view.visible 	= true;
			this.view.text 		= this.message;
			
			if(this.modal)
				this.view.text += "\n\n[" + getlocstring("tutorials.continue") + "]";
			
			if(position == null || position != false)
			{
				this.view.resizetotext();
				this.view.x = window.width/2 - this.view.width/2;
			}
			
			if(!this.modal)
				this.expires = this.GetExpires();
			
			if(this.sethilite != null)
				this.sethilite(this.hilite, this.view);
			
			//window.modal		= this.modal;
			//window.acceptsmouse	= (this.modal || this.pause);
			
			// show the cursor if needed
			//game.enableimapinput(!this.modal);
			//game.cursor.update();
		}
		
		this.Now = function()
		{
			return (new Date()).getTime();
		}
		
		this.GetDuration = function()
		{
			return this.minduration + (Math.floor(this.message.length / 100) * 1000);
		}
		
		this.GetExpires = function()
		{
			return this.Now() + this.GetDuration();
		}
		
		this.IsExpired = function()
		{
			if(this.expires < 0)
				return false;
			
			return (this.expires <= this.Now()) ? true: false;
		}
		
		this.SetExpired = function(when)
		{
			this.expires = (!isNaN(when)) ? this.Now() + when : 0;
		}
		
		this.Expire = function()
		{
			this.view 			= null;
			this.expires 		= 0;
		}
		
		this.BaseID = function()
		{
			var parts = this.id.split(".");
			
			if(parts.length >= 3)
				return parts[0] + "." + parts[1] + "." + parts[2];
			else
				return this.id;
		}
	}
	
	game.TUT_UI_POPUP 		= 262144;
	game.TUT_UI_DESTROYED 	= 524288;
	game.TUT_UI_READY 		= 1048576;
	
	-->
</script>
