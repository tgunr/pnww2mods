<script>
	
	<include file="classes/ListControl.uixml"/>
	<include file="classes/TreeNode.uixml"/>
	
	<!--
	
	function TreeControl(list, width, onclick, ondraw)
	{
		// base class
		var self 				= new ListControl(list, onclick, ondraw);
		
		// members
		self.init				= false;
		self.indent				= 10;
		self.root				= new TreeNode("Root", "root", 0, true);
		self.expandIcon			= TreeControl.EXPAND_ICON;
		self.collapseIcon		= TreeControl.COLLAPSE_ICON;
		
		// lets explicitly set the width
		self.setWidth(width);
		
		// lets set the callbacks
		if(self.ondraw == null)
			self.ondraw = TreeControl.ondraw;
		
		// methods
		self.draw = function(node)
		{
			if(node.branch && node.open)
			{
				var children = node.children;
				
				for(var i = 0; i < children.length; i++)
				{
					var child = children[i];
					
					this.addRow(child);
					this.draw(child);
				}
			}
		}
		
		self.reset = function()
		{
			this.clearRows(false);
			this.root = new TreeNode("Root", "root", 0, true);
			this.root.expand();
		}
		
		self.clickTree = function(dblclick, index)
		{
			consoleprint("clickTree called with " + dblclick + " and " + index + "\n");
			
			this.clickList(dblclick, index);
			
			var node = this.data;
			
			//consoleprint("Clicked node is " + node.data + " and " + node.branch + "\n");
			
			if(dblclick && node.branch)
			{
				consoleprint("Toggling node " + node.title + "\n");
				node.toggle();
				this.drawTree();
			}
		}
		
		self.drawTree = function(reset)
		{
			if(reset == null || reset)
				this.clearRows(false);
			
			this.draw(this.root);
			this.setScrollY();
		}
		
		self.addNode = function(node)
		{
			this.root.addNode(node);
		}
		
		self.findNode = function(title)
		{
			return this.root.findNode(title);
		}
		
		self.expandNode = function(title)
		{
			var node = this.root.findNode(title);
			
			if(node != null && node.branch)
				node.expand();
		}
		
		// constructor logic
		self.root.expand();
		self.drawTree();
		
		return self;
	}
	
	TreeControl.EXPAND_ICON		= "ui/textures/test/treeview_expand.bmp";
	TreeControl.COLLAPSE_ICON	= "ui/textures/test/treeview_colapse.bmp";
	
	// default format function
	TreeControl.ondraw = function(tree, node)
	{
		var row 	= "";
		var name	= tree.list.id;
		var width	= tree.getWidth();
		var indent 	= tree.indent * node.level; 
		
		if(node.branch)
		{
			var icon = (node.open) ? tree.collapseIcon: tree.expandIcon;
			
			row = "\
<view id='" + node.title + "' width='" + width + "' height='16'\
	onmouseenter='" + name + ".mouseEnter(this)' onmouseexit='" + name + ".mouseExit(this)'>\
	<button id='tree_button' x='" + indent + "' y='3' width='10' height='10' onclick='" + name + ".clickTree(true, " + tree.count + ")'\
		style='control-on: " + icon + "; control-off: " + icon + ";' acceptsmouseclick='false'/>\
	<caption id='branch_title' x='" + (indent + tree.indent) + "' y='0' rright='1' height='16' style='color: #e9e3d9ff; '\
		label='" + node.title + "'/>\
</view>";
		}
		else
		{
			row = "\
<view id='" + node.title + "' width='" + width + "' height='16'\
	onmouseenter='" + name + ".mouseEnter(this)' onmouseexit='" + name + ".mouseExit(this)'>\
	<caption id='node_title' x='" + indent + "' y='0' rright='1' height='16' style='color: #e9e3d9ff; '\
		label='" + node.title + "'/>\
</view>";
		}
		
		return row;
	}
	
	-->
</script>
