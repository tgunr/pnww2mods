<script>
	<!--
	
	function DDListControl(caption, onclick, size, sbar)
	{
			consoleprint("Creating new dropdown list!!!\n");
			
			// create base list
			var list = DDListControl.createList(caption, size, sbar);
			
			// base class
			var self = new ListControl(list, onclick);
			
			self.sbar					= sbar;
			self.caption			= caption;
			self.caption.mgr	= self;
			self.list.mgr			= self;
			self.list.visible = false;
			
			self.showList = function()
			{
					this.list.visible = true;
			}
			
			self.hideList = function()
			{
					this.list.visible = false;
			}
			
			self.toggleList = function()
			{
					this.list.visible = !this.list.visible;
			}
			
			// save ListControl.clickList
			self.doClick = self.clickList;
			
			// override clickList
			self.clickList = function(dbl, index)
			{
					this.doClick(dbl, index);
					this.hideList();
					
					if(this.row != null)
							this.caption.label = this.row.findview("row-value").label;
			}
			
			self.setDefault = function(label)
			{
					this.caption.label = label;
			}
			
			self.addItem = function(label, value, isDefault)
			{
					var width 	= this.list.nwidth - ((this.sbar) ? 12 : 0); // for scrollbar
					
					var row = "\
<view id='" + this.list.id + "_item_" + this.length() + "' width='" + width + "' height='16' aspectalign='left'>\
	<caption id='row-value' x='0' y='0' width='" + width + "' height='15' style='color: #e9e3d9ff;' label='" + label + "'/>\
</view>";
				
					this.addRow((value != null ) ? value: label, row);
					
					if(isDefault != null && isDefault == true)
							this.clickList(true, this.length() - 1);
			}
			
			self.addOption = function(label, value, current)
			{
					var isDefault = false;
					
					if(value != null && current != null && typeof(value) == "string" && typeof(current) == "string")
							isDefault = (value.toUpperCase() == current.toUpperCase());
					else if(value == current)
							isDefault = true;
					
					this.addItem(label, value, isDefault);
			}
			
			self.resize = function(size)
			{
				if(size == null)
					size = 16 * this.count;
				
				var oldHeight = this.list.height;
				
				this.list.height = this.list.scalev(size);
				this.list.y += oldHeight - this.list.height;
			}
			
			//consoleprint("Created dropdown list!!!\n");
			
			return self;
	}
	
	DDListControl.createList = function(caption, size, sbar)
	{
			var parentWin = caption.parentwin;
			
			if(parentWin == null)
				parentWin = window;
			
			var w = caption.nwidth;
			var h = size; //caption.normv("h", size);
			var x = caption.normv("w", caption.windowx);
			var y = caption.normv("h", caption.windowy) - h;
			
			var format = '<list id="' + caption.id + '-list" x="' + x + '" y="' + y + '" width="' + w + '" height="' + h + '" style="color: #FFFFFF; background-color: #3e5248;" onselect="this.mgr.clickList(false)" onmouseout="this.mgr.hideList()" aspectalign="left">';
			
			if(sbar)
				format += '<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>';
			
			format += '</list>';
			
			var ddl = parentWin.addview(format);
			
			ddl.x = caption.windowx;
			ddl.y = caption.windowy - caption.scalev("h", h);
			
			consoleprint("Parent Win is " + parentWin.name + "\n");
			consoleprint("Window width is " + parentWin.nwidth + "\n");
			consoleprint("Window height is " + parentWin.nheight + "\n");
			consoleprint("Caption x is " + caption.windowx + " -> " + x + "\n");
			consoleprint("Caption y is " + caption.windowy + " -> " + y + "\n");
			consoleprint("DD List x is " + ddl.windowx + "\n");
			consoleprint("DD List y is " + ddl.windowy + "\n");
			consoleprint("Adding: " + format + "\n");
			
			return ddl;
	}
	
	-->
</script>
