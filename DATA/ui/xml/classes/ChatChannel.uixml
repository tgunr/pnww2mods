<script>
	<!--
	
	function ChatChannel(index)
	{
		// members
		this.index		= index;
		this.id			= "F" + (index + 1);
		this.button 	= findview(this.id);
		this.icon		= this.button.findview("icon");
		this.xmit		= false;
		
		// methods
		this.tune = function(to)
		{
			var channel = game.player.client.chatchannels[this.index];
			if(channel != null) channel.name = to;
		}
		
		this.update = function()
		{
			var channel = game.player.client.chatchannels[this.index];
			
			if(channel != null)
			{
				var tuned 	= channel.name;
				var button 	= this.button;
				var icon	= this.icon;
				
				if(icon != null)
					icon.channelname = tuned;
				
				if(tuned != null && tuned != "")
				{
					tuned = tuned.toLowerCase();
					
					// hack
					if(tuned == "objective")
						tuned = "target"
					
					var name = getlocstring("chat.channel." + tuned);
					
					if(name.charAt(0) == "?")
						name = tuned;
					
					//consoleprint("Setting channel name to " + name + "\n");
					
					button.label = "     " + button.id + " - " + name.toLowerCase();
				}
				else
				{
					button.label = "     " + button.id;
				}
				
				if(channel.xmit != this.xmit)
				{
					this.xmit = channel.xmit;
					
					if(this.xmit)
					{
						button.setstyleproperty("color", ChatChannel.CHANNEL_CAPTION_XMIT);
						button.setstyleproperty("background-color", ChatChannel.CHANNEL_BGCOLOR_XMIT);
					}
					else
					{
						button.setstyleproperty("color", ChatChannel.CHANNEL_CAPTION_OFF);
						button.setstyleproperty("background-color", ChatChannel.CHANNEL_BGCOLOR_OFF);
					}
				}
			}
		}
		
		this.radioCheck = function()
		{
			var channel = game.player.client.chatchannels[this.index];
			
			if(channel != null && channel.xmit != this.xmit)
			{
				this.xmit = channel.xmit;
				
				if(this.xmit)
				{
					this.button.setstyleproperty("color", ChatChannel.CHANNEL_CAPTION_XMIT);
					this.button.setstyleproperty("background-color", ChatChannel.CHANNEL_BGCOLOR_XMIT);
				}
				else
				{
					this.button.setstyleproperty("color", ChatChannel.CHANNEL_CAPTION_OFF);
					this.button.setstyleproperty("background-color", ChatChannel.CHANNEL_BGCOLOR_OFF);
				}
			}
		}
		
		this.mouseEnter = function()
		{
			this.button.setstyleproperty("color", ChatChannel.CHANNEL_CAPTION_ON);
			this.button.setstyleproperty("background-color", ChatChannel.CHANNEL_BGCOLOR_ON);
		}
		
		this.mouseExit = function()
		{
			this.button.setstyleproperty("color", ChatChannel.CHANNEL_CAPTION_OFF);
			this.button.setstyleproperty("background-color", ChatChannel.CHANNEL_BGCOLOR_OFF);
		}
		
	}
	
	// class members
	ChatChannel.CHANNEL_BGCOLOR_OFF 		= "#3E5248BB";
	ChatChannel.CHANNEL_BGCOLOR_ON 			= "#BFE2CEFF";
	ChatChannel.CHANNEL_CAPTION_OFF 		= "#BFE2CEFF";
	ChatChannel.CHANNEL_CAPTION_ON 			= "#3E5248BB";
	ChatChannel.CHANNEL_BGCOLOR_XMIT 		= "#BFE2CEFF";
	ChatChannel.CHANNEL_CAPTION_XMIT 		= "#3E5248BB";
	
	-->
</script>
