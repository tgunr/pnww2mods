<script>
	<!--
	
	function MapMission(widget)
	{
		// base class
		var self = new MapControl(widget);
		
		// members
		self.panels				= widget.findview("mapmissioncreatorpanels");
		self.creatorButton 		= widget.findview("creator-button");
		self.creatorOrigin 		= widget.findview("creator-origin");
		self.creatorTarget 		= widget.findview("creator-target");
		self.creatorDescription	= widget.findview("creator-description");
		self.typesList 			= new ListControl(self.setManager('creator-type'));
		
		self.setManager("mapmissioncreatorpanels");
		self.setManager("creator-origin");
		self.setManager("creator-target");
		self.setManager("creator-origin-edit");
		self.setManager("creator-target-edit");
		self.setManager("creator-origin-zoom");
		self.setManager("creator-target-zoom");
		self.setManager("creator-button");
		self.setManager("creator-tab");

		self.missionOrigin 		= null;
		self.missionTarget 		= null;
		self.setMapPosition		= true;
		self.wantedType			= -1;
		self.buttonTimer		= new CycleTimer(1000);
		self.panelTimer			= new CycleTimer(200);

		/*
		if(window.showCreateMission && window.showCreateMission())
		{
			var panels = self.widget.findview("mapmissioncreatorpanels");
			
			if(panels)
				panels.value = (game.player.client.canpostmission) ? 1: 2;
		}
		*/
		
		self.updateCreateTool = function()
		{
			this.creatorOrigin.label = (this.missionOrigin != null) ? this.missionOrigin.name: getlocstring('brigade.createtab.origin.default');
			this.creatorTarget.label = (this.missionTarget != null) ? this.missionTarget.name: getlocstring('brigade.createtab.target.default');
		}

		self.setOrigin = function()
		{
			var mapObject = this.map.selectedobject;
			
			if(mapObject == null || mapObject.objecttype != "strat")
			{
				soundPlayError();
				showOk(getlocstring('brigade.createtab.error.invalid'));
				return;
			}
			
			var stratObject = mapObject.stratobject;
			var result 		= stratObject.validmissionorigin();
			
			switch(result)
			{
				case 1:
				{
					soundPlayClick();
					this.missionOrigin = stratObject;
					this.updateCreateTool();
					this.drawTypes();
				}
				break;
				default:
				{
					soundPlayError();
					showOk(getlocstring('brigade.createtab.error.' + result));	
				}
				break;
			}
		}
		
		self.setTarget = function()
		{
			var mapObject = this.map.selectedobject;
			
			if(mapObject != null && mapObject.objecttype == "strat")
			{
				soundPlayClick();
				this.missionTarget = mapObject.stratobject;
				this.updateCreateTool();
				this.drawTypes();
			}
			else
			{
				soundPlayError();
				showOk(getlocstring('brigade.createtab.error.select'))
			}
		}

		self.centerOrigin = function()
		{
			soundPlayClick();
			
			if(this.missionOrigin)
				this.map.mgr.setSelection(this.missionOrigin);
		}
		
		self.centerTarget = function()
		{
			soundPlayClick();
			
			if(this.missionTarget)
				this.map.mgr.setSelection(this.missionTarget);
		}
				
		self.validMissionDescription = function()
		{
			if(this.creatorDescription.text.length > 256)
			{
				showOk(getVariableLocString('brigade.createtab.error.length', creatorDescription.text.length));
				return false;
			}
			
			return true;
		}
		
		self.createMission = function()
		{
			if(this.missionOrigin != null && this.missionTarget != null)
			{
			 	if(this.typesList.data == null)
			 		this.typesList.select();

				var missionTypeID 	= this.typesList.data;
				var client			= game.player.client;

				if(missionTypeID > -1)
				{
					// make sure we don't have a weapon reserved
					client.cancelweaponreservation();
					
					var missionID = client.createmission(this.missionOrigin, this.missionTarget, missionTypeID, 1, this.creatorDescription.text);
					
					if(missionID == -1)
					{
						showOk(getlocstring('brigade.createtab.postreply.2'));
					}
				}
			}
		}

		self.updateCreator = function()
		{
			if(this.buttonTimer.run())
				this.creatorButton.enabled = (this.missionOrigin != null && this.missionTarget != null && this.typesList.data != null) ? true: false;
			
			if(this.panelTimer.run())
				this.showCreator();
		}

		self.resupplyOK = function()
		{
			var target		= this.missionTarget;
			var origin		= this.missionOrigin;
			var brigade 	= game.player.client.brigade;
			var targetCp	= (target.stratclass != "cp") ? target.parent: target;
			var originCp	= (origin.stratclass != "cp") ? origin.parent: origin;

			if(brigade == null)
				false;

			var division = brigade.parent;

			if(division == null)
				return false;

			if(targetCp.name == originCp.name)
				return false;

			var brigadeOk = false;
			var divisionOk = false;

			for(var ob = 0; ob < originCp.brigades.length; ob++)
			{
			 	if(originCp.brigades[ob].id == division.id)
				 	divisionOk = true;
			}

			for(var tb = 0; tb < targetCp.brigades.length; tb++)
			{
			 	if(targetCp.brigades[tb].id == brigade.id)
				 	brigadeOk = true;
			}

			return (brigadeOk && divisionOk) ? true: false;
		}

		self.drawTypes = function()
		{
		 	game.consoleprint("Drawing mission types\n");

			var list 	= this.typesList;
			var target	= this.missionTarget;
			var origin	= this.missionOrigin;

			list.clearRows(true);

			if(origin != null || target != null)
			{
			 	game.consoleprint("Target or origin not null\n");

				for(var i = 0; i < MapMission.MISSION_TYPES.length; i++)
				{
				 	var typeid		= i;
					var type 		= MapMission.MISSION_TYPES[typeid];
					var typeName	= getlocstring('common.mission.' + type.toLowerCase());
					var eligible	= false;
					var row			= "";

					//game.consoleprint("Doing mission type " + typeName + "\n");
					
					if(typeid == 4) // no recon missions yet
						continue;

					if(target == null)
					{
					 	eligible = true;
					}
					else
					{
					 	var sameSide 	= (origin != null && target.country.side == origin.country.side) ? true: false;
					 	var cpClass 	= (target.stratclass == "cp") ? true: false;

						switch(typeid)
						{
						 	case 0: // point attack
								eligible = (!sameSide && !cpClass) ? true: false;
						 		break;
						 	case 1: // point defense
								eligible = (sameSide && !cpClass) ? true: false;
						 		break;
						 	case 2: // area attack
								eligible = (!sameSide && cpClass) ? true: false;
						 		break;
						 	case 3: // area defense
								eligible = (sameSide && cpClass) ? true: false;
						 		break;
						 	case 4: // recon
								eligible = false;
						 		break;
						 	case 5: // resupply
								eligible = (sameSide) ? this.resupplyOK(): false;
						 		break;
						}
					}

					if(eligible)
					{
						row = "\
<view id='creator-type-" + i + "' x='0' width='165' height='13' onmouseenter='this.mgr.typesList.mouseEnter(this)' onmouseexit='this.mgr.typesList.mouseExit(this)'>\
	<caption x='5' y='0' width='160' height='13' style='color: #e9e3d9ff; font-size: -1;' label='" + htmlencode(typeName) + "'/>\
</view>";
						this.setManagerByWidget(list.addRow(i, row));
					}
				}

			 	this.typesList.clickList(false, 0);
			}
			else
			{
				var row = "\
<view id='empty' x='2' width='153' height='13'>\
	<caption x='5' y='0' width='153' height='13' style='color: #e9e3d9ff; font-size: -1;' label='-'/>\
</view>";

				var rowview = list.addRow(null, row);
			}
		}
		
		self.selectType = function()
		{
			this.typesList.clickList(false);
		}
		
		self.showCreator = function()
		{
			//consoleprint("Calling SHOW_CREATOR\n");
			
		 	if(window.showCreateMission && window.showCreateMission())
		 	{
		 		//consoleprint("Call OK with " + game.player.client.canpostmission + "\n");
		 		
		 		if(this.setMapPosition)
		 		{
					//this.map.mgr.setSelection(game.player.client.brigade.home);
					this.setMapPosition = false;
				}
				
				this.panels.value = (game.player.client.canpostmission) ? 1: 2;
			}
			else
			{
				//consoleprint("Call NOK\n");	
				this.panels.value = 0;
			}
		}
		
		self.onSelected = function()
		{
			//this.showCreator();	
		}

		self.drawTypes();

		return self;
	}

	MapMission.MISSION_TYPES 	= new Array();
	MapMission.MISSION_TYPES[0]	= "pa"; // point attack
	MapMission.MISSION_TYPES[1]	= "pd"; // point defense
	MapMission.MISSION_TYPES[2]	= "aa"; // area attack
	MapMission.MISSION_TYPES[3]	= "ad"; // area defense
	MapMission.MISSION_TYPES[4]	= "re"; // recon
	MapMission.MISSION_TYPES[5]	= "rs"; // resupply

	-->
</script>
