		this.nominateOIC = function(brigade)
		{
			var popup = load("nominate");
			popup.initNominatePopup(brigade);
		}
		
		this.joinBrigade = function(brigade)
		{
			//consoleprint("Joining brigade " + brigade + "\n");
			if(game.ingame)
			{
				return;
			}
			
			if(brigade == null)
			{
				return;
			}
			
			var persona = game.player.client.persona;
			
			if(brigade.country.side != persona.country.side)
			{
				return;
			}
			
			if(persona.brigade != null && brigade.id == persona.brigade.id)
			{
				return;
			}
			
			//consoleprint("Passed checks\n");
			
	 	 	var newPersona	= null;
	 	 	var personas 	= game.player.client.personas;

			for(var i = 0; i < personas.length; i++)
			{
			 	var check = personas[i];

			 	if(brigade.country.code == check.country.code && brigade.branch.toUpperCase() == check.branch.toUpperCase())
			 	{
			 		//consoleprint("Found persona: " + check.country.code + "/" + check.branch + "\n");
			 		newPersona = check;
				 	break;
			 	}
			}
			
			if(newPersona == null)
			{
				return;
			}
			
			if(game.player.client.reservedweapon != null)
			{
				game.player.client.cancelweaponreservation();
			}
			
			if(game.player.client.currentmission != null)
			{
				game.player.client.exitmission();
			}
			
			// always at least go back to the brigades screen
			var loadUI = "brigades";
			
			if(newPersona.country.code != persona.country.code || newPersona.branch.toUpperCase() != persona.branch.toUpperCase())
			{
				//consoleprint("Persona needs selecting!\n");
				if(game.player.client.selectpersona(newPersona))
				{
					persona = game.player.client.persona;
				}
			}
			
			if(persona.country.code == brigade.country.code && brigade.branch.toUpperCase() == persona.branch.toUpperCase())
			{
				//consoleprint("Brigade needs selecting!\n");
				if(game.player.client.selectbrigade(brigade))
				{
					//consoleprint("Selected brigade!\n");
					
					if(brigade.home != null)
						this.jumpTo(brigade.home);
					
					this.MapToSync();
					
					loadUI = "brigade";
				}
			}
			
			var currentUI = window;
			
			if(this.isfullmap)
			{
				//consoleprint("This is the fullmap.\n");
				var uis = new Array("brigades", "brigade", "mission");
				
				for(var i = 0; i < uis.length; i++)
				{
					var found = game.findview(uis[i]);
					
					if(found != null)
					{
						currentUI = found;
						break;
					}
				}
				
				// close the fullmap
				window.close();
			}
			
			// we always at least go back to the brigades screen
			currentUI.loadWin(loadUI, true);
			
			//consoleprint("Done!\n");
		}
		
		this.unitName = function(u)
		{
			if(u.activeoic && u.oic != "")
				return htmlencode(u.name) + " (" + htmlencode(u.oic) + ")";
			
			return u.name;	
		}
		
		// callbacks
		this.centerMeCallback;
		
		if(reset)
			game.globals.map = null;
		
		if(game.ingame)
		{
			if(game.scenario)
				this.map.addlayer('<object type="player" size=".1" arrowscale=".02" arrowradius=".1" navring="off"/>');
			else
				this.map.addlayer('<object type="player" size=".1" arrowscale=".02" arrowradius=".1"/>');
		}
		
		this.map.addlayer('<layer type="waypoints" minscale="0" maxscale="20" />');
		
		if(game.online && game.ingame && (player.client.currentmission != null || game.scenario))
			this.map.addlayer('<layer type="players" minscale="0" maxscale="20" />');
		
		MapManager.createActionMenu = function(control, parent, item, event)
		{
		 	var menu = parent.addmenu(control.createMenu(item.label, item.iconL1, item.iconL2, item.iconR1, item.iconR2), item.data);
			
			// set the manager
			menu.mgr = item.mgr;

			// add events
			menu.addevent('onclick', event);
		 	
		 	return menu;
		}
		
		function getCountryFlagIconRound(brigade)
		{
			var country = brigade.country.code;
			var icon = null;
			var index = null;			// Used by uiFlagIconCreate
			
			if(country == "US")			index = 1;
			else if(country == "UK")	index = 0;
			else if(country == "FR")	index = 2;
			else if(country == "DE")	index = 3;
			else						index = 9;
			
			icon = '<view class="flagicon"  x="0" height="15" width="15" index="' + index + '" style="color: #FF0000;" acceptmouseclick="false"/>';
			
			return icon;
		}
		
		function getCountryFlagIcon(brigade)
		{
			var country = brigade.country.code;
			var icon = null;
			var index = null;			// Used by uiFlagIconCreate
			
			if(country == "US")			index = 33;
			else if(country == "UK")	index = 32;
			else if(country == "FR")	index = 34;
			else if(country == "DE")	index = 35;
			else						index = 9;
			
			icon = '<view class="flagicon"  x="0" height="13" width="20" index="' + index + '" style="color: #FF0000;" acceptmouseclick="false"/>';
			
			return icon;
		}
		
		function getCountryName(brigade)
		{
			return brigade.country.code;
		}
		
		function getBrigTypeIcon(brigade)
		{
			var type = brigade.branch;
			var icon = null;	
			var index = null;			// Used by uiCreateContactIcon
			
			cprint("Type: " + type);
			
			if(type == "army")			index = 8;
			else if(type == "airforce")	index = 0;
			else if(type == "navy")		index = 1;
			else						index = 6;
			
			icon = '<view class="contacticon"  x="20" height="15" width="13" index="' + index + '" style="color: #FF0000;" acceptmouseclick="false"/>';
			
			return icon;
		}
		
		function getBrigTypeName(brigade)
		{
			return brigade.branch;
		}
		
		function getBrigadeInfo(brigade)
		{
			// Get necessary info...
			var country = getCountryName(brigade).toLowerCase();
			var branch = getBrigTypeName(brigade);
			
			cprint("<><><><><><><><><><><><><><><><><><><>");
			cprint("Brigade: " + brigade);
			cprint("Country: " + country);
			cprint("Branch: " + branch);
			cprint("<><><><><><><><><><><><><><><><><><><>");
			
			// Build localization string
			var loc = "common.countries." + country + '.' + branch;
			
			return getlocstring(loc);
		}
	}
	
	-->
</script>

