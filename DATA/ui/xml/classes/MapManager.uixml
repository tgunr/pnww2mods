<?xml version="1.0"?>
<script>
	
	<include file="classes/MapControl.uixml"/>
	<include file="classes/MapInfo.uixml"/>
	<include file="classes/MapFinder.uixml"/>
	<include file="classes/MapOptions.uixml"/>
	<include file="classes/MapLegend.uixml"/>
	<include file="classes/MapWaypoints.uixml"/>
	<include file="classes/MapMission.uixml"/>
	<include file="classes/MapDetails.uixml"/>
	<include file="classes/MapSizer.uixml"/>
	<include file="classes/MapCenterMe.uixml"/>
	<include file="classes/MapRadar.uixml"/>
	<include file="classes/MapCP.uixml"/>
	
	<!--
	
	function MapInit(frame, mapname, mapcp, isfullmap)
	{
	 	//game.consoleclear();

		var map = frame.findview(mapname);
		
		if(!map.mgr)
		{
			var mapManager 	= new MapManager(map, false, isfullmap);
			var cpManager 	= new MapCP(frame.findview(mapcp), map.id);
			
			//consoleprint("Init map options from MapInit\n");
			var opManager	= new MapOptions(frame.findview("map-options"));
		}
	}

	function MapManager(map, reset, isfullmap)
	{
		// members
		this.map 			= map;
		this.map.mgr		= this;
		this.inited			= false;
		this.centerme 		= true; //game.getpref("ui.map.centerme", 0, true);
		this.autopan		= true; //game.getpref("ui.map.autopan", 0, true);
		this.mousein		= false;
		this.pending		= null;
		this.selection		= null;
		this.clickposition	= null;
		this.isfullmap		= isfullmap;
		this.isHCMap		= false;
		this.now				= (new Date()).getTime();
		
		this.hooks			= new Object();
		this.extHooks		= new Object();
		this.overrides		= new Object();

		this.initMap = function()
		{
			if(this.inited == false)
			{
			 	consoleprint("Initing map(" + this.isfullmap + ")\n");

				this.runExtHooks('onInit');

				var client = game.player.client;
				
				/*
				if(game.ingame)
				{
					this.centerme = game.getpref("ui.map.centerme", 0, true);
				}
				*/
				/*
				else
				{
					if(client.currentmission != null)
					{
					 	consoleprint("Initing map with mission target.\n");
						this.setSelection(client.currentmission.origin, false, false);
					}
					else if(client.brigade.home != null)
					{
					 	consoleprint("Initing map with brigade home.\n");
						this.setSelection(client.brigade.home, false, false);
					}
				}
				*/

				if(game.globals.map == null)
					this.MapToSync();
				
				this.inited = true;
			}
			
			this.map.enablelayer("aws", game.getpref(MapRadar.PREF_NAME, 0, false));
			this.centerme 	= game.getpref(MapCenterMe.PREF_NAME, 0, true);
			this.autopan 	= game.getpref("ui.map.autopan", 0, true);
		}
		
		// methods
		this.addHook = function(name, callback)
		{
			this.hooks[name] = callback;
		}

		this.addOverride = function(name, callback)
		{
			this.overrides[name] = callback;
		}

		this.addExtHook = function(name, callback)
		{
			if(this.extHooks[name] == null)
				this.extHooks[name] = new Array();
			
			this.extHooks[name].push(callback);
		}
		
		this.setPosition = function(position, pan, scale)
		{
			this.setCenterMe(false);
			
			if(this.autopan && (pan == null || pan))
			{
				this.map.panto(position.x, position.y, (scale != null) ? scale: this.map.scale);
			}
			else
			{
				this.map.position = position;
				
				if(!isNaN(scale) && scale != this.map.scale)
					this.map.scale = scale;
			}
		}
		
		this.jumpTo = function(stratObject)
		{
			if(stratObject != null)
			{
				if(!this.selection || this.selection.name != stratObject.name)
				{
					this.pending = stratObject;
					this.updatePending();
				}

				this.setPosition(stratObject.position, false);
			}
		}

		this.setSelection = function(stratObject, nocenter, pan, sync)
		{
		 	consoleprint("MAP SELECTION!\n");

		 	if(sync == null || sync)
		 		this.map.mgr.SyncToMap();
			
			if(stratObject != null)
			{
			 	consoleprint("SELECTING: " + stratObject.name + "\n");

				if(!this.selection || this.selection.name != stratObject.name)
				{
					this.pending = stratObject;
					this.updatePending();
				}

				if(nocenter == null || !nocenter)
					this.setPosition(stratObject.position, pan);
			}
		}

		this.updatePending = function()
		{
			if(this.pending != null)
			{
				var cpObject 	= (this.pending.stratclass != "cp") ? this.pending.parent: this.pending;
				var mapObject 	= this.map.findcpobject(cpObject);
				
				if(mapObject != null)
				{
					this.map.sethclinks(cpObject);
					this.map.selectedobject = mapObject;
					this.selection 			= this.pending;
					this.pending 			= null;
					this.runExtHooks('onCPSelected');
				}
			}
		}
		
		// only called for the normal map by the UI
		this.onActivate = function()
		{
		 	consoleprint("onActivate called\n");
		}

		// only called for the normal map by the UI
		this.onDeactivate = function()
		{
		 	consoleprint("onDeactivate called\n");
		}

		this.onShow = function()
		{
			var onShow = this.hooks.onShow;
			
			if(!onShow || onShow(this))
			{
			 	consoleprint("MAP SHOW!\n");
			 	
			 	this.SyncToMap()
				this.initMap();
				this.runExtHooks('onShow');
			}
		}

		this.onDrag = function()
		{
			var onDrag = this.hooks.onDrag;
			
			if(!onDrag || onDrag(this))
			{
				this.setCenterMe(false);
				this.runExtHooks('onDrag');
			}
		}

		this.onUpdate = function()
		{
			var onUpdate = this.hooks.onUpdate;

			if(!onUpdate || onUpdate(this))
			{
				if(this.centerme && game.ingame)
					this.map.position = player.position;
				
				this.updatePending();
				this.runExtHooks('onUpdate');

				if(this.inited)
					this.MapToSync();
			}
		}
		
		this.onClick = function()
		{
			var now = (new Date()).getTime();
			
			// don't allow any clicks within 1 second of the creation of this object
			if(now < this.now + 1000)
				return;
			
		 	var rcmenu		= findview("map_rcmenu");
			var onClick 	= this.hooks.onClick;
			
			if(rcmenu != null)
				rcmenu.close();
			
			if(!onClick || onClick(this))
			{
				var map = this.map;
				
				if(map.objectclicked)
				{
					var stratObject = (map.selectedobject != null) ? map.selectedobject.stratobject: null;
					
					if(stratObject != null)
					{
						this.pending 	= null;
						this.selection 	= stratObject;
						this.runExtHooks('onCPSelected');
						this.map.sethclinks((stratObject.stratclass != "cp") ? stratObject.parent: stratObject);
					}
				}
				
				this.runExtHooks('onClick');
			}
			
			this.clickposition = this.map.mouseposition;
		}
		
		this.onRightClick = function(mapobj)
		{
		 	consoleclear();
		 	consoleprint("Doing map right click...\n");

		 	if(this.overrides.onRightClick != null)
		 	{
			 	this.overrides.onRightClick(mapobj);
			 	this.runExtHooks('onRightClick');
		 	}
		 	else
			{
			 	//consoleprint("Creating right click menu...\n");

			 	var mapObjects 	= this.map.findmapobjects(this.map.mx, this.map.my);
			 	
			 	//consoleprint("Found " + mapObjects + "\n");
				
				var mission		= player.client.currentmission;
			 	var persona 	= game.player.client.persona;
			 	var brigade 	= persona.brigade;
			 	var isleader	= (game.online == 1 && mission != null && mission.amleader) ? true: false;
			 	var onmission	= (game.online == 1 && mission != null) ? true: false;
			 	var targetCP	= null;
			 	var isHC		= player.client.ishc;
				var isOIC		= player.client.isoic;

			 	//consoleprint("Mission inits done\n");

			 	var stratList 		= new Array();
			 	var bridgeList		= new Array();
			 	var brigadesList  	= new Array();
			 	var waypointsList	= new Array();
			 	var contactsList	= new Array();
			 	var approveList		= new Array();
			 	var playerList		= new Array();

				//consoleprint("Setting up map objects...\n");
				
				if(mapObjects != null && mapObjects.length > 0)
				{
				 	for(var i = 0; i < mapObjects.length; i++)
				 	{
				 	 	var mapObject = mapObjects[i];
	
					 	if(mapObject.objecttype == "strat")
					 	{
					 	 	//consoleprint("Found strat map object...\n");

						 	stratList.push(mapObject);

						 	if(mapObject.stratobject.stratclass == "cp")
					 		{
					 		 	//consoleprint("Checking for brigade map objects...\n");

					 		 	var brigades = mapObject.stratobject.brigades;

					 		 	for(var b = 0; b < brigades.length; b++)
					 		 		brigadesList.push(brigades[b]);
					 		 	
					 		 	if(mapObject.stratobject.strattype != "bridge")
					 		 		targetCP = mapObject;
					 		 	else
					 		 		bridgeList.push(mapObject);
					 		}
					 	}
					 	else if(mapObject.objecttype == "waypoint")
					 	{
					 	 	//consoleprint("Found wp map object...\n");

							if(mapObject.shared && mapObject.local)
							{
								approveList.push(mapObject);
							}
							else
							{
							 	if(mapObject.type == 3) // contact report
									contactsList.push(mapObject);
								else
									waypointsList.push(mapObject);
							}
					 	}
					 	else if(mapObject.objecttype == "vehicle")
					 	{
					 	 	//consoleprint("Found player map object...\n");
						 	playerList.push(mapObject);
					 	}
					}
				}

			 	//consoleprint("Adding menu items...\n");

				// create the menu
				var root = new MenuItem("ROOT");
				
				//consoleprint("Root menu created...\n");

				// do we have selection options?
				if(stratList.length > 0)
				{
				 	//consoleprint("Adding strat menu items...\n");

				 	var stratMenu = root.addItem(new MenuItem(getlocstring("widgets.map.context.selection") + " >"));

			   		for(var s = 0; s < stratList.length; s++)
						stratMenu.addItem(new MenuItem(stratList[s].stratobject.name, stratList[s], this, this.createStratMenu));
				}

				// do we have brigade options?
				if(game.online == 1 && !game.ingame && brigadesList.length > 0 && !this.isHCMap)
				{
				 	//consoleprint("Adding brigade menu items...\n");

				 	var brigadesMenu = null;

			   		for(var s = 0; s < brigadesList.length; s++)
			   		{
			   			if(brigadesList[s].country.side == persona.country.side)
			   			{
			   				if(brigadesList[s].isbrigade && (brigade == null || brigadesList[s].id != brigade.id))
			   				{
					   			if(brigadesMenu == null)
					   				brigadesMenu = root.addItem(new MenuItem(getlocstring("widgets.map.context.brigade.join") + " >"));
					   			
								var toPersona = game.player.client.getpersona(brigadesList[s].country.id, brigadesList[s].branchid);
								
								if(toPersona != null && game.player.client.state.paccess(toPersona))
								{	

									var countryFlagIcon = getCountryFlagIcon(brigadesList[s]);
									var brigadeTypeIcon = getBrigTypeIcon(brigadesList[s]);
									var brigInfo = getBrigadeInfo(brigadesList[s]);
									
									var label = '[' + brigInfo + '] ' + this.unitName(brigadesList[s]);
									cprint(" &&& label: " + label);
									
									var mItem = new MenuItem(label, brigadesList[s], this, this.createBrigadeMenu);
									cprint("MenuItem: " + mItem);
									brigadesMenu.addItem(mItem);
								}
							}
						}
					}
					if(brigadesMenu != null) cprint("brigadesMenu size is " + brigadesMenu.items.length);
				}
				
				if(game.online == 1)
				{
				 	//consoleprint("Were online...\n");
				 	//var waypointsMenu = root.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints") + " >"));
					
					if(waypointsList.length > 0 || contactsList.length > 0)
					{
					 	//consoleprint("Adding activate menu items...\n");
					 	var activeMenu = root.addItem(new MenuItem(getlocstring("widgets.map.context.activate") + " >"));

				   		for(var s = 0; s < waypointsList.length; s++)
							activeMenu.addItem(new MenuItem(waypointsList[s].displayname, waypointsList[s], this, this.createActivateMenu));

				   		for(var s = 0; s < contactsList.length; s++)
							activeMenu.addItem(new MenuItem(contactsList[s].name, contactsList[s], this, this.createActivateMenu));
					}
					
				 	if(isleader)
				 	{
				 	 	var wpAddMenu = root.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.add.waypoint"), "rally", this, this.createWaypointMenu));

					 	//wpAddMenu.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.add.waypoint.rally"), "rally", this, this.createWaypointMenu));
					 	//wpAddMenu.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.add.waypoint.attack"), "attack", this, this.createWaypointMenu));
				 	}
				 	
				 	if(game.ingame)
				 	{
				 		var crAddMenu = root.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.add.report"), "troop", this, this.createContactMenu));
					 	//var addMenu = waypointsMenu.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.add") + " >"));
						
						/*
				 	 	var crAddMenu = addMenu.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.add.report") + " >"));

					 	crAddMenu.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.add.report.infantry"), "troop", this, this.createContactMenu));
					 	crAddMenu.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.add.report.armor"), "land", this, this.createContactMenu));
					 	crAddMenu.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.add.report.air"), "air", this, this.createContactMenu));
					 	crAddMenu.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.add.report.sea"), "sea", this, this.createContactMenu));
					 	crAddMenu.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.add.report.gun"), "gun", this, this.createContactMenu));
					 	crAddMenu.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.add.report.truck"), "truck", this, this.createContactMenu));
					 	crAddMenu.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.add.report.danger"), "danger", this, this.createContactMenu));
					 	crAddMenu.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.add.report.unknown"), "unknown", this, this.createContactMenu));
						*/
					}
					
					if(isleader)
					{
					 	//consoleprint("Were a leader...\n");

					 	/*
					 	if(approveList.length > 0)
					 	{
					 	 	//consoleprint("Adding approve menu items...\n");

						 	var approveMenu = root.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.approve") + " >"));
							
							approveMenu.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.approve.all"), "all", this, this.createApproveAllMenu));
							
					   		for(var s = 0; s < approveList.length; s++)
								approveMenu.addItem(new MenuItem(approveList[s].displayname, approveList[s], this, this.createApproveMenu));
						}
						*/

						if(waypointsList.length > 0 || contactsList.length > 0)
						{
						 	//consoleprint("Adding delete menu items...\n");

						 	var deleteMenu = root.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.delete") + " >"));
						 	
						 	if(contactsList.length > 0)
						 		deleteMenu.addItem(new MenuItem(getlocstring("widgets.map.context.contacts.delete.all"), "allcontacts", this, this.createDeleteAllMenu));
						 		
						 	if(waypointsList.length > 0)
						 		deleteMenu.addItem(new MenuItem(getlocstring("widgets.map.context.waypoints.delete.all"), "allwaypoints", this, this.createDeleteAllMenu));
							
					   		for(var s = 0; s < waypointsList.length; s++)
								deleteMenu.addItem(new MenuItem(waypointsList[s].displayname, waypointsList[s], this, this.createDeleteMenu));

					   		for(var s = 0; s < contactsList.length; s++)
								deleteMenu.addItem(new MenuItem(contactsList[s].name, contactsList[s], this, this.createDeleteMenu));
						}
			 		}

			 		if(playerList.length > 0)
			 		{
			 		 	//consoleprint("Adding player menu items...\n");

					 	var playerMenu = root.addItem(new MenuItem(getlocstring("widgets.map.context.chat") + " >"));

				   		for(var s = 0; s < playerList.length; s++)
							playerMenu.addItem(new MenuItem(playerList[s].callsign, playerList[s], this, this.createPlayerMenu));
			 		}
				}
				
				// Map Positioning
				var positionMenu = new MenuItem(getlocstring("widgets.map.context.position") + " >");
				
				// center on me
				if(game.ingame)
					positionMenu.addItem(new MenuItem(getlocstring("widgets.map.context.position.me"), null, this, this.createPositionMEMenu));
				
				if(brigade != null)
				{
					if(brigade.home != null)
						positionMenu.addItem(new MenuItem(getlocstring("widgets.map.context.position.brigade"), brigade.home, this, this.createPositionCPMenu));
					
					if(brigade.parent != null && brigade.parent.home != null)
						positionMenu.addItem(new MenuItem(getlocstring("widgets.map.context.position.division"), brigade.parent.home, this, this.createPositionCPMenu));
				}
				
				if(mission != null)
				{
					positionMenu.addItem(new MenuItem(getlocstring("widgets.map.context.position.origin"), mission.origin, this, this.createPositionCPMenu));
					positionMenu.addItem(new MenuItem(getlocstring("widgets.map.context.position.target"), mission.target, this, this.createPositionCPMenu));
				}
				
				if(positionMenu.items != null)
					root.addItem(positionMenu);
				
				// do we have hc options?
				if(game.online == 1 && (isHC || isOIC))
				{
					//consoleprint("Adding hc options items...\n");
					
					var hcMenu 		= root.addItem(new MenuItem(getlocstring("widgets.map.context.hc") + " >"));
					var oicBrigade 	= player.client.oicof;
					
					// can we nominate, volunteerreplace or remove from any of these brigades?
					//consoleprint("Adding hc menu items...\n");
					
					var hcBrigadesMenu 		= new MenuItem(getlocstring("widgets.map.context.hc.brigades") + " >");
					var hcObjectivesMenu 	= new MenuItem(getlocstring("widgets.map.context.hc.objectives") + " >");
					var hcMoveMenu 			= new MenuItem(getlocstring("widgets.map.context.hc.move") + " >");
					
					for(var s = 0; s < brigadesList.length; s++)
					{
						var currentBrigade = brigadesList[s];
						
						if(currentBrigade.country.side == persona.country.side)
						{
							//consoleprint("Found " + currentBrigade.name + " ...\n");
							
							var hcBrigadeMenu = null;
							
							if(isHC)
							{
								hcBrigadeMenu = new MenuItem(this.unitName(currentBrigade) + " >");
								
								if(!currentBrigade.activeoic && currentBrigade.isbrigade)
								{
									//consoleprint("Adding no oic options menu items...\n");
									hcBrigadeMenu.addItem(new MenuItem(getlocstring("widgets.map.context.hc.nominate") + " ...", currentBrigade, this, this.createNominateMenu));
								}
								else if(currentBrigade.activeoic && (oicBrigade == null || oicBrigade.id != currentBrigade.id))
								{
									//consoleprint("Adding oic options menu items...\n");
									hcBrigadeMenu.addItem(new MenuItem(getlocstring("widgets.map.context.hc.remove"), currentBrigade, this, this.createRemoveMenu));
								}
								
								if(oicBrigade != null && oicBrigade.id == currentBrigade.id)
									hcBrigadeMenu.addItem(new MenuItem(getlocstring("widgets.map.context.hc.resign"), currentBrigade, this, this.createResignMenu));
								else if(brigade != null && currentBrigade.id == brigade.id)
									hcBrigadeMenu.addItem(new MenuItem(getlocstring("widgets.map.context.hc.takecharge"), currentBrigade, this, this.createTakeChargeMenu));
							}
							else if(isOIC && oicBrigade != null && oicBrigade.id == currentBrigade.id)
							{
								hcBrigadeMenu = new MenuItem(this.unitName(currentBrigade) + " >");
								hcBrigadeMenu.addItem(new MenuItem(getlocstring("widgets.map.context.hc.resign"), currentBrigade, this, this.createResignMenu));
							}
							
							if(hcBrigadeMenu != null)
								hcBrigadesMenu.addItem(hcBrigadeMenu);
						}
					}
					
					if(targetCP != null)
					{
						var hcObjMenu 	= new MenuItem(targetCP.stratobject.name + " >");	
						var originCP	= this.map.selectedobject;
						
						if(targetCP.stratobject.canattack)
							hcObjMenu.addItem(new MenuItem(getlocstring("widgets.map.context.hc.attack"), targetCP.stratobject, this, this.createAttackMenu));
						if(targetCP.stratobject.candefend)
							hcObjMenu.addItem(new MenuItem(getlocstring("widgets.map.context.hc.defend"), targetCP.stratobject, this, this.createDefendMenu));
						if(targetCP.stratobject.canclear)
							hcObjMenu.addItem(new MenuItem(getlocstring("widgets.map.context.hc.clear"), targetCP.stratobject, this, this.createClearMenu));
						
						if(hcObjMenu.items != null)
							hcObjectivesMenu.addItem(hcObjMenu);
						
						if(originCP != null &&
						   originCP.stratobject != null &&
						   originCP.stratobject.stratclass == "cp" &&
						   originCP.stratobject.strattype != "bridge" &&
						   originCP.stratobject.name != targetCP.stratobject.name &&
						   targetCP.stratobject.country.side == originCP.stratobject.country.side)
						{
							var originBrigades = originCP.stratobject.brigades;
							
							for(var s = 0; s < originBrigades.length; s++)
							{	
								var originBrigade = originBrigades[s];
								
								if(originBrigade.country.side != persona.country.side)
									continue;
								
								// why did I put this true in here? testing?
								if(true || (!originBrigade.activeoic && isHC) || (oicBrigade != null && oicBrigade.id == originBrigade.id))
								{
									//consoleprint("Adding move options menu items...\n");
									
									var move = new Object();
									
									move["brigade"] = originBrigade;
									move["origin"] = originCP.stratobject;
									move["target"] = targetCP.stratobject;
									
									hcMoveMenu.addItem(new MenuItem(this.unitName(originBrigade), move, this, this.createMoveMenu));
								}
							}
						}
					}
					
					for(var i = 0; i < bridgeList.length; i++)
					{
						var bridge 		= bridgeList[i];
						var hcObjMenu 	= new MenuItem(bridge.stratobject.name + " >");	
						
						if(bridge.stratobject.canattack)
							hcObjMenu.addItem(new MenuItem(getlocstring("widgets.map.context.hc.attack"), bridge.stratobject, this, this.createAttackMenu));
						if(bridge.stratobject.candefend)
							hcObjMenu.addItem(new MenuItem(getlocstring("widgets.map.context.hc.defend"), bridge.stratobject, this, this.createDefendMenu));
						if(bridge.stratobject.canclear)
							hcObjMenu.addItem(new MenuItem(getlocstring("widgets.map.context.hc.clear"), bridge.stratobject, this, this.createClearMenu));
						
						if(hcObjMenu.items != null)
							hcObjectivesMenu.addItem(hcObjMenu);
					}
					
					if(hcMoveMenu.items != null)
						hcBrigadesMenu.addItem(hcMoveMenu);
					
					if(hcBrigadesMenu.items != null)
						hcMenu.addItem(hcBrigadesMenu);
					
					if(hcObjectivesMenu.items != null)
						hcMenu.addItem(hcObjectivesMenu);
					
					if(hcMenu.items == null)
						hcMenu.addItem(new MenuItem(getlocstring("widgets.map.context.hc.na")));
				}
				
				new MenuControl("map_rcmenu", cursor.x, window.height - cursor.y, 160, 15, 90, -10, root.items, this.clickMenu);

				this.runExtHooks('onRightClick');
			}
		}

		this.clickMenu = function(item, dblclick)
		{
		 	consoleprint("Clicked menu with data: " + item.selecteddata + "\n");
		}

		this.onDblClick = function()
		{
			var onDblClick = this.hooks.onDblClick;
			
			if(!onDblClick || onDblClick(this))
			{
				if(this.autopan)
				{
					var pos = (this.clickposition) ? this.clickposition: this.map.mouseposition;
					this.map.panto(pos.x, pos.y, this.map.scale);
				}
				else
				{
					this.map.position = (this.clickposition) ? this.clickposition: this.map.mouseposition;
				}
				
				this.setCenterMe(false);
				this.runExtHooks('onDblClick');
			}
		}

		this.onMouseEnter = function()
		{
			var onMouseEnter = this.hooks.onMouseEnter;
			
			if(!onMouseEnter || onMouseEnter(this))
				this.mousein = true;
		}
		
		this.onMouseExit = function()
		{
			var onMouseExit = this.hooks.onMouseExit;
			
			if(!onMouseExit || onMouseExit(this))
				this.mousein = false;
		}
		
		this.getLatLon = function(pos)
		{
			var lat 	= Math.abs(pos.lat);
			var latdeg 	= Math.floor(lat);
			var latmin 	= Math.floor((lat - latdeg) * 60);
			var latsec 	= Math.floor((lat - (latdeg + latmin / 60.0)) * 3600);
			
			var lon 	= Math.abs(pos.lon);
			var londeg 	= Math.floor(lon);
			var lonmin 	= Math.floor((lon - londeg) * 60);
			var lonsec 	= Math.floor((lon - (londeg + lonmin / 60.0)) * 3600);
			
			return latdeg + "." + latmin + "." + latsec + ((pos.lat > 0) ? "N":"S") + " " +
				   londeg + "." + lonmin + "." + lonsec + ((pos.lon > 0) ? "E":"W");
		}
		
		this.canAddWaypoint = function()
		{
			if(game.online)
			{
				var client = player.client;
				
				if(client.canaddwaypoint())
					return true;
			}
			
			showOk(getlocstring('waypoints.limited'));
			
			return false;
		}
		
		this.canAddReport = function()
		{
			if(game.online && game.ingame)
			{
				var client = player.client;
				
				if(client.canaddreport())
					return true;
				else
					showOk(getlocstring('waypoints.limited'));
			}
			else
			{
				showOk(getlocstring('waypoints.restricted'));
			}
			
			return false;
		}
		
		this.setCenterMe = function(flag)
		{
			//printJSStack("CENTERING: " + flag);
		 	//consoleprint("CENTERING: " + flag + "\n");

			var onCenter = this.hooks.onCenter;

			if(!onCenter || onCenter(this))
			{
				if(flag && this.centerme != flag)
					game.tutorialevent(4194304, 1);
				
				this.centerme = flag;

				if(this.centerMeCallback)
					this.centerMeCallback(flag);

				this.runExtHooks('onCenter');
			}
		}
		
		this.openFullMap = function()
		{
			var fullMap = game.load("fullmap");

			if(fullMap)
			{
				fullMap.setOpener(this);
				fullMap.showCreateMission = window.showCreateMission;
			}
		}
		
		this.MapToSync = function()
		{
			//consoleprint("MAP TO SYNC!!!\n");
			
			var map = this.map;

			if(!game.globals.map)
				game.globals.map = new Object();
			
			game.globals.map["x"]			= map.position.x;
			game.globals.map["y"]			= map.position.y;
			game.globals.map["scale"]		= map.scale;
			game.globals.map["selection"]	= this.selection;
		}
		
		this.SyncToMap = function()
		{
			var sync	= game.globals.map;
			var synced 	= false;
			
			if(sync)
			{
	 		 	consoleprint("SYNC TO MAP!!!\n");

				if(sync.selection != null)
				{
					this.setSelection(sync.selection, false, false, false);
					synced = true;
				}
				
				if(sync.scale != null)
				{
					this.map.scale = sync.scale;
					synced = true;
				}
				
				if(sync.x != null)
				{
					this.map.position.x = sync.x;
					synced = true;
				}
				
				if(sync.y != null)
				{
					this.map.position.y = sync.y;
					synced = true;
				}
			}
			
			return synced;
		}
		
		this.runExtHooks = function(event)
		{
			var hooks = this.extHooks[event];
			
			if(hooks)
			{
				for(var h = 0; h < hooks.length; h++)
					hooks[h][event](this);
			}
		}
		
		// MENU FUNCTIONS
				
		this.createStratMenu = function(control, parent, item)
		{
			return MapManager.createActionMenu(control, parent, item, 'this.mgr.setSelection(this.selecteddata.stratobject)');
		}

