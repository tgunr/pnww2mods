<?xml version="1.0"?>
<script>
	<!--
	
	function MapOptions(widget)
	{
		game.consoleprint("INIT MAP OPTIONS\n");
		
		// base class
		var self = new MapControl(widget);
		
		self.centerMeWidget = self.widget.findview("centerMe.centerme");
		self.lastScaler 	= null;
		self.lastScale	= 0;
		self.initialized	= false;

  		self.setManager('mapDefaults.setDefaults')

		// methods
		self.init = function()
		{
			game.consoleprint("FILTERS INIT\n");
			//game.restoresettings(this.widget);
			
			var options = MapOptions.OPTIONS;
			
			for(var i = 0; i < options.length; i++)
			{
				//game.consoleprint("Initing control " + options[i] + "\n");

				var control = this.setManager(options[i]);
				
				if(control)
				{
					if(control.id == "centerMe.centerme")
					{
						control.checked = game.getpref(MapOptions.CENTERME_NAME, 0, true);
					}
					else if(control.id == "autoPan.autopan")
					{
						control.checked = game.getpref(MapOptions.AUTOPAN_NAME, 0, true);
					}
					else
					{
						//game.consoleprint("Found control\n");
						
						var parts = options[i].split(".");
						
						if(parts[0] == "mapFilter")
						{
							control.checked = game.getpref(control.id, 0, true);
							this.stratFilter(control.checked, parts[1], true);
							
							/*
							var initScript = "this." + parts[0] + "(control.checked, '" + parts[1] + "', true)";
							game.consoleprint("Init map with " + initScript + "\n");
							eval(initScript);
							*/
						}
					}
				}
			}
			
			this.map.mgr.addExtHook("onUpdate", this);
			this.map.mgr.addExtHook("onCenter", this);
			this.map.mgr.addExtHook("onShow", this);
			
			this.onCenter();
			
			this.initialized = true;
		}
		
		self.stratFilter = function(flag, filter, nosound)
		{
			if(this.map)
				this.map.stratfilter(filter, flag);
				
			if(this.initialized)
			{
				game.setpref("mapFilter." + filter, 0, flag);
				game.savesettings();
			}
			
			if(!nosound)
				soundPlayClick();
			
			return flag;
		}

		self.centerMe = function(flag, option, nosound) // outgoing centerme
		{
			game.setpref(MapOptions.CENTERME_NAME, 0, flag);
			
			var map = this.map;

			if(map)
				map.mgr.setCenterMe(flag);

			if(!nosound)
				soundPlayClick();

			return flag;
		}

		self.autoPan = function(flag, option, nosound)
		{
			game.setpref(MapOptions.AUTOPAN_NAME, 0, flag);
			
			var map = this.map;

			if(map)
			{
				if(flag != null)
					map.mgr.autopan = flag;
				else
					flag = map.mgr.autopan;
			}

			if(!nosound)
				soundPlayClick();

			return flag;
		}
		
		self.scaleMap = function(control, scale, nosound)
		{
			if(this.lastScaler != null && this.lastScaler.id != control.id)
				this.lastScaler.checked = false;
			
			this.lastScaler			= control; 
			this.lastScaler.checked = true;
			this.lastScale			= scale;
			
			if(this.map)
				this.map.scale = scale;
			
			if(!nosound)
				soundPlayClick();
		}
		
		self.scaleMapInc = function(control, up, nosound)
		{
			var map = this.map;
			
			if(map)
			{
				var mapScaleMin	= MapOptions.ZOOM_LEVELS[0];
				var mapScaleMax	= MapOptions.ZOOM_LEVELS[4];
				var mapScale	= map.scale;
				var jump 		= mapScale * .4;
				
				if(!up)
					jump *= -1;
				
				mapScale += jump;
				
				if(mapScale < mapScaleMin)
					mapScale = mapScaleMin;
				
				if(mapScale > mapScaleMax)
					mapScale = mapScaleMax;
				
				map.scale = mapScale;
			}
			
			if(!nosound)
				soundPlayClick();
		}
		
		self.mapDefaults = function()
		{
			var map = this.map;
			
			if(map)
			{
				var widget = this.widget;
				
				if(widget)
				{
					widget.findview("centerMe.centerme").checked 			= this.centerMe(true);
					widget.findview("autoPan.autopan").checked 				= this.autoPan(true);
					//widget.findview("mapFilter.showclutter").checked 	= !this.stratFilter(false, 'showclutter', true);
					widget.findview("mapFilter.showcps").checked 			= this.stratFilter(false, 'showcps', true);
					widget.findview("mapFilter.showairfields").checked 	= this.stratFilter(false, 'showairfields', true);
					widget.findview("mapFilter.showports").checked 		= this.stratFilter(false, 'showports', true);
					widget.findview("mapFilter.showbridges").checked 		= this.stratFilter(false, 'showbridges', true);
					widget.findview("mapFilter.showews").checked 			= this.stratFilter(true, 'showews', true);
					widget.findview("mapFilter.showobjectives").checked 	= this.stratFilter(true, 'showobjectives', true);
					widget.findview("mapFilter.showbrigades").checked 	= this.stratFilter(true, 'showbrigades', true);
					widget.findview("mapFilter.showmydivision").checked 	= this.stratFilter(true, 'showmydivision', true);
					widget.findview("mapFilter.showdeployments").checked 	= this.stratFilter(false, 'showdeployments', true);
				}
			}
		}
		
		self.onShow = function(mgr)
		{
			this.onCenter();
		}
		
		self.onUpdate = function(mgr)
		{
			var map		= this.map;
			var scale 	= this.map.scale;
			
			if(map != null && this.lastScale != scale)
			{
				for(var i = 0; i < 5; i++)
				{
					var level = MapOptions.ZOOM_LEVELS[i];
					
					if(scale <= level)
					{
						this.scaleMap(this.widget.findview("scaleMap." + i), scale, true);
						break;
					}
				}
			}
		}

		self.onCenter = function(mgr) // make sure we are synced with prefs
		{
			this.centerMeWidget.checked = game.getpref(MapOptions.CENTERME_NAME, 0, true);
		}

		self.init();

		return self;
	}

	MapOptions.OPTIONS 			= new Array();
	MapOptions.OPTIONS[0] 		= "mapFilter.showcps";
	MapOptions.OPTIONS[1] 		= "mapFilter.showbridges";
	MapOptions.OPTIONS[2] 		= "mapFilter.showews";
	MapOptions.OPTIONS[3] 		= "mapFilter.showairfields";
	MapOptions.OPTIONS[4] 		= "mapFilter.showports";
	MapOptions.OPTIONS[5] 		= "mapFilter.showobjectives";
	MapOptions.OPTIONS[6] 		= "mapFilter.showbrigades";
	MapOptions.OPTIONS[7] 		= "mapFilter.showdeployments";
	MapOptions.OPTIONS[8] 		= "mapFilter.showclutter";
	MapOptions.OPTIONS[9] 		= "mapFilter.showmydivision";
	MapOptions.OPTIONS[10]		= "centerMe.centerme";
	MapOptions.OPTIONS[11]		= "scaleMap.4";
	MapOptions.OPTIONS[12]		= "scaleMap.3";
	MapOptions.OPTIONS[13]		= "scaleMap.2";
	MapOptions.OPTIONS[14]		= "scaleMap.1";
	MapOptions.OPTIONS[15]		= "scaleMap.0";
	MapOptions.OPTIONS[16]		= "scaleMapInc.scaleup";
	MapOptions.OPTIONS[17]		= "scaleMapInc.scaledown";
	MapOptions.OPTIONS[18]		= "autoPan.autopan";

	MapOptions.ZOOM_LEVELS		= new Array();
	MapOptions.ZOOM_LEVELS[0]	= .0625; 	// tactical
	MapOptions.ZOOM_LEVELS[1]	= .25;		// facilities
	MapOptions.ZOOM_LEVELS[2]	= .75;		// city
	MapOptions.ZOOM_LEVELS[3]	= 2;		// regional
	MapOptions.ZOOM_LEVELS[4]	= 7.5;		//sector
	
	MapOptions.CENTERME_NAME	= "ui.map.centerme";
	MapOptions.AUTOPAN_NAME		= "ui.map.autopan";

	-->
</script>
