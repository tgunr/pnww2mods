<?xml version="1.0"?>
 
<window id="nominate" x="0" y="0" width="1024" height="768"  viewportwidth="1024" viewportheight="768"
	style="background-color: #00000077;" layer="100">
	<include file="lib/popup.uixml"/>
	<view x="350" y="400" width="350" height="140" style="background-color: #00000088; 
							border-sides: ui/textures/hud/border_side.bmp;
							border-corner: ui/textures/hud/border_corner.bmp;
							border-width: 4;
							border-height: 4;" moveondrag="yes">
		<text id="popup-caption" x="10" height="50" width="330" rtop="20" acceptfocus="no" style=" color: #FFFFFF;"/>
		<caption label="${common.nominateoic.enter}" x="10" height="15" width="150" rtop="70" acceptfocus="no" style=" color: #FFFFFF;" align="right"/>
		<textcontrol id="nominate-player" x="180" height="15" width="100" rtop="70" acceptsfocus="true" maxlength="40" style="color: #BFE2CE; background-color: #FFFFFF44;"/>
		<button id="nominate-no" x="20" y="10" width="150" height="25" label="${popup.cancel}" onclick="doNominateAction(false)"
			style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
			onmouseenter="if(this.enabled) this.setstyleproperty('color', '#FFFF00')" onmouseexit="this.setstyleproperty('color', '#FFFFFF')"/>
		<button id="nominate-yes" x="180" y="10" width="150" height="25" label="${popup.ok}" onclick="doNominateAction(true)"
			style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
			onmouseenter="if(this.enabled) this.setstyleproperty('color', '#FFFF00')" onmouseexit="this.setstyleproperty('color', '#FFFFFF')"/>
	</view>
	<script>
		<!--
		
		var brigade = null;
		
		function initNominatePopup(b)
		{
			consoleprint("Initing Nominate Popup\n");
			
			brigade = b;
			setPopupMessage(getVariableLocString("common.nominateoic", brigade.name));
			window.findview("nominate-player").focused = true;
			
			consoleprint("Completed Nominate Popup\n");
		}
		
		function doNominateAction(confirm)
		{
			soundPlayClick();
			
			if(confirm && brigade != null)
				brigade.nominate(window.findview("nominate-player").text);
			
			window.close();
		}
		
		// -->
	</script>
</window>
