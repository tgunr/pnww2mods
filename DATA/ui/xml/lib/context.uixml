<?xml version="1.0"?>
<script>
	
	<include file="lib/common.uixml"/>
	
	<!--
	
	var popupCallback;
	var popupCursorState;
	var popupCloseCallback;
	
	function initPopup(message, action, yes, no)
	{
		popupCallback 			= action;
		popupCursorState 		= game.cursor.visible;
		game.cursor.visible 	= true;
		
		setPopupMessage(message);
		
		if(yes != null)
		{
			var button = findview("popup-yes");
			
			if(button)
				button.label = yes;
		}
		
		if(no != null)
		{
			var button = findview("popup-no");
			
			if(button)
				button.label = no;
		}
	}
	
	function setPopupMessage(message)
	{
		if(message)
		{
			var caption = findview("popup-caption");
			
			if(caption)
				caption.text = message;
		}
	}
	
	function setPopupCursorState(state)
	{
		popupCursorState = state;
	}
	
	function setPopupClose(flag)
	{
		var closer = findview("popup-close");
		
		if(closer != null)
			closer.visible = flag;
	}
	
	function setPopupCloseAction(action)
	{
		popupCloseCallback = action;
	}
	
	function setButtonEnabled(button, flag)
	{
		findview(button).enabled = flag;
	}
	
	function doPopupClose()
	{
		if(popupCloseCallback != null)
			popupCloseCallback();
		
		doPopupFree();
	}
	
	function doPopupAction(response)
	{
		if(popupCallback != null)
			popupCallback(response);
		
		doPopupFree();
	}
	
	function doPopupFree()
	{
		soundPlayClick();
		game.cursor.visible = popupCursorState;
		window.close();
	}
	
	-->
</script>

