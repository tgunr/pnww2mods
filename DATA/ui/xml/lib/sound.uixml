<?xml version="1.0"?>
<script>
	<!--
	
	function soundPlayClick()
	{
		game.playsound("ui/sounds/click.wav", 1, 1);
	}
	
	function soundPlaySelect()
	{
		game.playsound("ui/sounds/select.wav", 1, .05);
	}
	
	function soundPlayBump()
	{
		game.playsound("ui/sounds/tab.wav", 1, 1);
	}
	
	function soundPlayShuffle()
	{
		game.playsound("ui/sounds/btnup.wav", 1, .05);
	}
	
	function soundPlayError()
	{
		game.playsound("ui/sounds/error.wav", 1, 1);
	}

	function soundPlayPMSound()
	{
		game.playsound("ui/sounds/private_msg.wav", 1, .09);
	}
	function soundPlayOrders()
	{
		game.playsound("ui/sounds/recv_orders.wav", 1, 0.05);
	}
	
	function musicPlayIntro()
	{
		musicKill();
		
		var play = game.getpref('app.playmusic', 0, false);
		
		if(play && game.globals && game.settings.musicmultiplier > 0)
			game.globals.musicId = game.playsound("ui/sounds/" + musicGetSide() + "_main.wav", 1, game.settings.musicmultiplier, "game.globals.musicLoop()", 0);
	}
	
	function musicPlayLoop()
	{
		musicKill();
		
		var play = game.getpref('app.playmusic', 0, false);
		
		if(play && game.globals && game.settings.musicmultiplier > 0)
			game.globals.musicId = game.playsound("ui/sounds/" + musicGetSide() + "_loop.wav", 0, game.settings.musicmultiplier, null, 0);
	}
	
	function musicGetSide()
	{
		var side = (game.online) ? eval("game.player.client.persona.country.side"): 0;

		if(side == 2)
		 	return "axis";
		else if(side == 1)
		 	return "allied";
		
		// if we don't have a side, randomly pick one
		return (Math.floor(Math.random()*2+1) == 1)? "allied": "axis";
	}
	
	function musicKill()
	{
		if(game.globals != null)
		{
			if(game.globals.musicId != null)
				game.stopsound(game.globals.musicId, 0);
			
			game.globals.musicId = null;
		}
	}
	
	// handle music prefs change
	function onMusicChange()
	{
		consoleprint("Handling music changes!\n");
		
		if(game.getpref('app.playmusic', 0, true) && game.settings.musicmultiplier > 0)
		{
			consoleprint("Making sure music is started\n");
			
			if(game.globals.musicID == null)
				musicPlayIntro();
			
			game.setsoundvolume(game.globals.musicId, game.settings.musicmultiplier);
		}
		else
		{
			consoleprint("Making sure music is stopped\n");
			musicKill();
		}
	}
	
	-->
</script>

