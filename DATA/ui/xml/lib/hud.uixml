<script>
	<!--
	
	var display = null;
	var label = null;
	
	function initHUDObject(v)
	{
		display = v.findview("display");
		
		var loc = v.id.split("-");
		
		label = getlocstring("hud.waypoints." + loc[1]);
		
		if(label.charAt(0) == "?")
			label = null;
	}
	
	function updateHUDObject(placement, distance, alpha)
	{
		if(display != null)
		{
			
			if(alpha == 0)
			{
				if(display.visible)
					display.visible = false;
			}
			else
			{
				if(!display.visible)
					display.visible = true;
					
				var color = 255 * alpha;
				var bg = 128 * alpha;
				
				display.setstyleproperty("color", "#FFFFFF" + color.toString(16));
				display.setstyleproperty("shadow-color", "#000000" + bg.toString(16));
				
				var newLabel = "";
				
				if(label != null)
					newLabel = (placement == 0) ? label : label.charAt(0);
				
				if(distance >= 0 && placement == 0)
				{
					if(label != null)
						newLabel += ": ";
					
					newLabel += distance + "m";
				}
				
				display.text = newLabel;
				display.resizetotext();
			}
		}
	}
	
	-->
</script>

