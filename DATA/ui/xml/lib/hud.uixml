<?xml version="1.0"?>
<script>
	
	<include file="classes/GameAlert.uixml"/>
	<include file="classes/FadeView.uixml"/>
	
	<!--
	
	// game callbacks
	game.onbuilder			= doGameEvent;
	game.oncontact	 		= onContact;
	game.onorders 			= onOrders;
	
	game.oncyclehud				= onCycleHud;
	game.oncyclegameinfo		= onCycleGameInfo;
	game.oncyclereadout		= onCycleReadout;
	
	game.onenterbuilding		= onEnterBuilding;
	game.onleavebuilding		= onLeaveBuilding;
	
	game.onmapactivate		= onMapActivate;
	game.onmapdeactivate 	= onMapDeactivate;
	game.onchatdeactivate 	= onChatDeactivate;
	game.oncooldown			= onCoolDown;
	game.ongameevent			= doGameEvent;
	
	// helpers
	var hudInited				= false;
	var me							= game.player;
	var meType					= game.player.vehicletype;
	
	// persona view
	var personaView				= findview("persona");
	var state						= findview("state");
	var stateIcon				= findview("state-icon");
	var atpBar					= findview("atp-bar");
	var healthBar				= findview("health-bar");
	var resupply				= findview("persona-resupply");
	
	// primary weapon
	var primary		 			= findview("primary");
	var primaryLabel 			= findview("primary-label");
	var primaryName				= findview("primary-name");
	var primaryAmmo				= findview("primary-ammo");
	var primaryClips			= findview("primary-clips");
	var primaryIcon				= findview("primary-icon");
	var primaryProgress			= findview("primary-progress");
	var primaryOn				= game.getpref("view.primary.visible", 0, true);
	
	// secondary weapon
	var secondary				= findview("secondary");
	var secondaryName			= findview("secondary-name");
	var secondaryAmmo			= findview("secondary-ammo");
	var secondaryClips			= findview("secondary-clips");
	var secondaryOn				= game.getpref("view.secondary.visible", 0, true);
	
	// minimap vars
	var scaleTimer 				= new CycleTimer(250);
	var kenny						= findview("kenny");
	var miniMap 					= kenny.findview("minimap");
	var mapScale				= kenny.findview("minimapscale");
	var kennyOn				= game.getpref("view.kenny.visible", 0, true);
	
	if(game.online)
		miniMap.addlayer('<layer type="players"/>');
	
	var gameEventView			= null;
	var gameAlertView			= findview("game-alert");
	var gameAlertIconView	= findview("game-alert-icons");
	var gameAlert				= null; // current text display
	var gameAlerts				= new Array(); // icons list 0 is current
	var gameAlertTimer 		= new CycleTimer(25);

	var overSupplyState		= 6;
	var resupplyState			= 7; // na
	var resupplyTimer			= new CycleTimer(500);
	var overSupplyTimer		= new CycleTimer(500);
	
	// campaign specific
	var binfoView				= findview("binfo");
	var cinfoView				= findview("cinfo");
	var infoTimer				= new CycleTimer(200);
	var capCheckTimer		= new CycleTimer(game.player.client.state.cancapturecheck);
	var currentOrders				= findview("current-orders");
	var currentOrdersTimeout	= 0;

	// scenario specific
	var objectives					= new Object();
	var gameCycleTimer 		= new CycleTimer(1000);
	var gameTime					= -1;
	var gameTimer					= findview("game-timer");
	var gameProgress			= findview("game-progress");
	var obj1Progress				= findview("objective1-progress");
	var obj2Progress				= findview("objective2-progress");
	var hudMessages				= new Array(2);
	
	function initDefaultHud(hud)
	{
		//consoleclear();
		cprint("Initing HUD !!!\n");
		initGlobals();
		musicKill();
		
		hudMessages[0] = new FadeView("game-message1", 8000);
		hudMessages[1] = new FadeView("game-message2", 8000);
		
		gameAlertView.visible = false;
		
		primary.visible		= false;
		secondary.visible 	= false;
		
		primaryName.visible		= false;
		primaryIcon.visible		= false;
		primaryProgress.visible	= false;
		
		var state = hud.findview("state");
		
		if(meType == "person")
		{
			state.label	= getlocstring('hud.health.state.infantry');
			
			primaryIcon.visible	= true;
			primaryLabel.label	= getlocstring('hud.primary.weapon');
		}
		else
		{
			if(meType == "air")
			{
				state.label	= getlocstring('hud.health.state.pilot');
			}
			else
			{
				state.label	= getlocstring('hud.health.state.crew');
			}
			
			primaryName.visible	= true;
			primaryLabel.label	= getlocstring('hud.primary');
		}
		
		if(game.online)
		{
			//miniMap.addlayer('<layer type="waypoints"/>');
			//miniMap.addlayer('<layer type="players"/>');
		}
		
		//miniMap.scale = game.getpref('hud.minimap.scale', 4, .04);
		binfoView.mgr = new BuildingInfo(binfoView);
		cinfoView.mgr = new CPInfo(cinfoView);
		
		// go ahead and set the position of the 
		if(!game.training && player.client.currentorders.length > 0)
		{
			currentOrders.text = player.client.currentorders;
			currentOrders.resizetotext();
			restoreCustomOrders(currentOrders);
		}
		
		// run default callbacks at least once
		onCycleHud(game.training);
		onOrders(false);
		updateHud(hud);
			
		if(game.lastentered != null)
			game.onenterbuilding();
		
		// make sure this gets reset
		setCaptureCallback(null);
		
		if(gameTime == -1)
			gameTimer.visible = false;
		
		gameProgress.visible = false;
		
		if(!game.scenario)
		{
			obj1Progress.visible = false;
			obj2Progress.visible = false;
		}
	
		var compass = hud.findview("compass");
		
		if(!game.customterrain)
			compass.visible = false;
		
		hudInited = true;
	}
	
	function updateDefaultHud(hud)
	{
		var hudVisible = game.settings.hudvisible;
		
		if(personaView.visible)
		{
			// update player state icon
			//stateIcon.src = "ui/textures/hud/" + "state_" + me.state + ".bmp";
			if(me.state == "stand" && me.walkrun != null)
				stateIcon.src = "ui/textures/hud/" + "state_" + me.walkrun + ".bmp";
			else
				stateIcon.src = "ui/textures/hud/" + "state_" + me.state + ".bmp";
			
			
			// update health
			atpBar.value 	= me.atp;
			healthBar.value = me.blood;
			
			atpBar.settip(getVariableLocString('hud.health.atp.tip', Math.round(me.atp * 100) + "%"));
			healthBar.settip(getVariableLocString('hud.health.blood.tip', Math.round(me.blood * 100) + "%"));
			
			updateResupplyIcon(resupply);
		}
		
		primaryProgress.visible = false;
		
		// update weapon boxes
		if(meType == "person")
		{
			if(me.primaryammoname != "" && (hudVisible == 1 || (hudVisible == 2 && primaryOn)))
			{
				// primary is visible
				if(!primary.visible)
					primary.visible	= true;
					
				var iconName = me.primaryammoname;
				
				if(iconName == "buildtool")
					iconName = "shovel";
					
				//cprint("Weapon is " + iconName + "\n");
				
				// set icon
				primaryIcon.src = "ui/textures/hud/weapon_" + iconName + ".bmp";
				
				// update ammo
				updateAmmo(primary);
			}
			else
			{
				primary.visible	= false;
			}
			
			// troops never have a secondary
			secondary.visible = false;
		}
		else
		{
			// do primary
			if(me.primaryammoname != "" && (hudVisible == 1 || (hudVisible == 2 && primaryOn)))
			{
				// primary is visible
				if(!primary.visible)
					primary.visible	= true;
				
				// set name
				primaryName.label = me.primaryammoname;
				
				// update ammo
				updateVehicleAmmo(primary);
			}
			else
			{
				primary.visible	= false;
			}
			
			// do secondary
			if(me.secondaryammoname != "" && (hudVisible == 1 || (hudVisible == 2 && secondaryOn)))
			{
				// primary is visible
				if(!secondary.visible)
					secondary.visible = true;
				
				// set name
				secondaryName.label = me.secondaryammoname;
				
				// update ammo
				updateVehicleAmmo(secondary);
			}
			else
			{
				secondary.visible = false;
			}
		}
		
		// lets update the minimap
		if(kenny.visible)
			updateMiniMap();
		
		if(gameAlertTimer.run())
			updateGameAlerts();
			
		if(infoTimer.run())
			updateInfo();
			
		if(gameTimer.visible && gameTime >= 0 && gameCycleTimer.run())
		{
			SetTimer(gameTime - 1);
		}
		
		hudMessages[0].update();
		hudMessages[1].update();
	}
	
	function updateAmmo(weapon)
	{
		var clipAmmo 	= me[weapon.id + "ammocount"]; 	// ammo in clip
		var clipCount	= me[weapon.id + "clipcount"]; 	// number of clips or rounds if clipsize is 1
		var clipSize 	= me[weapon.id + "clipsize"]; 	// number of rounds in clip
		var clipType 	= me[weapon.id + "cliptype"]; 	// clip type: clip, magazine, belt
		var overSupply 	= me[weapon.id + "oversupply"]; // number of oversupply rounds or clips
		var range 		= me[weapon.id + "range"]; 		// primary's range setting
		var rgAmmo	 	= me["rgammo"]; 				// number of rg rounds left
		var rgLoaded	= me["rgloaded"]; 				// do we have an rg round loaded
			
		var ammoView 	= weapon.findview(weapon.id + "-ammo");
		var clipView 	= weapon.findview(weapon.id + "-clips");
		
		primaryLabel.label = getlocstring('hud.primary.weapon') + ((range > 0) ? ' - ' + range + 'm': '');
		
		var progress = false;
		
		if(me.primaryammoname == "buildtool")
		{
			ammoView.visible = false;
			clipView.visible = false;
			
			progress = true;					
		}
		else if(clipSize > 1) // we're dealing with a clipped weapon
		{
			ammoView.label = clipAmmo;
			
			if(rgLoaded > 0)
				ammoView.label += " +1";
			
			if(clipCount >= 0)
			{
				clipView.label = clipCount;
				
				if(overSupply > 0)
					clipView.label += " +" + overSupply;
				
				if(clipType >= 0)
				{
					var clipTypeLoc = "hud.cliptype." + clipType;
					
					if(clipCount + overSupply != 1)
						clipTypeLoc += ".plural";
					
					clipView.label  += " " + game.getlocstring(clipTypeLoc);
				}
				
				if(rgAmmo > 0)
					clipView.label  += ", " + rgAmmo + " rg";
				
				if(overSupply > 0)
				{
					//cprint("We have clipped oversupply\n");
					
					switch(overSupplyState)
					{
						/*
						case 4:
						case 22:
							clipView.setstyleproperty("color", "#FFFF00");
						break;
						*/
						case 5:
							clipView.setstyleproperty("color", "#FF0000");
						break;
						default:
							clipView.setstyleproperty("color", "#BFE2CE");
						break;
					}
					
					if(overSupplyState == 5)
					{
						if(overSupplyTimer.run())
							clipView.visible = (clipView.visible) ? false: true;
					}
					else
					{
						clipView.visible = true;
					}
				}
				else
				{
					//cprint("We dont have clipped oversupply\n");
					
					clipView.setstyleproperty("color", "#BFE2CE");
					
					if(!clipView.visible)
						clipView.visible = true;
				}
				
				ammoView.setstyleproperty("color", "#BFE2CE");
			}
			else
			{
				clipView.visible = false;	
			}
			
			if(!ammoView.visible)
				ammoView.visible = true;
		}
		else // we're dealing with a single round weapon
		{
			clipView.visible = false;
			
			if(clipCount >= 0)
			{
				ammoView.label = clipCount;
				
				if(overSupply > 0)
				{
					//cprint("We have non-clipped oversupply\n");
					
					ammoView.label += " +" + overSupply;
					
					switch(overSupplyState)
					{
						/*
						case 4:
						case 22:
							ammoView.setstyleproperty("color", "#FFFF00");
						break;
						*/
						case 5:
							ammoView.setstyleproperty("color", "#FF0000");
						break;
						default:
							ammoView.setstyleproperty("color", "#BFE2CE");
						break;
					}
					
					if(overSupplyState == 5)
					{
						if(overSupplyTimer.run())
							ammoView.visible = (ammoView.visible) ? false: true;
					}
					else
					{
						ammoView.visible = true;
					}
				}
				else
				{
					//cprint("We dont have non-clipped oversupply\n");
					
					ammoView.setstyleproperty("color", "#BFE2CE");
					
					if(!ammoView.visible)
						ammoView.visible = true;
				}
			}
			else
			{
				ammoView.visible = false;
			}
		}
		
		if(primaryProgress.visible != progress)
			primaryProgress.visible = progress;
	}
	
	function updateVehicleAmmo(weapon)
	{
		var ammo 			= me[weapon.id + "ammocount"];
		var clips 			= me[weapon.id + "clipcount"];
		var clipType		= me[weapon.id + "cliptype"];
		var ammoView 		= weapon.findview(weapon.id + "-ammo");
		var clipView 		= weapon.findview(weapon.id + "-clips");
		var clipTypeName	= "";
		
		if(ammo == null)
			ammo = -1;

		if(clips == null)
			clips = -1;
		
		if(clipType >= 0 && clips > 0)
		{
			var clipTypeLoc = "hud.cliptype." + clipType;
			
			if(clips > 1)
				clipTypeLoc += ".plural";
			
			clipTypeName = game.getlocstring(clipTypeLoc);
		}
		
		ammoView.label = (ammo > -1) ? ammo: '';
		clipView.label = (clips > 0) ? clips + " " + clipTypeName: '';
	}
	
	function updateMiniMap()
	{
		miniMap.position = me.position;
		
		if(scaleTimer.run())
			mapScale.label = miniMap.mapscale;
	}
	
	/*
	received inf resupply
	lost oversupply
	new orders
	new mission leader
	facility/cp lost (in my town)
	facility/cp gained (in my town)
	infantry emotes (ammo, get down, etc..
	you hear enemy voices
	msp deployable now
	msp not deployabled
	*/
	
	function updateGameAlerts()
	{
		var now 		= (new Date()).getTime();
		var vertBuffer 	= gameAlertIconView.width + 5;
		var vertInc		= gameAlertIconView.width/2;
		
		for(var i = 0; i < gameAlerts.length; i++)
		{
			var currentAlert = gameAlerts[i];
			
			if(currentAlert.view != null)
			{
				var minY = i * vertBuffer;
				
				currentAlert.view.y -= vertInc;
				
				if(currentAlert.view.y <= minY)
					currentAlert.view.y = minY;
				
				if(currentAlert.view.y <= 0)
				{
					if(currentAlert.start == 0)
					{
						if(game.getpref("hud.alerts.textmode", 2, 0) == 0)
						{
							gameAlert = currentAlert;
							gameAlertView.visible = false;
						}
						else
						{
							// start the expire timer
							currentAlert.start = now;
						}
					}
					else if(currentAlert.isExpired(now))
					{
						// its expired
						if(currentAlert.view != null)
						{
							currentAlert.view.visible = false;
							currentAlert.view.close();
						}
						
						gameAlerts.shift();
					}
				}
			}
			else
			{
				// new icon alert
				var add = "<image src='" + currentAlert.getIcon() + "' x='0' y='" + (365 - 32) + "' width='32' height='32' onclick='gameAlertClicked(this.mgr)' aspectlimit='width'/>";
				currentAlert.view = gameAlertIconView.addview(add);
				currentAlert.view.mgr = currentAlert;
			}
		}
		
		if(gameAlert != null)
		{
			if(gameAlert.start > 0 && !gameAlert.reset)
			{
				// continuing a current alert
				if(gameAlert.isExpired(now))
				{
					gameAlertView.visible = false; // its expired
					gameAlert = null;
				}
				else
				{
					if(!gameAlertView.visible)
						gameAlertView.visible = true;
					
					gameAlertView.setstyleproperty("color", gameAlert.getColor());
				}
			}
			else
			{
				// starting a new alert	
				gameAlert.start = now;
				gameAlert.reset = false;
				
				if(game.settings.wantmessagealert)
					game.playsound(gameAlert.getSound(), 1, 1);
				
				// set the text
				gameAlertView.text = gameAlert.text;
				gameAlertView.setstyleproperty("color", gameAlert.getColor());
				gameAlertView.resizetotext();
				
				gameAlertView.x = window.width/2 - gameAlertView.width/2;
			}
		}
	}
	
	function gameAlertClicked(newAlert)
	{
		gameAlert = newAlert;
		
		if(gameAlert != null)
		{
			var index 	= -1;
			var now 	= (new Date()).getTime();
			
			gameAlertView.visible = false;
			
			for(var i = 1; i < gameAlerts.length; i++)
			{
				if(gameAlerts[i].id == gameAlert.id)
				{
					index = i;
					break;
				}
			}
			
			if(index == 0)
			{
				gameAlert.reset = true;
			}
			else if(index > 0)
			{
				if(gameAlert.view != null)
				{
					gameAlert.view.close();
					gameAlert.view = null;
				}
				
				gameAlerts.splice(index, 1);
			}
		}
	}
	
	function getLatLon(pos)
	{
		var lat 	= Math.abs(pos.lat);
		var latdeg 	= Math.floor(lat);
		var latmin 	= Math.floor((lat - latdeg) * 60);
		var latsec 	= Math.floor((lat - (latdeg + latmin / 60.0)) * 3600);
		
		var lon 	= Math.abs(pos.lon);
		var londeg 	= Math.floor(lon);
		var lonmin 	= Math.floor((lon - londeg) * 60);
		var lonsec 	= Math.floor((lon - (londeg + lonmin / 60.0)) * 3600);
		
		return latdeg + "." + latmin + "." + latsec + ((pos.lat > 0) ? "N":"S") + " " +
			   londeg + "." + lonmin + "." + lonsec + ((pos.lon > 0) ? "E":"W");
	}
	
