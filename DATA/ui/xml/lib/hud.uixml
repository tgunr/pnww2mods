	/************ CALLBACKS ************/
	
	function doGameEvent(type, data, data2)
	{
		cprint(">>>>>>>>>>>>>>>>>>>>>>>>>>>>\n");
		cprint("Doing Game Event: " + type + "/" + data + "\n");
		
		if(gameEventView != null)
			gameEventView.close();
		
		gameEventView = null;
		
		switch(type)
		{
			case 2: // builders
			{
				if(data != null)
				{
					var content = game.getcontent("builders/" + data + ".xml");
					if(content != null)
					{
						gameEventView = game.load("widgets/builder", findview("hud"));
						gameEventView.setBuilder(gameEventView, content);
					}
				}
			}
			break;
			case 3: // content
			{
				if(data != null)
				{
					var content = game.getcontent("gamevents/memorial.xml");
					if(content != null)
					{
						gameEventView = game.load("widgets/memorial", findview("hud"));
						gameEventView.setMemorial(gameEventView, content);
					}
				}
			}
			break;
			case 7: // resupply
			case 8: // resupply
			case 9: // resupply
				setResupplyState(type);
			break;
			case 10: // resupply
				// received
				soundPlayBump();
			break;
			case 11: // game alert
			case 26: // game alert
			case 29: // ppo
			case 30: // no bailout
				addGameAlert(type, data);
			break;
			case 12: // strat
			case 13: // hc
			case 18: // cp update
			case 19: // facility
			case 21: // objective update
			case 24: // enemy spotted
				addGameAlert(type, getVariableLocString("hud.alerts." + type + "." + data, data2));
			break;
			case 5: // oversupply warning
			case 4: // oversupply gained
			case 6: // oversupply lost
			case 22: // oversupply inrange
				if(type != overSupplyState)
				{
					setOverSupplyState(type);
					
					if(game.player.isoversupplied)
					{
						if(!game.getpref("hud.alerts.show", 0, true) || game.getpref("hud.alerts.textmode", 2, 0) != 0)
						{
							if(type == 5 || type == 6)
								soundPlayError();
							else
								soundPlayBump();
						}
						
						if(type == 4) // received
							addGameAlert(type, getVariableLocString("hud.alerts." + type, data));
						else if(type == 6) // lost
							addGameAlert(type, getlocstring("hud.alerts." + type));
					}
				}
			break;
			case 14: // contact
			case 15: // orders
			case 16: // leader
				addGameAlert(type, getlocstring("hud.alerts." + type));
			break;
			case 17: // infresupply
			case 23: // cp under attack
			case 25: // cp under attack
			case 27: // hourly timeleft
			case 28: // can't fire here
				addGameAlert(type, getVariableLocString("hud.alerts." + type, data));
			break;
			default:
				// dont do anything
			break;
		}
	}
	
	function onContact()
	{
		cprint("New contact report!\n");
		//soundPlayPMSound();
		doGameEvent(14);
	}
	
	function onCycleHud(def)
	{
		// set window settings
		cprint("Cycing HUD to " + game.settings.hudvisible + "!\n");
		
		var chat 	= game.findview("chat");
		var vis		= (def) ? 1: game.settings.hudvisible;
		
		switch(vis)
		{
			case 0: // no hud
				chat.visible 	= false;
				window.visible 	= false;
				break;
			case 1: // reset hud
				window.visible 	= true;
				setDefaultHUD();
				break;
			default: // show hud
				window.visible 	= true;
				setCustomHUD();
				break;
		}
		
		gameAlertView.visible = false;
	}
	
	function onCycleGameInfo()
	{
		// set window settings
		cprint("Cycing Game Info!\n");
		var gameinfo = findview("gameinfo");
		gameinfo.visible = !gameinfo.visible;
		game.setpref("view.gameinfo.visible", 0, gameinfo.visible);
	}

	function onCycleReadout()
	{
		// set window settings
		cprint("Cycing Readout!\n");
		var readout = findview("readout");
		readout.visible = !readout.visible;
		game.setpref("view.readout.visible", 0, readout.visible);
	}

	function onMapActivate()
	{
		cprint("Map activation called!\n");
		kenny.visible = false;
	}
	
	function onMapDeactivate()
	{
		cprint("Map deactivation called!\n");
		
		var hudVisible 	= game.settings.hudvisible;
		
		if(hudVisible > 0 && kennyOn && !game.customterrain)
		{
			cprint("setting kenny visible!\n");
			kenny.visible = true;
			//initCompass();
		}
		else
		{
			cprint("setting kenny invisible!\n");
			kenny.visible = false;
		}
	}
	
	function onChatDeactivate()
	{
		cprint("Handling chat deactivate: " + game.settings.hudvisible + "!\n");
		
		var chat 	= game.findview("chat");
		var vis		= chat.visible;
		
		switch(game.settings.hudvisible)
		{
			case 0:
				vis = false;
				break;
			case 2:
				vis = game.getpref('view.chat.visible', 0, true);
				break;
			default:
				vis = true;
				break;
		}
		
		if(!game.ingame)
			vis = true;
		
		if(vis != chat.visible)
		{
			chat.visible = vis;
			
			if(vis)
				chat.initChatter();
		}
	}
	
	function onCoolDown(progress)
	{
		primaryProgress.value = progress;			
	}
	
	function onOrders(sendAlert)
	{
		cprint("New orders: " + player.client.currentorders + "\n");
		
		currentOrders.visible = false;
		
		if(game.training)
			return; // no orders while training
		
		var hudSetting = game.settings.hudvisible;
		
		if(player.client.currentorders.length > 0 && hudSetting > 0)
		{
			if(game.getpref("view.current-orders.visible", 0, true))
			{
				cprint("Setting custom orders position\n");
				
				var cx		= currentOrders.x + currentOrders.width/2;
				var cy		= currentOrders.y + currentOrders.height/2;
				
				currentOrders.text 		= player.client.currentorders;
				currentOrders.visible	= true;
				currentOrdersTimeout	= (new Date()).getTime() + 600000;
				
				currentOrders.resizetotext();
				
				currentOrders.x = cx - currentOrders.width/2;
				currentOrders.y = cy - currentOrders.height/2;
				
				if(currentOrders.x < 5)
					currentOrders.x = 5;					
				if(currentOrders.x + currentOrders.width > window.width - 5)
					currentOrders.x = window.width - currentOrders.width - 5;
				
				if(currentOrders.y < 5)
					currentOrders.y = 5;					
				if(currentOrders.y + currentOrders.height > window.height - 5)
					currentOrders.y = window.height - currentOrders.height - 5;
				
				if(game.settings.wantalerts)
					soundPlayOrders();
				
				// update the config
				saveCustomOrders(currentOrders);
				
				cprint("Done setting custom orders position\n");
			}
			
			if(sendAlert == null || sendAlert == true)
				doGameEvent(15);
		}
	}
	
	function saveCustomPosition(view, extra)
	{
		if(extra == null)
			extra = 0;
		// save position
		game.savesettings(view, 2 | extra);
	}
	
	function saveCustomOrders(view, what)
	{
		cprint("Saving custom orders position\n");
		
		game.setpref("view." + view.id + ".x", 4, normalizeX(view.x + view.width/2));
		game.setpref("view." + view.id + ".y", 4, normalizeY(view.y + view.height/2));
	}
	
	function restoreCustomOrders(view)
	{
		cprint("Restoring custom orders position\n");
		
		var newX = game.getpref("view." + view.id + ".x", 4, normalizeX(view.x + view.width/2));
		var newY = game.getpref("view." + view.id + ".y", 4, normalizeY(view.y + view.height/2));
		
		view.x = scaleX(newX) - view.width/2;
		view.y = scaleY(newY) - view.height/2;
	}
	
	function setCustomHUD()
	{
		cprint("Setting custom HUD!\n");
		
		var what = 2 | 8; // restore position and visibility
		var chat = game.findview("chat");
		
		var readout 	= setDefaultReadoutPosition(findview("readout"), true);
		var gameinfo 	= setDefaultGameinfoPosition(findview("gameinfo"), true);
		
		game.restoresettings(readout, 2 | 4);
		game.restoresettings(gameinfo, 2 | 4);
		game.restoresettings(currentOrders, 0 | 8);
		game.restoresettings(personaView, what);
		game.restoresettings(primary, what);
		game.restoresettings(secondary, what);
		game.restoresettings(kenny, what);
		game.restoresettings(binfoView, what);
		game.restoresettings(cinfoView, what);
		game.restoresettings(chat, 0 | 2);
		
		readout.visible = game.getpref("view.readout.visible", 0, false);
		gameinfo.visible = game.getpref("view.gameinfo.visible", 0, false);
		chat.visible = game.getpref("view.chat.visible", 0, true);
		miniMap.scale = game.getpref('hud.minimap.scale', 4, .04);
		
		// do the real position
		restoreCustomOrders(currentOrders);
		
		if(chat.visible)
			chat.initChatter();
			
		if(game.customterrain)
		{
			kennyOn = false;
			kenny.visible = false;
		}
		
		onOrders(false);
	}
	
	function setDefaultHUD()
	{
		cprint("Setting default HUD!\n");
		
		var what = 2 | 8; // position and visibility
		
		// readout, gameinfo off, the rest on
		var gameinfo 	= setDefaultGameinfoPosition(findview("gameinfo"), true);
		var readout 	= setDefaultReadoutPosition(findview("readout"), true);
		
		gameinfo.visible 	= false;
		readout.visible 	= false;
		
		game.savesettings(gameinfo, what | 4);
		game.savesettings(readout, what | 4);
		
		// orders - center top
		currentOrders.x = window.width/2 - currentOrders.width/2;
		currentOrders.y = window.height - currentOrders.height - 6;
		saveCustomOrders(currentOrders);
		game.setpref("view.current-orders.visible", 0, true);
		
		// persona - bottom left
		setViewMetrics(personaView, true, 6, 6);
		game.savesettings(personaView, what);
		
		// primary ammo - bottom left above persona
		setViewMetrics(primary, true, 6, personaView.y + personaView.height + 6);
		game.savesettings(primary, what);
		
		// secondary - bottom left above primary
		setViewMetrics(secondary, true, 6, primary.y + primary.height + 6);
		game.savesettings(secondary, what);
		
		// city info - bottom right below kenny
		setViewMetrics(cinfoView, true, window.width - 6 - cinfoView.width, 6);
		game.savesettings(cinfoView, what);

		// building info - bottom right above city info
		setViewMetrics(binfoView, true, window.width - 6 - binfoView.width, cinfoView.y + cinfoView.height + 6);
		game.savesettings(binfoView, what);
		
		// kenny - bottom right above building info
		setViewMetrics(kenny, true, window.width - 6 - kenny.width, window.height - 6 - kenny.height);
		game.savesettings(kenny, what);
		game.setpref("hud.minimap.mode", 1, 0);
		
		// chat - center bottom
		var chat = game.findview("chat");
		setViewMetrics(chat, true, window.width/2 - chat.width/2, 10);
		game.savesettings(chat, what);
		
		game.setpref('hud.alerts.show', 0, true);
		game.setpref("hud.alerts.textmode", 2, 0);
		game.settings.iconmode = 0;
		
		primaryOn = true;
		secondaryOn = true;
		kennyOn = true;
		
		if(game.customterrain)
		{
			kennyOn = false;
			kenny.visible = false;
		}

		
		chat.initChatter();
		onOrders(false);
		
		// set the hud back to on (1 = reset, 2 = on)
		game.settings.hudvisible = 2;
		
		// reset our mapscale
		miniMap.scale = game.getpref('hud.minimap.scale', 4, .04);
		
		cprint("Finished setting default HUD!\n");
	}
	
	function setDefaultGameinfoPosition(gameinfo, force)
	{
		if(!game.getpref("view.gameinfo.custom", 0, false) || force)
		{
			gameinfo.x = window.width - gameinfo.width - 6;
			gameinfo.y = window.height/2 - gameinfo.height/2;
		}

		return gameinfo;
	}

	function setDefaultReadoutPosition(readout, force)
	{
		if(!game.getpref("view.readout.custom", 0, false) || force)
		{
			readout.x = 5;
			readout.y = window.height - readout.height - 5;
		}

		return readout;
	}
	
	function setViewMetrics(view, v, x, y)
	{
		if(view != null)
		{
			cprint("1Setting view metrics for " + view.id + " to " + v + "," + x + "," + y + "\n");
			view.visible = v;
			view.x = x;
			view.y = y;
		}
		
		return view;
	}
	
	function setResupplyState(newState)
	{
		resupplyState = newState;
	}
	
	function setOverSupplyState(newState)
	{
		overSupplyState = newState;
	}
	
	function updateResupplyIcon(icon)
	{
		if(resupplyState == 7)
			icon.visible = false;
		else if(resupplyState == 8)
			icon.visible = true;
		else if(resupplyState == 9 && resupplyTimer.run())
			icon.visible = (icon.visible) ? false: true;
	}
	
	function addGameAlert(type, text)
	{
		if(!game.getpref("hud.alerts.show", 0, true))
			return;
		
		var newAlert 	= new GameAlert(type, text.toUpperCase());
		var okToAdd		= true;
		
		if(newAlert.isUnique())
		{
			for(var i = 0; i < gameAlerts.length; i++)
			{
				if(gameAlerts[i].type == newAlert.type)
				{
					okToAdd = false;
					break;
				}	
			}
		}
		
		if(okToAdd)
			gameAlerts.push(newAlert);	
	}
	
	function onEnterBuilding()
	{
		//binfoView.mgr.onEnter();
		
		var capCheck = game.player.client.state.cancapturecheck;
		
		if(game.online && capCheck > 0 && capCheckTimer.run())
		{
			var le 			= game.lastentered;
			var fac			= (le != null) ? le.parent : null;
			
			if(game.player.capturezone && fac != null && !game.player.client.state.cancapture)
				doGameEvent(11, getlocstring("hud.alerts.11.nocapture"));
		}
	}
	
	function onLeaveBuilding()
	{
		//binfoView.mgr.onLeave();
		cprint("onLeaveBuilding\n");
	}
	
	function updateInfo()
	{
		binfoView.mgr.update();
		cinfoView.mgr.update();
	}
	
	// hook for combat tutorials
	function setCaptureCallback(c)
	{
		//game.chatprint("Setting capture callback!!!");
		binfoView.mgr.callback = c;
	}
	
	function OnMessage(loc, color)
	{
		var message = getlocstring(loc);
		
		if(message.charAt(0) == "?")
			message = loc;
			
		if(hudMessages[0].start > 0)
		{
			var hm0	= hudMessages[0];
			var hm1 	= hudMessages[1];
			
			// move it down
			hm1.color				= hm0.color;
			hm1.view.text 		= hm0.view.text;
			
			hm1.view.resizetotext();
			hm1.view.setstyleproperty("color", hm1.color);
			
			hm1.view.x 			= (game.screenwidth/2) - hm1.view.width/2;
			hm1.view.y			= (game.screenheight/4) - hm1.view.height - 10;  
			hm1.view.visible 	= true;
			hm1.start				= hm0.start;
		}
		
		hudMessages[0].init(message, color);
		
		// centered x, 1/3 y
		hudMessages[0].view.x = (game.screenwidth/2) - hudMessages[0].view.width/2;
		hudMessages[0].view.y = (game.screenheight/4);
		
		// get their attention
		//game.playsound("ui/sounds/recv_orders.wav", 1, 1);
	}
	
	function SetTimer(seconds)
	{
		gameTime = seconds;
		
		if(gameTime < 0)
		{
			if(gameTimer.visible)
				gameTimer.visible = false;
		}
		else
		{
			if(!gameTimer.visible)
				gameTimer.visible = true;
			
			var formatted = "";
			
			if(gameTime < 60)
			{
				if(gameTime < 10)
					formatted = ":0" + gameTime;
				else
					formatted = ":" + gameTime;
			}
			else
			{
				var fminutes = parseInt(gameTime / 60);
				var fseconds = parseInt(gameTime % 60);
				
				if(fseconds < 10)
					formatted =  fminutes + ":0" + fseconds;
				else
					formatted =  fminutes + ":" + fseconds;
			}
			
			gameTimer.visible = true;
			gameTimer.text = formatted;
			gameTimer.resizetotext();
			gameTimer.x = (game.screenwidth/2) - gameTimer.width/2;
		}
	}
	
	function SetProgress(progress, label)
	{
		if(progress < 0)
		{
			if(gameProgress.visible)
				gameProgress.visible = false;
		}
		else
		{
			if(!gameProgress.visible)
				gameProgress.visible = true;
			
			var bar = gameProgress.findview("game-progress-bar");
			bar.value = progress;
			
			var loc = getlocstring(label);
			if(loc.charAt(0) == "?")
				loc = label;
			
			var header = gameProgress.findview("game-progress-label");
			header.text = loc;
			header.resizetotext();
			header.x = gameProgress.width/2 - header.width/2; 
			
			gameProgress.x = (game.screenwidth/2) - gameProgress.width/2;
			gameProgress.y = (game.screenheight/6);
		}
	}
	
	function SetObjective(objective, progress)
	{
		cprint("Set objective called!");
		
		var view = (objective == "objective1") ? obj1Progress : obj2Progress;
		
		if(progress < 0)
		{
			view.visible = false;
			return;
		}
		
		if(progress > 1)
			progress = 1;
		
		view.visible = true;
		
		var bar = view.findview(objective + "-progress-bar");
		bar.value = progress;
		
		var loc = getlocstring(objective);
		if(loc.charAt(0) == "?")
			loc = objective;
		
		var header = view.findview(objective + "-progress-label");
		header.label = loc;
		//header.resizetotext();
		//header.x = view.width/2 - header.width/2; 
		
		//view.x = (game.screenwidth/2) - gameProgress.width/2;
		//view.y = (game.screenheight/6);
	}
	
	-->
</script>

