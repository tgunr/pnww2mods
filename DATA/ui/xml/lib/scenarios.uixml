<?xml version="1.0"?>
<script>

	<include file="classes/ScenarioPopulation.uixml"/>
	
	<!--
	
		var scenariosRoot = null;
		var lastScenarioError = null;
		var MAX_SIDE_PLAYERS = 64;
		var balanceChecking = false;
		
		function loadRoot()
		{
			if(scenariosRoot == null)
				scenariosRoot = game.getcontent("scenarios");
			
			return scenariosRoot; 
		}
		
		function loadCategory(category)
		{
			//cprint("Loading category: " + category);
			
			var root = loadRoot();
			if(root == null) return null;
			
			for(var i = 0; i < root.links.length; i++)
			{
				var link = root.links[i];
				if(link == null) continue;
				
				var content = game.getcontent(link.path);
				
				if(content.category == category)
					return content;
			}
			
			return null;
		}
		
		function loadScenario(category, map)
		{
			//cprint("Loading scenario: " + category + "/" + map);
			
			var content = loadCategory(category);
			if(content == null) return null;
			
			if(map >= 0 && map < content.links.length)
			{
				var sc = game.getcontent(content.links[map].path);
				
				if(sc)
				{
					sc.type = map;
					sc.population = new ScenarioPopulation(sc);
				}
				else
				{
					cprint("Couldnt load scenario!");
				}
				
				return sc;
			}
			
			return null;
		}
		
		function loadObjectives(scenario, team)
		{
			if(scenario == null || !game.online || game.player.client.persona == null)
				return null;
			
			if(team == null)
				team = game.player.client.persona.country.side;
				
			if(team < 1 || team > 2)
				return null;
			
			if(scenario.links != null && scenario.links.length >= 2)
				return game.getcontent(scenario.links[team - 1].path);
				
			return null;
		}
		
		function joinLobby()
		{
			var hud = game.findview("scenhud");
			if(hud != null) hud.close();
			
			// make sure no scenario is running
			game.stopscenario();
			
			var root = loadRoot();
			var client = game.player.client;
			
			if(client.instance.category != root.category)
				client.joininstance(root.category, 0, 0, 0);
			
			// load our lobby windows 
			loadWin("scenarios/lobby", true);
		}
		
		function joinInstance(instance, init)
		{
			if(instance == null)
				return false;
			
			//cprint("Joining instance " + instance.category + "/" + instance.type);
			
			var scenario = loadScenario(instance.category, instance.type);
			//var creator	= (instance.owner == ); 
			
			// start the scenario
			if(client.joininstance(instance.category, instance.type, instance.owner, instance.id))
			{
				if(scenario != null && game.startscenario(scenario.path, init))
				{
					// save our content
					game.globals.scenario = scenario;
					
					// move to the scenario screen
					loadWin("scenarios/scenario", true);
					
					return true;
				}
			}
			
			return false;
		}
		
		function createInstance(category, map)
		{
			//cprint("Creating new instance: " + category + "/" + map);
			
			var mapPack = loadCategory(category);
			
			if(mapPack != null && !scenarioPermission(mapPack.permission))
				return scenarioError("notpermitted");
			
			if(game.player.client.createinstance(category, map))
				return true;
			
			return scenarioError("creationfailed");
		}
		
		function selectTeam(scenario, team)
		{
			var population 	= scenario.population;
			var instance	= scenario.instance;
			
			// find the best team
			if(team == null)
				team = 0;
			
			//var maxplayers	= population.maxPlayers();
			var team1ratio 	= population.teamRatio(1);
			var team2ratio 	= population.teamRatio(2);
			var team1count 	= instance.allies;
			var team2count 	= instance.axis;
			var totalplayers	= team1count + team2count; 
			
			if(team == 0)
			{
				if(totalplayers == 0)
					return selectTeam(scenario, game.player.client.persona.country.side);
				
				// find the team with the smallest imbalance
				var pop1Ratio = team1count / totalplayers;
				var pop2Ratio = team2count / totalplayers;
				
				var team1diff = (team1ratio - pop1Ratio);
				var team2diff = (team2ratio - pop2Ratio);
				
				if(team1diff > team2diff)
					return selectTeam(scenario, 1);
				else if(team2diff > team1diff)
					return selectTeam(scenario, 2);
				else
					return selectTeam(scenario, (team1count < team2count) ? 1 : 2);
			}
			else if(team == 1)
			{
				if(balanceChecking && totalplayers > 0)
				{
					cprint("totalplayers is " + totalplayers);
					cprint("team1ratio is " + team1ratio);
					cprint("team1count is " + team1count);
					cprint("team1max is " + population.team1max);
					
					if(team1count >= population.team1max)
						return scenarioError("sidefull");
					
					var teamratio = team1count / totalplayers;
					
					if(teamratio == 0)
						teamratio = team1ratio;
					
					//cprint("team1diff is " + team1diff);
					cprint("teamratio is " + teamratio);
					cprint("allowance is " + population.allowance);
					
					if(team1ratio < teamratio - population.allowance || team1ratio > teamratio + population.allowance)
						return scenarioError("sideimbalance");
				}
			}
			else
			{
				if(balanceChecking && totalplayers > 0)
				{
					cprint("totalplayers is " + totalplayers);
					cprint("team2ratio is " + team2ratio);
					cprint("team2count is " + team2count);
					cprint("team2max is " + population.team2max);
					
					if(team2count >= this.team2max)
						return scenarioError("sidefull");
					
					var teamRatio = team2count / totalplayers;
					
					if(teamratio == 0)
						teamratio = team2ratio;
					
					cprint("teamratio is " + teamRatio);
					cprint("allowance is " + population.allowance);
					
					if(team2ratio < teamratio - population.allowance || team2ratio > teamratio + population.allowance)
						return scenarioError("sideimbalance");
				}
			}
			
			var client		= game.player.client;
			var country 	=  scenario["team" + team];
			
			if(!client.persona || client.persona.country.id != country)
			{
				var personas 	= client.personas;
				var persona		= null;
				
				for(var i = 0; i < personas.length; i++)
				{
					if(personas[i].country.id == country && personas[i].branchid == 1)
					{
						persona = personas[i];
						break;
					}
				}
				
				if(persona == null)
					return scenarioError("badpersona");
				
				if(client.selectpersona(persona))
					return true;
				else
					return scenarioError("failedpersona");
			}
			
			return true;
		}
		
		function switchTeams(scenario)
		{
			return selectTeam(scenario,  ((game.player.client.persona.country.side == 1) ? 2 : 1));
		}
		
		// potentially expensive call, don't use it to often (calls across network and blocks)
		function getScenarioState(instance)
		{
			if(instance == null)
				instance = game.player.client.instance;
			
			if(game.player.client.listinstances(instance.category, instance.type, instance.owner))
			{
				var instances = client.instances;
				
				for(var i = 0; i < instances.length; i++)
				{
					var state = instances[i];
					
					if(state.description.id == instance.id)
						return state;
				}
			}
			
			return null;
		}
		
		function canJoinScenario(scenario)
		{
			if(!balanceChecking)
				return true;
			
			if(scenario == null || scenario.instance == null)// || !scenario.instance.running)
				return scenarioError("badscenario");
				
			var category = loadCategory(scenario.instance.category);
			
			if(category != null && !scenarioPermission(category.permission))
				return scenarioError("notpermitted");
			
			var maxplayers	= scenario.population.maxPlayers();
			var team1count	= scenario.instance.allies;
			var team2count	= scenario.instance.axis;
			
			if(team1count + team2count >= maxplayers)
				return scenarioError("fullscenario");
			
			return true;
		}
		
		function canScenarioSpawn(scenario)
		{
			if(!balanceChecking)
				return true;
			
			if(scenario == null || scenario.instance == null)// || !scenario.instance.running)
				return scenarioError("badscenario");
			
			var team1min = scenario.population.team1min;
			var team2min = scenario.population.team2min;
			
			var team1count = scenario.instance.allies;
			var team2count = scenario.instance.axis;
			
			//cprint("Found " + team1count + " of " + team1min + " allied players!");
			//cprint("Found " + team2count + " of " + team2min + " axis players!");
			
			if(team1count < team1min || team2count < team2min)
				return scenarioError("moreplayers");
			
			return true;
		}
		
		function scenarioPermission(p)
		{
			// if no permission passed, allow access
			if(p == null || p == "")
				return true;
			
			// otherwise check access 
			return game.haspermission(p);
		}
		
		function scenarioError(code)
		{
				lastScenarioError = "scenarios." + code;
				return false;
		}
		
	-->
</script>

