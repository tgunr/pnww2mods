<?xml version="1.0"?>

<window id="Login" x="0" y="0" width="1024" height="768" viewportwidth="1024" viewportheight="768"
			style="background-image: screens/loadingscreen_blank.bmp; background-color: #000000;" aspectalign="center"
			onshow="WindowInit()" onhide="WindowKill()" onupdate="WindowUpdate()">
	<include file="lib/common.uixml"/>
	<!-- HACK: From template.uixml -->
	<button id="quit-button" x="980" y="725" width="30" height="30" onclick="tplQuit()"
				style="control-on: ui/textures/test/exit_on.bmp; control-off: ui/textures/test/exit_off.bmp;"
				tip="${widgets.template.quit.tip}"/>
	
	<!-- CONNECTING -->
	
	<script>
		<!--
		//==============================
		// GLOBAL
		
		var authconn = null;
		var modeselect_window = findview("modeselect-window");
		var connecting_window = findview("connecting-window");
		var userlogin_window = findview("userlogin-window");
		var arena_window = findview("arenas-window");
		
		function WindowInit() {
			showChat(false);
			//showIDCard(false);
			
			ResetWindow();
		}
		
		function WindowKill() {
			if ( authconn )
				authconn.Disconnect();
		}
		
		function WindowUpdate() {
			if ( authconn )
				authconn.CheckMessages();
		}
		
		//======
		
		// addr is optional, overrides default auth address
		function ResetAuthLogin(addr) {
			modeselect_window.visible = connecting_window.visible = userlogin_window.visible = arena_window.visible = false;
			
			if ( authconn ) {
				authconn.OnError       = null;
				authconn.OnConnect     = null;
				authconn.OnLogin       = null;
				authconn.OnArenaUpdate = null;
				authconn.OnArenaJoin   = null;
				authconn.OnURLResponse = null;
				authconn.OnFTPResponse = null;
			}
			
			modeselect_window.visible = true;
		}
		
		
		function OnError(desc) {
			if ( PopupIsPresent() )
				window.close(); // Topmost? Hopefully? :/
			showOk(desc);
		}
		
		//======
		
		// HACK: To keep the UI flow simple, block things when the quit/error windows are up.
		function PopupIsPresent() {
			return (findview("popup-caption") != null); // HACK
		}
		
		// HACK: From template.uixml
		function tplQuit() {
			loadWin("quit", false);
		}
		
		//==============================
		
		// HACK: We aren't a proper UI stack/state machine.
		function ModeSelectInit() {
			if ( authconn )
				authconn.Disconnect();
		}
		
		//==============================
		// CONNECTING
		
		function ConnectingInit() {
			if ( authconn == null ) {
				authconn = new AuthHandler();
			} else {
				authconn.Disconnect();
			}
			
			authconn.OnError = OnError;
			authconn.OnConnect = OnConnect;
			
			authconn.Connect(addr);
		}
		
		
		function ConnectingKill() {
		
		}
		
		//======
		
		function OnConnect() {
			var is_steam = false;
			if (is_steam) {
				// TODO
			} else {
				login_window.visible = true;
			}
		}
		
		//==============================
		// NORMAL LOGIN
		
		var username_field = findview("username");
		var password_field = findview("password");
		
		
		function LoginShown() {
			//TODO: password_field.obscure = true;
			
			if ( client.HasSavedLoginInfo() ) {
				username_filed.text = client.GetSavedUsername();
				// TODO: Gray out password, clear/reset on selection
			}
			
			client.ConnectToAuth();
		}
		
		
		
		function updateWin() {
			if ( ! client.IsConnectedToAuth() ) {
				// TODO: Gray out auth area, put up message that we're not connected
			}
			// TODO: (Re)enable auth area if new connection
		}
		
		
		
		function AttemptLogin() {
			try {
				var save = false; // TODO: Checkbox
				client.Login(username_field.text, password_field.text, save);
				// TODO: We support waiting
				loadWin("ArenaSelect", true);
			} catch ( error ) {
				// TODO: popup with error.message
			}
		}
		
		//==============================
		// ARENA SELECT
		
		var arena_list = new ListControl(findview("ArenaList"), ClickArena);
		var update_timer;
		
		function ArenasShown() {
			setForward('arenaselect.forward');
			setBack('arenaselect.back');
			
			client.onarenalistchange = UpdateArenaList;
			update_timer = new CycleTimer(30000);
		}
		
		
		function ArenasHidden() {
			update_timer = null;
		}
		
		function UpdateArenas() {
			if ( ! client.IsConnectedToAuth() || client.arenas == null ) {
				// TODO: Popup message, then kick back to login screen
			}
			
			if ( update_timer.run() )
				client.PollArenas();
			
			if ( arena_list.data )
				setForwardEnabled(true);
			else
				setForwardEnabled(false);
		}
		
		
		function UpdateArenaList() {
			var arenas = client.arenas;
			arena_list.clearRows(false);
			
			if ( arenas.length > 0 ) {
				for ( var i = 0 ; i < arenas.length ; ++i ) {
					var name = arenas[i].name;
					var state = arenas[i].state;
					var color = ArenaColor(state);
					
					var row = "<view id='" + arenas[i].id + "' width='418' height='20' aspectalign='left' onmouseenter='missionList.mouseEnter(this)' onmouseexit='missionList.mouseExit(this)'>\
					               <image x='0' y='0' src='ui/textures/arenas/" + state + ".dds' width='30' height='30' style='font-size: -1; color: " + color + ";' tip='${arenas.states." + state + ".tip'}/>\
					               <caption id='arena-name' x='35' y='3' width='277' height='16' style='font-size: -1; color: " + color + "; 'label='" + name + "'/>\
					           </view>";
					arena_list.addRow(arena, row);
				}
			} else {
				var row = "<view id='arenas_empty' width='418' height='16' aspectalign='left'>\
				               <caption id='mission-vehicle' x='0' y='0' width='250' height='16' style='color: #e9e3d9ff;'\
				                     label='" + getlocstring("arenaselect.noarenas") + "'/>\
				           </view>";
					arena_list.addRow(null, row);
			}
		}
		
		function ClickArena(dblclick) {
			//UpdateArenaDetails();
			
			if ( dblclick )
				tplForward();
		}
		
		function GetArenaColor(state) {
			// TODO: Cycle by types
			return "#e9e3d9ff";
		}
		
		//==============================
		// GUI Helpers
		
		function UsernameEntered() {
			soundPlayClick();
			username_field.focused = false;
			password_field.focused = true;
		}
		
		function PasswordEntered() {
			soundPlayClick();
			password_field.focused = false;
			AttemptLogin();
		}
		-->
	</script>
</window>
