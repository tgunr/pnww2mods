<?xml version="1.0"?>
<window id="LoginCredentials" x="0" y="0" width="1024" height="768" viewportwidth="1024" viewportheight="768" aspectalign="center"
			onshow="InitWindow()">
	<include file="lib/login.uixml"/>
	<view id="login-pane" width="350" height="100" style="background-color: #00000088; 
				border-sides: ui/textures/hud/border_side.bmp;
				border-corner: ui/textures/hud/border_corner.bmp;
				border-width: 4;
				border-height: 4;" moveondrag="no">
		<caption id="username-label" rleft="10" rtop="10" height="20" width="100" label="${login.promptusername}" style="font-size:+1; color:#ffffff; align=right"/>
		<textcontrol id="username" rright="10" rtop="10" height="20" width="200" acceptsfocus="true" style="background-color: #FFFFFF; font-size:+1; color: #000000;"
					maxlength="40" ontab="UsernameEntered()" onenter="UsernameEntered()"/>
		<caption id="password-label" rleft="10" rtop="35" height="20" width="100" label="${login.promptpassword}" style="font-size:+1; color:#ffffff; align=right"/>
		<textcontrol id="password" rright="10" rtop="35" height="20" width="200" acceptsfocus="true" style="background-color: #FFFFFF; font-size:+1; color: #000000;"
					obscure="true"
					onenter="PasswordEntered()"/>
		<button id="connect-button" label="${login.promptlogin}" rleft="137" rtop="70" width="150" height="30"
					style="control-on: ui/textures/test/next_on.bmp; control-off: ui/textures/test/next_off.bmp; control-disabled: ui/textures/test/next_disabled.bmp; color: #FFFFFF; font-size: -3;"
					onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"
					onclick="soundPlayClick(); AttemptLogin();"/>
		<!-- TODO: Back button -->
	</view>
	<script>
		<!--
		var username_field = findview("username");
		var password_field = findview("password");
		var save_credentials = false; // TODO: Checkbox
		
		
		function InitWindow() {
			if ( auth.logged_in ) {
				loadWin("LoginArenaSelect", true);
				return;
			}
			
			// TODO
			/*if ( client.HasSavedLoginInfo() ) {
				username_filed.text = client.GetSavedUsername();
				// TODO: Gray out password, clear/reset on selection
				password_field.fakelength = 10;
			}*/
			
			auth.OnLogin = OnLogin;
		}
		
		//======
		
		function OnLogin() {
			loadWin("LoginArenaSelect", true);
		}
		
		
		function AttemptLogin() {
			var save = false; // TODO: Checkbox
			auth.Login(username_field.text, password_field.text, save);
		}
		
		//======
		
		function UsernameEntered() {
			soundPlayClick();
			username_field.focused = false;
			password_field.focused = true;
		}
		
		function PasswordEntered() {
			soundPlayClick();
			password_field.focused = false;
			AttemptLogin();
		}
		-->
	</script>
</window>
