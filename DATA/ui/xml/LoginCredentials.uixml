<?xml version="1.0"?>
<window id="LoginCredentials" x="0" y="0" width="1024" height="768" viewportwidth="1024" viewportheight="768"
			style="background-image: screens/loadingscreen_blank.bmp; background-color: #000000;" aspectalign="center"
			onshow="InitWindow()" onupdate="UpdateLogin()">
	<include file="lib/login.uixml"/>
	<!-- HACK: From template.uixml -->
	<button id="quit-button" x="980" y="725" width="30" height="30" onclick="tplQuit()"
				style="control-on: ui/textures/test/exit_on.bmp; control-off: ui/textures/test/exit_off.bmp;"
				tip="${widgets.template.quit.tip}"/>
	<view id="login-pane" x="350" y="400" width="350" height="100" style="background-color: #00000088; 
				border-sides: ui/textures/hud/border_side.bmp;
				border-corner: ui/textures/hud/border_corner.bmp;
				border-width: 4;
				border-height: 4;" moveondrag="yes">
		<caption id="username-label" rleft="10" rtop="10" height="20" width="100" label="${login.username}" style="font-size:+1; color:#ffffff; align=right"/>
		<textcontrol id="username" rright="10" rtop="10" height="20" width="200" acceptsfocus="true" style="background-color: #FFFFFF; font-size:+1; color: #000000;"
					maxlength="40" onenter="UsernameEntered()"/>
		<caption id="password-label" rleft="10" rtop="35" height="20" width="100" label="${login.password}" style="font-size:+1; color:#ffffff; align=right"/>
		<textcontrol id="password" rright="10" rtop="35" height="20" width="200" acceptsfocus="true" style="background-color: #FFFFFF; font-size:+1; color: #000000;"
					onenter="PasswordEntered()"/>
		<button id="connect-button" label="${login.connect}" rleft="137" rtop="70" width="150" height="30"
					style="control-on: ui/textures/test/next_on.bmp; control-off: ui/textures/test/next_off.bmp; control-disabled: ui/textures/test/next_disabled.bmp; color: #FFFFFF; font-size: -3;"
					onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"
					onclick="soundPlayClick(); AttemptLogin();"/>
	</view>
	<script>
		<!--
		var username_field = findview("username");
		var password_field = findview("password");
		var save_credentials = false; // TODO: Checkbox
		
		
		function InitWindow() {
			showChat(false);
			
			//TODO: password_field.obscure = true;
			
			// TODO
			/*if ( client.HasSavedLoginInfo() ) {
				username_filed.text = client.GetSavedUsername();
				// TODO: Gray out password, clear/reset on selection
			}*/
			
			auth.OnError = OnError;
			auth.OnLogin = OnLogin;
		}
		
		//======
		
		functon OnError(msg) {
		}
		
		function OnLogin() {
			if ( save_credentials ) {
				// TODO
			}
			loadWin();
		}
		
		//======
		
		function AttemptLogin() {
			client.Login(username_field.text, password_field.text, save);
		}
		
		//======
		
		function UsernameEntered() {
			soundPlayClick();
			username_field.focused = false;
			password_field.focused = true;
		}
		
		function PasswordEntered() {
			soundPlayClick();
			password_field.focused = false;
			AttemptLogin();
		}
		
		// HACK: From template.uixml
		function tplQuit() {
			loadWin("quit", false);
		}
		-->
	</script>
</window>
