<?xml version="1.0"?>
 
<window id="buildppo" x="0" y="0" width="1024" height="768" viewportwidth="1024" viewportheight="768" modal="true"
	style="background-color: #00000077;" layer="100" aspectalign="center">
	<include file="lib/popup.uixml"/>
	<include file="lib/sound.uixml"/>
	<view id="buildppo-viewer" width="350" height="100" rtop="200" moveondrag="yes"
		  		style="background-color: #00000088;
							border-sides: ui/textures/hud/border_side.bmp;
							border-corner: ui/textures/hud/border_corner.bmp;
							border-width: 4;
							border-height: 4;">
		<text id="popup-caption" x="10" rtop="10" height="50" width="330" acceptfocus="no" acceptsmouseclick="false" style=" color: #FFFFFF;"
			followtop="true" onshow="this.text = getPPOCaption()"/>
		<progressbar id="build-progress" x="20" y="45" height="10" rright="20" minvalue="0" maxvalue="1"
			fill="ui/textures/hud/blood-level-fill.bmp" background="ui/textures/hud/back-level-fill.bmp" orient="leftright"
			acceptmouseclick="false"/>
		<button id="popup-no" x="20" y="10" width="150" height="25" label="${popup.cancel}" onclick="doCancelAction()"
			style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
			onmouseenter="if(this.enabled) this.setstyleproperty('color', '#FFFF00')" onmouseexit="this.setstyleproperty('color', '#FFFFFF')"/>
	</view>
	<script>
		<!--
		
		var ppoID = -1;
		var progress = findview("build-progress");
		
		function initPPOPopup(type)
		{
			ppoID = type;
			initPopup(type, null, null, getlocstring("popup.cancel"));
		}
		
		function updatePPOPopup(p)
		{
			//cprint("Setting progress to " + p + "\n");
			progress.value = p;
		}
		
		function getPPOCaption()
		{
			var ppoName = game.getlocstring("ppos.ob" + ppoID);
			cprint("Building ppo: " + ppoName);
			return getVariableLocString("ppos.building", ppoName);
		}
		
		function doCancelAction()
		{
			soundPlayClick();
			game.cancelppo();
		}
		
		// -->
	</script>
</window>
