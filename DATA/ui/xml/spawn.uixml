<?xml version="1.0"?>
 
<view id="spawn" x="0" y="0" width="1024" height="768" viewportwidth="1024" viewportheight="768"
	onshow="setBackground(this)" onupdate="doFeedback()" aspectalign="center">
	<include file="lib/common.uixml"/>
	<text id="description-text" x="130" y="260" height="265" width="405" acceptfocus="no" style="color: #000000; font-size: +2;" onshow="this.text = getTip()"/>
	<caption id="feedback-caption" x="20" y="10" width="900" height="50" style="color: #00000044; font-size: 20;" onshow="this.label = getlocstring('spawn.loading')" aspectalign="center"/>
	<script>
		<!--
		
		var descriptionText		= findview("description-text");
		var feedbackCaption 	= findview("feedback-caption");
		var debugInfo			= findview("debug-info");
		var updateTimer			= new CycleTimer(1000);
		
		function setBackground(view)
		{
			var aspectRatio = game.screenwidth/game.screenheight;
			
			if(aspectRatio >= 1.6)
			{
				view.setstyleproperty("background-image", "screens/spawnscreen69.bmp");
				//descriptionText.x = view.scalev("x", 120);
				//descriptionText.width = view.scalev("width", 405);
			}
			else
			{
				view.setstyleproperty("background-image", "screens/spawnscreen43.bmp");
				//descriptionText.x = view.scalev("x", 25);
				//descriptionText.width = view.scalev("width", 500);
			}
			
			//descriptionText.y = view.scalev("y", 250);
			
			if(game.online && game.betarelease)
				game.load("gameinfo", window);
		}
		
		function doFeedback()
		{
			if(updateTimer.run())
				feedbackCaption.label = feedbackCaption.label + ".";
		}
		
		function getTip()
		{
			var index	= game.getcontent("tips/index.xml");
			var tips	= index.links;
			var winner 	= Math.round(Math.random() * (tips.length - 1));
			var tip		= game.getcontent(tips[winner].path); 
			var text	= (tip) ? tip.body: "";
			
			if(game.betarelease == 1)
				text += "\n\nResource: tips/launch" + winner + ".xml";
			
			return text;
		}
		
		-->
	</script>
</view>
	