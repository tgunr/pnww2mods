				axis.setstyleproperty("color","#ffff00");
				
				allies.label 	= getlocstring('persona.list.requesting');
				axis.label 		= getlocstring('persona.list.overpopulated');
			}
			else
			{
				allies.setstyleproperty("color", "#00ff00");
				axis.setstyleproperty("color", "#00ff00");
				
				allies.label 	= getlocstring('persona.list.balanced');
				axis.label 		= getlocstring('persona.list.balanced');
			}
			
			/*
			if(poll != null && !poll.empty)
			{
				question.text = poll.title;
		  		question.maxwidth = 280;
				question.resizetotext();
				
				if(question.height > 15)
				{
				 	consoleprint("Adjusting poll question position\n");
				 	question.y -= question.height - 15;
				 	pollList.list.height -= (question.height - 15) + 5;
		 		}

				consoleprint("Initing poll list\n");
				
				pollList.clearRows(true);
				
				var options = poll.options;
				
				if(options)
				{
					consoleprint("Initing " + options.length + " poll options\n");

					for(var i = 0; i < options.length; i++)
					{
						var option = options[i];
						
						consoleprint("Adding poll option " + i + ". " + option + "\n");
						
						var row = "\
<view id='option" + i + "' width='" + (potd.width - 40) + "' height='16' onmouseenter='pollList.mouseEnter(this)' onmouseexit='pollList.mouseExit(this)'>\
	<caption x='0' y='0' width='" + (potd.width - 40) + "' height='16' style='color: #e9e3d9ff; ' label='" + (i + 1) + ". " + htmlencode(option) + "'/>\
</view>";
						
						pollList.addRow(i, row);
					}
				}
				
				consoleprint("Done\n");
			}
			else
			{
				question.text = getlocstring('persona.potd.empty');
		  		question.maxwidth = 280;
				question.resizetotext();

				if(question.height > 15)
				 	question.y -= question.height - 15;

				pollList.list.visible = false;
			}
			*/
			
			if(squad != null)
			{
			 	findview('persona-squad-motd').text 	= squad.motd;
			 	findview('persona-squad-counts').label 	= getVariableLocString('common.squads.counts', squad.onlinecount, squad.totalcount);
			}
			else
			{
			 	findview('persona-squad-counts').visible = false;
			 	findview('persona-squad-motd').text = getlocstring('persona.welcome.squad.motd.nosquad');
			}

			consoleprint("Final Done\n");
		}
		
		function positionClose(button)
		{
			var parent = button.parent;
			button.x = (parent.width/2) - (button.width/2);
		}
		
		function editCrsMotd()
		{
			if(client.isplaynet)
			{
				soundPlayClick();
				
				if(motd.acceptsfocus)
				{
					motd.focused = false;
					motd.acceptsfocus = false;
					motd.setstyleproperty("background-color", "#00000000");
					
					client.setmotd(1, 0, motd.text);
					var crsmotd = client.requestmotd(0);
					
					if(crsmotd != null)
						motd.text = crsmotd.message;
				}
				else
				{
					motd.setstyleproperty("background-color", "#FFFFFF22");
					motd.acceptsfocus = true;
					motd.focused = true;
				}
			}
		}
		
		function getWelcomeMessage()
		{
			return getlocstring("online.campaign" + Math.round(Math.random() * 2));
		}
		
		function closeWelcome()
		{
		 	soundPlayClick();

		 	/*
			var vote = pollList.data;

			if(poll != null && !poll.empty)
			{
				var options = poll.options;

				consoleprint("Voted: " + vote + "\n");

				if(vote != null && vote >= 0 && vote < options.length)
				{
				 	game.globals.voted = true;
					poll.vote(vote);
				}
			}
			*/

			var personaWin = game.findview("persona");

			if(personaWin)
				personaWin.setWelcomed();
				
			window.close();
		}
		
		-->
	</script>
</window>

