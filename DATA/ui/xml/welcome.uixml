				game.globals.voted = false;
			
			//if(game.globals.voted)
			//	poll = null;

			if(crsmotd != null)
				motd.text = crsmotd.message;
				
			header.label = getlocstring("online.campaign");
				
			if(balance < 0)
			{
				allies.setstyleproperty("color","#ffff00");
				axis.setstyleproperty("color","#00ff00");
				
				allies.label 	= getlocstring('persona.list.overpopulated');
				axis.label 		= getlocstring('persona.list.requesting');
