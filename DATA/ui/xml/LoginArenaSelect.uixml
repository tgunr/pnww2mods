<?xml version="1.0"?>
<window id="Login-ArenaSelect" x="0" y="0" width="1024" height="768" viewportwidth="1024" viewportheight="768" modal="true" aspectalign="center"
			onshow="InitWindow()" onupdate="UpdateWindow()">
	<include file="lib/common.uixml"/>
	<include file="lib/login.uixml"/>
	<include file="classes/CycleTimer.uixml"/>
	<include file="classes/ListControl.uixml"/>
	<view id="arena-pane" x="290" y="178" width="450" height="411" style="background-color: #00000088; 
				border-sides: ui/textures/hud/border_side.bmp; border-corner: ui/textures/hud/border_corner.bmp; border-width: 4; border-height: 4;">
		<caption id="arena-header" rleft="10" rtop="6" height="20" width="430" style="font-size: +5; color: #BFE2CE;" label="${login.arenaselect.arenaheader}" align="center"/>
		<image rleft="10" rtop="22" src="ui/textures/test/horiz_underline.bmp" width="430" height="12"/>
		<view x="10" rtop="34" width="430" height="15">
			<caption x="0" y="0" width="16" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;" label="" align="center"/>
			<caption x="18" y="0" width="400" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;" label="${login.arenaselect.list.name}" align="center"/>
		</view>
		<list id="ArenaList" rleft="10" rtop="51" width="430" height="315"
					onselect="arena_list.clickList(false)" ondblselect="arena_list.clickList(true)">
			<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
		</list>

		<button id="back-button" label="${login.arenaselect.back}" rleft="20" rbottom="10" width="160" height="30" onclick="BackClicked()"
					style="control-on: ui/textures/test/back_on.bmp; control-off: ui/textures/test/back_off.bmp; control-disabled: ui/textures/test/back_disabled.bmp; color: #FFFFFF; font-size: -2;"
					onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
		<button id="offline-button" label="${login.arenaselect.offline}" rleft="20" rbottom="10" width="160" height="30" onclick="OfflineClicked()"
					style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; color: #FFFFFF; font-size: -2;"
					onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
		<button id="forward-button" label="${login.arenaselect.forward}" rright="20" rbottom="10" width="160" height="30" onclick="ForwardClicked()"
					style="control-on: ui/textures/test/next_on.bmp; control-off: ui/textures/test/next_off.bmp; control-disabled: ui/textures/test/next_disabled.bmp; color: #FFFFFF; font-size: -2;"
					onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
	</view>
	<script>
		<!--
		var arena_list = new ListControl(findview("ArenaList"), ClickArena);
		var update_timer = new CycleTimer(30000);
		
		var forward_button = findview("forward-button");
		var back_button = findview("back-button");
		var offline_button = findview("offline-button");
		
		function InitWindow() {
			forward_button.enabled = false;
			if ( true ) // TODO: Steam
				back_button.visible = false;
			else
				offline_button.visible = false;
			
			update_timer = new CycleTimer(30000);
			
			auth.OnArenaUpdate = OnArenaUpdate;
			auth.OnArenaJoin = OnArenaJoin;
		}
		
		function UpdateWindow() {
			if ( update_timer.run() )
				auth.PollArenas();
			
			forward_button.enabled = (arena_list.data != null && arena_list.data.can_join == true);
		}
		
		//======
		
		function OnArenaJoin() {
			if ( game.player.client.connecttoarena() ) {
				auth.Disconnect();
				window.close();
				// The GUI state starts/stops based on what we're connected to, if anything.
				game.player.client.loadrootwindow();
			} else {
				showOk(getlocstring("login.arenaselect.failedtoconnect"));
			}
		}
		
		//======
		
		function OnArenaUpdate() {
			arena_list.clearRows(false);
			
			if ( auth.arenas.length > 0 ) {
				for ( var i = 0 ; i < auth.arenas.length ; ++i ) {
					var arena = auth.arenas[i];
					var name = arena.name;
					var state = arena.state;
					var color = GetArenaColor(state, arena.can_join);
					
					var row = "<view id='" + arena.id + "' width='417' height='16' aspectalign='left' onmouseenter='arena_list.mouseEnter(this)' onmouseexit='arena_list.mouseExit(this)'>\
					               <image x='0' y='0' src='ui/textures/arenas/" + state + ".dds' width='16' height='16' style='font-size: +1; color: " + color + ";' tip='${login.arenaselect.states." + state + ".tip}'/>\
					               <caption id='arena-name' x='18' y='0' width='277' height='16' style='font-size: +1; color: " + color + ";' label='" + name + "'/>\
					           </view>";
					arena_list.addRow(arena, row);
				}
			} else {
				var row = "<view id='arenas_empty' width='418' height='16' aspectalign='left'>\
				               <caption id='arena-name' x='0' y='0' width='250' height='16' style='color: #e9e3d9ff;'\
				                     label='" + getlocstring("login.arenaselect.noarenas") + "'/>\
				           </view>";
				arena_list.addRow(null, row);
			}
			arena_list.postInit();
		}
		
		function ClickArena(dblclick) {
			if ( dblclick )
				ForwardClicked()
		}
		
		function GetArenaColor(state) {
			// TODO: Cycle by types
			return "#e9e3d9ff";
		}
		
		//==============
		
		function ForwardClicked() {
			if ( arena_list.data == null || ! arena_list.data.can_join )
				return;
			
			soundPlayClick();
			auth.JoinArena(arena_list.data);
		}
		
		function BackClicked() {
			soundPlayClick();
			auth.Disconnect(); // In order to change our login we need to disconnect.
			loadWin("LoginConnecting", true);
		}
		
		function OfflineClicked() {
			soundPlayClick();
			auth.Disconnect();
			loadWin("offline", true);
		}
		-->
	</script>
</window>