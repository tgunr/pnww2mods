<?xml version="1.0"?>
<window id="Login-Connecting" x="0" y="0" width="1024" height="768" viewportwidth="1024" viewportheight="768" modal="true" aspectalign="center">
	<view width="250" height="50" style="background-color: #00000088; 
							border-sides: ui/textures/hud/border_side.bmp;
							border-corner: ui/textures/hud/border_corner.bmp;
							border-width: 4;
							border-height: 4;" moveondrag="yes" aspectlimit="width">
		<caption id="username-label" rleft="10" rtop="10" height="30" width="230" label="${login.connectingtoauth}" style="font-size:+2; color:#ffffff; align=center"/>
	</view>
</window>




<view id="connecting-window" visible="false"
				onshow="ConnectingInit()"/>

<!-- LOGIN -->
<view id="userlogin-window" x="350" y="400" width="350" height="100" style="background-color: #00000088; 
				border-sides: ui/textures/hud/border_side.bmp; border-corner: ui/textures/hud/border_corner.bmp; border-width: 4; border-height: 4;"
			visible="false" moveondrag="yes"
			onshow="UserloginInit()" onhide="UserloginKill()" onupdate="UserloginUpdate()">
	>
	<caption id="username-label" rleft="10" rtop="10" height="20" width="100" label="${login.username}" style="font-size:+1; color:#ffffff; align=right"/>
	<textcontrol id="username" rright="10" rtop="10" height="20" width="200" acceptsfocus="true" style="background-color: #FFFFFF; font-size:+1; color: #000000;"
				maxlength="40" onenter="UsernameEntered()"/>
	<caption id="password-label" rleft="10" rtop="35" height="20" width="100" label="${login.password}" style="font-size:+1; color:#ffffff; align=right"/>
	<textcontrol id="password" rright="10" rtop="35" height="20" width="200" acceptsfocus="true" style="background-color: #FFFFFF; font-size:+1; color: #000000;"
				onenter="PasswordEntered()"/>
	<button id="connect-button" label="${login.connect}" rleft="137" rtop="70" width="150" height="30"
				style="control-on: ui/textures/test/next_on.bmp; control-off: ui/textures/test/next_off.bmp; control-disabled: ui/textures/test/next_disabled.bmp; color: #FFFFFF; font-size: -3;"
				onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"
				onclick="soundPlayClick(); AttemptLogin();"/>
</view>

<!-- ARENA SELECT -->
<view id="arenas-window" x="350" y="400" width="444" height="411"
			visible="false"
			onshow="ArenasInit()" onhide="ArenasKill()" onupdate="ArenasUpdate()">
	<caption id="arena-header" rleft="10" rtop="12" height="20" width="400" style="font-size: +2; color: #BFE2CE;"/>
	<image rleft="10" rtop="22" src="ui/textures/test/horiz_underline.bmp" width="425" height="12"/>
	<view x="10" rtop="34" width="425" height="15">
		<caption x="0" y="0" width="24" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;" label="${arenaselect.list.name}"/>
		<caption x="26" y="0" width="399" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;" label="${arenaselect.list.state}" align="center"/>
	</view>
	<list id="ArenaList" rleft="10" rtop="34" width="425" height="340"
				onselect="arena_list.clickList(false)" ondblselect="arena_list.clickList(true)">
		<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
	</list>
</view>