		</tab>
		<tab id="map" label="  &common.map.tab;  " x="20" y="10" width="930" height="460"
			onshow='setHelp(getlocstring("common.map.tab.help")); tplTab()' tip="&common.map.tab.tip;">
			<include file="widgets/map.uixml"/>
