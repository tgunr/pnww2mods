<?xml version="1.0"?>
 
<window id="help" x="0" y="0" width="1024" height="768"  viewportwidth="1024" viewportheight="768" layer="90" modal="true"
	onclick="doNextHelp()" aspectalign="center">
	<include file="lib/common.uixml"/>
	<include file="classes/ListControl.uixml"/>
	<include file="classes/ViewBuilder.uixml"/>
	<include file="classes/TextBuilder.uixml"/>
	<view id="help-popup" x="200" width="400" height="300" rtop="120" moveondrag="yes" aspectlimit='width'
		style="background-color: #000000;
				border-width: 4;
				border-height: 4;
				shadow-type: point;
				shadow-color: #3e524899;
				shadow-border-color: #BFE2CE88">
		<tabview id="help-tab" x="10" y="30" rright="10" rtop="10" style="color: #BFE2CE;
				control-on-endcap:  ui/textures/test/body_tab_cap_on.bmp;
				control-on-back:  ui/textures/test/body_tab_filler_on.bmp;
				control-off-endcap: ui/textures/test/body_tab_cap.bmp;
				control-off-back: ui/textures/test/body_tab_filler.bmp;
				control-on-color: #FFFFCE;
				border-width: 16;
				border-height: 16;">
			<tab label="   ${help.current}   " x="0" y="0" rright="0" rtop="0">
				<view x="0" y="0" rright="0" rtop="20" style="border-color: #3e5248;">
					<caption id="help-title" x="10" height="20" rright="10" rtop="10" style="font-size: +3; color: #FFFFFFFF;"/>
					<text id="help-body" x="15" y="10" rtop="40" rright="10" acceptfocus="no"
						style="color: #e9e3d9ff; border-size-right: 10;">
						<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
					</text>
				</view>
			</tab>
			<tab label="   ${help.index}   " x="0" y="0" rright="0" rtop="0">
				<view x="0" y="0" rright="0" rtop="20" style="border-color: #3e5248;">
					<list id="help-toc" x="5" y="5" rright="5" rtop="5"
						onselect="helpTocList.clickList(false)" ondblselect="helpTocList.clickList(true)">
						<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
					</list>
				</view>
			</tab>
		</tabview>
		<caption width="130" height="15" rright="40" rtop="10"
			style="color: #FFFFFFFF;" onupdate="showPosition(this)"/>
		<caption id="help-info" width="130" height="15" rright="10" rtop="10" align="right"
			style="color: #BFE2CE;" tip="${help.nav.current.tip}"/>
		<view id="help-cp" x="5" y="5" rright="5" height="20">
			<caption id="help-last" x="5" y="5" width="100" height="15" align="left"
				style="background-color: #BFE2CE44;  color: #BFE2CE;"
				onclick="doLastHelp()" ondblclick="doLastHelp()"/>
			<caption id="help-close" x="107" y="5" height="15" rright="107" align="center"
				style="background-color: #BFE2CE44;  color: #BFE2CE;"
				label="${help.nav.close}" onclick="doCloseHelp()"/>
			<caption id="help-next" y="5" width="100" height="15" rright="5" align="right"
				style="background-color: #BFE2CE44;  color: #BFE2CE;"
				onclick="doNextHelp()" ondblclick="doNextHelp()"/>
		</view>
	</view>
	<script>
		<!--
		
		var helpPages	= 0;
		var helpTOC		= null;
		var helpContent = null;
		var helpIndex	= -1;
		var helpTocList = new ListControl(findview("help-toc"), selectHelpTOC);
		var helpTab 	= window.findview("help-tab");
		var helpPopup 	= window.findview("help-popup");
		var helpTitle 	= window.findview("help-title");
		var helpBody 	= window.findview("help-body");
		var helpLast 	= window.findview("help-last");
		var helpNext 	= window.findview("help-next");
		var helpInfo 	= window.findview("help-info");
		var helpCache	= new Array();

		function initHelp(toc)
		{
			helpTOC = toc;
			initTOC();
			setContent(helpTOC);
			//setHelpPosition(helpTOC.position);
			game.cursor.visible = true;
		}
		
		function initTOC()
		{
			consoleclear();
			var toc 	= helpTOC.links;
			var width 	= helpTocList.list.nwidth - 12;
			
			helpPages = (toc != null) ? toc.length + 1: 1;
			helpTocList.clearRows(true);
			
			var rb 	= new ViewBuilder(helpTocList, "tocintro", 0, 0, width, 16);
			var vb 	= rb.addBuilder(new TextBuilder(rb, null, "caption", helpTOC.title));
			
			vb.addStyle("color", "#e9e3d9ff");
			
			helpTocList.addRow(-1, rb.build());
			
			if(toc != null)
			{
				for(var i = 0; i < toc.length; i++)
				{
					var link = toc[i];
					
					rb 	= new ViewBuilder(helpTocList, "toc" + i, 0, 0, width, 16);
					rb.addAttribute("onmouseenter", "helpTocList.mouseEnter(this)");
					rb.addAttribute("onmouseexit", "helpTocList.mouseExit(this)");
					
					vb 	= rb.addBuilder(new TextBuilder(rb, null, "caption", link.title));
					vb.addStyle("color", "#e9e3d9ff");
					
					helpTocList.addRow(i, rb.build());
				}
			}
			
			helpTocList.postInit();
			setNavLabels();
		}
		
		function setContent(content)
		{
			if(content)
			{
				helpTitle.label = content.title;
				helpBody.text 	= initBody(content.body);
				helpInfo.label 	= (helpIndex + 2) + " / " + helpPages;
				
				// reset the scroll position
				helpBody.scrollto(0);
				
				setHelpPosition(content.position);
				setHelpTarget(content.target);
				
				// show the current contents
				helpTab.value = 0;
				
				setNavLabels();
			}
		}
		
		function setHelpPosition(p)
		{
			helpPopup.x = window.width/2 - helpPopup.width/2;
			helpPopup.y = window.height/2 - helpPopup.height/2;
			
			if(p != null)
			{
				var position = p.split("x");
				
				if(position.length == 2)
				{
					if(position[0] != "CENTER" && position[0] != "center")
						helpPopup.x = window.scalev("w", position[0]);
					
					if(position[1] != "CENTER" && position[1] != "center")
						helpPopup.y = window.scalev("h", position[1]);
				}
			}
		}
		
		function setHelpTarget(t)
		{
			helpPopup.shadowx = window.width/2;
			helpPopup.shadowy = window.height/2;
					
			if(t != null)
			{
				var target = t.split("x");
				
				if(target.length == 2)
				{
					if(target[0] != "CENTER" && target[0] != "center")
						helpPopup.shadowx = window.scalev("w", target[0]);
					
					if(target[1] != "CENTER" && target[1] != "center")
						helpPopup.shadowy = window.scalev("h", target[1]);
				}
				else
				{
					target = t.split(":");
					
					if(target.length > 1)
					{
						consoleprint("Trying tab target: " + t + "\n"); 
						var targetView = game.findview(target[0]);
						
						if(targetView != null)
						{
							consoleprint("Found tab target: " + target[0] + "\n");
							var tab = (isNaN(target[1])) ? targetView.findview(target[1]): targetView.getchild(target[1]);
							
							if(tab != null)
							{
								consoleprint("Found tab: " + target[1] + "\n");
								
								var tx 	= tab.tabx; //targetView.screenx + // wtf?
								var ty 	= targetView.screeny + tab.taby;
								
								consoleprint("TSX: " + targetView.screenx + ", TSY: " + targetView.screeny + "\n");
								consoleprint("TTX: " + tab.tabx + ", TTY: " + tab.taby + "\n");
								consoleprint("TX: " + tx + ", TY: " + ty + "\n");
								
								if(target.length > 2)
								{
									consoleprint("Tab target has an offset: " + target[2] + "\n");
									
									var offset = target[2].split(",");
									
									if(offset.length == 1)
									{
										consoleprint("X offset found: " + offset[0] + "\n");
										var ox = parseInt(offset[0]);
										
										tx += (ox < 0) ? tab.tabw + ox: ox;
										ty += tab.tabh/2;
									}
									else if(offset.length >= 2)
									{
										consoleprint("XY offset found: " + offset[0] + "," + offset[1] + "\n");
										var ox = parseInt(offset[0]);
										var oy = parseInt(offset[1]);
										
										tx += (ox < 0) ? tab.tabw + ox: ox;
										ty += (oy < 0) ? tab.tabh + oy: oy;
									}
									else
									{
										consoleprint("No offsets found 1\n");
										tx += tab.tabw/2;
										ty += tab.tabh/2;
									}
								}
								else
								{
									consoleprint("No offsets found 2\n");
									tx += tab.tabw/2;
									ty += tab.tabh/2;
								}
								
								consoleprint("Seting shadow X to " + tx + "\n");
								consoleprint("Seting shadow Y to " + ty + "\n");
								
								helpPopup.shadowx = tx;
								helpPopup.shadowy = ty;
							}
						}
					}
					else
					{
						var targetView = game.findview(t);
						
						if(targetView != null)
						{
							helpPopup.shadowx = targetView.width/2;
							helpPopup.shadowy = targetView.screeny + targetView.height/2;
						}
					}
				}
			}
		}
				
		function doLastHelp()
		{
			if(helpPages > 1)
			{
				soundPlayClick();
				
				helpIndex -= 1;
				
				if(helpIndex < -1)
					helpIndex = -1;
					
				setNavLabels();
				
				helpTocList.clickList(false, helpIndex + 1);
			}
		}
		
		function doNextHelp()
		{
			if(helpPages > 1)
			{
				soundPlayClick();
				
				var lastHelpIndex = helpIndex;
				
				helpIndex += 1;
				
				if(helpIndex >= helpTOC.links.length)
					doCloseHelp();
				
				setNavLabels();
				
				helpTocList.clickList(false, helpIndex + 1);
			}
			else
			{
				doCloseHelp();
			}
		}
		
		function setNavLabels()
		{
			helpLast.label = (helpIndex >= 0) ? '  < ' + getlocstring('help.nav.last'): '';
			helpNext.label = (helpPages > 1 && helpIndex < helpTOC.links.length - 1) ? getlocstring('help.nav.next') + ' >  ': getlocstring('help.nav.done') + '    ';
		}
		
		function doCloseHelp()
		{
			game.cursor.update(window.name);
			soundPlayClick();
			window.close();
		}
		
		function showPosition(caption)
		{
			caption.label = ""; //"Mouse is at " + normalizeX(game.cursor.x) + "," + normalizeY(window.height - game.cursor.y);
		}
		
		function selectHelpTOC(dblclick)
		{
			helpIndex = helpTocList.data;
			
			if(helpPages > 1 && helpIndex >= 0 && helpIndex < helpTOC.links.length)
				setContent(game.getcontent(helpTOC.links[helpIndex].path));
			else
				setContent(helpTOC);
		}
		
		function initBody(body)
		{
			if(body != null)
			{
				var input		= false;
				var regex 		= /\{([^\}]+)\}/;
				var match 		= regex.exec(body);
				var maxloops	= 5;
				
				while(match != null && match.length > 0)
				{
					if(!input)
					{
						game.initkeymaps();
						input = true;
					}
					
					var parts 	= match[1].split(".");
					var control	= parts[0];
					var keyname	= game.getkeymapkey(control);
					
					if(keyname == control)
					{
						if(parts.length == 2)
						{
							cprint("looking up keyname 2\n");
							keyname = game.getkeymapkey(control, parseInt(parts[1]), -1);
						}
						else if(parts.length >= 3)
						{
							cprint("looking up keyname 3\n");
							keyname = game.getkeymapkey(control, parseInt(parts[1]), parseInt(parts[2]));
							
							if(parts.length == 5) // used by axis
							{
								cprint("looking up keyname 5\n");
								var keyname2 = game.getkeymapkey(control, parseInt(parts[3]), parseInt(parts[4]));
								
								if(keyname2 != control)
									keyname += "/" + keyname2;
							}

						}
					}
					
					var replace = "(" + keyname + ")";
					
					cprint("Found input match: " + match.join('/') + '/' + replace + "\n");
					
					body 	= body.replace(match[0], replace);
					match 	= regex.exec(body);
					
					maxloops -= 1;
					
					if(maxloops <= 0)
						break;
				}
				
				if(input)
					game.killkeymaps();
			}
			
			return body;
		}
		
		-->
	</script>
</window>

