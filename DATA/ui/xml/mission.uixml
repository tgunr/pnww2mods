				</tab>
				<tab x="17" y="17" width="896" height="414" style="background-color: #00000066;" showtab='false' acceptmouseclick='false'>
					<caption x="10" y="210" rright="10" height="20" style="font-size: +2; color: #ffffff;" align="center"
						onshow="this.label = (pendingResults) ? getlocstring('mission.aartab.pending'): getlocstring('mission.aartab.pending.none')"/>
				</tab>
			</tabview>
			<script>
				<!--
				
				// aar specific scripts
				
				var pendingResults	= false;
				var resultsView		= findview("mission-results");
				var resultsDetails	= findview("mission-results-details");
				var sortieList		= new ListControl(findview("sorties"), sortieSelect);
				var killList		= new ListControl(findview("kills"));
				
				function showAARTab()
				{
					consoleprint("Show AAR\n");
					
					setHelp(getlocstring('mission.aartab.help'));
					initSortieResults();
					
					if(!pendingResults && game.globals.sorties.length > 0)
					{
					 	resultsView.value = 0;
					 	initMissionSummary();
						quickhelp('aar');
					}
					else
					{
					 	resultsView.value = 1;
					}
				}
				
				function initSortieResults()
				{
					consoleprint("Init sorties\n");
					
					sortieList.clearRows(true);
					
					var sorties = game.globals.sorties;
					var width	= sortieList.list.nwidth - 12;
					
					if(sorties != null)
					{
						for(var i = 0; i < sorties.length; i++)
						{
							var sortie = sorties[i];

							var row = "\
<view id='" + sortie.id + "' width='" + width + "' height='16' aspectalign='left' onmouseenter='sortieList.mouseEnter(this)' onmouseexit='sortieList.mouseExit(this)'>\
	<caption id='sortie-spawned-caption' x='0' y='0' width='85' height='16' style='color: #e9e3d9ff; '\
		label='" + sortie.id + "'/>\
	<caption id='sortie-weapon-caption' x='87' y='0' width='118' height='16' style='color: #e9e3d9ff; '\
		label='" + sortie.weapon + "'/>\
	<caption id='sortie-caps-caption' x='209' y='0' width='68' height='16' style='color: #e9e3d9ff; '\
		label='" + sortie.numcaptures + "' align='center'/>\
	<caption id='sortie-kills-caption' x='281' y='0' width='68' height='16' style='color: #e9e3d9ff; '\
		label='" + sortie.numkills + "' align='center'/>\
	<caption id='sortie-result-caption' x='353' y='0' width='78' height='16' style='color: #e9e3d9ff; '\
		label='" + htmlencode(sortie.rtb(false)) + "' align='center'/>\
</view>";
							
							sortieList.addRow(sortie, row);
						}
						
						sortieList.postInit(0);
					}
				}
				
				function initSortieKills()
				{
					consoleprint("Init kills\n");
					
					killList.clearRows(true);
					
					if(sortieList.data != null)
					{
						var sortie 	= sortieList.data;
						var types	= sortie.kills;
						
						if(types && types.length > 0)
						{
							for(var i = 0; i < types.length; i++)
							{
								var type = types[i];
								
								var row = "\
<view id='sortie_0' width='400' height='16' aspectalign='left'>\
	<caption id='kill-type-caption' x='0' y='0' width='198' height='16' style='color: #e9e3d9ff; '\
		label='" + htmlencode(type.description) + "'/>\
	<caption id='kill-hits-caption' x='202' y='0' width='98' height='16' style='color: #e9e3d9ff; '\
		label='" + type.hits + "' align='right'/>\
	<caption id='kill-kills-caption' x='304' y='0' width='80' height='16' style='color: #e9e3d9ff; '\
		label='" + type.kills + "' align='right'/>\
</view>";
								
								killList.addRow(null, row);
							}
						}
						else
						{
							row = "\
<view id='sortie_0' width='400' height='16' aspectalign='left'>\
	<caption id='kill-type-caption' x='0' y='0' width='413' height='16' style='color: #e9e3d9ff; '\
		label='" + htmlencode(getlocstring('mission.aartab.aars.aar.kills.none')) + "'/>\
</view>";
							
							killList.addRow(null, row);
						}
					}
				}
				
				function sortieSelect(dblclick)
				{
					consoleprint("Select sortie\n");
					
					if(sortieList.data != null && dblclick)
					{
						var sortie 		= sortieList.data;
						var spawned		= sortie.spawned;
						var despawned	= sortie.despawned;
						var weapon 		= sortie.reserved;
						var notes		= findview("aar-notes");
						
						notes.text = "";
						
						findview("aar-title").label 			= getlocstring('mission.aartab.aars.aar') + " #" + sortie.id;
						findview("aar-unit").label 				= sortie.weapon;
						findview("aar-spawned").label 			= mission.origin.name;
						findview("aar-despawned").label 		= sortie.rtbfac;
						findview("aar-started").label 			= MissionResults.formatTime(spawned);
						findview("aar-stopped").label 			= MissionResults.formatTime(despawned);
						findview("aar-tom").label 				= getVariableLocString("mission.aartab.aars.aar.minutes", sortie.tom);
						findview("aar-killedby").label 			= sortie.killedby;

						findview("aar-result").label 			= sortie.rtb(true);
						findview("aar-kills").label 			= sortie.numkills;
						findview("aar-captures").label 			= sortie.numcaptures; // + " (" + sortie.numcapassists + ")";
						findview("aar-scored").label 			= sortie.pointsscored;
						findview("aar-guardingpoints").label 	= sortie.guardingpoints;

						if(sortie.nextrank != null && sortie.nextrank != "")
						{
							findview("aar-accumulated").label 		= getVariableLocString('mission.aartab.aars.aar.totalspoints', sortie.pointsaccumulated, sortie.pointsnextrank);
							findview("aar-nextrank").label 			= sortie.nextrank;
						}
						else
						{
							findview("aar-accumulated").label 		= getlocstring('mission.aartab.aars.aar.nextrank.max');
							findview("aar-nextrank").label 			= getlocstring('mission.aartab.aars.aar.nextrank.max');
						}

						findview("aar-kills2").label 			= sortie.numkills;
						findview("aar-captures2").label 		= sortie.numcaptures; // + " (" + sortie.numcapassists + ")";
						findview("aar-unitshit").label 			= sortie.unitshit;
						findview("aar-aishit").label 			= sortie.aishit;
						findview("aar-bridgeshit").label 		= sortie.bridgeshit;
						findview("aar-bridgesrepaired").label 	= sortie.bridgesrepaired;
						findview("aar-factorieshit").label 		= sortie.factorieshit;
						findview("aar-firebaseshit").label 		= sortie.firebaseshit;
						findview("aar-resupplies").label 		= getVariableLocString('mission.aartab.aars.aar.totalspoints', sortie.scoredresupplies, sortie.resupplies);
						findview("aar-guardingkills").label 	= sortie.guardingkills;
						findview("aar-capperkills").label 		= sortie.capperkills;

						if(sortie.promoted)
							notes.text += "* " + getlocstring('mission.aartab.aars.aar.notes.promoted') + "\n";

						if(sortie.mobilespawnees && sortie.mobilespawnees > 0)
							notes.text += "* " + getVariableLocString('mission.aartab.aars.aar.notes.ms', sortie.mobilespawnees) + "\n";

						if(notes.text == "")
							notes.text = getlocstring('mission.aartab.aars.aar.notes.none');

						initSortieKills();

						resultsDetails.value = 1;
					}
				}
				
				function showMissionResults()
				{
					consoleprint("Show Mission Results\n");
					
					musicPlayLoop();
					pendingResults = true;
					showTab(2);
					
					var timeleft = game.player.client.state.timeleft;
					
					if(timeleft != 0 && game.player.client.state.upsells)
					{
						game.load("upsell");
					}
					else if(timeleft >= 0)
					{
						checkTimeLeft(timeleft, true);
					}
				}
				
				function initMissionResults()
				{
					consoleprint("Init Mission Results\n");
					
					var results = new MissionResults(client.missionresults);
					
					if(client.reservedweapon != null)
					{
						consoleprint("Weapon already reserved!\n");
						showReservedWeapon();
					}
					else if(results.weaponindex > 0)
					{
						consoleprint("Attempting to reserve the last spawned weapon!\n");
						
						var vehicles 	= client.spawnablevehicles;
						var counts 		= client.weaponcounter;
						
						for(var i = 0; i < vehicles.length; i++)
						{
							if(vehicles[i].index == results.weaponindex && counts[i].current > 0)
							{
								consoleprint("Found a good match: " + vehicles[i].description + "\n");
								reserveWeapon(vehicles[i]);
								showReservedWeapon();
								break;
							}
						}
						
						if(client.reservedweapon == null)
							showWeaponSelect();
					}
					
					if(game.globals.sortietotals == null)
					{
						game.globals.sortietotals = new MissionTotals();

						for(var s = 0; s < game.globals.sorties.length; s++)
						 	game.globals.sortietotals.addResults(game.globals.sorties[s]);
					}

					if(game.globals.sorties == null)
						game.globals.sorties = new Array();

					game.globals.sorties.unshift(results);
					game.globals.sortietotals.addResults(results);

					if(game.globals.sorties.length >= 10)
						game.globals.sorties.pop();
					
					initSortieResults();
					initMissionSummary();

					resultsView.value = 0;
					pendingResults = false;
					sortieSelect(true);
					
					if(mission.state != null && mission.state != 1)
						showOk(getlocstring('mission.state.' + mission.state));
					
					if(results.promoted)
						game.load("promoted");
				}
				
				function initMissionSummary()
				{
				 	consoleprint("Init mission summary!\n");

				 	var sortietotals = game.globals.sortietotals;
				 	
				 	if(sortietotals != null)
				 	{
				 	 	sortietotals.calcUnits();

						findview("aar-summary-sorties").label 			= sortietotals.sorties;
						findview("aar-summary-tom").label 				= sortietotals.tom;
						findview("aar-summary-kills").label 			= sortietotals.numkills;
						findview("aar-summary-captures").label 			= sortietotals.numcaptures;
						findview("aar-summary-promotions").label 		= sortietotals.promoted;
						findview("aar-summary-msspawnees").label 		= sortietotals.mobilespawnees;
						
						findview("aar-summary-rtbs").label 				= sortietotals.rtbcodes[0];
						findview("aar-summary-rescues").label 			= sortietotals.rtbcodes[1];
						findview("aar-summary-mias").label 				= sortietotals.rtbcodes[2];
						findview("aar-summary-kias").label 				= sortietotals.rtbcodes[3];

						findview("aar-summary-favorite").label 			= sortietotals.favorite;
						findview("aar-summary-best").label 				= sortietotals.best;
						findview("aar-summary-worst").label 			= sortietotals.worst;

						findview("aar-summary-unitshit").label 			= sortietotals.unitshit;
						findview("aar-summary-aishit").label 			= sortietotals.aishit;
						findview("aar-summary-bridgeshit").label 		= sortietotals.bridgeshit;
						findview("aar-summary-bridgesrepaired").label 	= sortietotals.bridgesrepaired;
						findview("aar-summary-factorieshit").label 		= sortietotals.factorieshit;
						findview("aar-summary-firebaseshit").label 		= sortietotals.firebaseshit;
						
						findview("aar-summary-resupplies").label 		= getVariableLocString('mission.aartab.aars.aar.totalspoints', sortietotals.scoredresupplies, sortietotals.resupplies);

						findview("aar-summary-pointsscored").label 		= sortietotals.pointsscored;
						
						if(sortietotals.nextrank != null)
						{
							findview("aar-summary-pointsaccumulated").label = getVariableLocString('mission.aartab.aars.aar.totalspoints', sortietotals.pointsaccumulated, sortietotals.pointsnextrank);
							findview("aar-summary-nextrank").label 			= sortietotals.nextrank;
						}
						else
						{
						 	findview("aar-summary-pointsaccumulated").label = getlocstring('mission.aartab.aars.aar.nextrank.max');
							findview("aar-summary-nextrank").label 			= getlocstring('mission.aartab.aars.aar.nextrank.max');
						}
					}
				}

				-->
			</script>
		</tab>
		<tab id="map" label="  ${common.map.tab}  " x="20" y="10" width="930" height="460"
			onshow='setHelp(getlocstring("common.map.tab.help")); tplTab()' tip="${common.map.tab.tip}">
			<include file="widgets/map.uixml"/>
		</tab>
		<include file="widgets/globals/squads.uixml"/>
		<include file="widgets/globals/manuals.uixml"/>
		<include file="widgets/globals/settings.uixml"/>
	</tabview>
	<include file="widgets/infobar.uixml"/>
	<script>
		<!--
		
		game.consoleprint(">>> STARTING MISSION PAGE\n");
		
		var client 				= game.player.client;
		var mission 			= client.currentmission;
		var missionType			= getlocstring('common.mission.' + mission.typeid); //getMissionType(mission.origin, mission.target);

		var mobileSpawn			= true;					
		var theatreMap			= findview("mapview");
		var weaponPoll			= new CycleTimer(10000);
		var msPoll				= new CycleTimer(5000);
		var spawnDelay			= new CycleTimer(50);
		
		var membersCount		= 0; // total number of mission members
		var membersSpawned		= 0; // total number of spawned members
		var multiMate			= null;
		
		/***************** COMMON FUNCTIONS *******************/
		
		function doBack()
		{
			if(mission.poster == client.handle)
			{
				var popup = showConfirm(getlocstring('mission.back.decision'), doLeaderBack, getlocstring('common.yes'), getlocstring('common.no'));
				popup.setPopupClose(false);
			}
			else
			{
				if(client.reservedweapon)
					client.cancelweaponreservation();
				
				client.exitmission();
				//TutSetInstance(1);
				loadWin("brigade", true);
			}
		}
		
		function doLeaderBack(cancel)
		{
			if(cancel)
			{
				if(client.reservedweapon)
					client.cancelweaponreservation();
				
				client.cancelandexitmission();
				loadWin("brigade", true);
			}
		}
		
		function doForward()
		{
			setForwardEnabled(false);
			spawnDelay.add(10000);
			
			var weapon = vehicles[spawnTree.selectedData()];
			
			if(weapon == null || weapon.spawnable != "spawnable")
			{
				unreserveWeapon();
				return;
			}
			
			if(!client.reservedweapon && weapon != null)
				client.reserveweapon(weapon.type);
			
			if(client.reservedweapon)
			{
				if(spawnOptions.value != 3)
					showReservedWeapon();
				
				doSpawn();
			}
		}
		
		function initWin(win)
		{
			game.consoleclear();
			
			var chat = game.findview("chat");
			if(chat != null)
			{
				chat.x = window.width/2 - chat.width/2;
				chat.y = 10;
			}
			
			showChat(true, true);
			setHelp(getlocstring('mission.readytab.help'));
			setBack('mission.back');
			setForward('mission.forward');
			doWeaponPoll();
			
			// not sure why I need this
			if(game.globals.despawning != true)
				showWeaponSelect();
			
			// reset it
			game.globals.despawning = false;
			
			updateMissionMembers();
			
			// game callbacks
			client.onmissionroomchange		= updateMissionMembers;
			client.onmissionresults 		= initMissionResults;
			client.oncrewjoinaccept			= onCrewAccept;
			client.oncrewjoindeny			= onCrewDeny;
			client.oncrewbailed				= onCrewBailed;
			client.oncrewpostexpired		= onWeaponExpired;
			client.onbasecaptured 			= onBaseCaptured;
			client.onweaponlist				= onWeaponUpdate;
			client.onspawnerror				= onSpawnDenied;
			client.onreserveweapon		= onReserveWeapon;
			
			theatreMap.mgr.jumpTo(mission.target);
			missionMap.mgr.jumpTo(mission.target);
			
			var exitingVehicle = game.findview("exitvehicle");

			if(exitingVehicle != null)
			{
				var confirm = game.findview("despawn");
				confirm.doDespawnAction(true);
			}

			if(game.globals.sortietotals == null)
				game.globals.sortietotals = new MissionTotals();

			if(game.globals.sorties == null)
				game.globals.sorties = new Array();

			consoleprint("Spawn delay is currently at " + mission.spawndelay + "\n");
			
			initMissionSummary();
			quickhelp();
		}
		
		/***************** PAGE FUNCTIONS *****************/
		
		function doSpawn()
		{
			var weapon = new Object();

			weapon["description"] 	= client.reservedweapon.type.description;
			weapon["index"] 		= client.reservedweapon.type.index;
			weapon["serial"] 		= client.reservedweapon.serial;

			game.globals.spawnedweapon = weapon;

			musicKill();
			client.spawn(mobileSpawn && client.currentmission.mobilespawn);
		}
		
		function doWeaponPoll()
		{
			if(weaponPoll.run())
			{
				cprint("<<< Requesting weapon list\n");
				client.requestweaponlist(mission.origin);
				weaponPoll.add(30000); 
			}
		}
		
		function doMSPoll(caption)
		{
			if(msPoll.run())
			{
				if(client.currentmission.mobilespawn)
				{
					caption.label = getlocstring('brigade.hqtab.brief.ms.on');
					caption.setstyleproperty("color", "#00ff00");
					missionMsCheckbox.visible = true;
				}
				else
				{
					caption.label = getlocstring('brigade.hqtab.brief.ms.off');
					caption.setstyleproperty("color", "#e9e3d9ff");
					missionMsCheckbox.visible = false;
				}
			}
		}
		
		function updateMissionMembers()
		{
			var started 		= new Date();
			var members			= client.missionroomlist;
			var vehicleMgr		= new VehicleManager();
			var crewmen			= new Array();
			var commanders		= new Array();
			
			multiMate			= null;
			membersSpawned		= 0;
			membersCount		= members.length;
			
			memberList.clearRows(false);

			for(var i = 0; i < membersCount; i++)
			{
				/************ Update Member List **************/
				
				var member 	= members[i];
				
				//var leader		= "";
				//var multicrew	= "";
				var vehicle		= "-";
				var spawned		= "<image x='400' y='3' src='ui/textures/test/notspawned_icon.bmp' width='10' height='10' tip='" + getlocstring('mission.brieftab.brief.sstatus') + "'/>";
				
				if(member.weapon != null)
				{
					var memberWeapon = member.weapon;
					
					if(memberWeapon.description.toLowerCase() == "buzzard")
						continue;
					
					vehicle = memberWeapon.description;
					
					if(client.reservedweapon != null && member.serial == client.reservedweapon.serial && member.callsign.toUpperCase() != client.handle.toUpperCase())
						multiMate = member;
				}
				
				var rank		= member.rank;
				var callsign 	= member.callsign;
				
				if(member.wantscrew && !member.spawned)
					commanders[commanders.length] = member;
				
				if(member.iscrew)
					crewmen[crewmen.length] = member;
				
				//if(member.missionleader)
				//	leader = "<image x='366' y='3' src='ui/textures/test/leader_icon.bmp' width='10' height='10' tip='" + getlocstring('mission.brieftab.brief.lstatus') + "'/>";
				
				if(member.spawned)
					spawned = "<image x='400' y='3' src='ui/textures/test/spawned_icon.bmp' width='10' height='10' tip='" + getlocstring('mission.brieftab.brief.sstatus') + "'/>";
				/*
				if(member.commander)
					multicrew = "<image x='383' y='3' src='ui/textures/test/commander_icon.bmp' width='10' height='10' tip='" + getlocstring('mission.brieftab.brief.mstatus') + "'/>";
				else if(member.iscrew)
					multicrew = "<image x='383' y='3' src='ui/textures/test/gunner_icon.bmp' width='10' height='10' tip='" + getlocstring('mission.brieftab.brief.status') + "'/>";
				*/
				var row = "\
<view id='member_" + i + "' width='413' height='16' aspectalign='left'>\
	<caption id='member-rank-caption' class='rankicon' rank='" + (member.rank.level - 1) + "' x='5' y='1' width='14' height='14'/>\
	<caption id='member-name-caption' x='24' y='0' width='115' height='16' style='color: #e9e3d9ff; '\
		label='"+ callsign +"'/>\
	<caption id='member-vehicle-caption' x='154' y='0' width='210' height='16' style='color: #e9e3d9ff; '\
		label='" + vehicle + "'/>\
	" + spawned + "\
</view>";
				
				memberList.addRow(member, row);
				
				/************ Update Deployed List **************/
				
				if(vehicle != "-")
					vehicleMgr.addVehicle(vehicle);
				
				if(member.spawned)
					membersSpawned++;
			}
			
			memberList.setScrollY();
			
			initCrewList(crewmen);
			initCommanderList(commanders);
			initDeployedVehicles(vehicleMgr.getVehicles());
			
			var stopped = new Date();
			
			//game.consoleprint("Member List Update took " + (stopped.getTime() - started.getTime()) + "ms with " + membersCount + " members\n");
		}
		
		function getMissionType(missionOrigin, missionTarget)
		{
			var missionType = "";
			
			if(missionOrigin != null && missionTarget != null)
			{
				var originSide 	= missionOrigin.country.side;
				var targetSide 	= missionTarget.country.side;
				
				if(originSide == targetSide)
					missionType = (missionTarget.stratclass == "cp") ? getlocstring('common.mission.ad'): getlocstring('common.mission.pd');
				else
					missionType = (missionTarget.stratclass == "cp") ? getlocstring('common.mission.aa'): getlocstring('common.mission.pa');
			}
			else
			{
				missionType = "-";
			}
			
			return missionType;
		}
		
		function onCrewAccept()
		{
			showOk(getlocstring('mission.host.accept'), showReservedWeapon);
		}
		
		function onCrewDeny()
		{
			showOk(getlocstring('mission.host.denied'), showWeaponSelect);
		}
		
		function onCrewBailed()
		{
			showOk(getlocstring('mission.host.bailed'), showWeaponSelect);
		}
		
		function onWeaponExpired()
		{
			showOk(getlocstring('mission.host.expired'), showWeaponSelect);
		}
		
		function onBaseCaptured()
		{
			showOk(getlocstring('mission.host.captured'), doLeaderBack);
		}
		
		function onSpawnDenied(code)
		{
			consoleprint("Processing Spawn Denied Code: " + code + "\n");
			showOk(getlocstring('mission.spawn.denied' + code));
		}
		
		function onWeaponUpdate()
		{
			//game.consoleprint("Handling Weapon Update\n");
			cprint(">>> Received weapon list\n");
			
			initSpawnables();
			weaponPoll.reset();
		}
		
		function onReserveWeapon()
		{
			var rw = client.reservedweapon;
			
			if(rw)
			{
				var weapon = new Object();
	
				weapon["description"] 	= rw.type.description;
				weapon["index"] 				= rw.type.index;
				weapon["serial"] 				= rw.serial;
				
				game.globals.spawnedweapon = weapon;
			}
		}
		
		function updateSpawnDelay()
		{
			if(spawnDelay.run())
			{
				var delay = mission.spawndelay;
				
				if(mission.state != null && mission.state != 1)
				{
					setForward('mission.forward.closed');
					forwardButton.settip(getlocstring('mission.state.' + mission.state));
					setForwardEnabled(false);
				}
				else if(delay != null && delay > 0)
				{
					var titleText = getVariableLocString('mission.forward.delayed', delay);
					
					forwardButton.label = titleText.toUpperCase();
					forwardButton.settip(getlocstring('mission.forward.delayed.tip'));
					
					setForwardEnabled(false);
				}
				else
				{
					setForward('mission.forward');
					setForwardEnabled(true);
				}
			}
		}
		
		-->
	</script>
</window>
