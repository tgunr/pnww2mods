				<view x="10" y="175" width="250" height="190">
					<caption label="${mission.brieftab.brief}" x="5" y="170" width="225" height="20" style="color: #BFE2CE; font-size: +1;"/>
					<image x="5" y="165" src="ui/textures/test/horiz_underline.bmp" width="225" height="12"/>
					<caption label="${mission.brieftab.brief.leader}:" x="5" y="145" width="250" height="15" style="color: #FFFFFFFF; "/>
					<caption id="mission-leader" x="0" y="145" rright="15" height="20" style="color: #e9e3d9ff; " align="right"
						onupdate="this.label = mission.poster"/>
					<caption label="${mission.brieftab.brief.origin}:" x="5" y="130" width="250" height="15" style="color: #FFFFFFFF; "/>
					<caption id="mission-origin" x="0" y="130" rright="15" height="20" style="color: #e9e3d9ff; " align="right"
						onshow="this.label = mission.origin.name"/>
					<caption label="${mission.brieftab.brief.target}:" x="5" y="115" width="250" height="15" style="color: #FFFFFFFF; "/>
					<caption id="mission-target" x="0" y="115" rright="15" height="20" style="color: #e9e3d9ff; " align="right"
						onshow="this.label = mission.target.name"/>
					<caption label="${mission.brieftab.brief.type}:" x="5" y="100" width="250" height="15" style="color: #FFFFFFFF; "/>
					<caption id="mission-type" x="0" y="100" rright="15" height="20" style="color: #e9e3d9ff; " align="right"
						onshow="this.label = missionType"/>
					<caption label="${mission.brieftab.brief.members}:" x="5" y="85" width="250" height="15" style="color: #FFFFFFFF; "/>
					<caption id="mission-members" label="18" x="0" y="85" rright="15" height="20" style="color: #e9e3d9ff; " align="right"
						onupdate="this.label = membersCount"/>
					<caption label="${mission.brieftab.brief.spawned}:" x="5" y="70" width="250" height="15" style="color: #FFFFFFFF; "/>
					<caption id="mission-spawned" x="0" y="70" rright="15" height="20" style="color: #e9e3d9ff; " align="right"
						onupdate="this.label = membersSpawned"/>
				</view>
				<view x="260" y="175" width="175" height="190">
					<caption label="${mission.brieftab.brief.deployed}" x="5" y="170" width="165" height="20" style="color: #BFE2CE; font-size: +1;"/>
					<image x="5" y="165" src="ui/textures/test/horiz_underline.bmp" width="165" height="12"/>
					<list id="deployedList" x="5" y="8" width="165" height="155" style="color: #e9e3d9ff;">
						<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
					</list>
				</view>
				<view x="10" y="5" width="425" height="175">
					<caption label="${mission.brieftab.brief.orders}" x="0" height="20" width="300" rtop="0" style="font-size: +1; color: #BFE2CE;"/>
					<image x="0" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="12"/>
					<text x="5" y="5" width="415" height="145" acceptfocus="no" onshow="this.text = missionDescription()"
						style=" color: #e9e3d9ff; border-size-right: 10;">
						<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
					</text>
				</view>
			</view>
			<script>
				<!--
				
				// briefing specific scripts
				
				var memberList 		= new ListControl(findview("memberList"));
				var deployedList	= new ListControl(findview("deployedList"));
				
				function initDeployedVehicles(vehicles)
				{
					deployedList.clearRows(true);
					
					for(var i = 0; i < vehicles.length; i++)
					{
						var vehicle = vehicles[i];
						
						var row = "\
<view id='deployed_" + i + "' width='165' height='16' aspectalign='left'>\
	<caption id='deployed-name-caption' x='0' y='0' width='105' height='16' style='color: #e9e3d9ff; '\
		label='" + vehicle.name + "'/>\
	<caption id='deployed-count-caption' x='105' y='0' width='48' height='16' style='color: #e9e3d9ff; '\
		label='" + vehicle.count + "' align='right'/>\
</view>";
						
						deployedList.addRow(vehicle, row);
					}
				}
				
				function showMissionBriefing()
				{
					setHelp(getlocstring('mission.brieftab.help'));
				}
				
				function missionDescription()
				{
					var md = "";
					
					if(client.currentorders != null && client.currentorders != "")
						md = client.currentorders + "\n\n";
					
					if(mission.description != null && mission.description != "")
						md += mission.description;
					
					return md;
				}
				
				-->
			</script>
		</tab>
		<tab label="  ${mission.aartab}  " x="0" y="0" width="930" height="460"
			onshow="showAARTab(); tplTab()" tip="${mission.aartab.tip}">
			<tabview id="mission-results" x="0" y="0" rright="0" rtop="0" acceptmouseclick='false'>
				<tab x="0" y="0" rright="0" rtop="0" showtab='false' acceptmouseclick='false'>
					<view id="left-pane" x="18" y="18" width="444" height="411">
						<view x="10" width="425" height="25" rtop="10">
							<caption id="debrief-header" x="0" width="400" height="20" rtop="0" label="${mission.aartab.aars}" style="color: #BFE2CE; font-size: +2;"/>
							<image x="0" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="10"/>
						</view>
						<view x="10" width="425" height="15" rtop="32">
							<caption x="0" y="0" width="85" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
								label="${mission.aartab.aars.id}"/>
							<caption x="87" y="0" width="120" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
								label="${mission.aartab.aars.unit}"/>
							<caption x="209" y="0" width="70" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
								label="${mission.aartab.aars.caps}" align="center"/>
							<caption x="281" y="0" width="70" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
								label="${mission.aartab.aars.kills}" align="center"/>
							<caption x="353" y="0" width="80" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
								label="${mission.aartab.aars.result}" align="center"/>
						</view>
						<list id="sorties" x="10" y="20" width="425" height="342" style="color: #e9e3d9ff; "
							onselect="sortieList.clickList(false)" ondblselect="sortieList.clickList(true)">
							<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
						</list>
						<caption x="10" y="5" rright="10" height="15" style="color: #e9e3d9ff;"
							label="${mission.aartab.aars.more}" align="center"/>
					</view>
					<include file="widgets/divider.uixml"/>
					<view id="right-pane" x="468" y="18" width="444" height="411">
						<tabview id="mission-results-details" x="0" y="0" rright="0" rtop="0" acceptmouseclick='false'>
							<tab x="0" y="0" rright="0" rtop="0" showtab='false' acceptmouseclick='false'>
								 <view x="10" y="10" rright="10" rtop="10">
