<?xml version="1.0"?>

<window id="mission" x="0" y="0" width="1024" height="768" viewportwidth="1024" viewportheight="768"
	onshow="initWin(this)" onupdate="updateSpawnDelay()" aspectalign="center">
	<include file="lib/tutorial.uixml"/>
	<include file="widgets/template.uixml"/>
	<include file="classes/TreeControl2.uixml"/>
	<include file="classes/IntelFile.uixml"/>
	<include file="classes/MissionResults.uixml"/>
	<include file="classes/MissionTotals.uixml"/>
	<include file="classes/Timer.uixml"/>
	<include file="classes/CycleTimer.uixml"/>
	<include file="classes/VehicleManager.uixml"/>
	<include file="classes/VehicleClass.uixml"/>
	<tabview id="body" x="43" y="140" width="930" height="450" ontab="doBodyTab()" style="color: #BFE2CE;
						background-color: #000000BB; 
						border-top-corner: ui/textures/test/body_ul.bmp;
						border-bottom-corner: ui/textures/test/body_br.bmp;
						border-sides: ui/textures/test/body_sides.bmp;
						border-top: ui/textures/test/body_top.bmp;
						border-bottom: ui/textures/test/body_bottom.bmp;
						control-on-endcap:  ui/textures/test/body_tab_cap_on.bmp;
						control-on-back:  ui/textures/test/body_tab_filler_on.bmp;
						control-off-endcap: ui/textures/test/body_tab_cap.bmp;
						control-off-back: ui/textures/test/body_tab_filler.bmp;
						control-on-color: #FFFFCE;
						border-width: 16;
						border-height: 16;">
		<tab label="  ${mission.readytab}  " x="0" y="0" width="930" height="460"
			onshow='setHelp(getlocstring("mission.readytab.help")); tplTab()' onupdate="doWeaponPoll()" tip="${mission.readytab.tip}">
			<view id="left-pane" x="18" y="23" width="444" height="411">
				<tabview id="spawn-options" x="0" y="0" rright="0" rtop="0">
					<tab x="0" y="0" rright="0" rtop="0" showtab='false'>
						<!-- weapon selection -->
						<view x="10" width="425" height="400" rtop="12">
							<caption id="forces-header" x="0" height="20" width="425" rtop="0"
								onshow="this.label = getlocstring('mission.readytab.forces') + ' - ' + mission.origin.name.toUpperCase()"
								style="font-size: +2; color: #BFE2CE; tooltip: widgets/tooltips/supplytip.uixml;"/>
							<image x="0" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="10"/>
							<view x="0" width="425" height="15" rtop="22">
								<caption x="0" y="0" width="190" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
									label="${mission.readytab.forces.name}"/>
								<caption x="192" y="0" width="80" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
									label="${mission.readytab.forces.available}" align="right"/>
								<caption x="274" y="0" width="80" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
									label="${mission.readytab.forces.capacity}" align="right"/>
								<caption x="356" y="0" width="76" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
									label="${mission.readytab.forces.intel}        " align="right"/>
							</view>
							<list id="spawnTree" x="0" width="425" height="300" rtop="40" onselect="spawnTree.clickTree(false)" ondblselect="spawnTree.clickTree(true)"/>
							<caption label="${mission.readytab.supply.info}" x="10" height="15" y="65" rright="10"
								 style="color: #e9e3d9ff; font-size: -1;" acceptmouseclick="false"/>
							<text id="noVehicles" x="10" width="405" height="280" rtop="50"
								 style="color: #e9e3d9ff;" acceptmouseclick="false"/>
							<script>
								<!--
								
								// solo playmode logic
								
								var spawnTree 		= new TreeControl("spawnTree", selectSpawnable, formatSpawnable, isSelectable);
								var vehicles		= new Object();
								var rootNodes		= new Array();
								var forcesHeader	= findview("forces-header");
								var noVehicles		= findview("noVehicles");
								var bestSelection	= -1;
								
								function showWeaponSelect()
								{
									spawnOptions.value 	= 0;
									multicrewing		= false;
									
									setReserveCallback("reserve", selectSpawnable);
									setMultiCrewCallback("joinvehicle", showCommanderSelect);
									
									if(client.reservedweapon != null)
										unreserveWeapon();
									
									setMissionWeapon();
								}
								
								function findBestSelection(node)
								{
									/*
									var s = (node.data == null || (vehicles[node.data].current > 0 && vehicles[node.data].spawnable == "spawnable")) ? true: false;
									var v = vehicles[node.data];
									
									if(v)
										consoleprint("CHECKING BEST: " + node.data + "/" + node.row + "/" + v.type.description + "/" + v.current + "/" + v.spawnable + "/" + s + "\n");
									*/
									
									if(bestSelection == -1 && node.data && isSelectable(node))
									{
										bestSelection = node.row;
										//consoleprint("FOUND BEST: " + bestSelection + "\n");
									}
								}
								
								function initSpawnableTree()
								{
									var spawnables = client.spawnablevehicles;
									
									if(spawnables.length > 0)
									{
										noVehicles.visible = false;
										
										var classes = new Object();
										
										for(var i = 0; i < spawnables.length; i++)
										{
											var vehicle = spawnables[i];
											if(vehicle == null) continue;
											
											if(classes[vehicle.vclassid] == null)
												classes[vehicle.vclassid] = new TreeNode(vehicle.vclassid, null, 1, true, vehicle.vclass);
											
											classes[vehicle.vclassid].addNode(new TreeNode(vehicle.id, vehicle.index, 2, false));
											
											vehicles[vehicle.index] = new VehicleClass(vehicle);
										}
										
										var cids 	= new Array(9, 8, 4, 7, 5, 6, 2, 1, 12, 13, 14);
										var preopen	= null;
										
										for(var c = 0; c < cids.length; c++)
										{
											var node = classes[cids[c]];
											
											if(node != null)
											{
												if(preopen == null)
													preopen = node; // open the first node
												
												spawnTree.addNode(node, toggleNode);
												rootNodes[rootNodes.length] = node;
											}
										}
										
										if(preopen)
											preopen.expand();
									}
									else
									{
										if(client.lastspawnliststatus != null && client.lastspawnliststatus != "")
											noVehicles.text = getVariableLocString('mission.readytab.supply.status.' + client.lastspawnliststatus, client.nextsupply);
										else
											noVehicles.text = getlocstring("mission.readytab.novehicles");
										
										spawnTree.init = false;
									}
									
									spawnTree.setColorText(false);
								}
								
								function initSpawnables()
								{
									if(!spawnTree.initTree())
										initSpawnableTree();
									
									var counters 	= client.weaponcounter;
									var vcount		= 0;
									
									for(var i = 0; i < counters.length; i++)
									{
										var counter	= counters[i];
										if(counter == null) continue;
										var vehicle = vehicles[counter.index];
										
										if(vehicle != null)
										{
											vehicle.capacity 		= counter.capacity;
											vehicle.current 		= counter.current;
											vehicle.minimumrank 	= counter.minimumrank;
											vehicle.spawnable 		= counter.spawnable;
											
											vcount++;
										}
									}
									
									for(var i = 0; i < rootNodes.length; i++)
										rootNodes[i].children = rootNodes[i].children.sort(sortNodes);
									
									spawnTree.drawTree();
									
									if(bestSelection == -1)
									{
										spawnTree.findNodes(findBestSelection);	
										
										if(bestSelection >= 0)
											spawnTree.clickTree(false, bestSelection);
									}

									var spawnStatus = "";
									
									if(client.lastspawnlistsource != null)
										spawnStatus += getlocstring('mission.readytab.supply.supplier') + " " + client.lastspawnlistsource.name + "\n";
									
									spawnStatus += getlocstring('mission.readytab.supply.state') + " ";
									spawnStatus += getlocstring('mission.readytab.supply.state' + client.lastspawnliststate) + "\n\n";
									spawnStatus += getVariableLocString('mission.readytab.supply.status.' + client.lastspawnliststatus, client.nextsupply);
									
									forcesHeader.settip(spawnStatus);
								}
								
								function sortNodes(a, b)
								{
									if(vehicles[b.data].current < vehicles[a.data].current)
										return -1;
									else if(vehicles[b.data].current > vehicles[a.data].current)
										return 1;
									
									if(vehicles[b.data].type.index < vehicles[a.data].type.index)
										return -1;
									else if(vehicles[b.data].type.index > vehicles[a.data].type.index)
										return 1;
									
									return 0;
								}
								
								function isSelectable(node)
								{
									var s = (node.data == null || (vehicles[node.data].current > 0 && vehicles[node.data].spawnable == "spawnable")) ? true: false;
									var v = vehicles[node.data];
									
									//if(node.data != null)
									//	consoleprint("ISSELECTABLE: " + node.data + "/" + v.type.description + "/" + v.current + "/" + v.spawnable + "/" + s + "\n");
									
									return s;
								}
								
								function toggleNode(node)
								{
									if(!node.open)
									{
										for(var i = 0; i < rootNodes.length; i++)
										{
											if(rootNodes[i].open && rootNodes[i].id != node.id)
												rootNodes[i].open = false;
										}
									}
								}
								
								function formatSpawnable(tree, node)
								{
									var row 	= "";
									var name	= tree.list.id;
									var width	= tree.getWidth();
									var indent 	= tree.indent * node.level;
									
									if(node.branch)
									{
										var icon = (node.open) ? tree.collapseIcon: tree.expandIcon;
										
										row = "\
<view id='" + node.id + "' width='" + width + "' height='16' aspectalign='left' onmouseenter='" + name + ".mouseEnter(this)' onmouseexit='" + name + ".mouseExit(this)'\
	tip='" + htmlencode(getlocstring('mission.readytab.forces.branch.tip')) + "'>\
	<image src='" + icon + "' x='" + indent + "' y='3' width='10' height='10' onclick='" + name + ".clickTree(true, " + tree.count + ")'/>\
	<caption id='branch_title' x='" + (indent + tree.indent) + "' y='0' rright='1' height='16' style='color: #e9e3d9ff; '\
		label='" + htmlencode(node.description.toUpperCase()) + "'/>\
</view>";
									}
									else
									{
										var vehicle		= vehicles[node.data];
										var dcolor 		= (vehicle.current > 0) ? "#e9e3d9ff": "#AAAAAA";
										var color 		= getVehicleColor(vehicle);
										var mouseenter	= (vehicle.current > 0) ? "onmouseenter='" + name + ".mouseEnter(this)'": "";
										var mouseexit	= (vehicle.current > 0) ? "onmouseexit='" + name + ".mouseExit(this)'": "";
										var tip			= "";
										
										if((vehicle.spawnable != "invalid" && vehicle.spawnable != "spawnable") || vehicle.current == 0)
										{
											tip = (vehicle.current == 0) ?
												getlocstring('mission.readytab.spawn.empty'):
												getlocstring('mission.readytab.spawn.' + vehicle.spawnable);
										}
										
										var lock = "";
										var details = "\
	<caption id='solo-capacity' x='192' y='0' width='80' height='16' style='color: " + dcolor + "; '\
		label='" + vehicle.current + "' align='right'/>\
	<caption id='solo-count' x='274' y='0' width='80' height='16' style='color: " + dcolor + "; '\
		label='" + vehicle.capacity + "' align='right'/>";
										
										if(vehicle.spawnable == "slocked")
										{
											//details = "\
	//<caption x='192' y='0' width='160' height='16' style='color: #ff0000;' label='" + getlocstring('mission.readytab.slocked') + "' align='right'/>";
											
											lock = "\
	<image x='" + (indent - 12) + "' y='2' src='ui/textures/lock.dds' width='12' height='12' style='color: #FF0000;'/>";
										}
										
										if(tip.length > 0)
											tip += "\n\n";
										
										tip += getVariableLocString('mission.readytab.spawn.minimumrank', vehicle.minimumrank, client.persona.rank.level) + "\n";
										tip	= "tip = '" + htmlencode(tip) + "'";
										
										//color = getVehicleColor(vehicle);
										
										row = "\
<view id='" + node.id + "' width='" + width + "' height='16' aspectalign='left' " + mouseenter + " " + mouseexit + " " + tip + ">\
	" + lock + "\
	<caption x='" + indent + "' y='0' width='190' height='16' style='color: " + color + "; '\
		label='" + htmlencode(vehicle.type.description) + "'/>\
	" + details + "\
	<image x='380' y='0' src='ui/textures/test/intel_icon.bmp' width='16' height='16' onclick='showVehicleManual(\"" + getVehicleManual(vehicle.type) + "\")'\
	onmouseenter='this.src = \"ui/textures/test/intel_icon_on.bmp\"' onmouseexit='this.src = \"ui/textures/test/intel_icon.bmp\"'/>\
</view>";
									}
									
									return row;
								}
								
								function getVehicleColor(vehicle)
								{
									if(vehicle.spawnable == "slocked")
									{
										return "#FF0000"; // subscription locked
									}
									else if(vehicle.minimumrank > client.persona.rank.level)
									{
										return "#FFFF00"; // rank limited
									}
									else if(vehicle.current == 0)
									{
										return "#AAAAAA"; // out of supply
									}
									
									return "#00FF00"; // can spawn
								}
								
								function selectSpawnable(reserve)
								{
									if(reserve)
									{
										unreserveWeapon();
										
										var weapon = vehicles[spawnTree.selectedData()];
										
										if(weapon != null)
										{
											reserveWeapon(weapon.type);
											showReservedWeapon();
										}
									}
									
									setMissionWeapon();
								}
								
								function showVehicleManual(path)
								{
									consoleprint("Loading Vehicle manual " + path + "\n");
									findview("body").value = 5;
									initManuals(false);
									loadManual(path);
								}
								
								-->
							</script>
						</view>
					</tab>
					<tab x="0" y="0" rright="0" rtop="0" showtab='false'>
						<!-- commander panel -->
						<view x="10" width="425" height="400" rtop="12">
							<caption label="${mission.readytab.cmdr}" x="0" height="20" width="425" rtop="0" style="font-size: +2; color: #BFE2CE;"/>
							<image x="0" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="10"/>
							<view x="0" width="425" height="15" rtop="22">
								<caption x="0" y="0" width="425" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
									label="${mission.readytab.cmdr.crewman}"/>
							</view>
							<list id="crewList" x="0" width="425" height="295" rtop="40" 
								onselect="crewList.clickList(false)" ondblselect="crewList.clickList(true)">
								<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
							</list>
							<script>
								<!--
								
								// commonder list logic
								
								var crewList = new ListControl(findview("crewList"), crewSelect);
								
								function showCrewSelect()
								{
									var weapon = client.reservedweapon;
									
									if(weapon == null)
									{
										showWeaponSelect();
									}
									else if(!weapon.type.ismulticrew)
									{
										showReservedWeapon();
									}
									else
									{
										client.requestcrews();
										spawnOptions.value = 1;
										setReserveCallback("cancelreservation", showWeaponSelect);
										setMultiCrewCallback("selectcrew", crewSelect);
									}
								}
								
								function initCrewList(crewmen)
								{
									//consoleprint("Init crew list with " + crewmen.length + " crewmen\n");
									
									crewList.clearRows(false);
									
									if(crewmen.length > 0)
									{
										for(var i = 0; i < crewmen.length; i++)
										{
											var row = "\
<view id='crew" + i + "' width='413' height='16' aspectalign='left' onmouseenter='crewList.mouseEnter(this)' onmouseexit='crewList.mouseExit(this)'>\
	<caption x='0' y='0' width='185' height='16' style='color: #e9e3d9ff; ' label='" + crewmen[i].callsign + "'/>\
</view>";
											
											crewList.addRow(crewmen[i], row);
										}
									}
									else
									{
										var row = "\
<view id='crew" + i + "' width='413' height='16' aspectalign='left'>\
	<caption x='0' y='0' width='350' height='16' style='color: #e9e3d9ff; '\
		label='" + htmlencode(getlocstring('mission.readytab.panel.requestcrew.empty')) + "'/>\
</view>";
										
										crewList.addRow(null, row);
									}
									
									crewList.postInit();
								}
								
								function crewSelect(accept)
								{
									if(accept && client.acceptcrew(crewList.data))
										showReservedWeapon(true);
								}
								
								-->
							</script>
						</view>
					</tab>
					<tab x="0" y="0" rright="0" rtop="0" showtab='false'>
						<!-- crew panel -->
						<view x="10" width="425" height="400" rtop="12">
							<caption label="${mission.readytab.crew}" x="0" height="20" width="425" rtop="0" style="font-size: +2; color: #BFE2CE;"/>
							<image x="0" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="10"/>
							<view x="0" width="425" height="15" rtop="22">
								<caption x="0" y="0" width="185" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
									label="${mission.readytab.crew.commander}"/>
								<caption x="187" y="0" width="245" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
									label="${mission.readytab.crew.vehicle}"/>
							</view>
							<list id="commanderList" x="0" width="425" height="295" rtop="40" 
								onselect="commanderList.clickList(false)" ondblselect="commanderList.clickList(true)">
								<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
							</list>
							<script>
								<!--
								
								// crew playmode logic
								
								var commanderList = new ListControl(findview("commanderList"), commanderSelect);
								
								function showCommanderSelect()
								{
									var weapon = client.reservedweapon;
									
									if(weapon != null)
									{
										showReservedWeapon();
									}
									else
									{
										spawnOptions.value = 2;
										setReserveCallback("canceljoin", showWeaponSelect);
										setMultiCrewCallback("selectcommander", commanderSelect);
										client.requestcommanders();
									}
								}
								
								function initCommanderList(commanders)
								{
									//consoleprint("Init commander list with " + commanders.length + " commanders\n");
									
									commanderList.clearRows(false);
									
									if(commanders.length > 0)
									{
										for(var i = 0; i < commanders.length; i++)
										{
											var row = "\
<view id='commander" + i + "' width='413' height='16' aspectalign='left' onmouseenter='commanderList.mouseEnter(this)' onmouseexit='commanderList.mouseExit(this)'>\
	<caption x='0' y='0' width='185' height='16' style='color: #e9e3d9ff; '\
		label='" + commanders[i].callsign + "'/>\
	<caption x='187' y='0' width='233' height='16' style='color: #e9e3d9ff; '\
		label='" + ((commanders[i].weapon != null) ? commanders[i].weapon.description: "-") + "'/>\
</view>";
											
											commanderList.addRow(commanders[i], row);
										}
									}
									else
									{
										var row = "\
<view id='commander" + i + "' width='413' height='16' aspectalign='left'>\
	<caption x='0' y='0' width='350' height='16' style='color: #e9e3d9ff; '\
		label='" + htmlencode(getlocstring('mission.readytab.panel.joinvehicle.empty')) + "'/>\
</view>";
										
										commanderList.addRow(null, row);
									}
									
									commanderList.postInit();
								}
								
								function commanderSelect(join)
								{
									if(join)
										client.joincrew(commanderList.data);
								}
								
								-->
							</script>
						</view>
					</tab>
					<tab x="0" y="0" rright="0" rtop="0" showtab='false'>
						<!-- reserved panel -->
						<view x="10" width="425" height="400" rtop="12">
							<caption id="reserved-header" x="0" height="20" width="425" rtop="0" style="font-size: +2; color: #BFE2CE;"/>
							<image x="0" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="10"/>
							<tabview id="reserved-viewer" x="0" y="60" rright="0" rtop="30" acceptmouseclick='false'>
								<tab x="0" y="0" rright="0" rtop="0" showtab='false' acceptmouseclick='false'/>
								<tab x="0" y="0" rright="0" rtop="0" showtab='false' acceptmouseclick='false' onshow="showReservedInfo(this)">
									<text id="info-brief" x="20" rtop="10" width="260" height="200" acceptsfocus="no" style="color: #e9e3d9; font-size: +1;"/>
									<image id="info-image" width="140" height="300" rright="10" rtop="0" style="border-color: #BFE2CE;"/>
								</tab>
								<tab x="0" y="0" rright="0" rtop="0" showtab='false' acceptmouseclick='false' onshow="showReservedInfo(this)">
									<text id="info-brief" x="10" rtop="0" width="220" height="200" acceptsfocus="no" style="color: #e9e3d9; font-size: +1;"/>
									<image id="info-image" width="200" height="150" rright="10" rtop="0" style="border-color: #BFE2CE;"/>
									
									<view id="multicrew-buddy" x="10" width="425" height="100" rtop="220">
										<caption label="${mission.readytab.commander}:" x="0" height="20" width="425" rtop="10" style="color: #FFFFFF;"/>
										<caption id="multicrew-commander" height="20" width="425" rright="10" rtop="10" style="color: #e9e3d9;" align="right"/>
										<caption label="${mission.readytab.crewman}:" x="0" height="20" width="425" rtop="30" style="color: #FFFFFF;"/>
										<caption id="multicrew-crewman" height="20" width="425" rright="10" rtop="30" style="color: #e9e3d9;" align="right"/>
									</view>
								</tab>
							</tabview>
							<script>
								<!--
								
								// reserved weapon logic
								
								var reservedHeader 	= findview("reserved-header");
								var reservedViewer	= findview("reserved-viewer");
								
								function showReservedWeapon(mc)
								{
									var weapon = client.reservedweapon;
									
									if(weapon != null)
									{
										cprint("Reserved Weapon is " + weapon.type.id);
										reservedHeader.label 	= weapon.type.description.toUpperCase() + " " + getlocstring('mission.readytab.forces.reserved');; 
										reservedViewer.value	= (weapon.type.vclassid == 9 || weapon.type.vclassid == 14) ? 1: 2;
										
										multicrewing = (mc) ? true: false;
										
										spawnOptions.value = 3;
										setReserveCallback("cancelreservation", showWeaponSelect);
										
										if(multiMate != null)
										{
											var multiCommander 	= findview("multicrew-commander");
											var multiCrewman 	= findview("multicrew-crewman");
											
											if(multiMate.commander)
											{
												multiCommander.label 	= multiMate.callsign;
												multiCrewman.label 		= client.handle;
											}
											else
											{
												multiCommander.label 	= client.handle;
												multiCrewman.label 		= multiMate.callsign;
											}
											
											findview("multicrew-buddy").visible = true;
										}
										else
										{
											findview("multicrew-buddy").visible = false;
										}
										
										consoleprint("Showing reserved weapon: " + weapon.type.description + "/" + weapon.type.ismulticrew + "\n");
										
										if(weapon.type.ismulticrew && !multicrewing)
											setMultiCrewCallback("requestcrew", showCrewSelect);
										else
											multicrewButton.visible	= false;
									}
									else
									{
										cprint("Reserved Weapon is null");
										showWeaponSelect();
									}
								}
								
								function showReservedInfo(viewer)
								{
									var weapon = client.reservedweapon;
									
									if(weapon != null)
									{
										var content = game.getcontent(getVehicleManual(weapon.type));
										
										if(content)
										{
											var infoBrief	= viewer.findview("info-brief");
											var infoImage	= viewer.findview("info-image");
											
											infoBrief.text 	= content.brief;
											infoImage.src 	= (weapon.type.vclassid == 9 || weapon.type.vclassid == 14) ? content.image: "ui/textures/vehicles/" + content.image + ".bmp";
										}
										
										consoleprint("Showed reserved info!!!:  " + getVehicleManual(weapon.type) + "\n");
									}
									else
									{
										consoleprint("Trying to show reserved weapon, but if was null!!!\n");
										showWeaponSelect();
									}
								}
								
								-->
							</script>
						</view>
					</tab>
				</tabview>
				<view x="20" y="10" height="40" width="400" style="background-color: #00000088; 
									border-sides: ui/textures/test/infobox_side.bmp;
									border-corner: ui/textures/test/infobox_corner.bmp;
									border-width: 16;
									border-height: 16;">
					<button id="reserve-button" label="${mission.readytab.panel.reserve}" x="35" y="5" height="27" width="160"
						style="control-on: ui/textures/test/gen_button_on.bmp;
							control-off: ui/textures/test/gen_button_off.bmp;
							control-disabled: ui/textures/test/gen_button_disabled.bmp;
							font-size: -3;
							color: #FFFFFF;"
						onclick="if(reserveCallback != null) reserveCallback(true); soundPlayClick()"
						onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
					<button id="multicrew-button" label="${mission.readytab.panel.joinvehicle}" x="210" y="5" height="27" width="160"
						style="control-on: ui/textures/test/gen_button_on.bmp;
							control-off: ui/textures/test/gen_button_off.bmp;
							control-disabled: ui/textures/test/gen_button_disabled.bmp;
							font-size: -3;
							color: #FFFFFF;"
						onshow="this.visible = canJoinCrew()" onclick="if(multicrewCallback != null) multicrewCallback(true); soundPlayClick()"
						onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
				</view>
			</view>
			<include file="widgets/divider.uixml"/>
			<view id="right-pane" x="468" y="23" width="444" height="411">
				<view x="10" width="425" height="35" rtop="12">
					<!--  style="background-color: #000000;" -->
					<caption x="0" height="20" width="425" rtop="0"
						onshow="this.label = mission.target.name.toUpperCase() + ': ' + missionType.toUpperCase()" style="font-size: +2; color: #BFE2CE;"/>
					<image x="0" src="ui/textures/test/horiz_underline.bmp" width="425" height="12" rtop="10"/>
				</view>
				<view x="10" width="425" height="90" rtop="35">
					<caption label="${mission.readytab.brief.location}:" x="5" width="300" height="15" rtop="0" style="color: #FFFFFFFF; "/>
					<caption id="mission-location" width="300" height="15" rright="20" rtop="0" style="color: #e9e3d9ff; " align="right"
						onshow="this.label = mission.origin.name" onclick="missionMap.mgr.setSelection(mission.origin)"/>
					<image width="16" height="16" rright="0" rtop="0" src="ui/textures/test/zoom_icon.bmp"
						onclick="missionMap.mgr.setSelection(mission.origin)"
						onmouseenter="this.src = 'ui/textures/test/zoom_icon_on.bmp'" onmouseexit="this.src = 'ui/textures/test/zoom_icon.bmp'"/>
					
					<caption label="${mission.readytab.brief.origin}:" x="5" width="300" height="15" rtop="15" style="color: #FFFFFFFF; "/>
					<caption id="mission-origin" width="300" height="15" rright="20" rtop="15" style="color: #e9e3d9ff; " align="right"
						onshow="this.label = mission.origin.name" onclick="missionMap.mgr.setSelection(mission.origin)"/>
					<image width="16" height="16" rright="0" rtop="15" src="ui/textures/test/zoom_icon.bmp"
						onclick="missionMap.mgr.setSelection(mission.origin)"
						onmouseenter="this.src = 'ui/textures/test/zoom_icon_on.bmp'" onmouseexit="this.src = 'ui/textures/test/zoom_icon.bmp'"/>
					
					<caption label="${mission.readytab.brief.target}:" x="5" width="300" height="15" rtop="30" style="color: #FFFFFFFF; "/>
					<caption id="mission-target" width="300" height="15" rright="20" rtop="30" style="color: #e9e3d9ff; " align="right"
						onshow="this.label = mission.target.name" onclick="missionMap.mgr.setSelection(mission.target)"/>
					<image width="16" height="16" rright="0" rtop="30" src="ui/textures/test/zoom_icon.bmp"
						onclick="missionMap.mgr.setSelection(mission.target)"
						onmouseenter="this.src = 'ui/textures/test/zoom_icon_on.bmp'" onmouseexit="this.src = 'ui/textures/test/zoom_icon.bmp'"/>
					
					<caption label="${mission.readytab.brief.weapon}:" x="5" width="300" height="15" rtop="45" style="color: #FFFFFFFF; "/>
					<caption id="mission-weapon" width="300" height="15" rright="20" rtop="45" style="color: #e9e3d9ff; " align="right"/>

					<caption label="${brigade.hqtab.brief.ms}:" x="5" width="300" height="15" rtop="70" style="color: #FFFFFFFF; "/>
					<caption id="mission-ms" width="300" height="15" rright="20" rtop="70" style="color: #e9e3d9ff;" align="right" onupdate="doMSPoll(this)"
						onclick="setMobileSpawn()"/>
					<image id="mission-ms-checkbox" width="20" height="20" rright="0" rtop="65" src="ui/textures/map-checkbox-on.bmp"
						onclick="setMobileSpawn()" tip="${mission.readytab.brief.ms.tip}"/>
				</view>
				<view id="mission-map" class="mapview" acceptsfocus="no" minscale=".03" maxscale="1.5" scale=".75"
					x="10" y="5" width="425" height="270" sx="18" sy="235"
					onload="if(!this.mgr) new MapManager(this, true)" onshow="this.mgr.onShow()" 
					onupdate="this.mgr.onUpdate()" onclick="this.mgr.onClick()" ondblclick="this.mgr.onDblClick()"
					ondrag="this.mgr.onDrag()" onmouseenter="this.mgr.onMouseEnter()" onmouseexit="this.mgr.onMouseExit()"
					onrightclick="this.mgr.onRightClick()"
					style="tooltip: widgets/tooltips/maptip.uixml;">
					<layer type="texture" id="default-64-tex" minscale="0" maxscale="64" enabled="true" orign="-26x210" rowcolsize="1x1" cellsize="64x64"/>
					<layer type="icon" id="icons" minscale="1" maxscale="8" enabled="true"/>
					<layer type="icon" id="rendered" minscale="0" maxscale="1" enabled="true"/>
					<layer type="terrainobj" id="terrainobj" minscale="0" maxscale=".5" enabled="true"/>
					<layer type="hclinks" id="hclinks" minscale="0" maxscale="20" enabled="true"/>
					<layer type="strat" id="strat" minscale="0" maxscale="20" enabled="true">
						<filter name="showcivilian" value="no"/>
						<filter name="showbrigdes" value="no"/>
						<filter name="showarmy" value="yes"/>
						<filter name="showairforce" value="yes"/>
						<filter name="shownavy" value="yes"/>
						<filter name="showdepots" value="yes"/>
						<filter name="showcpnames" value="yes"/>
						<filter name="showfacnames" value="no"/>
						<filter name="showflags" value="yes"/>
						<filter name="showicons" value="yes"/>
						<filter name="fadeupdate" value="no"/>
						<filter name="fadefrontline" value="yes"/>
						<filter name="cptextcolor" value="#FFFF00"/>
						<filter name="factextcolor" value="#FFFFFF"/>
						<filter name="seltextcolor" value="#00FF00"/>
						<filter name="factextsize" value="12"/>
						<filter name="cptextsize" value="12"/>
						<filter name="showclutter" value="no"/>
						<filter name="cluttercutoff" value=".2"/>
					</layer>
				</view>
			</view>
			<script>
				<!--
				
				// ready room specific scripts
				var missionMap			= findview("mission-map");
				var spawnOptions		= findview("spawn-options");
				var reserveButton		= findview("reserve-button");
				var multicrewButton		= findview("multicrew-button");
				var missionWeapon		= findview("mission-weapon");
				var missionMs			= findview("mission-ms");
				var missionMsCheckbox	= findview("mission-ms-checkbox");
				
				var reserveCallback		= null;
				var multicrewCallback	= null;
				var multicrewing		= false;
				
				function setMobileSpawn()
				{
					if(client.currentmission.mobilespawn)
					{
						soundPlayClick();
						mobileSpawn 			= !mobileSpawn;
						missionMsCheckbox.src 	= (mobileSpawn) ? "ui/textures/map-checkbox-on.bmp": "ui/textures/map-checkbox-off.bmp";
					}
				}
				
				function setMissionWeapon()
				{
					var description = "N/A";
					
					if(client.reservedweapon != null)
					{
						description = client.reservedweapon.type.description; 
					}
					else
					{
						var weapon = vehicles[spawnTree.selectedData()];
						
						if(weapon != null)
							description = weapon.type.description;
					}
					
					missionWeapon.label = description;
				}
				
				function reserveWeapon(weapon)
				{
					if(client.reservedweapon == null)
						client.reserveweapon(weapon);
				}
				
				function unreserveWeapon()
				{
					if(client.reservedweapon != null)
						client.cancelweaponreservation();
				}
				
				function setReserveCallback(label, callback)
				{
					reserveButton.label = getlocstring('mission.readytab.panel.' + label);
					reserveButton.settip(getlocstring('mission.readytab.panel.' + label + '.tip'));
					reserveCallback	= callback;
				}
				
				function setMultiCrewCallback(label, callback)
				{
					multicrewButton.label = getlocstring('mission.readytab.panel.' + label);
					multicrewButton.settip(getlocstring('mission.readytab.panel.' + label + '.tip'));
					multicrewCallback = callback;
					multicrewButton.visible	= true;
				}
				
				function canJoinCrew()
				{
					return (!multicrewing && (client.reservedweapon == null || client.reservedweapon.type.ismulticrew));
				}
				
				-->
			</script>
		</tab>
		<tab id="briefing" label="  ${mission.brieftab}  " x="0" y="0" width="930" height="460"
			onshow="showMissionBriefing(); tplTab()" tip="${mission.brieftab.tip}">
