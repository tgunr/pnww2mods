													label="${mission.aartab.aars.aar.kills.hits}" align="right"/>
												<caption x="304" y="0" width="100" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
													label="${mission.aartab.aars.aar.kills}    " align="right"/>
											</view>
											<list id="kills" x="0" y="0" width="400" height="160" style="color: #e9e3d9ff;">
												<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
