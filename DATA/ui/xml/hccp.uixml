<?xml version="1.0"?>
<!DOCTYPE uixml SYSTEM "loc://ui.dtd"> 
<window id="hccp" x="0" y="0" width="1024" height="768"  viewportwidth="1024" viewportheight="768" layer="100"
	onshow="initHCCOntrol()">
	<include file="lib/common.uixml"/>
	<include file="classes/ListControl.uixml"/>
	<view id="hc-popup" x="200" rright="200" rtop="100" height="500" style="background-color: #000000DD;
							border-sides: ui/textures/hud/border_side.bmp;
							border-corner: ui/textures/hud/border_corner.bmp;
							border-width: 4;
							border-height: 4;" moveondrag="yes">
		<!-- welcome -->
		<view x="10" rtop="10" width="325" height="40" style="background-color: #ffffff00;" followtop="true">
			<caption label="&hccp.title;" x="0" rtop="0" rright="0" height="30" style="color: #BFE2CE; font-size: +4;"/>
			<-- image src="ui/textures/test/horiz_underline.bmp" x="0" rtop="20" rright="0" height="12"/>
		</view>
		
		<tabview id="hc-options" x="10" y="50" rtop="50" rright="10" style="color: #BFE2CE;
			background-color: #000000DD; 
			border-sides: ui/textures/hud/border_side.bmp;
			border-corner: ui/textures/hud/border_corner.bmp;
			control-on-endcap:  ui/textures/test/body_tab_cap_on.bmp;
			control-on-back:  ui/textures/test/body_tab_filler_on.bmp;
			control-off-endcap: ui/textures/test/body_tab_cap.bmp;
			control-off-back: ui/textures/test/body_tab_filler.bmp;
			control-on-color: #FFFFCE;
			border-width: 4;
			border-height: 4;">
			<tab label="  &hccp.tabs.notices;  " x="0" y="0" rright="0" rtop="0" onshow="setHCCPTab(0)">
				<view x="10" rright="10" y="10" rtop="25">
					<caption label="&hccp.tabs.notices.title;" x="10" height="20" rright="10" rtop="0" style="font-size: +2; color: #BFE2CE;"/>
					<image x="10" src="ui/textures/test/horiz_underline.bmp" rright="10" height="12" rtop="12"/>
					<view x="10" rright="10" height="15" rtop="23">
						<caption x="0" y="0" rright="76" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;"
							label="&hccp.tabs.notices.text;"/>
						<caption y="0" width="75" height="15" rright="0" style="background-color: #BFE2CE44;  color: #BFE2CE;"
							label="&hccp.tabs.notices.veto;" center="true"/>
					</view>
					<list id="noticeList" x="10" y="5" rright="10" rtop="42" onselect="noticeList.clickList(false)" onupdate="if(noticeUpdater.run()) updateNotices(true);">
						<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
					</list>
				</view>

			</tab>
			<tab label="  &hccp.tabs.map;  " x="0" y="0" rright="0" rtop="0" onshow="setHCCPTab(1)">
				<view id="hccp-map" class="mapview" acceptsfocus="no" minscale=".03" maxscale="4.0" scale=".75"
					x="10" y="10" rright="10" rtop="30" sx="18" sy="235"
					onload="if(!this.mgr) new MapManager(this, true)" onshow="this.mgr.onShow()" 
					onupdate="this.mgr.onUpdate()" onclick="this.mgr.onClick()" ondblclick="this.mgr.onDblClick()"
					ondrag="this.mgr.onDrag()" onmouseenter="this.mgr.onMouseEnter()" onmouseexit="this.mgr.onMouseExit()"
					onrightclick="this.mgr.onRightClick()"
					style="tooltip: widgets/tooltips/maptip.uixml;">
					<layer type="texture" id="default-64-tex" minscale="0" maxscale="64" enabled="true" orign="-26x210" rowcolsize="1x1" cellsize="64x64"/>
					<layer type="icon" id="icons" minscale="1" maxscale="8" enabled="true"/>
					<layer type="icon" id="rendered" minscale="0" maxscale="1" enabled="true"/>
					<layer type="terrainobj" id="terrainobj" minscale="0" maxscale=".5" enabled="true"/>
					<layer type="hclinks" id="hclinks" minscale="0" maxscale="20" enabled="true"/>
					<layer type="strat" id="strat" minscale="0" maxscale="20" enabled="true">
						<filter name="showcivilian" value="no"/>
						<filter name="showbrigdes" value="no"/>
						<filter name="showarmy" value="yes"/>
						<filter name="showairforce" value="yes"/>
						<filter name="shownavy" value="yes"/>
						<filter name="showdepots" value="yes"/>
						<filter name="showcpnames" value="yes"/>
						<filter name="showfacnames" value="no"/>
						<filter name="showflags" value="yes"/>
						<filter name="showicons" value="yes"/>
						<filter name="fadeupdate" value="no"/>
						<filter name="fadefrontline" value="yes"/>
						<filter name="cptextcolor" value="#FFFF00"/>
						<filter name="factextcolor" value="#FFFFFF"/>
						<filter name="seltextcolor" value="#00FF00"/>
						<filter name="factextsize" value="12"/>
						<filter name="cptextsize" value="12"/>
						<filter name="showclutter" value="no"/>
						<filter name="cluttercutoff" value=".2"/>
					</layer>
				</view>
			</tab>
		</tabview>
		
		<!-- close -->
		<button id="veto-button" x="150" y="10" width="150" height="25" label="&hccp.tabs.notices.veto.button;" followbottom="true"
			style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
			onclick="clickVetoProposal()" onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"
			enabled="false"/>
			
		<button x="325" y="10" width="150" height="25" label="&popup.ok;" followbottom="true"
			style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
			onclick="closeHCControl()" onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
	</view>
	<script>
		<!--
		
		var client			= game.player.client;
		var mousestate		= game.cursor.visible;
		var noticeList 		= new ListControl(findview("noticeList"), selectNotice);
		var noticeUpdater	= new CycleTimer(300);
		var vetoButton		= window.findview("veto-button");
		
		function initHCCOntrol()
		{
			game.cursor.visible = true;
			consoleclear();
			updateNotices(false);
			consoleprint("Initing HC Control\n");
			
			// enable hc map control
			var map = window.findview("hccp-map");
			
			if(map && map.mgr)
			{
				consoleprint("Setting HC Map to true!\n");
				map.mgr.isHCMap = true;
			}
			
			window.findview("hc-options").value = game.getpref("ui.hccp.showtab", 1, 0);
		}
		
		function updateNotices(checkNewNotices)
		{
			if(checkNewNotices && !client.havenotices)
				return;
			
			var notices = client.brigadenotices;
			
			noticeList.clearRows(false);
			
			if(notices.length > 0)
			{
				consoleprint("Printing notices found!\n");
				
				var cleared = new Object();
				
				for(var i = 0; i < notices.length; i++)
				{
					var notice 		= notices[i];
					var color		= "#FFFFFF";
					var description	= getVariableLocString(notice.lockey, notice.locarg1, notice.locarg2, notice.locarg3, notice.locarg4);
					var action		= "";
					var actionable	= (notice.isvetoable && !notice.expired);
					
					consoleprint("Found notice: " + description + "\n");
					consoleprint("     Vetoable: " + notice.isvetoable + ", Expired: " + notice.expired + "\n");
					
					if(actionable)
						action = "<caption id='notice-action' x='500' y='0' width='30' height='16' style='color: #00FFFF; ' label='YES' onclick='noticeList.clickList(true)'/>";
					
					switch(notice.notice)
					{
						case 0:
							continue;
							break;
						case 1:
							if(cleared[notice.brigade.id] != null || notice.expired)
								continue;
							color = "#00FF00";
							break;
						case 3:
						case 6:
						case 9:
							if(cleared[notice.brigade.id] != null)
								continue;
							color = "#FFFF00";
							break;
					}
					
					if(!client.ishc || notice.notice != 5)
					{
						consoleprint("Setting cleared to true: " + client.ishc + "/" + notice.notice + "\n");
						cleared[notice.brigade.id] = true;
					}
					
					var row = "\
<view id='notice_" + notice.index + "' width='552' height='16'>\
	<caption id='notice-text' x='0' y='0' width='522' height='16' style='color: " + color + "; '\
		label='" + htmlencode(description) + "'/>\
	" + action + "\
</view>";
					noticeList.addRow(((actionable) ? notice: null), row);
				}
			}
			else
			{
				consoleprint("No notices found!\n");
				
				var row	= "\
<view id='notice_empty' width='418' height='16'>\
	<caption x='0' y='0' width='250' height='16' style='color: #e9e3d9ff; '\
		label='" + getlocstring("hccp.tabs.notices.none") + "'/>\
</view>";
				noticeList.addRow(null, row);
			}
			
			noticeList.postInit();
		}
		
		function selectNotice(dblclick)
		{
			consoleprint("Clicking noticeList!\n");
			vetoButton.enabled = false;
			
			if(noticeList.list.selecteddata != null)
				vetoButton.enabled = true;
		}
		
		function clickVetoProposal()
		{
			var notice = noticeList.list.selecteddata;
				
			if(notice != null && notice.isvetoable && !notice.expired)
			{
				var confirm = showConfirm(getlocstring('common.confirmdotcommand'), vetoProposal);
				confirm.setPopupClose(false);
			}
	
		}
		
		function setHCCPTab(index)
		{
			soundPlayShuffle();
			game.setpref("ui.hccp.showtab", 1, index);
		}
		
		function vetoProposal(confirm)
		{
			if(noticeList.list.selecteddata != null && confirm)
				noticeList.list.selecteddata.veto();
		}
		
		function positionClose(button)
		{
			var parent = button.parent;
			button.x = (parent.width/2) - (button.width/2);
		}
		
		function closeHCControl()
		{
		 	soundPlayClick();
		 	game.cursor.update(window.name);
			window.close();
		}
		
		-->
	</script>
</window>

