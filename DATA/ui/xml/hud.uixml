<?xml version="1.0"?>
 
<viewport id="hud" x="0" y="0" width="1024" height="768" viewportwidth="1024" viewportheight="768"
	onload="initHud(this)" onupdate="updateHud(this)">
	<include file="lib/common.uixml"/>
	<include file="classes/BuildingInfo.uixml"/>
	<include file="classes/CPInfo.uixml"/>
	
	<!-- include our default hud -->
	<include file="widgets/hud.uixml"/>
	
	<!-- MISSION ORDERS -->
	<text id="current-orders" x="362" width="300" height="20" rtop="5" maxwidth="600" aspectlimit='width'
		style="color: #FFFF00;
			background-color: #00000088; 
			border-sides: ui/textures/hud/border_side.bmp;
			border-corner: ui/textures/hud/border_corner.bmp;
			border-width: 4;
			border-height: 4;" moveondrag="yes"
		ondrag="saveCustomOrders(this)"/>
	
	<!-- GAME INFO -->
	<view id="binfo" y="58" width="175" height="47" rright="6" aspectlimit="width" visible="false"
		style="background-color: #00000088; 
			border-top: ui/textures/hud/header.bmp;
			border-sides: ui/textures/hud/border_side.bmp;
			border-corner: ui/textures/hud/border_corner.bmp;
			border-top-corner: ui/textures/hud/header_corner.bmp; 
			border-width: 4;
			border-size-top: 14;
			border-size-bottom: 4;" moveondrag="yes"
		ondrag="saveCustomPosition(this)">
		<text id="title" x="5" height="15" rtop="0" rright="5" style="font-size: -1; color: #BFE2CE;" acceptmouseclick="false"/>
		<image id="icon" src="ui/textures/StratFac.dds" x="5" y="5" width="25" height="25" acceptmouseclick="false"/>
		<caption id="details" left="36" height="15" rtop="15" rright="5" style="color: #FFFFFF;" acceptmouseclick="false" align="center"/>
		<view id="bars" left="36" right="167" bottom="7" top="14">
			<image id="friendly" x="0" bottom="0" rtop="0" rright="0" src="ui/textures/capture-fill.bmp" acceptmouseclick="false"
				onshow="this.setstyleproperty('color', settings.friendlycolor)"/>
			<image id="enemy" x="0" bottom="0" rtop="0" rright="0" src="ui/textures/capture-fill.bmp" acceptmouseclick="false"
				onshow="this.setstyleproperty('color', settings.enemycolor)"/>
		</view>
		<image id="vcr" x="0" y="0" width="14" height="14" align="middle" style="font-size: +5; color: #FFFF00;"/>
	</view>
	
	<!-- GAME INFO -->
	<view id="cinfo" y="6" width="175" height="47" rright="6" aspectlimit="width"
		style="background-color: #00000088; 
			border-top: ui/textures/hud/header.bmp;
			border-sides: ui/textures/hud/border_side.bmp;
			border-corner: ui/textures/hud/border_corner.bmp;
			border-top-corner: ui/textures/hud/header_corner.bmp; 
			border-width: 4;
			border-size-top: 14;
			border-size-bottom: 4;" moveondrag="yes"
		ondrag="saveCustomPosition(this)">
		<text id="title" x="5" height="15" rtop="0" rright="5" style="font-size: -1; color: #BFE2CE;" acceptmouseclick="false"/>
		<image id="icon" src="ui/textures/NoCapIcon.dds" x="5" y="5" width="25" height="25" acceptmouseclick="false"/>
		<caption id="details" left="36" height="15" rtop="15" rright="5" style="color: #FFFFFF;" acceptmouseclick="false" align="center"/>
		<view id="bars" left="36" right="167" bottom="7" top="14">
			<image id="friendly" x="0" bottom="0" rtop="0" rright="0" src="ui/textures/capture-fill.bmp" acceptmouseclick="false"
				onshow="this.setstyleproperty('color', settings.friendlycolor)"/>
			<image id="enemy" x="0" bottom="0" rtop="0" rright="0" src="ui/textures/capture-fill.bmp" acceptmouseclick="false"
				onshow="this.setstyleproperty('color', settings.enemycolor)"/>
			<image id="none" x="0" bottom="0" rtop="0" rright="0" src="ui/textures/capture-fill.bmp" acceptmouseclick="false"
				style="color: #FFFFFF44;"/>
		</view>
	</view>
	
	<!-- HUD SETUP -->
	<script>
		<!--
		
		// campaign specific
		var infoTimer				= new CycleTimer(200);
		var capCheckTimer		= new CycleTimer(game.player.client.state.cancapturecheck);
		
		game.onorders 			= onOrders;
		
		function initHud(hud)
		{
			if(hudInited)
				return;
			
			initDefaultHud(hud);
			
			views["binfo"].mgr = new BuildingInfo(views["binfo"]);
			views["cinfo"].mgr = new CPInfo(views["cinfo"]);
			
			// go ahead and set the position of the 
			if(!game.training && player.client.currentorders.length > 0)
			{
				views["current-orders"].text = player.client.currentorders;
				views["current-orders"].resizetotext();
				restoreCustomOrders(views["current-orders"]);
			}
			
			// run default callbacks at least once
			//onCycleHud(game.training);
			//onOrders(false);
			updateHud(hud);
			
			// make sure this gets reset
			setCaptureCallback(null);
		}
		
		function setupHUD(mode)
		{
			setupDefaultHUD(mode);
			
			// restore position and visibility
			var flags = 2 | 8;
			
			if(mode == 1)
			{
				game.restoresettings(views["current-orders"], 0 | 8);
				game.restoresettings(views["binfo"], flags);
				game.restoresettings(views["cinfo"], flags);
				
				// do the real position
				restoreCustomOrders(views["current-orders"]);
			}
			else
			{
				// orders - center top
				views["current-orders"].x = window.width/2 - views["current-orders"].width/2;
				views["current-orders"].y = window.height - views["current-orders"].height - 6;
				saveCustomOrders(views["current-orders"]);
				game.setpref("view.current-orders.visible", 0, true);
				
				// city info - bottom right below kenny
				setViewMetrics(views["cinfo"], true, window.width - 6 - views["cinfo"].width, 6);
				game.savesettings(views["cinfo"], flags);
		
				// building info - bottom right above city info
				setViewMetrics(views["binfo"], true, window.width - 6 - views["binfo"].width, views["cinfo"].y + views["cinfo"].height + 6);
				game.savesettings(views["binfo"], flags);
			}
			
			onOrders(false);
		}
		
		function updateHud(hud)
		{
			updateDefaultHud(hud);
			
			if(infoTimer.run())
				updateInfo();
		}
		
		function onOrders(sendAlert)
		{
			cprint("New orders: " + player.client.currentorders + "\n");
			
			var currentOrders = views["current-orders"];
			
			currentOrders.visible = false;
			
			if(game.training)
				return; // no orders while training
			
			var hudSetting = game.settings.hudvisible;
			
			if(player.client.currentorders.length > 0 && hudSetting > 0)
			{
				if(game.getpref("view.current-orders.visible", 0, true))
				{
					cprint("Setting custom orders position\n");
					
					var cx		= currentOrders.x + currentOrders.width/2;
					var cy		= currentOrders.y + currentOrders.height/2;
					
					currentOrders.text 		= player.client.currentorders;
					currentOrders.visible	= true;
					
					currentOrders.resizetotext();
					
					currentOrders.x = cx - currentOrders.width/2;
					currentOrders.y = cy - currentOrders.height/2;
					
					if(currentOrders.x < 5)
						currentOrders.x = 5;					
					if(currentOrders.x + currentOrders.width > window.width - 5)
						currentOrders.x = window.width - currentOrders.width - 5;
					
					if(currentOrders.y < 5)
						currentOrders.y = 5;					
					if(currentOrders.y + currentOrders.height > window.height - 5)
						currentOrders.y = window.height - currentOrders.height - 5;
					
					if(game.settings.wantalerts)
						soundPlayOrders();
					
					// update the config
					saveCustomOrders(currentOrders);
					
					cprint("Done setting custom orders position\n");
				}
				
				if(sendAlert == null || sendAlert == true)
					doGameEvent(15);
			}
		}
		
		
		function saveCustomOrders(view, what)
		{
			cprint("Saving custom orders position\n");
			
			game.setpref("view." + view.id + ".x", 4, normalizeX(view.x + view.width/2));
			game.setpref("view." + view.id + ".y", 4, normalizeY(view.y + view.height/2));
		}
		
		function restoreCustomOrders(view)
		{
			cprint("Restoring custom orders position\n");
			
			var newX = game.getpref("view." + view.id + ".x", 4, normalizeX(view.x + view.width/2));
			var newY = game.getpref("view." + view.id + ".y", 4, normalizeY(view.y + view.height/2));
			
			view.x = scaleX(newX) - view.width/2;
			view.y = scaleY(newY) - view.height/2;
		}
		
		function updateInfo()
		{
			views["binfo"].mgr.update();
			views["cinfo"].mgr.update();
		}
		
		// hook for combat tutorials
		function setCaptureCallback(c)
		{
			//game.chatprint("Setting capture callback!!!");
			views["binfo"].mgr.callback = c;
		}
		
		
		-->
	</script>
</viewport>

