<panel label="SELECTED MAP" id="scenario-info" manager="ScenarioInfoManager" align="center">
	<body x="15" height=".46" rright="15" rtop="20"/>
	<view x="15" height=".46" y="15" rright="15" style="layout: flow; vpad: 3;">
		<caption height="15" width=".5" label="Map Name:" style="class: litebg; vpad: 3;"/>
		<caption height="15" width=".5" id="scenario-name" label="none" style="class: litebg; vpad: 3;" align="right"/>
		<caption height="15" width=".5" label="Map Type:"  style="class: litebg;"/>
		<caption height="15" width=".5" id="scenario-type" label="none" style="class: litebg;" align="right"/>
		<caption height="15" label="Map Description:" style="class: litebg;"/>
		<text id="scenario-description" style="class: litebg;">none</text>
	</view>
</panel>
