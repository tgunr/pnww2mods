		function savePrefsAndClose(confirm)
		{
			if(confirm)
				savePreferences();
			
			closeSettings();
		}
		
		function closeSettings()
		{
			if(game.globals.referrer != null)
				loadWin(game.globals.referrer, false);
			
			window.close();
		}
		
		function initWin(win)
		{
			consoleclear();
			showIDCard(false);
			
			// lets set the default message
			setHelp(getlocstring('common.settings.help'));
			setBack('widgets.template.back');
			
			quickhelp();
			
			forwardButton.visible = false;
		}
		
		-->
	</script>
</window>
