<ra id="weapon" manager="RAScreen">
	<include file="lib/scenarios.uixml"/>
	<include file="classes/VehicleClass.uixml"/>
	<include file="classes/CycleTimer.uixml"/>
	<panel label="SELECT A WEAPON" x="10" height=".8" width=".5" rtop="20" align="center">
		<view x="15" height="20" rtop="20" rright="15" style="class: whitebg;">
			<text id="team-header"/>
			<view id="team-color" width="10" height="10" style="class: border;"/>
		</view>
		<listcontrol id="weapon-list" x="15" y="15" rright="15" rtop="40" style="class: litebg;"/>
	</panel>
	<weapinfov id="weapon-info" width=".45" height=".8" rright="20" rtop="20"/>
	
	<navbar id="navbar">
		<button id="forward" label="   CHANGE TEAM" x="20" onclick="window.mgr.DoTeam()" center="y"/>
		<button id="back" label="CONFIRM WEAPON   " rright="20" onclick="this.mgr.Click(selectWeapon, true)" center="y"/>
				<caption label="RAPID ASSAULT- WEAPON SELECT" width="250" height="20" center="true" style="class:bigtext;"/>
	</navbar>
	<script>
		<!--
		 //
		 
		var client 					= game.client;
		var scenario				= game.scenario;
		var scenarios			= loadRoot();
		var weaponList 		= findview("weapon-list");
		var weaponInfo		= findview("weapon-info");
		var selectBtn			= findview("select-button");
		var teamHeader		= findview("team-header");
		var teamColor			= findview("team-color");
		var weapTimer			= new CycleTimer(500);
		var updateList			= true;
		
		game.onplayerupdate 	= OnUpdatedWeapons;
		
		function OnShow(win)
		{
			teamHeader.visible = false;
			
			// set some callbacks
			weaponList.mgr.selectCallback = selectWeapon;
			
			// set our scenario info
			weaponInfo.mgr.SetWeapon(scenario.player.weapon);
			
			initHeaders(weaponList);
		}
		
		function OnUpdate()
		{
			var team = scenario.player.team;
			
			if(team > 0 && updateList && weapTimer.run())
			{
				cprint("Player team is " + team);
				cprint("Updating weapons!");
				
				var x = teamHeader.x;
				var color = "#00000000";
				
				if(team == 1)
				{
					teamHeader.label = "BLUE TEAM WEAPON LIST";
					color = "#0000FFBB";
				}
				else
				{
					teamHeader.label = "RED TEAM WEAPON LIST";
					color = "#FF0000BB";
				}
				
				teamHeader.resizetotext();
				teamHeader.x = x;
				teamHeader.visible = true;
				teamColor.x = teamHeader.right + 10;
				teamColor.y = (teamHeader.height) * .5 - (teamColor.height * .5); 
				teamColor.setstyleproperty("background-color", color);
				
				initWeapons();
				updateList = false;
			}
		}
		
		function initHeaders(p)
		{
			// create our headers
			p.mgr.StartHeaders("weapons-header", 0, -1, 0, 15);
		 	p.mgr.AddHeader("WEAPON", .4);
		 	p.mgr.AddHeader("TYPE", .3);
		 	p.mgr.AddHeader("CURRENT", .15, "center");
		 	p.mgr.AddHeader("CAPACITY", .15, "center");
			p.mgr.EndHeaders();
		}
		
		function initWeapons()
		{
			var spawnables = scenario.spawnables;
			
			// now update our visible list
			weaponList.mgr.control.clearRows(false);
			
			for(var i = 0; i < spawnables.length; i++)
			{
				var spawnable = spawnables[i];
				var weapon = spawnable.weapon;
				
				var id = "row." + weapon.weapkey;
				
				weaponList.mgr.StartRow(id, 0, 0, 0, 16);
				
				// determine country icon
				var image = scenarioFlag(weapon.country.id);
				
				weaponList.mgr.AddRowIcon("image", image, .03, 12, 2);
				weaponList.mgr.AddRowColumn(weapon.description, .37);
				weaponList.mgr.AddRowColumn("common.vehicles.classes." +  weapon.vclassid, .3);
				
				if(spawnable.capacity == -1)
					weaponList.mgr.AddRowColumn(spawnable.current, .15, "center");
				else if(spawnable.current < spawnable.capacity)
					weaponList.mgr.AddRowColumn(spawnable.current, .15, "center");
				else
					weaponList.mgr.AddRowColumn("max", .15, "center");
				
				if(spawnable.capacity == -1)
					weaponList.mgr.AddRowColumn("unlimited", .15, "center");
				else
					weaponList.mgr.AddRowColumn(spawnable.capacity, .15, "center");
				
				weaponList.mgr.EndRow(spawnable);
				
				if(scenario.player.weapon != null && scenario.player.weapon.weapkey == weapon.weapkey)
					weaponList.control.selectByID(id);
			}
			
			weaponList.mgr.control.postInit();
			selectWeapon(false);
		}
		
		function selectWeapon(action)
		{
			var spawnable = weaponList.mgr.control.selectedData();
			
			weaponInfo.mgr.SetWeapon();
			
			if(spawnable != null)
			{
				// update our weapon info
				weaponInfo.mgr.SetWeapon(spawnable.weapon);
				
				// this call
				if(action)
				{
					if(spawnable.status == "spawnable")
					{
						game.setplayerdata("weapon", spawnable.weapon.weapkey);
						game.setplayerdata("ready", "true");
						
						loadWin("readyroom", true);
					}
					else
					{
						showOk(spawnable.status);
					}
				}
			}
		}
		
		function OnUpdatedWeapons()
		{
			updateList = true;
		}
		
		-->
	</script>
</ra>
