<ra id="weapon" manager="RAScreen">
	<include file="lib/scenarios.uixml"/>
	<include file="lib/scenariodata.uixml"/>
	<panel label="SELECT A WEAPON" x="10" height=".8" width=".5" rtop="20" align="center">
		<caption id="team-header" x="15" height="20" rtop="15" rright="15" style="class: whitebg;"/>
		<treecontrol id="weapon-tree" x="15" y="15" rright="15" rtop="40" style="class: litebg;"/>
	</panel>
	<weapinfov id="weapon-info" width=".45" height=".8" rright="20" rtop="20"/>
	
	<navbar id="navbar">
		<button id="back" label="CHANGE TEAM   " x="20" onclick="window.mgr.DoTeam()" align="right" center="y"/>
		<button id="forward" label="   CONFIRM WEAPON" rright="20" onclick="this.mgr.Click(selectWeapon, true)" align="left" center="y"/>
	</navbar>
	<script>
		<!--
		 //
		 
		var client 				= game.player.client;
		var scenarios		= loadRoot();
		var weaponTree 	= findview("weapon-tree");
		var weaponInfo	= findview("weapon-info");
		var selectBtn		= findview("select-button");
		var teamHeader	= findview("team-header");
		var team				= 0;
		
		function OnShow(win)
		{
			// set some callbacks
			weaponTree.mgr.selectCallback = selectWeapon;
			weaponTree.control.ondraw = formatSpawnable;
			weaponTree.control.isselectable = isSelectable;
			
			// set our scenario info
			weaponInfo.mgr.SetWeapon(game.player.vehicle);
		}
		
		function OnUpdate()
		{
			var t = game.player.team;
			
			//cprint("Player team is " + t);
			
			if(t != team)
			{
				if(t == 1)
				{
					teamHeader.label = "BLUE TEAM WEAPON LIST:";
					teamHeader.setstyleproperty("color", "#0000FFBB");
				}
				else
				{
					teamHeader.label = "READ TEAM WEAPON LIST:";
					teamHeader.setstyleproperty("color", "#FF0000BB");
				}
				
				initSpawnables(weaponTree.control);
				team = t;
			}
		}
		
		function selectWeapon(action)
		{
			var node = weaponTree.control.selectedNode();
			
			weaponInfo.mgr.SetWeapon();
			
			if(node != null && !node.branch)
			{
				var index = weaponTree.control.selectedData();
				
				if(index != null)
				{
					var vehicle = vehicles[index];
					
					// update our weapon info
					weaponInfo.mgr.SetWeapon(vehicle.type);
					
					// this call
					if(action)
					{
						if(vehicle.spawnable == "spawnable")
						{
							if(game.globals != null)
								game.globals.scenariovehicle = index;
							
							game.setplayerdata("weapon", vehicle.type.weapkey);
							game.setplayerdata("ready", "true");
							
							loadWin("readyroom", true);
						}
						else
						{
							showOk(vehicle.spawnable);
						}
					}
				}
			}
		}
		
		-->
	</script>
</ra>
