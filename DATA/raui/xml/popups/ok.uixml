<?xml version="1.0"?>
 
<window id="ok" x="0" y="0" width="1024" height="768"  viewportwidth="1024" viewportheight="768"  modal="true"
	style="background-color: #00000077;" layer="100" aspectalign="center">
	<include file="lib/popup.uixml"/>
	<view width="350" height="150" style="background-color: #00000088;" moveondrag="yes" aspectlimit="width">
		<text id="popup-caption" x="10" rtop="10" y="50" rright="10" acceptfocus="no" style=" color: #FFFFFF;"/>
		<button id="popup-yes" x="100" y="10" width="150" height="25" label="${popup.ok}" onclick="doPopupAction(true)"
			style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
			onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
	</view>
</window>

