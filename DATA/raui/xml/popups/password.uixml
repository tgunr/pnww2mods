<dialog id="password">
	<text id="dialog-label" value="DIALOG" x="10" rtop="10" height="20" rright="10"
		acceptmouseclick="no" acceptfocus="no" style="class: border;"/>
	<textcontrol id="password-input" x="10" rtop="40" height="20" rright="10"/>
	<button id="dialog-no" x="10" y="10" label="${popup.cancel}" onclick="window.mgr.Close(false)" style="class: button.small;"/>
	<button id="dialog-yes" y="10" rright="10" label="${popup.ok}" onclick="window.mgr.Close(true)" style="class: button.small;"/>
</dialog>
