<ra id="create" manager="OnlineScreen">
	<include file="lib/scenarios.uixml"/>
	<include file="classes/ListControl.uixml"/>
	<include file="classes/DDListControl.uixml"/>
	<include file="classes/TreeControl2.uixml"/>
	<include file="classes/CycleTimer.uixml"/>
	<include file="classes/ViewBuilder.uixml"/>
	<include file="classes/TextBuilder.uixml"/>
	<include file="classes/ImageBuilder.uixml"/>
	<include file="classes/RowBuilder.uixml"/>
	
	<tabview id="body" x="43" y="140" width="930" height="450" ontab="doBodyTab()" style="color: #BFE2CE;
						background-color: #000000BB; 
						border-top-corner: ui/textures/test/body_ul.bmp;
						border-bottom-corner: ui/textures/test/body_br.bmp;
						border-sides: ui/textures/test/body_sides.bmp;
						border-top: ui/textures/test/body_top.bmp;
						border-bottom: ui/textures/test/body_bottom.bmp;
						control-on-endcap:  ui/textures/test/body_tab_cap_on.bmp;
						control-on-back:  ui/textures/test/body_tab_filler_on.bmp;
						control-off-endcap: ui/textures/test/body_tab_cap.bmp;
						control-off-back: ui/textures/test/body_tab_filler.bmp;
						control-on-color: #FFFFCE;
						border-width: 16;
						border-height: 16;">
		<tab label="  ${online.ra.create}  " x="0" y="0" width="930" height="460"
			onshow="showCreate()" tip="${scenarios.create.help}">
			<view id="left-pane" x="18" y="23" width="444" height="411">
				<!-- left pane -->
				<caption label="${scenarios.create.header}" x="10" rtop="12" height="20" width="400" style="font-size: +2; color: #BFE2CE;"/>
				<image x="10" rtop="22" src="ui/textures/test/horiz_underline.bmp" width="425" height="12"/>
				<view x="10" rtop="34" width="425" height="15">
					<caption x="0" y="0" rright="0" height="15" style="background-color: #BFE2CE44;  color: #BFE2CE;" label="${scenarios.create.map}"/>
				</view>
				<list id="createTree" x="10" rtop="53" width="425" height="300"
					onselect="createTree.clickTree(false)" ondblselect="createTree.clickTree(true)">
					<scrollbar style="width: 10; background-image: ui/textures/test/scrolltunnel_bg.bmp; control-on: ui/textures/test/scrollhandle.bmp;"/>
				</list>
				<view x="10" y="0" height="50" rright="10">
					<image src="ui/textures/test/horiz_underline.bmp" x="5" height="12" rtop="0" rright="5"/>
					<caption id="password" label="${online.ra.password}" x="10" y="5" height="20" rright="10" style="color: #e9e3d9ff;"/>
					<textcontrol id="passwordText" x="150" y="5" width="80" height="20" maxlength="15"
						style="color: #e9e3d9ff; start-color: #e9e3d9ff; border-color: #3e5248;"/>
					<button id="create-button" y="0" width="120" height="30" rright="5" label="${online.ra.create}" onclick="selectScenario(true)"
						style="control-on: ui/textures/test/gen_button_on.bmp; control-off: ui/textures/test/gen_button_off.bmp; control-disabled: ui/textures/test/gen_button_disabled.bmp; font-size: -1; color: #ffffff;"
						onmouseenter="buttonMouseEnter(this)" onmouseexit="buttonMouseExit(this)"/>
				</view>
			</view>
			<include file="widgets/divider.uixml"/>
			<view id="right-pane" x="468" y="23" width="444" height="411">
				<!-- right pane -->
				<caption id="scenario-name" label="DOG GREEN" x="10" height="20" rright="10" rtop="12"
						style="font-size: +2; color: #BFE2CE; tooltip: widgets/tooltips/supplytip.uixml;"/>
				<image src="ui/textures/test/horiz_underline.bmp" x="10" rright="10" height="12" rtop="22"/>
				<view id="scenario-map" class="scenimage" src="map.bmp" acceptsfocus="no" x="20" width="400" height="192" rtop="50"
					style="border-color: #BFE2CE; border-size: 1;" aspectalign="width"/>
				<text id="scenario-description" x="20" y="60" rright="20" rtop="260"
					style="font-size: +1; color: #FFFFFFBB;"/>
				<view id="scenario-data" x="10" y="0" height="75" rright="10">
					<caption id="maxPlayers" label="${online.ra.maxplayers}" x="10" height="20" rtop="20" rright="10" style="color: #e9e3d9ff;"/>
					<caption id="maxPlayers-value" x="10" height="20" rtop="20" rright="10" style="color: #e9e3d9ff;" align="right"/>
					<caption id="timeLimit" label="${online.ra.timelimit}" x="10" height="20" rtop="50" rright="10" style="color: #e9e3d9ff;"/>
					<caption id="timeLimit-value" x="10" height="20" rtop="50" rright="10" style="color: #e9e3d9ff;" align="right"/>
				</view>
			</view>
		</tab>
		<include file="widgets/globals/settings.uixml"/>
	</tabview>
	<!-- include file="widgets/infobar.uixml"/ -->
	<script>
		<!--
		
		cprint(">>> STARTING LOBBY PAGE\n");
		
		var client 				= game.client;
		var scenarios		= loadRoot();
		var scenName		= findview("scenario-name");
		var scenMap			= findview("scenario-map");
		var scenDesc		= findview("scenario-description");
		var scenData		= findview("scenario-data");
		var createBtn		= findview("create-button");
		var createTree 	= new TreeControl("createTree", selectScenario, formatScenario);
		var initialized		= false;
		var categories		= new Object();
		var rootNodes		= new Array();
		
		var maxPlayers	= findview("maxPlayers-value");
		var timeLimit		= findview("timeLimit-value");
		
		/***************** COMMON FUNCTIONS *******************/
		
		function doForward()
		{
			selectScenario(true);
		}
		
		function doBack()
		{
			loadWin("scenarios/lobby", true);
		}
		
		function initLobby(win)
		{
			var chat = game.findview("chat");
			if(chat != null)
			{
				chat.x = window.width/2 - chat.width/2;
				chat.y = 10;
			}
			
			showIDCard(false);
			showChat(true);
			
			setHelp(getlocstring('scenarios.help'));
			
			setBack('online.back');
			setForward('scenarios.create');
			setForwardEnabled(false);
			forwardButton.visible = false;
			createBtn.enabled = false;
			
			showCreate();
		}
		
		function initCreateTree()
		{
			if(rootNodes.length > 0)
				return;
			
			var preopen	= null;
			
			// add our categories
			for(var i = 0; i < scenarios.links.length; i++)
			{
				var content 	= game.getcontent(scenarios.links[i].path);
				if(content == null) continue;
				
				cprint("Adding category " + content.title);
				
				var id = "category." + content.category;
				var node = new TreeNode(id, id, 1, true, content.title.toUpperCase());
				
				//if(preopen == null)
				//	preopen = node; // open the first node
				node.expand();
				
				// add it to our tree
				createTree.addNode(node, toggleNode);
				
				// save a reference by category
				categories[node.data] = node;
				
				// save a reference
				rootNodes.push(node);
				
				// add our new scenario links
				addScenarioNodes(node);
			}
			
			cprint("done adding categories");
			
			//if(preopen)
			//	preopen.expand();
			
			createTree.setColorText(false);
			createTree.drawTree();
		}
		
		function isSelectable(node)
		{
			return true;
		}
		
		function addScenarioNodes(catNode)
		{
			cprint("Adding category scenarios");
			
			if(catNode == null)
				return;
			
			var cid					= catNode.data.split(".");
			var catID				= cid[1];
			var category 		= loadCategory(catID);
			
			if(category == null)
				return;
			
			for(var i = 0; i < category.links.length; i++)
			{
				cprint("Trying new scenario " + catID + "/" + i);
				
				var scenario = loadScenario(catID, i);
				if(scenario == null) continue;
				
				var sid = "scenario." + catID + "." + i;
				
				cprint("Adding new scenario " + sid);
				
				catNode.addNode(new TreeNode(sid, sid, 2, false, scenario.title));
			}
		}
		
		function getOpenCategory()
		{
			for(var c in categories)
			{
				if(categories[c].open)
					return categories[c];
			}
			
			return null;
		}
		
		function toggleNode(node)
		{
			return;
			
			if(!node.open)
			{
				for(var i = 0; i < rootNodes.length; i++)
				{
					if(rootNodes[i].open && rootNodes[i].id != node.id)
						rootNodes[i].open = false;
				}
			}
		}
		
		function selectScenario(action)
		{
			var node = createTree.selectedNode();
			
			updateData();
			
			createBtn.enabled = false;
			
			if(node != null)
			{
				//setForwardEnabled(!node.branch);
				
				createBtn.enabled = !node.branch;
				
				if(node.branch)
				{
					var id = node.data.split(".");
					var content = loadCategory(id[1]);
					
					scenName.label = content.title.toUpperCase();
					scenDesc.text = content.brief;
					scenMap.src = "";
				}
				else
				{
					var id					= node.data.split(".");
					var content			= loadScenario(id[1], id[2]);
					
					scenName.label 	= content.title.toUpperCase();
					scenDesc.text 		= content.brief;
					scenMap.src 		= "scenarios/terrain/" + content.terrain + "/map.bmp";
				}
				
				if(action && !node.branch)
				{
					var category 	= id[1];
					var map 			= id[2];
					
					// create a new instance
					if(createInstance(category, map))
					{
						cprint("Instance created!");
						
						if(game.listinstances(category, map))
						{
							var instances = client.instances;
							
							cprint("Looking for created instance: " + instances.length);
							
							for(var i = 0; i < instances.length; i++)
							{
								// join an existing instance
								var instance = instances[i];
								
								cprint("Mine is: " + instance.description.mine);
								
								if(!instance.description.mine)
									continue;
									
								cprint("Found created instance!");
								
								var scenario = loadScenario(category, map);
								
								scenario.instance = instance;
								
								cprint("Joining created instance!");
								
								if(!selectTeam(scenario) || !joinInstance(instance.description, true))
								{
									showOk(lastScenarioError);
									joinLobby();
								}
								
								break;
							}
						}
					}
					else
					{
						showOk(lastScenarioError);
					}
				}
			}
			else
			{
				//setForwardEnabled(false);
				createBtn.enabled = false;
			}
		}
		
		function formatScenario(tree, node)
		{
			var name				= tree.list.id;
			var indent 			= tree.indent * node.level;
			var mouseenter	= name + ".mouseEnter(this)";
			var mouseexit		= name + ".mouseExit(this)";
			var id					= node.id.split("."); 
			
			if(node.branch)
			{
				var icon 			= (node.open) ? tree.collapseIcon: tree.expandIcon;
				var label			= node.description;
				
				cprint("Formatting tree node " + label);
				
				var row = new ViewBuilder(tree.list, node.id, 0, 0, 0, 16);
				
				var expander = row.addBuilder(new ImageBuilder(row, "image", icon, indent, 3, 10, 10));
				
				expander.addAttribute("onclick", name + ".clickTree(true, " + tree.count + ")");
				
				var caption = row.addBuilder(new TextBuilder(row, "title", "caption", label, (indent + tree.indent), 0, 0, 16));
				
				row.addAttribute("aspectalign", "left");
				row.addAttribute("onmouseenter", mouseenter);
				row.addAttribute("onmouseexit", mouseexit);
				
				caption.addStyle("color", "#e9e3d9ff");
				
				return row.build();			
			}
			else
			{
				var label 		= "[unknown]";
				var color 		= "#00FF00";
				
				if(node.data != null)
				{
					var id					= node.data.split(".");
					var content			= loadScenario(id[1], id[2]);
					label						= content.title;
				}
				
				indent += tree.indent;
				
				//cprint("Formatting tree instance " + label);
				
				var row 				= new ViewBuilder(tree.list, node.id, 0, 0, 0, 16);
				var caption			= row.addBuilder(new TextBuilder(row, "title", "caption", label, indent, 0, -indent, 16));
				
				row.addAttribute("aspectalign", "left");
				row.addAttribute("onmouseenter", mouseenter);
				row.addAttribute("onmouseexit", mouseexit);
				
				caption.addStyle("color", color);
				
				return row.build();
			}
		}
		
		function updateLobby()
		{
		}
		
		function onPersonas()
		{
			initialized = true;
		}
		
		function showCreate()
		{
			setHelp(getlocstring('scenarios.create.help'));
			tplTab();
			setForward('scenarios.create');
			selectScenario(false);
			initCreateTree();
		}
		
		function updateData()
		{
			var node = createTree.selectedNode();
			
			if(node != null && !node.branch)
			{
				scenData.visible = true;
				
				var id					= node.data.split(".");
				var content			= loadScenario(id[1], id[2]);
				
				content.population = new ScenarioPopulation(content);
				
				var duration = null;

				if(content != null)
				{
					duration = content.duration;
				
					if(duration == null)
						duration = content.duration1;
				}
				
				if(duration != null)
					duration += " minutes";
				else
					duration = "na";
				
				maxPlayers.label = content.population.maxPlayers();
				timeLimit.label = duration; 
			}
			else
			{
				scenData.visible = false;
			}
		}
		
		/*
		function updateData()
		{
			var node = createTree.selectedNode();
			
			if(node != null && !node.branch)
			{
				var id					= node.data.split(".");
				var content			= loadScenario(id[1], id[2]);
				
				content.population = new ScenarioPopulation(content);
			
				initMaxPlayers(content);
				initTimeLimit(content);
				initVictory(content);
			}
			else
			{
				initMaxPlayers(null);
				initTimeLimit(null);
				initVictory(null);
			}
		}
		
		function initMaxPlayers(content)
		{
			if(!maxPlayersList.mgr)
				new DDListControl(maxPlayersList, null, 80, true);
			
			maxPlayersList.mgr.clearRows(true);
			
			if(content != null)
				maxPlayersList.mgr.addOption(content.population.maxPlayers(), -1, -1);
			
			maxPlayersList.mgr.hideList();
		}
		
		function initTimeLimit(content)
		{
			if(!timeLimitList.mgr)
				new DDListControl(timeLimitList, null, 80, true);
			
			var duration = 0;

			if(content != null)
			{
				duration = content.duration;
			
				if(duration == null)
					duration = content.duration1;
			}
			
			timeLimitList.mgr.clearRows(true);
			
			if(content != null)
				timeLimitList.mgr.addOption(duration, -1, -1);
			
			timeLimitList.mgr.hideList();
		}
		
		function initVictory(content)
		{
			if(!victoryList.mgr)
				new DDListControl(victoryList, null, 80, true);

			victoryList.mgr.clearRows(true);
			
			if(content != null)
				victoryList.mgr.addOption(content.getloc("victoryconditions"), -1, -1);
			
			victoryList.mgr.hideList();
		}
		*/
		
		-->
	</script>
</window>
