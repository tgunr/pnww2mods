<window id="aar" x="0" y="0" width="1024" height="768" viewportwidth="1024" viewportheight="768" layer="52" manager="AARScreen">
	<include file="lib/common.uixml"/>
	<include file="classes/Preference.uixml"/>
	<view id="aarbody" width=".9" height=".7" aspectlimit="width" center="true">
		<playerinfov id="player-info" x="10" width=".3" height=".8" rtop="20" style="class: medbg;">
			<view id="map" class="mapview" acceptsfocus="no" minscale=".01" maxscale=".1" scale=".05" sx="0" sy="0">
				<layer type="texture" id="default-64-tex" minscale="0" maxscale="64" enabled="true" orign="-26x210" rowcolsize="1x1" cellsize="64x64"/>
				<layer type="icon" id="icons" minscale="1" maxscale="8" enabled="true"/>
				<layer type="icon" id="rendered" minscale="0" maxscale="1" enabled="true"/>
				<layer type="scenario" id="scenmap" minscale="0" maxscale="2" enabled="true"/>
				<layer type="players" minscale="0" maxscale="20" />
			</view>
		</playerinfov>
		<panel label="PLAYER LIST" height=".8" width=".65" rright="10" rtop="20" align="center">
			<listcontrol id="players" x="15" y="15" rright="15" rtop="20" style="class: medbg;"/>
		</panel>
		<navbar id="navbar">
			<button id="forward" label="   DESPAWN" x="20" onclick="window.mgr.Close(true)" center="y"/>
			<button id="back" label="CHANGE WEAPON   " rright="20" onclick="window.mgr.DoWeapon()" center="y"/>
		</navbar>
	</view>
	<script>
		<!--
		
		var client = game.player.client;
		var playerList = findview("players");
		var playerInfo = findview("player-info");
		var updatePlayers = true;
		
		game.onscenarioplayers = playersUpdated;
		
		function OnShow(win)
		{
			initHeaders(playerList);
			playerList.mgr.selectCallback = selectPlayer;
			//playerInfo.mgr.SetInfo(game.player.score);
		}
		
		function OnUpdate()
		{
			if(updatePlayers)
				updatePlayerList();
		}
		
		function initHeaders(ph)
		{
		 	ph.mgr.StartHeaders("players-header", 0, -1, 0, 15);
		 	ph.mgr.AddHeader("TEAM", .07, "center");
		 	ph.mgr.AddHeader("PLAYER", .17);
		 	ph.mgr.AddHeader("RANK", .07);
		 	ph.mgr.AddHeader("WEAPON", .365);
		 	ph.mgr.AddHeader("K", .05, "center");
		 	ph.mgr.AddHeader("D", .05, "center");
		 	ph.mgr.AddHeader("S", .06, "center");
		 	ph.mgr.AddHeader("READY", .162, "center");
		 	ph.mgr.EndHeaders();
		}
		
		function updatePlayerList()
		{
			consoleprint("ML 1");
			var started 				= new Date();
			var members			= game.player.client.missionroomlist;
			consoleprint("ML 2");
			if(members == null)
				return;
			
			updatePlayers = false;	
			
			consoleprint("ML 2.5");
			
			// sort our member list
			members = members.sort(sortMembers);
			
			consoleprint("ML 2.75");
			
			// clear our list of rows
			playerList.control.clearRows(false);
			
			var membersCount = members.length;
			consoleprint("ML 3");
			for(var i = 0; i < membersCount; i++)
			{
				/************ Update Member List **************/
				
				var member 			= members[i];
				var vehicle			= "-";
				var ready				= "";
				
				if(member.weapon != null)
				{
					var memberWeapon = member.weapon;
					
					if(memberWeapon.description.toLowerCase() == "buzzard")
						continue;
					
					vehicle = memberWeapon.description;
				}
				
				var rank			= member.rank;
				var callsign 		= member.callsign;
				var kills				= parseInt(member.kills);
				var deaths		= parseInt(member.deaths);
				var score			= parseInt(member.score);
				var teamIcon 	= "blueteam"; //scenarioFlag(parseInt(scenario["team" + member.team]));
				
				if(member.team == 2)
					teamIcon = "redteam";
				
				if(member.ready)
					ready = "ready";
				
				var id = "member." + member.callsign;
				var row = playerList.mgr.StartRow(id, 0, 0, 0, 16);
				
				// space out our children builders
				row.hspace(2);
				
				playerList.mgr.AddRowView(.07, 10, .5, teamIcon);
				playerList.mgr.AddRowColumn(callsign, .17);
				playerList.mgr.AddRowIcon("rankicon",  member.rank.level - 1, .07, 12, .5);
				playerList.mgr.AddRowColumn(vehicle, .365);
				playerList.mgr.AddRowColumn(kills, .05, "center");
				playerList.mgr.AddRowColumn(deaths, .05, "center");
				playerList.mgr.AddRowColumn(score, .06, "center");
				playerList.mgr.AddRowColumn(ready, .162, "center");
				
				playerList.mgr.EndRow(member);
				
				if(member.me)
				{
					playerList.control.selectByID(id);
					selectPlayer(false);
				}
			}
			consoleprint("ML 4");
			playerList.control.setScrollY();
			playerList.control.postInit();
			
			var stopped = new Date();
		}
		
		function selectPlayer(action)
		{
			playerInfo.mgr.SetPlayer();
			
			var p = playerList.mgr.control.selectedData();
			
			if(p != null)
				playerInfo.mgr.SetInfo(p);
		}
		
		function playersUpdated()
		{
			consoleprint("Players have new data!!!");
			updatePlayers = true;
		}
		
		function sortMembers(a,b)
		{
			if(a.score > b.score)
				return -1;
			else if(a.score < b.score)
				return 1;
			
			return 0;
		}
		
		-->
	</script>
</view>
