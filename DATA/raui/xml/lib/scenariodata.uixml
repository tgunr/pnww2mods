<?xml version="1.0"?>
<script>

	<include file="classes/VehicleManager.uixml"/>
	<include file="classes/VehicleClass.uixml"/>
	
	<!--
	
		game.onscenarioplayers = membersUpdated;
		
		var doMemberUpdate	= false;
		
		var vehicles			= new Object();
		var classes			= new Object();
		var rootNodes		= new Array();
		
		function initSpawnableTree(spawnables, treeCtl)
		{
			if(spawnables.length == 0)
				return;
				
			for(var i = 0; i < spawnables.length; i++)
			{
				var vehicle = spawnables[i];
				if(vehicle == null) continue;
				
				if(classes[vehicle.vclassid] == null)
					classes[vehicle.vclassid] = new TreeNode(vehicle.vclassid, null, 1, true, vehicle.vclass);
			}
			
			var cids 	= new Array(9, 8, 4, 7, 5, 6, 2, 1, 12, 13, 14);
			var preopen	= null;
			
			for(var c = 0; c < cids.length; c++)
			{
				var node = classes[cids[c]];
				
				if(node != null)
				{
					if(preopen == null)
						preopen = node; // open the first node
					
					treeCtl.addNode(node, toggleNode);
					rootNodes[rootNodes.length] = node;
				}
			}
			
			if(preopen)
				preopen.expand();
			
			treeCtl.setColorText(false);
		}
		
		function initSpawnables(treeCtl)
		{
			var spawnables 	= game.spawnablevehicles;
			var counters			= game.scenariospawns;
			
			if(!treeCtl.initTree())
				initSpawnableTree(spawnables, treeCtl);
				
			// clear out previous data
			for(var i in classes)
				classes[i].reset();
			
			vehicles = new Object();
			
			// rebuild data
			for(var i = 0; i < spawnables.length; i++)
			{
				var vehicle = spawnables[i];
				
				if(vehicle == null || classes[vehicle.vclassid] == null)
					continue;
				
				classes[vehicle.vclassid].addNode(new TreeNode(vehicle.id, vehicle.index, 2, false));
				
				var vc = new VehicleClass(vehicle);
				
				if(counters.length == 0)
				{
					vc.capacity 			= 100;
					vc.current 			= 0;
					vc.minimumrank 	= 1;
					vc.spawnable 		= "spawnable";
				}
				else
				{
					vc.capacity 			= counters[i].capacity;
					vc.current 			= counters[i].current;
					vc.minimumrank 	= counters[i].minimumrank;
					vc.spawnable 		= counters[i].spawnable;
				}
				
				if(vc.capacity == -1)
				{
					vc.available = -1;
				}
				else
				{
					vc.available = vc.capacity - vc.current;
					
					if(vc.available < 0)
						vc.available = 0;
				}
				
				vehicles[vehicle.index] = vc;
			}
			
			for(var i in classes)
				classes[i].children = classes[i].children.sort(sortNodes);
			
			//cprint("Drawing tree!");
			
			treeCtl.drawTree();
		}
		
		function sortNodes(a, b)
		{
			if(vehicles[b.data].current < vehicles[a.data].current)
				return -1;
			else if(vehicles[b.data].current > vehicles[a.data].current)
				return 1;
			
			if(vehicles[b.data].type.index < vehicles[a.data].type.index)
				return -1;
			else if(vehicles[b.data].type.index > vehicles[a.data].type.index)
				return 1;
			
			return 0;
		}
								
		function isSelectable(node)
		{
			return true;
		}
		
		function toggleNode(node)
		{
			if(!node.open)
			{
				for(var i = 0; i < rootNodes.length; i++)
				{
					if(rootNodes[i].open && rootNodes[i].id != node.id)
						rootNodes[i].open = false;
				}
			}
		}
		
		function formatSpawnable(tree, node)
		{
			var name				= tree.list.id;
			var indent 			= tree.indent * node.level;
			var mouseenter	= name + ".mouseEnter(this)";
			var mouseexit		= name + ".mouseExit(this)";
			
			//cprint("Formatting " + node.description);
			
			if(node.branch)
			{
				var icon 			= (node.open) ? tree.collapseIcon: tree.expandIcon;
				var label			= node.description.toUpperCase();
				
				var row 			= new ViewBuilder(tree.list, node.id, 0, 0, 0, 16);
				var expander 	= row.addBuilder(new ImageBuilder(row, "image", icon, indent, 3, 10, 10));
				var caption		= row.addBuilder(new TextBuilder(row, "title", "caption", label, (indent + tree.indent), 0, 0, 16));
				
				//row.addAttribute("aspectalign", "left");
				//row.addAttribute("onmouseenter", mouseenter);
				//row.addAttribute("onmouseexit", mouseexit);
				
				//row.addAttribute("acceptmouseclick", "false");
				expander.addAttribute("onclick", name + ".clickTree(true, " + tree.count + ")");
				caption.addStyle("color", "#e9e3d9ff");
				caption.addAttribute("acceptmouseclick", "false");
				
				return row.build(); 				
			}
			else
			{
				var vehicle			= vehicles[node.data];
				var label				= vehicle.type.description;
				var availability		= "n/a";
				var color				= "#00FF00";
				
				if(vehicle.spawnable == "spawnable")
				{
					if(vehicle.capacity == -1)
						availability = vehicle.current + " / unlimited";
					else
						availability = vehicle.current + " / " + vehicle.capacity;
					
					color	 = "#00FF00";
				}
				else if(vehicle.spawnable == "notpresent")
				{
					if(vehicle.capacity == -1)
						availability = "none available";
					else
						availability = vehicle.current + " / " + vehicle.capacity;
					
					color	 = "#FF0000";
				}
				else if(vehicle.spawnable == "notpermitted")
				{
					availability = "not permitted";
					color	 = "#FF0000";
				}
				
				var iconSize 		= 12;
				var textIndent = indent + iconSize + 5;
				var flagPath = scenarioFlag(game.player.team);
				
				var row 				= new ViewBuilder(tree.list, node.id, 0, 0, 0, 16);
				var flagImage		= row.addBuilder(new ImageBuilder(row, "image", flagPath, indent, 2, iconSize, iconSize));
				var vcaption			= row.addBuilder(new TextBuilder(row, "title", "caption", label, textIndent, 0, -textIndent, 16));
				var acaption			= row.addBuilder(new TextBuilder(row, "avail", "caption", availability, textIndent, 0, -5, 16));
				
				//row.addAttribute("aspectalign", "left");
				//row.addAttribute("onmouseenter", mouseenter);
				//row.addAttribute("onmouseexit", mouseexit);
				
				//vcaption.addStyle("color", color);
				//acaption.addStyle("color", color);
				acaption.addAttribute("align", "right");
				//flagImage.addStyle("color", "#FFFFFF00");
				
				//row.addAttribute("acceptmouseclick", "false");
				vcaption.addAttribute("acceptmouseclick", "false");
				acaption.addAttribute("acceptmouseclick", "false");
				flagImage.addAttribute("acceptmouseclick", "false");
				
				return row.build();
			}
		}
		
		function initMemberHeaders(p)
		{
		 	var rb = new RowBuilder(p, "members-header", 0, -22, 0, 15);
		 	
		 	rb.addColumn("TEAM", .07);
		 	rb.addColumn("PLAYER", .17);
		 	rb.addColumn("RANK", .07);
		 	rb.addColumn("WEAPON", .365);
		 	rb.addColumn("K", .05, "center");
		 	rb.addColumn("D", .05, "center");
		 	rb.addColumn("S", .06, "center");
		 	rb.addColumn("READY", .162, "center");
		 	
		 	p.addview(rb.build());
		}
		
		function initMissionMembers()
		{
			var started 				= new Date();
			var members			= game.player.client.missionroomlist;
			
			if(members == null)
				return;
			
			// sort our member list
			members = members.sort(sortMembers);
			
			// clear our list of rows
			memberList.clearRows(false);
			
			var membersCount = members.length;
			
			for(var i = 0; i < membersCount; i++)
			{
				/************ Update Member List **************/
				
				var member 			= members[i];
				var vehicle			= "-";
				var ready				= "";
				
				if(member.weapon != null)
				{
					var memberWeapon = member.weapon;
					
					if(memberWeapon.description.toLowerCase() == "buzzard")
						continue;
					
					vehicle = memberWeapon.description;
				}
				
				var rank			= member.rank;
				var callsign 		= member.callsign;
				var kills				= parseInt(member.kills);
				var deaths		= parseInt(member.deaths);
				var score			= parseInt(member.score);
				var teamIcon 	= scenarioFlag(parseInt(scenario["team" + member.team]));
				
				if(member.ready)
					ready = "ready";
				
				var row 						= new ViewBuilder(memberList.list, "member_" + i, 0, 0, -15, 16);
				var teamBuilder			= row.addBuilder(new ImageBuilder(row, "member-team-image", teamIcon, 102, 1, 14, 14));
				var nameBuilder			= row.addBuilder(new TextBuilder(row, "member-name-caption", "caption", callsign, 15, 0, 72, 16));
				var rankBuilder				= row.addBuilder(new TextBuilder(row, "member-rank-caption", "caption", "", 0, 1, 14, 14));
				var vehicleBuilder			= row.addBuilder(new TextBuilder(row, "member-vehicle-caption", "caption", vehicle, 102, 0, 152, 16));
				var killsBuilder				= row.addBuilder(new TextBuilder(row, "member-kills-caption", "caption", kills, 257, 0, 20, 16));
				var deathsBuilder			= row.addBuilder(new TextBuilder(row, "member-deaths-caption", "caption", deaths, 279, 0, 20, 16));
				var scoreBuilder			= row.addBuilder(new TextBuilder(row, "member-score-caption", "caption", score, 301, 0, 25, 16));
				var readyBuilder	 		= row.addBuilder(new TextBuilder(row, "member-ready-caption", "caption", ready, 328, 0, 60, 16));
				
				teamBuilder.hbuffer		= 7;
				rankBuilder.hbuffer		= 6;
				
				// space out our children builders
				row.hspace(2);
				
				// fix up our main row
				row.addAttribute("aspectalign", "left");
				row.addStyle("background-color", ((member.friendly) ? game.settings.friendlycolor : game.settings.enemycolor) + "22");
				if(member.me) row.addStyle("border-color", game.settings.friendlycolor);
				
				//row.addAttribute("onmouseenter", mouseenter);
				//row.addAttribute("onmouseexit", mouseexit);
				
				// rank attributes
				rankBuilder.addAttribute("class", "rankicon");
				rankBuilder.addAttribute("rank", member.rank.level - 1);
				
				// font colors
				nameBuilder.addStyle("color", "#e9e3d9ff");
				vehicleBuilder.addStyle("color", "#e9e3d9ff");
				killsBuilder.addStyle("color", "#e9e3d9ff");
				deathsBuilder.addStyle("color", "#e9e3d9ff");
				scoreBuilder.addStyle("color", "#e9e3d9ff");
				readyBuilder.addStyle("color", "#e9e3d9ff");
				
				if(false)
				{
					nameBuilder.addStyle("border-color", "#e9e3d9ff");
					vehicleBuilder.addStyle("border-color", "#e9e3d9ff");
					killsBuilder.addStyle("border-color", "#e9e3d9ff");
					deathsBuilder.addStyle("border-color", "#e9e3d9ff");
					scoreBuilder.addStyle("border-color", "#e9e3d9ff");
					readyBuilder.addStyle("border-color", "#e9e3d9ff");
				}
				
				killsBuilder.addAttribute("align", "center");
				deathsBuilder.addAttribute("align", "center");
				scoreBuilder.addAttribute("align", "center");
				readyBuilder.addAttribute("align", "center");
				
				memberList.addRow(member, row.build());
			}
			
			memberList.setScrollY();
			
			var stopped = new Date();
			
			//game.consoleprint("Member List Update took " + (stopped.getTime() - started.getTime()) + "ms with " + membersCount + " members\n");
		}
		
		function membersUpdated()
		{
			doMemberUpdate = true;
		}
		
		function sortMembers(a,b)
		{
			if(a.team == b.team)
			{
				if(a.score > b.score)
					return -1;
				else if(a.score < b.score)
					return 1;
			}
			else  
			{
				if(a.team == game.scenario.team)
					return -1;
				else
					return 1; 
			}
			
			return 0;
		}
		
	-->
</script>

