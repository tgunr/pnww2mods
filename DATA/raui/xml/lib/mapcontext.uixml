<?xml version="1.0"?>
<script private="true">
	<!--
	
	contextMenu = this;
	
	function initContext(mgr, clickx, clicky, mapobj)
	{
		contextMenu.mgr 		= mgr;
		contextMenu.clickx 		= clickx;
		contextMenu.clicky 		= clicky;
		contextMenu.mapobj		= mapobj;
	}
	
	function addWaypoint(type)
	{
		consoleprint("Adding new waypoint!\n");
		
		var mgr = contextMenu.mgr;
		
		if(mgr && mgr.canAddWaypoint())
		{
			var popup = load("widgets/map/waypoint");
			popup.initWaypointPopup(mgr.map, type, contextMenu.clickx, contextMenu.clicky);
		}
		
		consoleprint("Closing menu!\n");
	}
	
	function addReport(type)
	{
		consoleprint("Adding new report!\n");
		
		var mgr = contextMenu.mgr;
		
		if(mgr && mgr.canAddReport())
		{
			var popup = load("widgets/map/report");
			popup.initReportPopup(mgr.map, type, contextMenu.clickx, contextMenu.clicky);
		}
		
		consoleprint("Closing menu!\n");
	}
	
	function approveWaypoint()
	{
		consoleprint("Approving waypoint!\n");
		
		var mgr = contextMenu.mgr;
		
		if(mgr)
			mgr.map.approvewaypoint(contextMenu.mapobj);
	}
	
	function deleteWaypoint()
	{
		consoleprint("Deleting waypoint!\n");
		
		var mgr = contextMenu.mgr;
		
		if(mgr)
			mgr.map.deletewaypoint(contextMenu.mapobj);
	}
	
	function activateWaypoint()
	{
		consoleprint("Approving waypoint!\n");
		
		var mgr = contextMenu.mgr;
		
		if(mgr)
			mgr.map.setactivewaypoint(contextMenu.mapobj);
	}
	
	function sendChat()
	{
		consoleprint("Sending chat!\n");
		
		if(contextMenu.mapobj)
			contextMenu.mapobj.setchattoplayer();
	}
	
	function setContexts(contexts)
	{
		var draw = false;
		
		for(var c in contexts)
		{
			var context = contextMenu.findview(c);
			
			if(context)
			{
				context.enabled = contexts[c];
				
				if(contexts[c])
					draw = true;
			}
		}
		
		consoleprint("Context Menu Draw is " + draw + "\n");
		
		contextMenu.visible = (draw) ? true: false;
	}
	
	function mouseEnter(menu)
	{
		menu.setstyleproperty('background-color','#000000');
		menu.setstyleproperty('color','#FFFF00');
	}
	
	function mouseExit(menu)
	{
		menu.setstyleproperty('background-color','#000000AA');
		menu.setstyleproperty('color','#FFFFFF');
	}
	
	-->
</script>

