<ra id="lobby">
	<include file="lib/common.uixml"/>
	<include file="lib/scenarios.uixml"/>
	
	<!-- start editing -->
	
	<view id="info-panel" x="10" y="80" width="210" rtop="20">
		<view style="layout: vertical; vpad: 10;">
			<panel label="POPULAR MAPS" align="center" height="130" style="class: litebg;">
				<listcontrol id="popular" pad="15" rtop="20" style="class: litebg;"/>
			</panel>
			
			<panel label="MESSAGE OF THE DAY" align="center" height="100" style="class: litebg;">
				<text id="motd" pad="15" rtop="20" style="class: litebg;"/>
			</panel>
			
			<panel label="RECENT ACHIEVEMENTS" align="center" height="100" style="class: litebg;">
				<list id="achievements" pad="15" rtop="20" style="class: litebg;"/>
			</panel>
		</view>
	</view>
	<view id="main-panel" x="240" y="80" rright="10" rtop="20">
		<panel label="ACTIVE MAPS" x="10" height=".49" rright="10" rtop="0" align="center">
			<listcontrol id="instance-list" pad="15" rtop="20"/>
		</panel>
		<view x="10" y="0" height=".47" rright="10">
			<sceninfoh id="scenario-info">
				<image id="scenario-image"/>
			</sceninfoh>
		</view>
	</view>
	<navbar>
		<button id="create-button" label="    NEW GAME" x="20" onclick="window.mgr.DoCreate()" style="class: button.forward;" center="y"/>
		<button id="join-button" label="JOIN GAME   " rright="20" onclick="this.mgr.Click(selectInstance, true)" enabled="false" style="class: button.back;" center="y"/>
				<caption label="RAPID ASSAULT- MAIN LOBBY" width="250" height="20" center="true" style="class:bigtext;"/>
	</navbar>
	
		<!-- stop editing -->
	
	<script>
		<!--
		 //
		 
		var client 				= game.player.client;
		var createBtn		= findview("create-button");
		var joinBtn			= findview("join-button");
		var updateTimer	= new CycleTimer(5000);
		var root				= loadRoot();
		var running			= new Array();
		var instanceList 	= findview("instance-list");
		var popularList 	= findview("popular");
		var scenarioInfo	= findview("scenario-info");
		var testRows		= new Array();
		var mapCount		= new Object();
		
		// when our instance list is updated
		game.oninstancelist = initInstances;
		
		function OnShow(win)
		{
			if(game.online)
			{
				var motd = client.requestmotd(0);
			
				if(motd != null)
					findview("motd").text = motd.message;
			}
			
			// make sure
			game.stopscenario();
			
			// we're on the lobby, we don't need this
			window.mgr.SetVisible("lobby-button", false);
			
			initHeaders(instanceList);
			
			scenarioInfo.mgr.SetScenario();
			
			// init our local list variable
			instanceList.mgr.selectCallback = selectInstance;
			
			// call out to the host to get our list of instances
			// join our lobby instance
			if(game.online)
				client.selectinstance(root.category, 0);
			
			//createTestRows();
			initInstances();
		}
		
		function initHeaders(pp)
		{
			//p.mgr.SetTitle("INSTANCES");
			
			// create our headers
			pp.mgr.StartHeaders("scenarios-header", 0, -1, 0, 15);
			pp.mgr.AddHeader("PW", .03);
		 	pp.mgr.AddHeader("scenarios.list.id", .12);
		 	pp.mgr.AddHeader("scenarios.list.map", .4);
		 	pp.mgr.AddHeader("scenarios.list.type", .1, "center");
		 	pp.mgr.AddHeader("scenarios.list.status", .15, "center");
		 	pp.mgr.AddHeader("scenarios.list.players", .1, "center");
		 	pp.mgr.AddHeader("scenarios.list.squad", .1, "center");
			pp.mgr.EndHeaders();
		}
		
		function initInstances()
		{
			// reset our running list of instances 
			running = new Array();
			mapCount = new Object();
			
			joinBtn.enabled = false;
			
			// some temp vars
			var instances = client.instances;
			
			// now for each category, add our instances
			for(var i = 0; i < instances.length; i++)
			{
				var instance = instances[i];
				if(instance == null) continue;
				
				var content = loadScenario(instance.description.category, instance.description.type);
				if(content == null) continue;
				
				var scenario = new Object();
				
				scenario.id				= instance.description.id;
				scenario.content 		= content;
				scenario.instance 	= instance;
				
				running.push(scenario);
			}
			
			// now sort our running instances
			// running = running.sort(sortScenarios);
			
			// now update our visible list
			instanceList.mgr.control.clearRows(false);
			
			for(var i = 0; i < running.length; i++)
			{
				var scenario 	= running[i];
				var content 		= scenario.content;
				var instance 	= scenario.instance;
				var id				= instance.description.id;
				var players		= instance.axis + instance.allies;
				
				var team1max	= parseInt(content.team1max);
				if(isNaN(team1max)) team1max = MAX_SIDE_PLAYERS;
				
				var team2max	= parseInt(content.team2max);
				if(isNaN(team2max)) team2max = MAX_SIDE_PLAYERS;
				
				instanceList.mgr.StartRow("row" + i, 0, 0, 0, 16);
				
				if(instance.haspassword)
					instanceList.mgr.AddRowIcon("image", "ui/textures/lock.dds", .03, 12, 2);
				else
					instanceList.mgr.AddRowSpace(.03);
				
				instanceList.mgr.AddRowColumn("#" + id, .12);
				instanceList.mgr.AddRowColumn(content.title, .4);
				
				if(content.maptype != null)
					instanceList.mgr.AddRowColumn(content.maptype, .1, "center");
				else
					instanceList.mgr.AddRowColumn("DM", .1, "center");
				
				if(players < team1max + team2max)
					instanceList.mgr.AddRowColumn("scenarios.list.status.running", .15, "center");
				else
					instanceList.mgr.AddRowColumn("scenarios.list.status.full", .15, "center");
				
				instanceList.mgr.AddRowColumn(players, .1, "center");
				instanceList.mgr.AddRowIcon("chaticon", "squad", .1, 12, .5);
				
				addToMapCount(instance.description.category, instance.description.type, content.title);
				
				instanceList.mgr.EndRow(scenario);
			}
				
			addTestRows();
			
			if(running.length > 0)
				joinBtn.enabled = true;
			
			instanceList.mgr.control.postInit(0);
			
			updatePopulars();
		}
		
		function createTestRows()
		{
			var catCount = root.links.length;
			
			for(var t = 0; t < 100; t++)
			{
				var newTest 	= new Object();
				var catID			= 500 + Math.floor(Math.random() * 4) + 1;
				var category	= loadCategory(catID);
				
				if(category == null)
					continue;
				
				var mapCount	= category.links.length;
				var mapID		= Math.floor(Math.random() * mapCount);
				var scenario		= loadScenario(catID, mapID);
				
				if(scenario == null)
					continue;
				
				cprint("New test " + catID + "/" + mapID);
				
				newTest["haspassword"]	= Math.random() < .2; 
				newTest["content"]				= scenario;
				newTest["id"] 						= Math.floor(Math.random() * 10000);
				newTest["title"]					= scenario.title;
				newTest["full"]					= Math.random() > .5;
				newTest["players"] 			= Math.floor(Math.random() * 65);
				newTest["squad"]				= Math.random() > .5;
				newTest["cid"]						= catID;
				newTest["mid"]					= mapID;
				
				//cprint("Adding test scenario " + scenario.title);
				
				if(scenario.maptype != null)
					newTest["type"]	= scenario.maptype;
				else
					newTest["type"]	= "DM";
				
				testRows.push(newTest);
			}
		}
		
		function addTestRows()
		{
			if(testRows.length == 0)
				return;
			
			for(var i = 0; i < testRows.length; i++)
			{
				var t 		= testRows[i];
				var index = running.length + i;
				
				instanceList.mgr.StartRow("row" + index, 0, 0, 0, 16);
				
				if(t.haspassword)
					instanceList.mgr.AddRowIcon("image", "ui/textures/lock.dds", .03, 12, 2);
				else
					instanceList.mgr.AddRowSpace(.03);
				
				instanceList.mgr.AddRowColumn("#" + t.id, .12);
				instanceList.mgr.AddRowColumn(t.title, .4);
				instanceList.mgr.AddRowColumn(t.type, .1, "center");
				
				if(t.full)
					instanceList.mgr.AddRowColumn("scenarios.list.status.full", .15, "center");
				else
					instanceList.mgr.AddRowColumn("scenarios.list.status.running", .15, "center");
				
				instanceList.mgr.AddRowColumn(t.players, .1, "center");
				
				if(t.squad)
					instanceList.mgr.AddRowIcon("chaticon", "squad", .1, 12, .5);
				
				addToMapCount(t.cid, t.mid, t.title);
				
				instanceList.mgr.EndRow(t);
			}
		}
		
		function selectInstance(action)
		{
			cprint("Select instance called: " + instanceList.control.selectedID());
			
			joinBtn.enabled = false;
			
			var scenario = instanceList.mgr.control.selectedData();
			if(scenario == null) return;
			
			joinBtn.enabled = true;
			
			// update our info
			scenarioInfo.mgr.SetScenario(scenario.content);
			
			if(action)
			{
				if(!canJoinInstance(scenario.content, scenario.instance))
				{
					showOk(lastScenarioError);
					return;
				}
				
				if((scenario.instance != null && scenario.instance.haspassword) || scenario.haspassword)
				{
					showPopup("password", "ENTER PASSWORD TO JOIN:", checkPassword);
				}
				else if(!joinInstance(scenario.instance.description, false))
				{
					showOk("Failed to join instance!");
					joinLobby();
				}
			}
		}
		
		function checkPassword(action, pwMgr)
		{
			if(action)
			{
				var input = pwMgr.view.findview("password-input");
				var password = input.text;
				
				consoleprint("Entered password is " + password);
				
				if(!joinInstance(scenario.instance.description, false, password))
				{
					showOk("Failed to join instance!");
					joinLobby();
				}
			}
			
			return true;
		}
		
		function OnUpdate()
		{
			// grab our list of instances
			if(updateTimer.run())
				client.listinstances(0, 0, "");
		}
		
		function scoreSort(a, b)
		{
			if(a.score > b.score)
				return -1;
			else if(a.score < b.score)
				return 1;
			
			return 0;
		}
		
		function updatePopulars()
		{
			var pops = new Array();
			
			for(var mc in mapCount)
				pops.push(mapCount[mc]);
			
			cprint("Populars: " + pops.length);
			
			pops = pops.sort(scoreSort);
			
			popularList.mgr.control.clearRows(false);
			
			var plen = pops.length;
			
			if(plen > 6)
				plen = 6;
			
			for(var p = 0; p < plen; p++)
			{
				popularList.mgr.StartRow("row" + p, 0, 0, 0, 14);
				popularList.mgr.AddRowColumn(pops[p].title, .8, "left", "tinytext");
				popularList.mgr.AddRowColumn(pops[p].score, .2, "right", "tinytext");
				popularList.mgr.EndRow();
			}
			
			popularList.mgr.control.postInit();
		}
		
		function addToMapCount(cid, mid, title)
		{
			var id = cid + "." + mid;
			
			if(mapCount[id] == null)
			{
				var newCount = new Object();
				
				newCount["cid"] = cid;
				newCount["mid"] = mid;
				newCount["score"] = 0;
				newCount["title"] = title;
				mapCount[id] = newCount;
			}
			
			mapCount[id].score ++;
		}
		
		-->
	</script>
</ra>
