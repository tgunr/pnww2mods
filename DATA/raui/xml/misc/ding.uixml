<view id="ding" y="100" width="250" height="60" layer="500" center="x" style="class: ding;" manager="DingManager">
	<image id="ding-image" src="raui/textures/ra_ding.bmp" width="64" height="64" x="10" center="y" style="size-scaler: .7;"/>
	<text id="ding-title" height="25" width=".75" rtop="3" rright="0" style="class: ding.title;"/>
	<text id="ding-description" y="10" height="25" width=".75" rright="0" style="class: ding.description;"/>
</view>
