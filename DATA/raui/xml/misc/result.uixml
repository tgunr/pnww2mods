<window id="result" width=".9" height=".7" aspectlimit="width" center="true" style="class: ding; class: border;" manager="ResultScreen">
	<view x="50" height="30" rtop="20" rright="50">
		<caption id="result-header" label="DRAW: Neither Team Completed Its Objectives!" pad="2" style="font-size: +15;" center="true" align="center"/>
	</view>

	<view x="50" width=".4" y="50" rtop="70" style="layout: v; vpad: 15; class: border;">
		<panel label="TEAM STATS" pad="15" height=".25" rtop="25" style="class: litebg; vpad: 20;">
			<listcontrol id="teams" x="15" y="15" rtop="20" rright="15" style="class: litebg;"/>
		</panel>
		<panel label="YOUR SCORE" pad="15" height=".65" style="class: litebg;">
			<view pad="15" rtop="20" style="layout: v;">
				<view height="15" style="layout: h; class: litebg; vpad: 5;">
					<caption id="player-callsign" width=".5" label="ramp"/>
					<caption id="player-rank" width=".5" label="rank 1" align="right"/>
				</view>
				
				<view height="15" style="layout: h; class: litebg; vpad: 10;">
					<caption width=".5" label="objective points:"/>
					<caption id="player-obj-points" width=".5" label="0" align="right"/>
				</view>
				<view height="15" style="layout: h; class: litebg;">
					<caption width=".5" label="bonus points:"/>
					<caption id="player-bon-points" width=".5" label="0" align="right"/>
				</view>
				<view height="15" style="layout: h; class: litebg;">
					<caption width=".5" label="score:"/>
					<caption id="player-score" width=".5" label="0" align="right"/>
				</view>
				
				
				<view height="15" style="layout: h; class: litebg; vpad: 10;">
					<caption width=".5" label="kills:"/>
					<caption id="player-kills" width=".5" label="0" align="right"/>
				</view>
				<view height="15" style="layout: h; class: litebg;">
					<caption width=".5" label="kills streak:"/>
					<caption id="player-killstreak" width=".5" label="0" align="right"/>
				</view>
				<view height="15" style="layout: h; class: litebg;">
					<caption width=".5" label="deaths:"/>
					<caption id="player-deaths" width=".5" label="0" align="right"/>
				</view>
				
				<view height="15" style="layout: h; class: litebg; vpad: 10;">
					<caption width=".5" label="spawns:"/>
					<caption id="player-spawns" width=".5" label="12" align="right"/>
				</view>
				<view height="15" style="layout: h; class: litebg;">
					<caption width=".5" label="best weapon:"/>
					<caption id="player-best-weapon" width=".5" label="German SMG" align="right"/>
				</view>
				<view height="15" style="layout: h; class: litebg;">
					<caption width=".5" label="favorite weapon:"/>
					<caption id="player-favorite-weapon" width=".5" label="German RIfle" align="right"/>
				</view>

				<view height="15" style="layout: h; class: litebg; vpad: 10;">
					<caption width=".5" label="nemesis:"/>
					<caption id="player-nemesis" width=".5" label="BLOO" align="right"/>
				</view>
				<view height="15" style="layout: h; class: litebg;">
					<caption width=".5" label="dominated:"/>
					<caption id="player-dominated" width=".5" label="noone" align="right"/>
				</view>
				
				<view height="15" style="layout: h; class: litebg; vpad: 10;">
					<caption width=".5" label="last achievement:"/>
					<caption id="player-ding" width=".5" label="Running Man" align="right"/>
				</view>
				
			</view>
		</panel>
	</view>
	<view width=".4" y="50" rtop="70" rright="50" style="layout: v; vpad: 15; class: border;">
		<panel label="TOP 5 SCORERS" pad="15" height=".45" style="class: litebg; vpad: 20;">
			<listcontrol id="scorers" x="15" y="15" rtop="20" rright="15" style="class: litebg;"/>
		</panel>
		<panel label="TOP 5 KILLERS" pad="15" height=".45" style="class: litebg;">
			<listcontrol id="killers" x="15" y="15" rtop="20" rright="15" style="class: litebg;"/>
		</panel>
	</view>
	<button label="CLOSE" y="10" onclick="window.mgr.Close()" center="x" style="class: button.small;"/>
</window>
