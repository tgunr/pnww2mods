<script>

	<include file="classes/ScreenManager.uixml"/>
	
	<!--
	
	function ResultScreen(s)
	{
		var self = new ScreenManager(s);
		
		self.BaseOnShow 	= self.OnShow;
		self.winner				= 0;
		self.player				= null;
		
		self.OnShow = function()
		{
			this.winner = parseInt(game.getstate("victory", "0"));
			this.player = game.scenario.player;
			
			game.playsound("sounds/Drum1.wav", 1, 1);
			
			this.InitHeader();
			this.InitTeams();
			this.InitPlayer();
			this.InitScorers();
			this.InitKillers();
			this.BaseOnShow();
			
			if(game.ingame)
			{
				game.cancelppo();
				game.enableimapinput(false);
				game.cursor.visible 	= true;
			}
		}
		
		self.Close = function(click)
		{
			if((game.frametime - this.created) < 300)
				return;
			
			if(click != false)
				this.PlayClick();
			
			if(game.ingame)
			{
				//game.load("aar");
				game.despawn(false);
			}
			else
			{
				var readyRoom = game.findview("readyroom");
				readyRoom.OnResult();
			}
			
			this.view.close();
		}
		
		self.InitHeader = function()
		{
			var header = this.view.findview("result-header");
			
			if(this.winner == 1)
				header.label = "VICTORY! " + game.scenario.team1.name + " wins!";
			else if(this.winner == 2)
				header.label = "VICTORY! " + game.scenario.team2.name + " wins!";
			else
				header.label = "DRAW! Neither team completed its objectives!";
		}
		
		self.InitScorers = function()
		{
			var list 				= this.view.findview("scorers");
		 	var members 	= game.client.instance.members;
		 	
		 	members = members.sort(sortByScore);
		 	
		 	this.InitList(list, members, 5);
		}
		
		self.InitKillers = function()
		{
			var list 				= this.view.findview("killers");
		 	var members 	= game.client.instance.members;
		 	
		 	members = members.sort(sortByKills);
		 	
		 	this.InitList(list, members, 5);
		}
		
		self.InitPlayer = function()
		{
			this.SetPlayerInfo("player-callsign", "callsign");
			this.SetCaption("player-rank", "rank " + this.player.rank);
			this.SetPlayerInfo("player-kills", "kills");
			this.SetPlayerInfo("player-killstreak", "killstreak");
			this.SetPlayerInfo("player-deaths", "deaths");
			this.SetPlayerInfo("player-obj-points", "objectivepoints");
			this.SetPlayerInfo("player-bon-points", "bonuspoints");
			this.SetPlayerInfo("player-score", "score");
			this.SetPlayerInfo("player-spawns", "spawns");
			
			if(this.player.bestweapon != null)
				this.SetCaption("player-best-weapon", this.player.bestweapon.description);
			else
				this.SetCaption("player-best-weapon", "na");
				
			if(this.player.favoriteweapon != null)
				this.SetCaption("player-favorite-weapon", this.player.favoriteweapon.description);
			else
				this.SetCaption("player-favorite-weapon", "na");
				
			if(this.player.nemesis != null)
				this.SetCaption("player-nemesis", this.player.nemesis.callsign);
			else
				this.SetCaption("player-nemesis", "noone");

			if(this.player.dominated != null)
				this.SetCaption("player-dominated", this.player.dominated.callsign);
			else
				this.SetCaption("player-dominated", "noone");
			
			if(game.dings.length > 0)
				this.SetCaption("player-ding", game.dings[game.dings.length - 1].title);
			else
				this.SetCaption("player-ding", "na");
		}
		
		self.SetPlayerInfo = function(vid, state)
		{
			this.SetCaption(vid, this.player[state]);
		}
		
		self.InitTeams = function()
		{
			var list = this.view.findview("teams");
		 	
			list.mgr.StartHeaders("team-header", 0, -1, 0, 15);
			list.mgr.AddHeaderSpace(.05);
		 	list.mgr.AddHeader("TEAM", .1, "center");
		 	list.mgr.AddHeaderSpace(.4);
		 	list.mgr.AddHeader("KILLS", .15, "center");
		 	list.mgr.AddHeader("DEATHS", .15, "center");
		 	list.mgr.AddHeader("SCORE", .15, "center");
		 	list.mgr.EndHeaders();
			
			// clear our list of rows
			list.control.clearRows(false);
			
			var teams = new Array();
			
			if(this.winner == 1)
			{
				teams.push(game.scenario.team1);
				teams.push(game.scenario.team2);
			}
			else
			{
				teams.push(game.scenario.team2);
				teams.push(game.scenario.team1);
			}
			
			for(var i = 0; i < teams.length; i++)
			{
				/************ Update Member List **************/
				
				var team 			= teams[i];
				var name 			= team.name;
				var kills				= parseInt(team.kills);
				var deaths		= parseInt(team.deaths);
				var score			= parseInt(team.score);
				var teamIcon 	= "blueteam";
				
				consoleprint("Processing team " + team.team);
				
				if(team.team == 2)
					teamIcon = "redteam";
				
				var id = "team." + team.name;
				var row = list.mgr.StartRow(id, 0, 0, 0, 16);
				
				// space out our children builders
				row.hspace(2);
				
				list.mgr.AddRowColumn((i + 1) + ".", .05);
				list.mgr.AddRowView(.1, 10, .5, teamIcon);
				list.mgr.AddRowColumn(name, .4);
				list.mgr.AddRowColumn(kills, .15, "center");
				list.mgr.AddRowColumn(deaths, .15, "center");
				list.mgr.AddRowColumn(score, .15, "center");
				
				list.mgr.EndRow();
			}
			
			list.control.setScrollY();
			list.control.postInit();
		}
		
		self.InitList = function(list, members, limit)
		{
			if(list == null || members == null)
				return;
				
			list.mgr.StartHeaders("list-header", 0, -1, 0, 15);
			list.mgr.AddHeaderSpace(.05);
		 	list.mgr.AddHeader("TEAM", .1, "center");
		 	list.mgr.AddHeader("PLAYER", .4);
		 	list.mgr.AddHeader("KILLS", .15, "center");
		 	list.mgr.AddHeader("DEATHS", .15, "center");
		 	list.mgr.AddHeader("SCORE", .15, "center");
		 	list.mgr.EndHeaders();
			
			// clear our list of rows
			list.control.clearRows(false);
			
			var count = members.length;
			
			if(limit < count)
				count = limit;
			
			for(var i = 0; i < count; i++)
			{
				/************ Update Member List **************/
				
				var member 		= members[i];
				var callsign 		= member.callsign;
				var kills				= parseInt(member.kills);
				var deaths		= parseInt(member.deaths);
				var score			= parseInt(member.score);
				var teamIcon 	= "blueteam";
				
				if(member.team == 2)
					teamIcon = "redteam";
				
				var id = "member." + member.callsign;
				var row = list.mgr.StartRow(id, 0, 0, 0, 16);
				
				// space out our children builders
				row.hspace(2);
				
				list.mgr.AddRowColumn((i + 1) + ".", .05);
				list.mgr.AddRowView(.1, 10, .5, teamIcon);
				list.mgr.AddRowColumn(callsign, .4);
				list.mgr.AddRowColumn(kills, .15, "center");
				list.mgr.AddRowColumn(deaths, .15, "center");
				list.mgr.AddRowColumn(score, .15, "center");
				
				list.mgr.EndRow();
			}
			
			list.control.setScrollY();
			list.control.postInit();
		}
		
		self.SetCaption = function(vid, value)
		{
			var caption = this.view.findview(vid);
			
			if(caption != null)
				caption.label = value;
		}
		
		return self;
	}
	
	function sortByScore(a, b)
	{
		if(a.score > b.score)
			return -1;
		else if(a.score < b.score)
			return 1;
		
		return 0;
	}
	
	function sortByKills(a, b)
	{
		if(a.kills > b.kills)
			return -1;
		else if(a.kills < b.kills)
			return 1;
		
		return 0;
	}
	
	-->
</script>
