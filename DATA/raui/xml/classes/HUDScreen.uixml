<script>

	<include file="classes/ScreenManager.uixml"/>
	
	<!--
	
	function HUDScreen(s)
	{
		var self = new ScreenManager(s);
		
		game.consoleprint("Creating HUDScreen for " + self.view.id);
		
		
		
		// helper functions
		self.SetChildProp = function(id, prop, value)
