			var child = this.view.findview(id);
			
			if(child != null && child[prop] != value)
				child[prop] = value;
		}
		
		self.SetLabel = function(id, value)
		{
			this.SetChildProp(id, "label", getlocstring(value));
		}
		
		self.SetVisibility = function(id, value)
		{
			this.SetChildProp(id, "visible", value);
		}
		
		self.SetImage = function(id, value)
		{
			this.SetChildProp(id, "src", value);
		}
		
		self.SetValue = function(id, value)
		{
			this.SetChildProp(id, "value", value);
		}
		
		return self;
	}
	
	-->
</script>
