<script>
	<!--
	
	function List(list)
	{
		// members
		this.list				= list;
		this.width			= list.width;
		this.data 			= null; 				// selected data
		this.row			= null; 				// selected row
		this.selected	= null; 				// selected row's id
		this.count			= 0;					// number of rows
		this.colorText	= true;					// do we color the text of selected rows?
		this.scrolly		= this.list.scrolly;
		
		this.setScrollY = function(sy)
		{
			this.list.scrolly 	= (sy != null) ? sy: this.scrolly;
			this.scrolly 		= this.list.scrolly;
		}
		
		this.length = function()
		{
			return this.list.length;
		}
		
		this.setWidth = function(w)
		{
			this.width = w;
		}
		
		this.getWidth = function()
		{
			return (this.width) ? this.width: this.list.width; 
		}
		
		this.setColorText = function(c)
		{
			this.colorText = c;
		}

		this.mouseEnter = function(row)
		{
			row.setstyleproperty("background-color", ListControl.LISTROW_BGCOLOR_ON);
		}
		
		this.mouseExit = function(row)
		{
			if(this.row == null || row.id != this.selected)
				row.setstyleproperty("background-color", ListControl.LISTROW_BGCOLOR_OFF);
		}
	}
	
	function ListControl(list, onclick, ondraw, onselect)
	{
		var self = new List(list);

		// lets set the callbacks
		self.onclick 	= onclick;
		self.ondraw 	= ondraw;
		self.onselect	= onselect;
		
		// methods
		self.select = function(index)
		{
			//consoleprint("select called with " + index + "\n");
			
			var list = this.list;
			
			if(list.length > 0)
			{
				if(index != null && index > -1 && index < list.length)
					list.value = index;
				
				//consoleprint("Setting list value to " + list.value + "\n");
				
				if(list.selecteddata != null)
				{
					//consoleprint("Data was not null with " + list.selecteddata.data + "\n");
					
					if(list.value != -1 && this.selected != list.selectedrow.id)
						game.playsound("ui/sounds/select.wav", 1, .05);
					
					this.setData(list.selecteddata, list.selectedrow);
				}
			}
		}
		
		self.clickList = function(dbl, index)
		{
			consoleprint("clickList called with " + dbl + " and " + index + "\n");
			
			this.select(index);
			
			if(this.onclick != null)
				this.onclick(dbl)
		}
		
		self.addRow = function(data, row, selected)
		{
			if(row == null && this.ondraw != null)
				row = this.ondraw(this, data);
			
			var rowview = this.list.addrow(row, data);
			
			if((selected != null && selected(data)) || (rowview != null && rowview.id == this.selected))
				this.clickList(false, this.count);
			
			this.count++;
			
			return rowview;
		}
		
		self.clearRows = function(reset)
		{
			this.data 		= null;
			this.row 		= null;
			this.count		= 0;
			this.scrolly	= this.list.scrolly;
			
			this.list.clearrows();
			
			if(reset)
			{
				this.scrolly	= 0;
				this.selected 	= null;
			}
			
			//consoleprint("Scroll Y is now " + this.scrolly + "\n");
		}
		
		self.setData = function(data, row)
		{
			//consoleprint("setData called with " + row.id + "\n");
			
			if(this.onselect != null)
			{
				this.onselect(this.row, row);
			}
			else
			{
				if(this.row != null)
				{
					this.row.setstyleproperty("background-color", ListControl.LISTROW_BGCOLOR_OFF);
					
					if(this.colorText)
						this.row.setstyleproperty("color", ListControl.LISTROW_CAPTION_OFF, true);
				}

				row.setstyleproperty("background-color", ListControl.LISTROW_BGCOLOR_ON);
				
				if(this.colorText)
					row.setstyleproperty("color", ListControl.LISTROW_CAPTION_ON, true);
			}
						
			this.data 		= data;
			this.row		= row;
			this.selected	= row.id;
		}
		
		self.postInit = function(index)
		{
			if(this.list.value == -1)
			{
				if(index == null)
					index = 0;
				
				this.clickList(false, index);
			}
			
			this.setScrollY();
		}
		
		return self;
	}
	
	function SimpleListControl(list)
	{
		var self = new List(list);

		// lets set the callbacks
		self.callbacks = new Object();
		
		// our easy access row list
		self.rows 	= new Array();
		self.row	= null; // selected row
		
		self.addCallback = function(name, callback)
		{
			this.callbacks[name] = callback;
		}
		
		self.call = function(name, data)
		{
			var callback = this.callbacks[name];
			
			if(callback != null)
			{
				cprint("Calling " + name + "  with " + data);
				callback(data);
			}
		}
		
		// methods
		self.selectByIndex = function(index)
		{
			var id 		= null;
			var rows 	= this.rows;

			if(index >= 0 && index < this.rows.length)
				id = rows[index].id;
			
			return this.select(id);
		}
		
		self.selectByID = function(id)
		{
			return this.select(id);
		}
		
		self.selectByData = function(data)
		{
			var id 		= null;
			var rows 	= this.rows;
			
			for(var i = 0; i < rows.length; i++)
			{
				if(rows[i].data == data)
				{
					id = rows[i].id;
					break;
				}
			}
			
			return this.select(id);
		}
		
		self.selectByCallback = function(callback)
		{
			var id = null;
			
			if(callback)
			{
				var rows = this.rows;
				
				for(var i = 0; i < rows.length; i++)
				{
					if(callback(rows[i]))
					{
						id = rows[i].id;
						break;
					}
				}
			}
			
			return this.select(id);
		}
		
		self.selectFirst = function()
		{
			return this.selectByIndex(0);
		}
		
		self.selectLast = function()
		{
			return this.selectByIndex(this.rows.length - 1);
		}
		
		self.select = function(id)
		{
			var list = this.list;
			var index = this.rowIndex(id);
			
			cprint("Selected list index is " + index);
			
			if(index >= 0 && index <  list.length)
			{
				game.playsound("ui/sounds/select.wav", 1, .05);
				
				list.value = index;
				
				this.setData(this.rows[index]);
			}
			else
			{
				this.deselect();
			}
		}
		
		self.deselect = function()
		{
			this.setData(null);
		}
		
		self.clickList = function(dbl)
		{
			cprint("List Click is " + this.list.value);
			
			this.selectByIndex(this.list.value);
			this.call("onclick", dbl);
		}
		
		self.rowID = function(index)
		{
			if(index >= 0 && index < this.rows.length)
				return this.rows[index].id;
			
			return null;
		}
		
		self.rowIndex = function(id)
		{
			var rows = this.rows;
			
			for(var i = 0; i < rows.length; i++)
			{
				if(id == rows[i].id)
					return i;
			}
			
			return -1;
		}
		
		self.addRow = function(d, r)
		{
			var view = this.list.addrow(r, d);
			
			if(!view)
				return null;
			
			var row = new Object();
			
			row["data"] 		= d;
			row["view"] 		= view;
			row["id"]			= row.view.id;
			
			this.rows.push(row);
			this.call("onadd", row);
			
			if(row.id == this.selected)
				this.select(row.id);	
			
			return row;
		}
		
		self.removeRow = function(id)
		{
			var index = this.rowIndex(id);
			
			if(index >= 0 && index < this.rows.length)
			{
				var row = this.rows.splice(index, 1);
				
				// view will no longer be valid after the next call
				row.view = null;
				
				this.list.removerow(index);
				this.call("onremove", row);
				
				return true;
			}
			
			return false;
		}
		
		self.clearRows = function(reset)
		{
			this.rows		= new Array();
			this.row 		= null;
			this.count		= 0;
			this.scrolly	= this.list.scrolly;
			
			this.list.clearrows();
			
			if(reset)
			{
				this.scrolly		= 0;
				this.selected 	= null;
			}
		}
		
		self.setData = function(row)
		{
			if(this.row != null && this.row.view != null)
			{
				this.row.view.setstyleproperty("background-color", ListControl.LISTROW_BGCOLOR_OFF);
				
				if(this.colorText)
					this.row.view.setstyleproperty("color", ListControl.LISTROW_CAPTION_OFF, true);
			}
			
			if(row != null)
			{
				if(row.view != null)
				{
					row.view.setstyleproperty("background-color", ListControl.LISTROW_BGCOLOR_ON);
					
					if(this.colorText)
						row.view.setstyleproperty("color", ListControl.LISTROW_CAPTION_ON, true);
				}
				
				this.row			= row;
				this.selected	= row.view.id;
				
				this.call("onselect", row);
			}
			else
			{
				this.row			= null;
				this.selected	= null;
				
				this.call("ondeselect", null);
			}
		}
		
		self.selectedData = function()
		{
			return (this.row != null) ? this.row.data : null;
		}
		
		self.selectedView = function()
		{
			return (this.row != null) ? this.row.view : null;
		}
		
		self.selectedID = function()
		{
			return this.selected;
		}
		
		self.postInit = function()
		{
			this.setScrollY();
		}
		
		return self;
	}
	
	ListControl.LISTROW_BGCOLOR_OFF 	= "#00000000";
	ListControl.LISTROW_BGCOLOR_ON 		= "#FFFFFF33";
	ListControl.LISTROW_CAPTION_OFF 	= "#e9e3d9ff";
	ListControl.LISTROW_CAPTION_ON 		= "#BFE2CEFF";
	
	-->
</script>
