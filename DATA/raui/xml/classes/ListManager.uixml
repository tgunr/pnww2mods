<script>

	<include file="classes/ViewManager.uixml"/>
	<include file="classes/RowBuilder.uixml"/>
	<include file="classes/ListControl.uixml"/>
	
	<!--
	
	function ListManager(s)
	{
		var self = new ViewManager(s);
		
		self.hrb 					= null;
		self.rrb 					= null;
		self.list 					= self.view.findview("list");
		self.control 				= new SimpleListControl(self.list);
		self.list.mgr				= self;
		self.list.control			= self.control;
		self.view.control		= self.control;
		self.selectCallback 	= null;
		
		self.OnSelect = function(action)
		{
			this.control.clickList(action);
			
			if(this.selectCallback != null)
				this.selectCallback(action, this);
		}
		
		self.SetTitle = function(t)
		{
			var v = this.view.findview("list-title");
			
			if(v != null)
				v.label = getlocstring(t);
		}
		
		////////////////// columns
		self.StartHeaders = function(id, x, y, w, h)
		{
			this.hrb = new RowBuilder(this.view, id, x, y, w, h);
			
			// move our height down to accomodate our headers
			this.list.height = this.list.height - this.list.scalev("h", h);
			
			return this.hrb;
		}
		
		self.AddHeader = function(loc, width, align, style)
		{
			if(!this.hrb)
				return null;
				
			if(style == null)
				style = "header-column";
			
			return this.hrb.addColumn(loc, width, align, style);
		}
		
		self.AddHeaderIcon	= function(type, icon, width, size, pad, style)
		{
			if(!this.hrb)
				return null;
				
			if(style == null)
				style = "header-column";
			
			return this.hrb.addIcon(type, icon, width, size, pad, style);
		}
		
		self.EndHeaders = function()
		{
			if(!this.hrb)
				return;
			
			var xml = this.hrb.build();
			
			consoleprint("Header xml is " + xml);
			
			this.view.addview(xml);
			this.hrb = null;
		}
		
		///////////////// rows
		self.StartRow = function(id, x, y, w, h)
		{
			this.rrb = new RowBuilder(this.list, id, x, y, w, h);
			return this.rrb;
		}
		
		self.AddRowColumn = function(loc, width, align, style)
		{
			if(!this.rrb)
				return null;
				
			if(style == null)
				style = "row-column";
			
			return this.rrb.addColumn(loc, width, align, style);
		}
		
		self.AddRowIcon	= function(type, icon, width, size, pad, style)
		{
			if(!this.rrb)
				return null;
				
			if(style == null)
				style = "header-column";
			
			return this.rrb.addIcon(type, icon, width, size, pad, style);
		}
		
		self.EndRow = function(data)
		{
			if(!this.rrb)
				return;
				
			this.control.addRow(data, this.rrb.build());
			this.rrb = null;
		}
		
		self.list.addevent("onselect", "this.mgr.OnSelect(false)");
		self.list.addevent("ondblselect", "this.mgr.OnSelect(true)");
		
		return self;
	}
	
	-->
</script>
