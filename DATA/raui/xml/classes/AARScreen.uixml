<script>

	<include file="classes/RAScreen.uixml"/>
	
	<!--
	
	function AARScreen(s)
	{
		var self = new RAScreen(s);
		
		game.consoleprint("Creating AARScreen for " + self.view.id);
		
		self.BaseOnShow = self.OnShow;
		self.ScenarioComplete = false;
		
		self.OnShow = function()
		{
			this.BaseOnShow();
			
			game.cancelppo();
			game.enableimapinput(false);
			game.cursor.visible 	= true;
		}
		
		self.Close = function(exit, respawn, click)
		{
			if(click != false)
				this.PlayClick();
			
			game.enableimapinput(true);
			game.cursor.update(window.id);
			
			if(exit)
				this.DoDespawn(respawn);
			
			window.close();
		}
		
		self.DoDespawn = function(respawn)
		{
			if(respawn == null)
				respawn = false;
			
			if(this.ScenarioComplete)
				game.despawn(false);
			else
				game.despawn(respawn);
		}
		
		self.DoWeapon = function(click)
		{
			if(click != false)
				this.PlayClick();
			
			return this.Navigate("aarweapon");
		}
		
		self.DoAAR = function(click)
		{
			if(click != false)
				this.PlayClick();
			
			return this.Navigate("aar");
		}
		
		self.OnResult = function()
		{
			if(!this.ScenarioComplete)
			{
				// no changing weapons
				this.SetEnabled("weapon-button", false);
				this.ScenarioComplete = true;
				
				// let the players know who won!
				game.load("misc/victory", this.view);
			}
		}
		
		return self;
	}
	
	-->
</script>
