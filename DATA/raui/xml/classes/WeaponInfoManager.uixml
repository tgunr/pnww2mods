<script>

	<include file="classes/ViewManager.uixml"/>
	
	<!--
	
	function WeaponInfoManager(s)
	{
		var self = new ViewManager(s);
		
		self.SetWeapon = function(weapon)
		{
			var sv = this.view.getchild(0);
			
			if(weapon == null)
			{
				consoleprint("Weapon was null!!");
				sv.value = 0;
				return;
			}
			
			var index 		= this.GetViewer(weapon); 
			sv.value 		= index
			var viewer 	= sv.getchild(index);
			
			if(viewer != null)
				consoleprint("Viewer is not null!");
			
			var descView = viewer.findview("weapon-description");
			var imageView = viewer.findview("weapon-image");
			
			if(weapon != null)
			{
				var content = game.getcontent(this.VehicleManual(weapon));
				this.view.label 	= weapon.description;
				
				if(content)
				{
					this.view.label = content.title.toUpperCase();
					
					if(descView != null)
					{
						descView.text = content.brief;
						
						if(this.IsTrooper(weapon) && game.ingame)
						{
							descView.resizetotext();
							descView.y = 5;
							descView.x = (descView.parent.width * .5) - (descView.width * .5);
						}
					}
					
					if(imageView != null)
					{
						if(this.IsTrooper(weapon) && content.image != null)
							imageView.src = content.image;
						else
							imageView.src = "ui/textures/vehicles/" + content.image + ".bmp";
					}
				}
			}
		}
		
		self.IsTrooper = function(weapon)
		{
			return (weapon != null && (weapon.vclassid == 9 || weapon.vclassid == 14))  ? true : false;
		}
		
		self.GetViewer = function(weapon)
		{
			if(weapon == null)
			{
				return 0;
			}
			else if(!game.ingame)
			{
				if(this.IsTrooper(weapon))
					return 1;
				else
					return 2;
			}
			else
			{
				if(this.IsTrooper(weapon))
					return 3;
				else
					return 4;
			}
		}
		
		self.VehicleManual = function(weapon)
		{
			var path = "";
			
			if(weapon)
			{
				path = "manuals/vehicles/";
				path += weapon.country.adjective + "/";
				
				if(weapon.type == "person" || weapon.type == "ground")
					path += "land/";
				else if(weapon.type == "sea")
					path += "sea/";
				else if(weapon.type == "air")
					path += "air/";
				
				path += weapon.id + ".xml";
			}
			
			return path;
		}
			
		return self;
	}
	
	-->
</script>
