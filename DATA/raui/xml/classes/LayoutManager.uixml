<script>

	<include file="classes/ViewManager.uixml"/>
	
	<!--
	
	function LayoutManager(v)
	{
		var self = new ViewManager(v);
		
		consoleprint("Creatign LayoutManager!");
		
		self.DEFAULT_VPAD = 10;
		self.DEFAULT_HPAD = 10;
		
		self.Property = function(id)
		{
			return this.view.getstyleproperty(id);
		}
		
		self.VPad = function()
		{
			var pad = this.Property("vpad");
			
			if(pad == null || pad == "")
				pad = this.Property("pad");
				
			if(pad != null && pad != "")
				pad = parseInt(pad);
			else
				pad = this.DEFAULT_VPAD;
			
			return pad;
		}
		
		self.HPad = function()
		{
			var pad 	= this.Property("hpad");
			
			if(pad == null || pad == "")
				pad = this.Property("pad");
				
			if(pad != null && pad != "")
				pad = parseInt(pad);
			else
				pad = this.DEFAULT_HPAD;
			
			return pad;
		}
		
		self.Layout = function(how)
		{
			if(how == null)
				how = this.Property("layout");
				
			if(how == "vertical")
				this.LayoutVertical();
			else if(how == "flow")
				this.LayoutFlow();
			else
				consoleprint("Unknown layout: " + how);
		}
		
		self.LayoutVertical = function()
		{
			var vpad = this.VPad();
			var maxLayouts = 100;
			var Y = this.view.height;
			var i = 0;
			var child = this.view.getchild(i);
			
			while(child != null && i < maxLayouts)
			{
				child.top = Y;
				Y = child.y - vpad;
				i++;
				child = this.view.getchild(i);
			}
		}
		
		self.LayoutFlow = function()
		{
			var vpad 	= this.VPad();
			var hpad 	= this.HPad();
			var maxLayouts = 100;
			var lowestChild = null;
			var top = this.view.height;
			var right = 0;
			var i = 0;
			var child = this.view.getchild(i);
			
			while(child != null && i < maxLayouts)
			{
				child.x = right;
				child.top = top;
				
				right = child.right + hpad;
				
				if(lowestChild != null)
				{
					// check horizontal position
					// and check for overhangs
					if((child.right > this.view.width) || (child.x > lowestChild.right && child.top <= lowestChild.y))
					{
						// we need to shift this child down
						right = 0;
						top = lowestChild.y - vpad;
						child.x = right;
						child.top = top;
						right = child.right + hpad;
						//top = child.y - vpad;
						consoleprint("Shift " + child.id + " down due to width");
					}
				}
				
				if(lowestChild == null || child.y <= lowestChild.y)
				{
					lowestChild = child;
					consoleprint("Lowest child is now " + child.id + " at " + child.y);
				}
				
				i++;
				child = this.view.getchild(i);
			}
		}
		
		self.Layout();
		
		return self;
	}
	
	-->
</script>
