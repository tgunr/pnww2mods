<script>

	<include file="classes/ViewBuilder.uixml"/>
	<include file="classes/TextBuilder.uixml"/>
	<include file="classes/ImageBuilder.uixml"/>

	<!--
	
	function RowBuilder(par, id, x, y, w, h)
	{
		var self = new ViewBuilder(par, id, x, y, w, h);
		
		self.hpadding		= 2;
		self.vpadding		= 1;
		self.columns			= new Array();
		self.colStyle			= null; // default column style to use
		
		self.setColumnStyle = function(s)
		{
			this.colStyle = s;
		}
		
		self.addColumn	= function(loc, width, align, style)
		{
			var column = new Object();
			
			column["type"] 	= "caption";
			column["loc"] 		= loc;
			column["width"] 	= width;
			column["align"] 	= align;
			column["style"] 	= style;
			
			this.columns.push(column);
			
			return column;
		}
		
		self.addChatIcon	= function(icon, width, size, pad, style)
		{
			return this.addIcon("chaticon", icon, width, size, pad, style);
		}
		
		self.addRankIcon	= function(icon, width, size, pad, style)
		{
			return this.addIcon("rankicon", icon, width, size, pad, style);
		}
		
		self.addImageIcon	= function(icon, width, size, pad, style)
		{
			return this.addIcon("image", icon, width, size, pad, style);
		}
		
		self.addIcon	= function(type, icon, width, size, pad, style)
		{
			var column = new Object();
			
			column["type"] 	= type;
			column["icon"] 		= icon;
			column["width"] 	= width;
			column["size"] 		= size;
			column["pad"] 		= pad;
			column["style"] 	= style;
			
			this.columns.push(column);
			
			return column;
		}
		
		self.buildRow = function()
		{
			// add our headers
			
			var totalWidth 			= this.nwidth;
			var totalHeight 		= this.nheight;
			
			var workingWidth 	= totalWidth - (this.hpadding * (this.columns.length - 1));
			var workingHeight 	= totalHeight - (this.vpadding * 2);
			var currentX				= 0; 
			
			for(var i = 0; i < this.columns.length; i++)
			{
				var column 	= this.columns[i];
				
				var x				= currentX;
				var y				= this.vpadding;
				var h			= workingHeight;
				var w			= workingWidth * column.width;
				var cb			= null;
				
				if(column.type == "caption")
				{
					var label = getlocstring(column.loc);
					
					if(label != null && label.charAt(0) == "?")
						label = column.loc;
					
					cb = new TextBuilder(this, "column" + i, "caption", label, x, y, w, h);
					
					if(column.align != null) cb.addAttribute("align", column.align);
					if(column.style != null) 		cb.addStyle("class", column.style);
					if(this.fontsize != null) 	cb.addStyle("font-size", this.fontsize);
				}
				else if(column.type == "chaticon")
				{
					var iconX = x + (w * column.pad) - (column.size * .5);   
					var iconY	= (totalHeight * .5) - (column.size * .5);
					var iconW = column.size;
					var iconH = column.size;
					
					cb = new TextBuilder(this, "column" + i, "caption", "", iconX, iconY, iconW, iconH);
					
					cb.addAttribute("class", "chaticon");
					cb.addAttribute("acceptmouseclick", "false");
					cb.addAttribute("onshow", "this.channelname = '" + column.icon + "'");
					
					if(column.style != null) cb.addStyle("class", column.style);
				}
				else if(column.type == "rankicon")
				{
					var iconX = x + (w * column.pad) - (column.size * .5);   
					var iconY	= (totalHeight * .5) - (column.size * .5);
					var iconW = column.size;
					var iconH = column.size;
					
					cb = new TextBuilder(this, "column" + i, "caption", "", iconX, iconY, iconW, iconH);
					
					cb.addAttribute("class", "rankicon");
					cb.addAttribute("acceptmouseclick", "false");
					cb.addAttribute("rank", column.icon);
					
					if(column.style != null) cb.addStyle("class", column.style);
				}
				else if(column.type == "image")
				{
					var iconX = x + (w * column.pad) - (column.size * .5);   
					var iconY	= (totalHeight * .5) - (column.size * .5);
					var iconW = column.size;
					var iconH = column.size;
					
					cb = new ImageBuilder(this, "column" + i, column.icon, iconX, iconY, iconW, iconH);
					
					cb.addAttribute("acceptmouseclick", "false");
					
					if(column.style != null) cb.addStyle("class", column.style);
				}
				
				if(cb != null)
				{
					if(column.style == null && this.colStyle != null)
						cb.addStyle("class", this.colStyle);

					if(column.attributes != null)
					{
						for(var n in column.attributes)
							cb.addAttribute(n, column.attributes[n]);
					}
					
					if(column.styles != null)
					{
						for(var n in column.styles)
							cb.addStyle(n, column.styles[n]);
					}
					
					this.addBuilder(cb);
				}
				
				currentX += w + this.hpadding;
			}
			
			return this.buildView();
		}
		
		self.build = self.buildRow;
		
		return self;
	}
	
	-->
</script>
