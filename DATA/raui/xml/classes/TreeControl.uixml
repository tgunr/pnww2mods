<script>
	
	<include file="classes/TreeNode.uixml"/>
	<include file="classes/TextBuilder.uixml"/>
	<include file="classes/ImageBuilder.uixml"/>
	
	<!--
	
	function TreeControl(list, onclick, ondraw, isselectable)
	{
		consoleprint("New TreeControl\n");
		
		// members
		this.list				= list;
		
		this.count				= 0;					// number of rows
		this.row				= null;					// selected row
		this.selected			= null; 				// selected row's id
		this.scrolled			= this.list.scrolly;
		
		this.init				= false;
		this.indent				= 10;
		this.root				= new TreeNode("Root", "root", 0, true);
		
		// icons
		this.expandIcon			= TreeControl.EXPAND_ICON;
		this.collapseIcon		= TreeControl.COLLAPSE_ICON;
		this.flagIcon			= null;
		
		this.color				= null;
		this.bgcolor			= null;
		this.colorText			= true;

		// lets set the callbacks
		this.onclick 		= onclick;
		this.ondraw 		= (ondraw != null) ? ondraw: TreeControl.ondraw;
		
		this.isselected		= null;
		this.isselectable 	= isselectable;
		
		// public methods
		this.preInit = function()
		{
			this.root.reset();
			this.root.expand();
		}
		
		this.initTree = function()
		{
			var init	= this.init;
			this.init 	= true;
			
			return init;
		}
		
		this.postInit = function(index)
		{
			if(this.list.value == -1)
			{
				if(index == null)
					index = 0;
				
				this.clickTree(false, index);
			}
			
			this.scroll();
		}
		
		this.clickTree = function(action, index)
		{
			this.select(index);
			
			if(this.onclick != null)
				this.onclick(action)
			
			var node = this.list.selecteddata;
			
			if(action && node.branch)
			{
				consoleprint("Toggling node!\n");
				node.toggle();
				this.drawTree();
			}
		}
		
		this.drawTree = function(best)
		{
			this.clearRows(false);
			this.draw(this.root);
			this.postInit(best);
		}
		
		this.clearRow = function(node)
		{
			if(node)
				node.row = -1;
		}
		
		this.clearRows = function(reset)
		{
			this.count		= 0;
			this.row		= null;
			this.scrolly	= this.list.scrolly;
			
			this.list.clearrows();
			
			// set all row values to -1
			this.root.findNodes(this.clearRow);
			
			if(reset)
			{
				this.scrolly	= 0;
				this.selected 	= null;
			}
		}
		
		this.addNode = function(node, ontoggle)
		{
			if(ontoggle != null)
				node.ontoggle = ontoggle;
			
			return this.root.addNode(node);
		}
		
		this.findNode = function(id)
		{
			return this.root.findNode(id);
		}
		
		this.findNodes = function(filter)
		{
			this.root.findNodes(filter);
		}
		
		this.toggleNode = function(id, flag)
		{
			var node = this.root.findNode(id);
			
			if(node != null && node.branch)
				node.toggle(flag);
		}
		
		this.mouseEnter = function(row)
		{
			if(row.id != this.selected)
				this.setRowStyle(id, TreeControl.STYLE_MOUSEENTER);
		}
		
		this.mouseExit = function(row)
		{
			if(row.id != this.selected)
				this.setRowStyle(id, TreeControl.STYLE_MOUSEENTER);
		}
		
		this.selectedNode = function()
		{
			return (this.list.selecteddata != null) ? this.list.selecteddata: null;
		}
		
		this.selectedRow = function()
		{
			return (this.list.selectedrow != null) ? this.list.selectedrow: null;
		}
		
		this.selectedData = function()
		{
			return (this.list.selecteddata != null) ? this.list.selecteddata.data: null;
		}
		
		this.getWidth = function()
		{
			return (this.list.nwidth) ? this.list.nwidth: this.list.width;
		}
		
		this.saveState = function()
		{
			if(game.globals == null)
				game.globals = new Object();
			
			game.globals.tree_state 	= new Object();
			game.globals.tree_scroll 	= this.list.scrolly;
			
			this.findNodes(TreeControl.savefilter);
		}
		
		this.loadState = function()
		{
			if(game.globals != null && game.globals.tree_state != null)
			{
				this.findNodes(TreeControl.loadfilter);
				this.scroll(game.globals.tree_scroll);
				game.globals.tree_state = null;
				
				return true;
			}
			
			return false;
		}
		
		this.hasState = function()
		{
			return (game.globals != null && game.globals.tree_state != null) ? true: false;
		}
		
		this.setRowStyle = function(id, style)
		{
			if(id == null)
				return;
			
			var view = this.list.findview(id);
			
			if(view != null)
				view.setstyle(style);
		}
		
		// private methods
		
		this.select = function(index)
		{
			var list = this.list;
			
			if(list.length > 0)
			{
				if(index != null && index > -1 && index < list.length)
					list.value = index;
				
				if(list.selecteddata != null)
				{
					var row = list.selectedrow;
					
					if(this.row != null)
						this.row.setstyle(TreeControl.STYLE_DESELECT);
					
					//if(row != null && row.id != this.selected)
					//	game.playsound("ui/sounds/select.wav", 1, .05);
					
					this.row			= row;
					this.selected	= row.id;
					this.row.setstyle(TreeControl.STYLE_SELECT);
				}
			}
		}
		
		this.draw = function(node)
		{
			if(node.branch && node.open)
			{
				var children = node.children;
				
				for(var i = 0; i < children.length; i++)
				{
					var child = children[i];
					
					this.addrow(child);
					this.draw(child);
				}
			}
		}
		
		this.addrow = function(node)
		{
			if(this.ondraw != null)
			{
				var format = this.ondraw(this, node);
				
				if(format != null)
				{
					var selectable 	= (this.isselectable != null) ? this.isselectable(node): true;
					var row 			= this.list.addrow(format, node, selectable);
					
					if(row != null)
					{
						if((this.isselected != null && this.isselected(node)) || row.id == this.selected)
							this.clickTree(false, this.count);
						
						row.mgr = this;
						row.addevent("onmouseenter", "this.mgr.onMouseEnter(this.id)");
						row.addevent("onmouseexit", "this.mgr.onMouseExit(this.id)");
						
						node.setRow(this.count);
						this.count++;
					}
				}
			}
		}
		
		this.scroll = function(sy)
		{
			this.list.scrolly 	= (sy != null) ? sy: this.scrolly;
			this.scrolly 		= this.list.scrolly;
		}
		
		this.length = function()
		{
			return this.list.length;
		}
		
		this.setColorText = function(c)
		{
		 	this.colorText = c;
		}
		
		this.onMouseEnter = function(id)
		{
			if(id != this.selected)
				this.setRowStyle(id, ListControl.STYLE_MOUSEENTER);
		}
		
		this.onMouseExit = function(id)
		{
			if(id != this.selected)
				this.setRowStyle(id, ListControl.STYLE_MOUSEEXIT);
		}
		
		// logic
		this.root.expand();
		
		consoleprint("New TreeControl Created\n");
		
		return this;
	}
	
	// default icons
	TreeControl.EXPAND_ICON		= "ui/textures/test/treeview_expand.bmp";
	TreeControl.COLLAPSE_ICON	= "ui/textures/test/treeview_colapse.bmp";
	
	// default formatters
	TreeControl.STYLE_SELECT 				= "class: list.select;";
	TreeControl.STYLE_DESELECT 			= "class: list.deselect;";
	TreeControl.STYLE_MOUSEENTER 	= "class: list.mouseenter;";
	TreeControl.STYLE_MOUSEEXIT 		= "class: list.mouseexit;";
	
	// default format function
	TreeControl.ondraw = function(tree, node)
	{
		var name	= tree.list.id;
		var width	= tree.getWidth() - 50;
		var indent 	= tree.indent * node.level; 
		var isize	= 10;
		
		consoleprint("Tree Control width is " + width + "\n");
		
		var rb = new ViewBuilder(tree.list, node.id, 0, 0, width, 16);
		var vb = null;
		
		//rb.addAttribute("onmouseenter", name + ".mouseEnter(this)");
		//rb.addAttribute("onmouseexit", name + ".mouseExit(this)");
		
		if(node.branch)
		{
			var icon = (node.open) ? tree.collapseIcon: tree.expandIcon;
			
			vb = rb.addBuilder(new ViewBuilder(rb, "branch_" + node.id, indent, 3, 10, 10));
			vb.addAttribute("onclick", name + ".clickTree(true, " + tree.count + ")");
			vb.addStyle("background-image", icon);
			
			vb = rb.addBuilder(new TextBuilder(rb, null, "caption", node.description, indent + tree.indent, 0, width - (indent + tree.indent), 16));
			vb.addStyle("color", "#e9e3d9ff");
		}
		else if(node.flag != null)
		{
			vb = rb.addBuilder(new TextBuilder(rb, null, "caption", node.description, indent + 17, 0, width - indent + 17, 16));
			vb.addStyle("color", "#e9e3d9ff");
			var icon = rb.addBuilder(new ViewBuilder(vb, null, indent, 0, 15, 15));
			icon.addAttribute("class", "flagicon");
			icon.addAttribute("index", node.flag);
		}
		else
		{
			vb = rb.addBuilder(new TextBuilder(rb, null, "caption", node.description, indent, 0, width - indent, 16));
			vb.addStyle("color", "#e9e3d9ff");
		}
		
		var out = rb.build();
		
		consoleprint("View Builder output is:\n\n" + out);
		
		return out;
	}
	
	TreeControl.savefilter = function(node)
	{
		if(node.open)
			game.globals.tree_state[node.id] = true;
	}
	
	TreeControl.loadfilter = function(node)
	{
		if(game.globals.tree_state[node.id])
			node.expand();
	}

	
	-->
</script>
