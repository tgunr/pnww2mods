<ra id="offline" manager="OfflineScreen">
	<panel label="SELECT UNIT" x="10" height=".8" width=".48" rtop="30">
		<treecontrol id="weapon-tree" rtop="30" style="pad: 20; class: litebg;"/>
	</panel>
	<weapinfov id="weapon-info" width=".48" height=".8" rright="10" rtop="30"/>
	<navbar>
		<button id="spawn-button" label="    SPAWN" rright="20" onclick="this.mgr.Click(DoSpawn)" align="left" center="y" style="class: button.forward;"/>
	</navbar>
	<script>
		<!--
		
		var weaponTree 	= findview("weapon-tree");
		var weaponInfo	= findview("weapon-info");
		var spawnButton	= findview("spawn-button");
		
		function DoSpawn()
		{
			var weapon = weaponTree.control.selectedData();
			
			if(weapon != null)
			{
				weaponTree.control.saveState();
				
				if(game.spawn(weapon))
				{
					game.globals.selectedindex = weapon.index;
					showChat(false);
				}
			}
		}
		
		function OnShow(mgr)
		{
			game.consoleclear();
			
			cprint("Init win was called for offline!");
			
			//cprint("sendmessage is " + game.sendchatmessage);

			game.sendchatmessage("What the heck!");
				
			// set some callbacks
			weaponTree.mgr.selectCallback = selectWeapon;
			
			initGlobals();
			initWeapons();
			selectWeapon(false);
			
			cprint("OnShow Done!");
		}
		
		function initWeapons()
		{
			var hasstate		= weaponTree.control.hasState(); 
			var spawnables 	= game.spawnlist;
			var countries 		= new Array('US','UK','FR','DE');
			
			for(var c = 0; c < countries.length; c++)
			{
				var country = countries[c];
				
				var classNode		= null;
				var countryNode 	= new TreeNode(country, null, 1, true, getlocstring("common.countries." + country.toLowerCase() + ".name"));
				
				for(var v = 0; v < spawnables.length; v++)
				{
					var vehicle = spawnables[v];
					
					//consoleprint("Trying offline vehicle: " + vehicle.id + "\n");
					
					if(vehicle.country != null && vehicle.country.code == country)
					{
						//consoleprint("Adding offline vehicle: " + vehicle.id + "\n");
						
						var badIDs = new RegExp("(skull|w154)", "gi");
						
						if(!vehicle.id.match(badIDs))
						{
							var classID = country + vehicle.vclassid;
							
							if(classNode == null || classNode.id != classID)
							{
								if(classNode != null)
									countryNode.addNode(classNode);
								
								classNode = new TreeNode(classID, null, 2, true, vehicle.vclass);
								
								if(!hasstate && vehicle.vclassid == 9)
									classNode.expand();
							}
							
							classNode.addNode(new TreeNode(vehicle.index, vehicle, 3, false, vehicle.description));
							
							if(vehicle.index == game.globals.selectedindex)
								weaponTree.control.selected = vehicle.index;
							else if(vehicle.id == "us-assault" && game.globals.selectedindex == null)
								game.globals.selectedindex = vehicle.index;
								//weaponTree.control.selected = vehicle.index;
						}
					}
				}
				
				if(classNode != null)
					countryNode.addNode(classNode);
				
				weaponTree.control.addNode(countryNode);
			}
			
			if(!weaponTree.control.loadState())
				weaponTree.control.toggleNode("US", true);
				
			weaponTree.control.clickTree(false, game.globals.selectedindex);
			weaponTree.control.drawTree();
		}
		
		function selectWeapon(action)
		{
			weaponInfo.mgr.SetWeapon();
			spawnButton.enabled = false;
			
			var weapon = weaponTree.control.selectedData(); 
			
			if(weapon != null)
			{
				weaponInfo.mgr.SetWeapon(weapon);
				//infoView.value = (weapon.vclassid == 9 || weapon.vclassid == 14) ? 1: 2;
				game.globals.selectedindex = weapon.index;
				spawnButton.enabled = true;
				
				if(action)
					DoSpawn(true);
			}
		}
				
		-->
	</script>
</ra>
