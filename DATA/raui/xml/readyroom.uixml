<ra id="readyroom">
	<include file="lib/common.uixml"/>
	<include file="lib/scenarios.uixml"/>
	<panel label="PLAYER LIST" id="mainpanel" x="10" height=".8" width=".65" rtop="20" align="center">
		<listcontrol id="players" x="15" y="15" rtop="20" rright="15" style="class: litebg;" manager="PlayerListManager"/>
	</panel>
	<sceninfov id="scenario-info" width=".3" height=".8" rright="20" rtop="20">
		<view id="map" class="mapview" acceptsfocus="no" minscale=".01" maxscale=".1" scale=".05" sx="0" sy="0">
			<layer type="texture" id="default-64-tex" minscale="0" maxscale="64" enabled="true" orign="-26x210" rowcolsize="1x1" cellsize="64x64"/>
			<layer type="icon" id="icons" minscale="1" maxscale="8" enabled="true"/>
			<layer type="icon" id="rendered" minscale="0" maxscale="1" enabled="true"/>
			<layer type="scenario" id="scenmap" minscale="0" maxscale="2" enabled="true"/>
			<layer type="players" minscale="0" maxscale="20" />
		</view>
	</sceninfov>
	<navbar id="navbar">
		<button id="weapon-button" label="   CHANGE WEAPON" x="20" onclick="window.mgr.DoWeapon()" center="y" style="class: button.forward;"/>
		<button id="fight-button" label="FIGHT!   " rright="20" onclick="this.mgr.Click(DoFight)" center="y" style="class: button.back;"/>
		<caption label="RAPID ASSAULT- READY ROOM" width="250" height="20" center="true" style="class:bigtext;"/>
	</navbar>
