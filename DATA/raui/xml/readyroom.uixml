<ra id="readyroom">
	<include file="lib/scenarios.uixml"/>
	<include file="classes/ListControl.uixml"/>
	<include file="classes/DDListControl.uixml"/>
	<include file="classes/TreeControl2.uixml"/>
	<include file="classes/CycleTimer.uixml"/>
	<include file="classes/ViewBuilder.uixml"/>
	<include file="classes/TextBuilder.uixml"/>
	<include file="classes/ImageBuilder.uixml"/>
	<include file="classes/RowBuilder.uixml"/>
	<view id="mainpanel" x="10" height=".8" width=".65" rtop="20" style="class: bordered;">
		<caption label="Click the Fight button to join the game." height="20" rtop="0"/>
		<view x="10" y="10" rright="10" rtop="30">
			<caption label="PLAYER LIST:" height="20" rtop="0"/>
			<listcontrol id="players" rtop="30" style="class: bordered;"/>
		</view>
	</view>
	<view id="infopanel" width=".3" height=".75" rright="10" rtop="50">
		<sceninfov id="scenario-info">
			<view id="map" class="mapview" acceptsfocus="no" minscale=".01" maxscale=".1" scale=".05"
				pad="10" sx="0" sy="0">
				<layer type="texture" id="default-64-tex" minscale="0" maxscale="64" enabled="true" orign="-26x210" rowcolsize="1x1" cellsize="64x64"/>
				<layer type="icon" id="icons" minscale="1" maxscale="8" enabled="true"/>
				<layer type="icon" id="rendered" minscale="0" maxscale="1" enabled="true"/>
				<layer type="scenario" id="scenmap" minscale="0" maxscale="2" enabled="true"/>
				<layer type="players" minscale="0" maxscale="20" />
			</view>
		</sceninfov>
	</view>
	<navbar id="navbar" style="class: bordered;">
		<button id="back" label="WEAPON   " x="20" onclick="window.mgr.DoWeapon()" align="right" center="y"/>
		<button id="forward" label="   FIGHT" rright="20" onclick="this.mgr.Click(DoFight)" center="y" align="left"/>
	</navbar>
	<script>
		<!--
		 //
		 
		var client 					= game.player.client;
		var scenarios			= loadRoot();
		var fightBtn				= findview("fight-button");
		var playerList 			= findview("players");
		var scenarioInfo		= findview("scenario-info");
		var updatePlayers 	= true;
		
		// player update callback
		game.onscenarioplayers = playersUpdated;
		
		function DoFight()
		{
			/*
			if(game.scenariocomplete || scenario.instance == null)
			{
				showOk("Bad scenario state!");
				return;
			}
			*/
			
			/*
			if(!canScenarioSpawn(scenario))
			{
				showOk("Waiting for more players to join!");
				return;
			}
			*/
			
			var vehicle = game.player.vehicle;
			
			if(vehicle != null)
				game.spawn(vehicle);
			
			/*
			if(vehicle != null && vehicle.spawnable)
			{
				if(vehicle.spawnable == "spawnable")
					game.spawn(vehicle.type);
				else
					showOk(vehicle.spawnable);
			}
			else
			{
				showOk("Vehicle not selected!");
			}
			*/
		}
		
		function OnShow(win)
		{
			initGlobals();
			initHeaders(playerList);
			scenarioInfo.mgr.SetScenario(client.scenario);
		}
		
		function OnUpdate()
		{
			if(updatePlayers)
				updatePlayerList();
		}
		
		function initHeaders(p)
		{
		 	p.mgr.StartHeaders("players-header", 0, -1, 0, 15);
		 	p.mgr.AddHeader("TEAM", .07);
		 	p.mgr.AddHeader("PLAYER", .17);
		 	p.mgr.AddHeader("RANK", .07);
		 	p.mgr.AddHeader("WEAPON", .365);
		 	p.mgr.AddHeader("K", .05, "center");
		 	p.mgr.AddHeader("D", .05, "center");
		 	p.mgr.AddHeader("S", .06, "center");
		 	p.mgr.AddHeader("READY", .162, "center");
		 	p.mgr.EndHeaders();
		}
		
		function updatePlayerList()
		{
			var started 				= new Date();
			var members			= game.player.client.missionroomlist;
			
			updatePlayers = false;		
			
			if(members == null)
				return;
			
			// sort our member list
			members = members.sort(sortMembers);
			
			// clear our list of rows
			playerList.control.clearRows(false);
			
			var membersCount = members.length;
			
			for(var i = 0; i < membersCount; i++)
			{
				/************ Update Member List **************/
				
				var member 			= members[i];
				var vehicle			= "-";
				var ready				= "";
				
				if(member.weapon != null)
				{
					var memberWeapon = member.weapon;
					
					if(memberWeapon.description.toLowerCase() == "buzzard")
						continue;
					
					vehicle = memberWeapon.description;
				}
				
				var rank			= member.rank;
				var callsign 		= member.callsign;
				var kills				= parseInt(member.kills);
				var deaths		= parseInt(member.deaths);
				var score			= parseInt(member.score);
				var teamIcon 	= scenarioFlag(parseInt(scenario["team" + member.team]));
				
				if(member.ready)
					ready = "ready";
				
				var row = playerList.mgr.StartRow("member" + i, 0, 0, 0, 16);
				
				// space out our children builders
				row.hspace(2);
				
				playerList.mgr.AddRowIcon("image", teamIcon, .07, 12, .5);
				playerList.mgr.AddRowColumn(callsign, .17);
				playerList.mgr.AddRowIcon("rankicon",  member.rank.level - 1, .07, 12, .5);
				playerList.mgr.AddRowColumn(vehicle, .365);
				playerList.mgr.AddRowColumn(kills, .05, "center");
				playerList.mgr.AddRowColumn(deaths, .05, "center");
				playerList.mgr.AddRowColumn(score, .05, "center");
				playerList.mgr.AddRowColumn(ready, .162, "center");
				
				playerList.mgr.EndRow(member);
			}
			
			playerList.control.setScrollY();
			
			var stopped = new Date();
		}
		
		function playersUpdated()
		{
			updatePlayers = true;
		}
		
		function sortMembers(a,b)
		{
			if(a.team == b.team)
			{
				if(a.score > b.score)
					return -1;
				else if(a.score < b.score)
					return 1;
			}
			else  
			{
				if(game.player.scenario != null && a.team == game.player.scenario.team)
					return -1;
				else
					return 1; 
			}
			
			return 0;
		}
		
		
		-->
	</script>
</ra>
