<ra id="create" manager="RAScreen">
	<include file="lib/scenarios.uixml"/>
	<panel label="SELECT MAP" id="select-panel" x="10" y="80" width="270" rtop="20">
		<listcontrol id="create-list" pad="15" rtop="20" style="class: litebg;"/>
	</panel>
	<sceninfoh id="scenario-info" x="300" height=".5" rright="10" rtop="20">
		<image id="scenario-image" height=".7" rtop="5"/>
	</sceninfoh>
	<panel label="OPTIONAL PASSWORD" x="300" y="90" height=".25" rright="10">
		<view pad="15" rtop="20" style="class: litebg;">
			<text pad="10" width=".45" center="y">Enter a password for this map to share with others (optional). Only players that know the password can join.
			
			Passwords can be up to 15 characters long and must be letters and numbers only.</text>
			<textcontrol id="password-input" width="200" height="20" rright="100" center="y"/>
		</view>
	</panel>
	

	<navbar id="navbar">
		<button id="create-button" label="CREATE NEW GAME   " rright="20" onclick="this.mgr.Click(selectScenario, true)" style="class: button.back;" center="y"/>
		
		
		<caption label="RAPID ASSAULT- MAP CREATION" width="250" height="20" center="true" style="class:bigtext;"/>
		
		
	</navbar>
	<script>
		<!--
		
		consoleprint("Create win!");
		 
		var client 				= game.client;
		var scenarios		= loadRoot();
		var mainPanel		= findview("main-panel");
		var createBtn		= findview("create-button");
		var createList 		= findview("create-list");
		var scenarioInfo	= findview("scenario-info");
		var password		= findview("password-input");
		
		// handles what happens when we create
		game.oninstanceresult = OnInstanceResult;
		
		function OnShow(win)
		{
			consoleprint("OnShowing!");
			createList.mgr.selectCallback = selectScenario;
			initCreateList();
		}
		
		function initCreateList()
		{
			consoleprint("Initing create list!");
			
			// now update our visible list
			createList.mgr.control.clearRows(false);
			
			// add our categories
			for(var i = 0; i < scenarios.links.length; i++)
				addCategory(game.getcontent(scenarios.links[i].path));
			
			createList.mgr.control.postInit();
		}
		
		function addCategory(category)
		{
			if(category == null)
				return;
				
			var catID = category.category;
			var rb = new RowBuilder(createList.mgr.list, "cat." + catID, 0, 0, 0, 16);
			
			rb.addColumn(category.title.toUpperCase(), 1);
			
			createList.mgr.control.addRow(null, rb.build());
			
			for(var mapID = 0; mapID < category.links.length; mapID++)
				addScenario(catID, mapID);
		}
		
		function addScenario(catID, mapID)
		{
			var scenario = game.getscenario(catID, mapID);
			if(scenario == null) return;
			
			var id = "map." + catID + "." + mapID;
			var rb = new RowBuilder(createList.mgr.list, id, 0, 0, 0, 16);
			
			rb.addColumn(" ", .15);
			rb.addColumn(scenario.content.title, .85);
			
			var data = new Object();
			
			data["scenario"] 		= scenario;
			data["category"] 		= catID;
			data["map"] 			= mapID;
			
			createList.mgr.control.addRow(data, rb.build());
			
			if(scenario.content.preferred == "true")
			{
				createList.mgr.control.selectByID(id);
				selectScenario(false);
			}
		}
		
		function selectScenario(action)
		{
			var data = createList.mgr.control.selectedData();
			
			if(data == null)
			{
				cprint("Select Scenario had null data!");
				createBtn.enabled = false;
				return;
			}
			
			cprint("Select Scenario had good data!");
			
			scenarioInfo.mgr.SetScenario(data.scenario);
			
			createBtn.enabled = true;
			
			if(action)
			{
				var category 	= data.category;
				var map 			= data.map;
				
				// create a new instance
				if(!createInstance(category, map, password.text))
					showOk(lastScenarioError);
			}
		}
		
		function OnInstanceResult()
		{
			var data = createList.mgr.control.selectedData();
			
			cprint("Instance result!");
			
			// something happened
			if(client.instance == null)
			{
				cprint("No instance!");
				//showOk("Failed: null instance!");
				return;
			}
			
			if(client.instance.category == data.category && client.instance.type == data.map)
			{
				cprint("Starting scenario: " + data.scenario.content.title);
				startScenario(data.scenario, true);
			}
			else
			{
				cprint("Failed to start scenario!");
			}
		}
		
		-->
	</script>
</ra>
