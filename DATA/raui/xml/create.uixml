<ra id="create" manager="RAScreen">
	<include file="lib/scenarios.uixml"/>
	<include file="classes/ListControl.uixml"/>
	<include file="classes/DDListControl.uixml"/>
	<include file="classes/TreeControl2.uixml"/>
	<include file="classes/CycleTimer.uixml"/>
	<include file="classes/ViewBuilder.uixml"/>
	<include file="classes/TextBuilder.uixml"/>
	<include file="classes/ImageBuilder.uixml"/>
	<include file="classes/RowBuilder.uixml"/>
	<view id="select-panel" x="10" y="80" width="270" rtop="20">
		<caption label="Choose a game and click, create." height="20" rtop="0"/>
		<listcontrol id="create-list" rtop="30" style="class: bordered;"/>
	</view>
	<stackview id="main-panel" x="300" y="80" rright="10" rtop="40">
		<view/>
		<view x="10" y="1" rright="10" rtop="10" style="class: bordered;">
			<sceninfoh id="scenario-info">
				<image id="scenario-image" height=".45" rtop="5"/>
			</sceninfoh>
		</view>
	</stackview>
	<navbar id="navbar" style="class: bordered;">
		<button id="create-button" label="    CREATE" rright="20" onclick="this.mgr.Click(selectScenario, true)" align="left" style="class: button.forward;" center="y"/>
	</navbar>
	<script>
		<!--
		 //
		 
		var client 				= game.player.client;
		var scenarios		= loadRoot();
		var mainPanel		= findview("main-panel");
		var createBtn		= findview("create-button");
		var createList 		= findview("create-list");
		var scenarioInfo	= findview("scenario-info");
		
		// handles what happens when we create
		game.oninstanceresult = OnInstanceResult;
		
		function OnShow(win)
		{
			mainPanel.value = 0;
			
			createList.mgr.selectCallback = selectScenario;
			
			initCreateList();
		}
		
		function initCreateList()
		{
			// now update our visible list
			createList.mgr.control.clearRows(false);
			
			// add our categories
			for(var i = 0; i < scenarios.links.length; i++)
				addCategory(game.getcontent(scenarios.links[i].path));
			
			createList.mgr.control.postInit();
		}
		
		function addCategory(category)
		{
			if(category == null)
				return;
				
			var rb = new RowBuilder(createList.mgr.list, "row" + category.category, 0, 0, 0, 16);
			
			rb.addColumn(category.title.toUpperCase(), 1);
			
			createList.mgr.control.addRow(null, rb.build());
			
			for(var map = 0; map < category.links.length; map++)
				addScenario(category, map);
		}
		
		function addScenario(category, map)
		{
			if(category == null)
				return;
				
			var scenario = loadScenario(category.category, map);
			
			var rb = new RowBuilder(createList.mgr.list, "row" + map, 0, 0, 0, 16);
			
			rb.addColumn(" ", .15);
			rb.addColumn(scenario.title, .85);
			
			var data = new Object();
			
			data["scenario"] = scenario;
			data["category"] = category.category;
			data["map"] = map;
			
			createList.mgr.control.addRow(data, rb.build());
		}
		
		function selectScenario(action)
		{
			var data = createList.mgr.control.data;
			
			if(data == null)
			{
				cprint("Select Scenario had null data!");
				mainPanel.value = 0;
				createBtn.enabled = false;
				return;
			}
			
			cprint("Select Scenario had good data!");
			
			scenarioInfo.mgr.SetScenario(data.scenario);
			
			mainPanel.value = 1;
			createBtn.enabled = true;
			
			if(action)
			{
				var category 	= data.category;
				var map 			= data.map;
				
				// create a new instance
				if(!createInstance(category, map, ""))
					showOk(lastScenarioError);
			}
		}
		
		function OnInstanceResult()
		{
			var data = createList.mgr.control.data;
			
			// something happened
			if(client.instance == null)
			{
				showOk("Failed: null instance!");
				return;
			}
			
			if(client.instance.result != 1)
			{
				showOk("Instance join failed: " + client.instance.result);
				return;
			}
			else if(client.instance.category == data.category || client.instance.type == data.map)
			{
				startScenario(data.scenario, true);
			}
		}
		
		-->
	</script>
</ra>
