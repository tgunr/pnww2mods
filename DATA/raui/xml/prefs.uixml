<ra id="prefs" manager="PrefScreen">
	<include file="lib/common.uixml"/>
	<include file="classes/Pref.uixml"/>
	<include file="classes/PrefGroup.uixml"/>
	<panel id="nav-panel" label="SELECT UNIT" x="10" height=".8" width="210" rtop="30">
		<view pad="20" rtop="20" style="class: litebg; layout: vertical; vpad: 10;" center="x">
			<!-- PREF GROUPS -->
			<caption label="GAME SETTINGS" width=".9" height="20" center="x" manager="PrefGroup:0"/>
			<caption label="VISUAL PREFERENCES" width=".9" height="20" center="x" manager="PrefGroup:1"/>
			<caption label="SOUND PREFERENCES" width=".9" height="20" center="x" manager="PrefGroup:2"/>
			<caption label="USER INTERFACE" width=".9" height="20" center="x" manager="PrefGroup:3"/>
			<caption label="KEYMAPPER" width=".9" height="20" center="x" manager="KeymapPrefGroup:4"/>
			<caption label="DEVICE CALIBRATION" width=".9" height="20" center="x" manager="KeymapPrefGroup:5"/>
		</view>
	</panel>
	<view id="main-panel" x="240" y="80" rright="10" rtop="20">
		<stackview id="prefs-view" pad="10">
			<scrollview id="game-prefs" style="class: litebg;">
				<view style="layout: vertical; vpad: 10; hpad: 5">
					<panel id="prefs" label="${widgets.prefs.groups.game.presets}" align="center" height="160" style="vpad: 20; class: medbg;">
							<text x="25" width="200" rtop="30" y="25" style="color: #e9e3d9ff;" onshow="this.text = getlocstring('widgets.prefs.groups.game.presets.description')"/>
							<button id="forward" rright="25" rtop="20" label="  BEST QUALITY" align="left"
								onclick="window.mgr.SetPreset(0)" style="size-scaler: .4; font-size: -3;"/>
							<button id="forward" rright="25" rtop="60" label="  BALANCED" align="left"
								onclick="window.mgr.SetPreset(1)" style="size-scaler: .4; font-size: -3;"/>
							<button id="forward" rright="25" rtop="100"  label="  PERFORMANCE" align="left"
								onclick="window.mgr.SetPreset(2)" style="size-scaler: .4; font-size: -3;"/>
					</panel>
					<panel id="prefs" label="MISC" align="center" height="140" style="vpad: 10; layout: vertical; class: medbg;">
						<listpref id="language" manager="Pref/ListPref:0" style="vpad: 30;">
							<script private="true">
								<!--
								
								var options = game.settings.languages;
								
								if(game.ostype == "mac")
								{
									this.mgr.AddOption(getlocstring("ra.prefs.na"), -1);
								}
								else
								{
									if(game.region == 5) // china
									{
										this.mgr.AddOption(getlocstring("ra.prefs.language." + options[game.region]), game.region);
									}
									else
									{
										for(var i = 0; i < options.length - 1; i++)
											this.mgr.AddOption(getlocstring("ra.prefs.language." + options[i]), i);
									}
								}
								
								this.mgr.Update();
								
								-->
							</script>
						</listpref>
						<listpref id="fontsize" manager="Pref/ListPref:0">
							<script private="true">
								<!--
								
								var options = new Array(9, 10, 11, 12);
								
								for(var i = 0; i < options.length; i++)
									this.mgr.AddOption(options[i], options[i]);
								
								this.mgr.Update();
								
								-->
							</script>
						</listpref>
						<boolpref id="app.showcredits" manager="Pref/BoolPref:0"/>
					</panel>
					
					<panel id="prefs" label="NETWORKING" align="center" height="100" style="vpad: 10; layout: vertical; class: medbg;">
						<listpref id="usenetworkroute" manager="Pref/ListPref:0" style="vpad: 30;">
							<script private="true">
								<!--
								
								var options = new Array("best", "primary", "secondary");
								
								for(var i = 0; i < options.length; i++)
									this.mgr.AddOption(getlocstring("ra.prefs.network." + options[i]), i);
								
								this.mgr.Update();
								
								-->
							</script>
						</listpref>
						
						<listpref id="visplayerlimit" manager="Pref/ListPref:0">
							<script private="true">
								<!--
								
								var options	= new Array("low", "medium", "high");
								
								// 1 based, 0 is super low
								for(var i = 0; i < options.length; i++)
										this.mgr.AddOption(getlocstring("ra.prefs.vislimit." + options[i]), i + 1);
								
								this.mgr.Update();
								
								-->
							</script>
						</listpref>
					</panel>
					<view height="50"/>
				</view>
				<scrollbar/>
			</scrollview>
			<scrollview id="visual-prefs" style="class: litebg;">
				<view style="layout: vertical; vpad: 10; hpad: 5;">
					<panel id="prefs" label="VIDEO CARD" align="center" height="140" style="vpad: 20; layout: vertical; class: medbg;">
						<listpref id="video" manager="Pref/ListPref:1" style="vpad: 30;">
							<script private="true">
								<!--
								
								var videoCards = game.settings.videocards;
								
								// INIT FUNCTIONS
								for(var i = 0; i < videoCards.length; i++)
									this.mgr.AddOption(videoCards[i].name, videoCards[i].id);
								
								this.mgr.Update();
								
								-->
							</script>
						</listpref>
						<listpref id="resolution" manager="Pref/ListPref:1">
							<script private="true">
								<!--
								
								var videoPref		= window.findview("video");
								var videoCards 	= game.settings.videocards;
								var options			= null;
								
								// INIT FUNCTIONS
								for(var i = 0; i < videoCards.length; i++)
								{
									if(videoCards[i].id == videoPref.mgr.pref.Value())
									{
										options = videoCards[i].modes
										break;
									}
								}
								
								if(options != null)
								{
									var lastResolution = null;
									
									options.reverse();
									
									for(var i = 0; i < options.length; i++)
									{
										if(options[i] != lastResolution)
										{
											this.mgr.AddOption(options[i], options[i]);
											lastResolution = options[i];
										}
									}
								}
								
								this.mgr.Update();
								
								-->
							</script>
						</listpref>
						<boolpref id="enablevsync" manager="Pref/BoolPref:1"/>
					</panel>
					<panel id="prefs" label="SHADERS" align="center" height="230" style="vpad: 10; layout: vertical; class: medbg;">
						<boolpref id="normalmaps" manager="Pref/BoolPref:1" style="vpad: 30;"/>
						<!-- boolpref id="postrenderfilter" manager="Pref/BoolPref:1"/ -->
						<boolpref id="enableh2oshaders" manager="Pref/BoolPref:1"/>
						<boolpref id="waterreflections" manager="Pref/BoolPref:1"/>
						<boolpref id="wantmultisample" manager="Pref/BoolPref:1"/>
						<boolpref id="wantdepthoffield" manager="Pref/BoolPref:1"/>
						<boolpref id="wantsoftparticles" manager="Pref/BoolPref:1"/>
						<boolpref id="shadowreceivers" manager="Pref/BoolPref:1"/>
					</panel>
					<!--
					<panel id="prefs" label="SPECIAL EFFECTS" align="center" height="160" style="vpad: 10; layout: vertical; class: medbg;">
						<boolpref id="suppressmuzzlelight" manager="Pref/BoolPref:1" style="vpad: 30;"/>
						<boolpref id="combatsmoke" manager="Pref/BoolPref:1"/>
						<boolpref id="bspecular" manager="Pref/BoolPref:1"/>
						<listpref id="shadows" manager="Pref/ListPref:1"/>
					</panel>
					<panel id="prefs" label="FOLIAGE" align="center" height="120" style="vpad: 10; layout: vertical; class: medbg;">
						<sliderpref id="radialdensity" manager="Pref/SliderPref:1" style="vpad: 30;"/>
						<sliderpref id="radialradius" manager="Pref/SliderPref:1"/>
						<boolpref id="radialclutterwhenflying" manager="Pref/BoolPref:1"/>
					</panel>
					-->
					<panel id="prefs" label="INFANTRY" align="center" height="210" style="vpad: 10; layout: vertical; class: medbg;">
						<sliderpref id="inflodmod" manager="Pref/SliderPref:1,0,4" style="vpad: 30;"/>
						<boolpref id="corpses" manager="Pref/BoolPref:1"/>
						<boolpref id="wantbloodeffects" manager="Pref/BoolPref:1"/>
						<sliderpref id="corpsecount" manager="Pref/SliderPref:1,0,4"/>
						<sliderpref id="corpsetime" manager="Pref/SliderPref:1,0,4"/>
						<boolpref id="corpsedetail" manager="Pref/BoolPref:1"/>
					</panel>
					<view height="50"/>
				</view>
				<scrollbar/>
			</scrollview>
			<view id="sound-prefs" style="class: litebg;">
				<view style="layout: vertical; vpad: 5; hpad: 5;">
					<panel id="prefs" label="SOUND CARD" align="center" height="140" style="vpad: 20; layout: vertical; class: medbg;">
						<listpref id="sound" manager="Pref/ListPref:2" style="vpad: 30;">
							<script private="true">
								<!--
								
								var soundCards = game.settings.soundcards;
								
								if(game.ostype == "mac")
								{
									this.mgr.AddOption(getlocstring("ra.prefs.na"), -1, -1);
								}
								else if(soundCards.length > 0)
								{
									for(var i = 0; i < soundCards.length; i++)
										this.mgr.AddOption(soundCards[i].name, soundCards[i].id);
								}
								
								this.mgr.Update();
								
								-->
							</script>
						</listpref>
						<sliderpref id="volumemultiplier" manager="Pref/SliderPref:2"/>
						<sliderpref id="musicmultiplier" manager="Pref/SliderPref:2"/>
					</panel>
					<panel id="prefs" label="MISC" align="center" height="120" style="vpad: 10; layout: vertical; class: medbg;">
						<listpref id="ambientlevel" manager="Pref/ListPref:2" style="vpad: 30;">
							<script private="true">
								<!--
								
								var options	= new Array("frequent", "infrequent", "disabled");
								
								for(var i = 0; i < options.length; i++)
									this.mgr.AddOption(getlocstring("ra.prefs.ambient." + options[i]), i);
								
								this.mgr.Update();
								
								-->
							</script>
						</listpref>
						<boolpref id="wantmessagealert" manager="Pref/BoolPref:2"/>
						<boolpref id="playmusic" manager="Pref/BoolPref:2"/>
					</panel>
				</view>
			</view>
			<scrollview id="ui-prefs" style="class: litebg;">
				<view style="layout: vertical; vpad: 5; hpad: 5;">
					<panel id="prefs" label="USER INTERFACE" align="center" height="240" style="vpad: 20; layout: vertical; class: medbg;">
						<boolpref id="tooltips" manager="Pref/BoolPref:3" style="vpad: 30;"/>
						<boolpref id="app.languagefilter" manager="Pref/BoolPref:3"/>
						<boolpref id="squadinvites" manager="Pref/BoolPref:3"/>
						<boolpref id="app.missionwaypoints" manager="Pref/BoolPref:3"/>
						<boolpref id="app.deathicons" manager="Pref/BoolPref:3"/>
						<boolpref id="hud.alerts.show" manager="Pref/BoolPref:3"/>
					</panel>
					<panel id="prefs" label="COLORS" align="center" height="240" style="vpad: 10; layout: vertical; class: medbg;">
						<colorpref id="friendlycolor" manager="Pref/ColorPref:3" style="vpad: 30;"/>
						<colorpref id="enemycolor" manager="Pref/ColorPref:3"/>
						<colorpref id="squadcolor" manager="Pref/ColorPref:3"/>
						<colorpref id="missioncolor" manager="Pref/ColorPref:3"/>
						<colorpref id="missionleadercolor" manager="Pref/ColorPref:3"/>
						<colorpref id="ppook" manager="Pref/ColorPref:3"/>
						<colorpref id="pponok" manager="Pref/ColorPref:3"/>
					</panel>
					<view height="50"/>
				</view>
				<scrollbar/>
			</scrollview>
			<view id="keymapper-prefs">
				<panel id="keymapper-panel" label="SET KEYMAPS" width=".7">
					<listcontrol id="keymap-list" pad="15" y="50" rtop="20" style="class: litebg;"/>
					<view id="keymap-buttons" pad="15" height="30" style="class: litebg;">
						<button id="clearkeymap" x="20" center="y" label="CLEAR" style="class: button.small; class: tinytext;"
							onclick="window.mgr.ClearKeymap()" tip="Click this button to discard the currently selected keymap."/>
						<button id="clearkeymap" center="true" label="DISCARD" style="class: button.small; class: tinytext;"
							onclick="window.mgr.ResetKeymaps()" tip="Click this button to discard any pending changes."/>
						<button id="defaultkeymap" rright="20" center="y" label="DEFAULTS" style="class: button.small; class: tinytext;"
							onclick="window.mgr.DefaultKeymaps()" tip="Click this button to set default keymaps."/>
					</view>
				</panel>
				<panel id="nav-panel" label="SELECT CATEGORY" width=".25" rright="0">
					<view pad="20" rtop="20" style="class: litebg; layout: vertical; vpad: 10;" center="x">
						<!-- KEYMAP CATEGORIES -->
						<caption label="GENERAL" width=".9" height="20" center="x" manager="KeymapCategory:0"/>
						<caption label="VIEWS" width=".9" height="20" center="x" manager="KeymapCategory:1"/>
						<caption label="INFANTRY" width=".9" height="20" center="x" manager="KeymapCategory:6"/>
						<caption label="ARMOR" width=".9" height="20" center="x" manager="KeymapCategory:3"/>
						<caption label="TRUCKS" width=".9" height="20" center="x" manager="KeymapCategory:4"/>
						<caption label="GUNS" width=".9" height="20" center="x" manager="KeymapCategory:5"/>
					</view>
				</panel>
				<!--
				<panel id="vclass-panel" label="SELECT CATEGORY" width=".25" rright="0">
					<listcontrol id="keymap-cat-list" pad="15" y="80" rtop="20" style="class: litebg;"/>
					<view id="keymap-buttons" pad="15" height="60" style="class: litebg;">
						<button id="defaultcategory" x="10" center="y" label="DEFAULT" style="class: button.small; class: tinytext;"
							onclick="window.mgr.DefaultCategory(initKeymapList)"	tip="${ra.prefs.keymapper.button.def.cat.tip}"/>
						<button id="revertcategory" rright="10" center="y" label="RESET" style="class: button.small; class: tinytext;"
							onclick="window.mgr.ResetCategory(initKeymapList)" tip="${ra.prefs..keymapper.button.discard.tip}"/>
					</view>
				</panel>
				-->
			</view>
			<view id="calib-prefs">
				<panel id="calibration-panel" label="CALIBRATE" width=".6">
					<stackview id="calibrator" pad="15" rtop="20" style="class: litebg;">
						<view>
							<text x="10" height="100" width="425" rtop="50" style="font-size: +2; color: #FFFFFFFF;"
								onshow="this.text = getlocstring('widgets.calibration.mouse.desc')"/>
							<caption x="50" y="250" height="20" width="50" style=" color: #FFFFFFFF;"
								onshow="this.label = getlocstring('widgets.calibration.mouse.less')" align="right"/>
							<caption x="350" y="250" height="20" width="50" style=" color: #FFFFFFFF;"
								onshow="this.label = getlocstring('widgets.calibration.mouse.more')"/>
							<caption x="150" height="20" width="425" y="275" style="font-size: +1; color: #BFE2CE;"
								onshow="this.label = getlocstring('widgets.calibration.mouse.subtitle')"/>
							<slider id="mouse-calibration" x="125" y="250" width="200" height="20" minvalue="0.125" maxvalue="2"
								onclick="window.mgr.SetCalibration('mouse', this.value)"/>
								
							<caption x="50" y="150" height="20" width="50" style=" color: #FFFFFFFF;"
								onshow="this.label = getlocstring('widgets.calibration.mouse.less')" align="right"/>
							<caption x="350" y="150" height="20" width="50" style=" color: #FFFFFFFF;"
								onshow="this.label = getlocstring('widgets.calibration.mouse.more')"/>
							<caption x="150" height="20" width="425" y="175" style="font-size: +1; color: #BFE2CE;"
								onshow="this.label = getlocstring('widgets.calibration.mouse.aimtitle')"/>
							<slider id="mouse-aim-calibration" x="125" y="150" width="200" height="20" minvalue="0.125" maxvalue="2"
								onclick="window.mgr.SetCalibration('aim', this.value)"/>
						</view>
						<view>
							<text height="100" width=".75" rtop="30" onshow="this.text = getlocstring('widgets.calibration.joystick.desc')" center="x"/>
							<view id="joystick-calibration" class="joycalib" width=".6" height="200" center="true" style="class: litebg; class: border;"/>
						</view>
					</stackview>
				</panel>
				<panel id="device-panel" label="SELECT DEVICE"width=".35" rright="0">
					<listcontrol id="device-list" pad="15" rtop="20" style="class: litebg;"/>
				</panel>
			</view>
		</stackview>
	</view>
	<navbar>
		<button id="forward" label="   BACK" x="20" onclick="window.mgr.DoBack()" center="y"/>
		<button id="save-button" label="SAVE   " rright="20" onclick="window.mgr.SavePrefs()" enabled="false" style="class: button.back;" center="y"/>
	</navbar>
	<script>
		<!--
		
		var deviceList 			= findview("device-list");
		var keymapList 		= findview("keymap-list");
		
		game.onkeymapevent = OnKeymapEvent;
		
		function OnShow()
		{
			deviceList.mgr.selectCallback = selectDevice;
			keymapList.mgr.selectCallback = selectKeymap;
			
			initDevices();
			
			// make sure our pref group is hilighted
			window.mgr.SelectGroup(window.mgr.GetGroup(0));
			window.mgr.SelectCategory(window.mgr.GetCategory(0));
		}
		
		function initDevices()
		{
			deviceList.mgr.control.clearRows(false);
			
			var mouseData = new Object();
			mouseData["name"] = "mouse1";
			
			deviceList.mgr.StartRow("mousedevice", 10, 0, 0, 14);
			deviceList.mgr.AddRowColumn(getlocstring('ra.prefs.calibration.device.mouse1'), 1);
			deviceList.mgr.EndRow(mouseData);

			var axis = new Array("axisx","axisy","axisz","axisrx","axisry","axisrz","axisslider1","axisslider2");
			
			for(var a = 0; a < axis.length; a++)
			{
				var jloc = getlocstring('ra.prefs.calibration.device.joystick1');
				var aloc = getlocstring('ra.prefs.calibration.device.' + axis[a]);
				var data = new Object();
				
				data["name"] = "joystick1" + axis[a];
				data["axis"] = axis[a];
				
				deviceList.mgr.StartRow("joyaxis" + a, 10, 0, 0, 14);
				deviceList.mgr.AddRowColumn(jloc + " " + aloc , 1);
				deviceList.mgr.EndRow(data);
			}
			
			deviceList.mgr.control.postInit();
		}
		
		function selectDevice(action)
		{
			window.mgr.SetCalibrator(deviceList.mgr.control.selectedData());
		}
		
		function selectKeymap()
		{
			window.mgr.SetKeymap(window.keymapList.mgr.control.selectedData());
		}
		
		function OnKeymapEvent(e, keymap)
		{
			window.mgr.HandleKeymapEvent(e, keymap);
		}
		
		-->
	</script>
</ra>