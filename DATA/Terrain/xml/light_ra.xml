<!-- SETTING 1  CLEAR                      -->
<!-- ===================================== -->
<lightdata>
<TerrainSky>
<!-- global scaling to tune for weather days -->
		<scale>0.95</scale>
<!-- the sky color -->
		<sky_color>
			<red>25.000000</red>
			<green>100.000000</green>
			<blue>125.000000</blue>
		</sky_color>
		
<!-- colors that are applied to things in the world -->
		<sky_clear_ambient>
			<red>200.000000</red>
			<green>195.000000</green>
			<blue>200.000000</blue>
		</sky_clear_ambient>		
		
<!-- color of the light from the sun -->
		<sun_noon>
			<red>1.4</red> 
			<green>1.4</green>
			<blue>1.4</blue>		
		</sun_noon>
		
<!-- color of the actual sun when you look at it -->
		<sun_itself_noon>
			<red>0.030000</red>
			<green>0.670000</green>
			<blue>0.470000</blue>
		</sun_itself_noon>		
		
		
	<!-- color of the band across the horizon -->
		<horizon>
			<red>100.000000</red>
			<green>120.000000</green>
			<blue>140.000000</blue>
		</horizon>			
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
		
<!-- the sky color at night -->
		<sky_color_night>
			<red>0.000000</red>
			<green>5.000000</green>
			<blue>20.000000</blue>
		</sky_color_night>

<!-- colors that are applied to things in the world -->
		<sky_night_ambient>
			<red>80.000000</red>
			<green>90.000000</green>
			<blue>100.000000</blue>
		</sky_night_ambient>

			

<!-- color of the actual sun when you look at it -->
		<sun_night>
			<red>0.000000 </red>
			<green>0.000000</green>
			<blue>0.000000</blue>
		</sun_night>
<!-- this setting effects both 0600 (sunrise) and 1800hrs (sunset)  -->
		<sunset>
			<red>0.700000</red>
			<green>0.300000</green>
			<blue>0.150000</blue>
		</sunset>

<!-- color of the light from the moon -->
		<moon>
			<red>32.500000</red>
			<green>32.000000</green>
			<blue>100.000000</blue>
		</moon>
<!-- color of the light from the moon -->
		<moon_day>
			<red>0.000000</red>
			<green>0.000000</green>
			<blue>0.000000</blue>
		</moon_day>
	</TerrainSky>
