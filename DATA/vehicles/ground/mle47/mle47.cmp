# Mle 25 

[tow-point]
usebombbay = 0
type = towpoint
subtype = none
x = 0 
y = -3.3
z = -.3
towtype = light

[haul_point]
type = haulpoint
subtype = none
# Where force is applied
x = 0.0
y = -3.3
z = 0.0
# force in Newtons
force = 12000
# Speed is m/s
speed = 2.5
haulsound = sounds\push.wav

[tow_gear]
type = gear
subtype = wheel
x = 0.0
y = -3.3
z = -0
mass = 50
gearnum = 3
wheelradius = 0.127
strutspringstrength = 10000.0
strutshockstrength = 500.0
strutshockreturnstrength = 10.0
strutlength = 1.0
contactpointtype = tire
wheelrotationalinertia = 10
castorrotinertia = 15

[steerwheelleft]
type = gear
#type = ballast
subtype = wheel
gearnum = 1
mass = 250
wheelradius = 0.45
contactpointtype = tire
#contactpointtype = steel
wheelrotationalinertia = 15
#2.5939375
#braketype = center
#brakestrength = 12000
rollcoefficient = 0.02
strutspringstrength = 25000
strutshockstrength = 1600
strutshockreturnstrength = 80

strutshockstrength = 260
strutshockreturnstrength = 110

hitmapcomponent1 = d_weelzaxl

#damagelevel of zero or less means that level isn't used
damagelevel1 = 4000
damagelevel2 = 20000
damagelevel3 = 45000
damagelevel4 = 60000

[steerwheelright]
type = gear
#type = ballast
subtype = wheel
