#braketype = center
#brakestrength = 12000
rollcoefficient = 0.02

strutspringstrength = 25000
strutshockstrength = 1600
strutshockreturnstrength = 80

strutshockstrength = 260
strutshockreturnstrength = 110

hitmapcomponent1 = d_weelzaxl

#damagelevel of zero or less means that level isn't used
damagelevel1 = 4000
damagelevel2 = 20000
damagelevel3 = 45000
damagelevel4 = 60000


[GeneralWeightBallast]
type = ballast
subtype = armor
x = 0
#y = -3
y = -0.5
z = 0
mass = 1628
#mass = 8000
inertiapitch = 5488
inertiaroll = 2529
inertiayaw = 5488


[47mm Gun]
type = weaponmount
criticalprimary = 1
usebombbay = 1
triggertype = primary
position = 2
selectornum = 1
confignum = 1
mountnum = 1
weapon = sa39l53
#weapon = sa38l33
weaponsound = sounds\mle47\47mm.wav
reloadsound = sounds\manloader.wav
ammocount = 55
ammofile = sa39l53.belt
#ammofile = sa38l33.belt
beltname = AP
gunfiresmokelevel = 0.00
collidertype = front60deg
# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d_gun

#damagelevel of zero or less means that level isn't used
ammoexplosioncomponent1 = d_gunhead
ammoexplosioncomponent2 = d_spothead

#damagelevel of zero or less means that level isn't used
damagelevel1 = 150000
damagelevel2 = 1500
damagelevel3 = 1500
damagelevel4 = 0

[crew_gunner]
type = crew
criticalsecondary = 1
#changed for CC audit v1.13
crewposition = 2
hitmapcomponent1 = d_spothead
hitmapcomponent2 = d_spottorso
hitmapcomponent3 = d_spotarms
hitmapcomponent4 = d_spotlegs

[crew_commander]
type = crew
criticalsecondary = 1
#changed for CC audit v1.13
crewposition = 1
hitmapcomponent1 = d_gunhead
hitmapcomponent2 = d_guntorso
hitmapcomponent3 = d_gunarms
hitmapcomponent4 = d_gunlegs

