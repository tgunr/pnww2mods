[transmission]
type = engine
subtype = transmission
transtype = limitedslip
mass = 2520
drivewheel1 = drivewheelleft
drivewheel2 = drivewheelright

[gearbox]
type = engine
subtype = gearbox
numforwardgears = 4
numreversegears = 4
gear1ratio = 20.82612
gear2ratio = 12.6173
gear3ratio = 8.70575
gear4ratio = 6.0
reverse1ratio = 20.1143
reverse2ratio = 12.82612
reverse3ratio = 8.6173
reverse4ratio = 6.70575
preselector = 1
propellercomponent = transmission

[clutch]
type = engine
subtype = clutch
clutchforce = 4000
clutchstart = 0.3
clutchend = 0.8
clutchdisengaged = 0.2
flywheelrotinertia = 20
propellercomponent = gearbox

