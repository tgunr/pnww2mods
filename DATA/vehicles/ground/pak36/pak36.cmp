# Pak 36 37mm

[tow-point]
usebombbay = 0
type = towpoint
subtype = none
x = 0 
y = -3.3
z = -.3
towtype = light

[haul_point]
type = haulpoint
subtype = none
# Where force is applied
x = 0.0
y = -3.3
z = 0.0
# force in Newtons
force = 12000
# Speed is m/s
# speed = 2.5 edited 6jan05 -Doc.
speed = 3.0
haulsound = sounds\push.wav

[tow_gear]
type = gear
subtype = wheel
x = 0.0
y = -3.3
z = -0
mass = 50
gearnum = 3
wheelradius = 0.127
strutspringstrength = 10000.0
strutshockstrength = 500.0
strutshockreturnstrength = 10.0
strutlength = 1.0
contactpointtype = tire
wheelrotationalinertia = 10
castorrotinertia = 15

[steerwheelleft]
type = gear
#type = ballast
subtype = wheel
gearnum = 1
mass = 250
wheelradius = 0.45
contactpointtype = tire
#contactpointtype = steel
wheelrotationalinertia = 15
#2.5939375
braketype = center
brakestrength = 120000
rollcoefficient = 0.02
strutspringstrength = 1656

strutshockstrength = 260
strutshockreturnstrength = 110

# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d-lwheel

#damagelevel of zero or less means that level isn't used
damagelevel1 = 6000
damagelevel2 = 15000
damagelevel3 = 60000
damagelevel4 = 0


[steerwheelright]
type = gear
#type = ballast
subtype = wheel
gearnum = 2
mass = 250
wheelradius = 0.45
contactpointtype = tire
wheelrotationalinertia = 15
braketype = center
brakestrength = 120000
rollcoefficient = 0.02

strutspringstrength = 1656
strutshockstrength = 260
strutshockreturnstrength = 110

# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d-rwheel
#damagelevel of zero or less means that level isn't used
damagelevel1 = 1500
damagelevel2 = 15000
damagelevel3 = 60000
damagelevel4 = 0

[GeneralWeightBallast]
type = ballast
subtype = armor
x = 0
y = 0
z = 0
mass = 328
#mass = 8000
inertiapitch = 5488
inertiaroll = 2529
inertiayaw = 5488


[37mm Gun]
type = weaponmount
criticalprimary = 1
usebombbay = 1
triggertype = primary
position = 2
selectornum = 1
confignum = 1
mountnum = 1
weapon = 37mmkwk46_5
weaponsound = sounds\pak36\37mmpak36.wav
reloadsound = sounds\autoloader.wav
beltname = AP
ammocount = 75
ammofile = 37kwk46_pzgr.belt
beltname2 = HE
ammocount2 = 25
ammofile2 = 37kwk46_pzgrhe.belt
#beltname3 = AP/40
#ammocount3 = 15
#ammofile3 = 37kwk46_pzgr40.belt
gunfiresmokelevel = 0.00
collidertype = front60deg
# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d_barrel
#damagelevel of zero or less means that level isn't used
ammoexplosioncomponent1 = d_spothead
ammoexplosioncomponent2 = d_spothead
#damagelevel of zero or less means that level isn't used
damagelevel1 = 150000
damagelevel2 = 1500
damagelevel3 = 1500
damagelevel4 = 0

[crew_commander]
type = crew
criticalsecondary = 1
#changed for CC audit v1.13
#fixed 1.34
crewposition = 1
hitmapcomponent1 = d_spothead
hitmapcomponent2 = d_spottorso
hitmapcomponent3 = d_spotarms
hitmapcomponent4 = d_spotlegs

# NOTE ON CREW DAMAGE: The damage objects in the art file for the crew are reversed, this file is adjusted for that
# EH NOT set it back

[crew_gunner]
type = crew
criticalsecondary = 1
#changed for CC audit v1.13
#fixed 1.34
crewposition = 2
hitmapcomponent1 = d_gunhead
hitmapcomponent2 = d_guntorso
hitmapcomponent3 = d_gunarms
hitmapcomponent4 = d_gunlegs


