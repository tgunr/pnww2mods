[maingun_mount]
criticalprimary = 1
#added for CC audit v1.13
type = weaponmount
criticalprimary = 1
usebombbay = 1
triggertype = primary
gunfiresmokelevel = 0.00
position = 2
selectornum = 1
confignum = 1
mountnum = 1
#addtogrpammocount = 1
weapon = 40mml60
weaponsound = sounds\bof.wav
#reloadsound = sounds\bofloader.wav
ammocount = 400
ammofile = 40mml60he.belt
beltname = HE
#ammocount2 = 15
#ammofile2 = 88mml56he.belt
#beltname2 = HE
collidertype = front60deg
# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d_barrel
#hitmapcomponent2 = o32_5
#damagelevel of zero or less means that level isn't used
ammoexplosioncomponent1 = d_gunhead
ammoexplosioncomponent2 = d_comhead
#damagelevel of zero or less means that level isn't used
damagelevel1 = 150000
damagelevel2 = 1500
damagelevel3 = 1500
damagelevel4 = 0

