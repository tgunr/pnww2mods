# Flak 36 88mm

[tow-point]
type = towpoint
subtype = none
x = 0 
y = 3.41
z = -.94
towtype = heavy

[haul_point]
type = haulpoint
subtype = none
# Where force is applied
x = 0.0
y = -3.3
z = 0.0
# force in Newtons
force = 32000
# Speed is m/s
# speed = 0.7 edited 6jan05 -Doc.
speed = 1.5
haulsound = sounds\push.wav

