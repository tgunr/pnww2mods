# Bofors 40mm turret file

#multicrewpos position, whichcrew
multicrewpos 1 1
multicrewpos 2 2

# Gun
position = 2
#elevationrate = 15
#traverserate = 34.0
elevationrate = 2
traverserate = 6
type = 360turret
gunsightfile = flak36.gs
gunsightalignmentmountobject = mount1
gunsightalignmentrange = 1000
# conditions are undeployed, depolyed, canopyopen, canopyclosed, hatchopen, hatchclosed
gunsightblocked = undeployed

#turret sound variables
turrettraverse = turret/hand_turret_move.wav
turretelevate = turret/hand_turret_move.wav


# added for centering gun
# neutral can be: bombayopen/closed, hatchopen/closed, canopyopen/closed
neutral = bombbayclosed
# neutraltraverse -1 max deflection left, 1 max deflection right, 0 straight ahead 
neutraltraverse = 0
# neutralelevate -1 max down, 1 max up, 0 is midtraverse
neutralelevate = -1

# commander
position = 1
elevationrate = 2
traverserate = 6
type = 360turret
neutral = bombbayclosed
neutraltraverse = 0
neutralelevate = 0
gunsightfile = 10x50binoc.gs
gunsightblocked undeployed