#engine stats file for Bofors 40mm
[human_power]
basehorsepower = 94.5
basehpalt = 0
basehprpm = 3000
basehppress = 1.0
basehpexhausttemp = 1000
idlethrottlepos = 0.1
idlerpm = 600
fuelperhphour = 0.260
oilconsumptionperhour = 0
wepmaxpress = 1.0
milmaxpress = 1.0
weprpm = 3000
milrpm = 3000
climbrpm = 3000
econrpm = 3000

superchargertype = none
weptype = none

#criticalrpm is the rpm at which below this the engine might stall, also used for starting
criticalrpm 200

#starterrpm is the rpm at which the starter motor will spin the engine at
starterrpm 100
#starterhp is the power of the starter motor
starterhp 2