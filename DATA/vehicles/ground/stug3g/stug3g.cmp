[75mm Main Gun]
type = weaponmount
triggertype = primary
criticalprimary = 1
gunfiresmokelevel = 0.1
position = 3
selectornum = 1
confignum = 1
mountnum = 1
weapon = 75mmstuk40l48
weaponsound = sounds\pzivg\75mmkwk40.wav
# You can do ammocount# up to 4 different types
ammocount = 40
ammofile = 75mmstuk40l48ap.belt
ammocount2 = 14
ammofile2 = 75mmstuk40l48he.belt
#ammocount2 = 12
#ammofile2 = 75mmgr38hl.belt
#ammocount3 = 26
#ammofile3 = 75mmsprgr34.belt
#beltname is what shows in the text buffer
beltname = AP
beltname2 = HE
# beltname2 = HEAT
# beltname3 = HE
#Reload sound is the breech action
reloadsound = sounds\autoloader.wav
collidertype = front60deg
# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d_75mmcannon
hitmapcomponent2 = d_ammo
ammoexplosioncomponent1 = d_gunnrhead
ammoexplosioncomponent2 = d_loaderhead
ammoexplosioncomponent3 = d_driverhead
ammoexplosioncomponent4 = d_tankcommanderhead
ammoexplosioncomponent5 = d_engine
ammoexplosioncomponent6 = d_radiohead
ammoexplosioncomponent7 = d_fueltank
#damagelevel of zero or less means that level isn't used
damagelevel1 = 250000
damagelevel2 = 1500
damagelevel3 = 1500
damagelevel4 = 0

