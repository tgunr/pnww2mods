#StuG III Ausf G component file

[drivewheelleft]
criticalsecondary = 1
#added for CC audit v1.13
type = gear
subtype = trackdrive
gearnum = 14
#x = -1.225
#y = 2.484
#z = -0.224
mass = 120
inertiapitch = 13
inertiaroll = 7.25
inertiayaw = 7.25
#strutlength = 0.14
wheelradius = .414
#contactpointtype = tire
contactpointtype = metal
#wheelrotationalinertia = 13
wheelrotationalinertia = 83
braketype = left
# brakestrength = 150000
brakestrength = 90000
# Only Driver wheels get: 
# atspeedrollcoefficient = to or < than rollcoefficient
# atspeed = 50
rollcoefficient = 0.035
atspeedrollcoefficient = 0.040
atspeedkph = 50
tracknum = 1
# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d_lftdrvwheel
hitmapcomponent2 = d_lfttread
#damagelevel of zero or less means that level isn't used
damagelevel1 = 150000
damagelevel2 = 300000
damagelevel3 = 450000
damagelevel4 = 600000
visdamage = lefttread
visdamage = drivewheelleft
damagelevelfail = 600000

