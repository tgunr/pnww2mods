
#Sd.Kfz 7 State File

#DOF state type, name of variable, name, time to articulate
#multiple states requier multiple lines
dofstate 1 hatchstate1 hatch 1 2000
#SMOKE: state type, name of variable, DOF name, smoke type, number
sound 1 enginesound1 enginesound 1

smokestate 1 fuelfire1 fleak fuelfire 1
smokestate 1 fuelleak1 fleak fuelleak 1
smokestate 1 glycolleak1 gleak glycolleak 1 1
smokestate 1 enginefire1 efire enginefire 1
smokestate 1 tankfire tfire1 tankfire 4000
smokestate 1 oilleak1 esmoke oilleak 1
smokestate 1 exhaust1 eexh1l exhaust 1
smokestate 1 exhaust1 eexh1r exhaust 1
dofstate 1 canopystate1 canopy 1 2000
dofstate 2 canopystate2 canopy 2 5000
dofstate 2 canopystate3 canopy 3 2000

#tread dust
smokestate 1 treaddust1 tdustl1 treaddust 1
smokestate 1 treaddust2 tdustl2 treaddust 2
smokestate 1 treaddust3 tdustr1 treaddust 3
smokestate 1 treaddust4 tdustr2 treaddust 4

# Crash and burn stuff

effect 1 crashexplosion crashexplosion

effect 1 crashejectriders crashejectriders

# visdamage <vis damage group name> <mass object name(in .mass file)> <emitter object> <ejectspeed>
visdamage wheel1 mass_wheel1 wheel1crap 25
visdamage wheel2 mass_wheel2 wheel2crap 25
visdamage wheel3 mass_wheel3 wheel3crap 25
visdamage wheel4 mass_wheel4 wheel4crap 25
visdamage wheel5 mass_wheel5 wheel5crap 25
visdamage wheel6 mass_wheel6 wheel6crap 25
visdamage wheel7 mass_wheel7 wheel7crap 25
visdamage wheel8 mass_wheel8 wheel8crap 25
visdamage engine mass_engine enginecrap
visdamage turret mass_turret turretcrap 20
 
visdamage hulk