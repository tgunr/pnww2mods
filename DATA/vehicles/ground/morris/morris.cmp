#Morris CDSW Hauler component file

[tow-point]
type = towpoint
subtype = none
x = 0 
y = 2
z = 0
towtype = heavy

[drivewheelleft]
type = gear
subtype = trackdrive
criticalsecondary = 1
#added for CC audit v1.13
gearnum = 3
mass = 40
wheelradius = 0.45
contactpointtype = tire
wheelrotationalinertia = 15
braketype = center
brakestrength = 100000
contactpointtype = tire
# Roll Coefficient Needs to be .02 for Wheeled vehicles
rollcoefficient = 0.014
strutspringstrength = 12000
strutshockstrength = 2000
strutshockreturnstrength = 1000
# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d_ltbackweel
hitmapcomponent2 = d_ltfsecweel
hitmapcomponent3 = d_ltfrntweel
#damagelevel of zero or less means that level isn't used
damagelevel1 = 6000
damagelevel2 = 12000
damagelevel3 = 18000
damagelevel4 = 22000
visdamage = wheel3
visdamage = wheel2
visdamage = wheel1
damagelevelfail = 22000

