# FlaK 30 AA gun

[tow-point]
usebombbay = 0
type = towpoint
subtype = none
x = 0 
y = -3.3
z = -.3
towtype = light

[haul_point]
type = haulpoint
subtype = none
# Where force is applied
x = 0.0
y = -3.3
z = 0.0
# force in Newtons
force = 12000
# Speed is m/s
# speed edited 6jan05 -Doc.
speed = 3.0
haulsound = sounds\push.wav

[tow_gear]
type = gear
subtype = wheel
x = 0.0
y = -3.3
z = -0
mass = 50
gearnum = 3
wheelradius = 0.127
strutspringstrength = 10000.0
strutshockstrength = 500.0
strutshockreturnstrength = 10.0
strutlength = 1.0
contactpointtype = tire
wheelrotationalinertia = 10
castorrotinertia = 15

[steerwheelleft]
type = gear
#type = ballast
subtype = wheel
gearnum = 1
mass = 250
wheelradius = 0.45
contactpointtype = tire
#contactpointtype = steel
wheelrotationalinertia = 15
#2.5939375
braketype = center
brakestrength = 12000
rollcoefficient = 0.02
strutspringstrength = 1656

strutshockstrength = 260
strutshockreturnstrength = 110

# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d-lwheel

#damagelevel of zero or less means that level isn't used
damagelevel1 = 1500
damagelevel2 = 15000
damagelevel3 = 60000
damagelevel4 = 0


[steerwheelright]
type = gear
#type = ballast
subtype = wheel
gearnum = 2
mass = 250
wheelradius = 0.45
contactpointtype = tire
wheelrotationalinertia = 15
braketype = center
brakestrength = 12000
rollcoefficient = 0.02

strutspringstrength = 1656
strutshockstrength = 260
strutshockreturnstrength = 110

# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d-rwheel
#damagelevel of zero or less means that level isn't used
damagelevel1 = 1500
damagelevel2 = 15000
damagelevel3 = 60000
damagelevel4 = 0

