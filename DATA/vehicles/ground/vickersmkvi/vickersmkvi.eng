#engine stats file for 
#British Vickers VI

[medows_6cylinder]
basehorsepower = 140
#basehorsepower = 88
#basehpalt = 0
basehprpm = 2900
basehppress = 1.0
basehpexhausttemp = 1100
idlethrottlepos = 0.1
#idlerpm used only for downshifting purposes
idlerpm = 800
fuelperhphour = 0.260
oilconsumptionperhour = 0
wepmaxpress = 1.0
milmaxpress = 1.0
weprpm = 3300
milrpm = 3300
climbrpm = 3300
econrpm = 3300

superchargertype = none
weptype = none

#criticalrpm is the rpm at which below this the engine might stall, also used for starting
criticalrpm 150

#starterrpm is the rpm at which the starter motor will spin the engine at
starterrpm 100
#starterhp is the power of the starter motor
starterhp 20