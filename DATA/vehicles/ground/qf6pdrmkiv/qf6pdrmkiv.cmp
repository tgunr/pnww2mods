# Q.F. 6Pdr MkIV 57mm

[tow-point]
usebombbay = 0
type = towpoint
subtype = none
x = 0 
y = -2.887
z = 0
towtype = light

[shovel_ballast]
type = ballast
subtype = none
x = 0
y = -2.1
z = 0
mass = 920
inertiapitch = 956
inertiaroll = 600
inertiayaw = 875

[haul_point]
type = haulpoint
subtype = none
# Where force is applied
x = 0.0
y = -2.49
z = 0
# force in Newtons
force = 12000
# Speed is m/s
# speed = 1.5 edited 6jan05 -Doc.
speed = 2.4
haulsound = sounds\push.wav

[tow_gear]
type = gear
subtype = wheel
x = 0
y = -2.49
y = -2.887
z = 0
# adding an extra 200kg to tow-gear to minimize skid.
mass = 50
inertiapitch = 101.7
inertiaroll = 10.63
inertiayaw = 93.01
#inertiapitch = 956
#inertiaroll = 100
#inertiayaw = 875
gearnum = 3
wheelradius = 0.1
rollcoefficient = .02
strutlength = 0.3
contactpointtype = tire
wheelrotationalinertia = 5
castorrotinertia = 15
strutspringstrength = 600
strutshockstrength = 100
strutshockreturnstrength = 100


[LeftBallast]
type = ballast
subtype = none
x = -0.45
y = -0.322
z = 0
mass = 850
# adding an extra 400kg to each ballast to minimize skid.
inertiapitch = 8.4
inertiaroll = 100
inertiayaw = 4.3


[steerwheelleft]
type = gear
subtype = wheel
x = -0.737
y = 0
z = 0
mass = 50
gearnum = 1
wheelradius = 0.86
contactpointtype = tire
wheelrotationalinertia = 3.67
braketype = center
brakestrength = 120000
rollcoefficient = .02
strutlength = 0.2
strutspringstrength = 1000
strutshockstrength = 200
strutshockreturnstrength = 200

# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d_lftwheel

#damagelevel of zero or less means that level isn't used
damagelevel1 = 1500
damagelevel2 = 15000
damagelevel3 = 60000
damagelevel4 = 0


[RightBallast]
type = ballast
subtype = none
x = 0.45
y = -0.322
z = 0
# adding an extra 400kg to each ballast to minimize skid.
mass = 850
inertiapitch = 8.4
inertiaroll = 100
inertiayaw = 4.3

[steerwheelright]
type = gear
subtype = wheel
x = 0.737
y = 0
z = 0
mass = 50
gearnum = 2
wheelradius = 0.86
contactpointtype = tire
wheelrotationalinertia = 3.67
braketype = center
brakestrength = 120000
rollcoefficient = .02
strutlength = 0.2
strutspringstrength = 1000
strutshockstrength = 200
strutshockreturnstrength = 200

# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d_rtwheel
#damagelevel of zero or less means that level isn't used
damagelevel1 = 1500
damagelevel2 = 15000
damagelevel3 = 60000
damagelevel4 = 0



[57mm High Velocity Gun]
type = weaponmount
criticalprimary = 1
mass = 1
inertiapitch = 8405
inertiaroll = 600
inertiayaw = 8405
usebombbay = 1
triggertype = primary
position = 2
selectornum = 1
confignum = 1
mountnum = 1
weapon = qf6pdrmkiv
weaponsound = sounds\qf6pdr\57mm.wav
reloadsound = sounds\autoloader.wav
beltname = AP
ammocount = 40
ammofile = 6pdrl52ap.belt
beltname2 = HE
ammocount2 = 15
ammofile2 = 6pdrl52he.belt
beltname3 = AP/40
# ammocount3 = 15
# ammofile3 = 6pdrl52apc.belt
gunfiresmokelevel = 0.0
collidertype = front60deg
# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d_barrel
#damagelevel of zero or less means that level isn't used
ammoexplosioncomponent1 = d_spothead
ammoexplosioncomponent2 = d_spothead
#damagelevel of zero or less means that level isn't used
damagelevel1 = 150000
damagelevel2 = 1500
damagelevel3 = 1500
damagelevel4 = 0

[crew_commander]
type = crew
criticalsecondary = 1
#changed for CC audit v1.13
crewposition = 1
hitmapcomponent1 = d_comarms
hitmapcomponent2 = d_comtorso
hitmapcomponent3 = d_comhead
hitmapcomponent4 = d_comleg1
hitmapcomponent5 = d_comleg2

# NOTE ON CREW DAMAGE: The damage objects in the art file for the crew are reversed, this file is adjusted for that

[crew_gunner]
type = crew
criticalsecondary = 1
#changed for CC audit v1.13
crewposition = 2
hitmapcomponent1 = d_gunarms
hitmapcomponent2 = d_guntorso
hitmapcomponent3 = d_gunhead
hitmapcomponent4 = d_gunleg1
hitmapcomponent5 = d_gunleg2


