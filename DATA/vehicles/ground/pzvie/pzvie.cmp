[88mm Main Gun]
type = weaponmount
triggertype = primary
criticalprimary = 1
#added for CC audit v1.13
gunfiresmokelevel = 0.1
position = 3
selectornum = 1
confignum = 1
mountnum = 1
weapon = 88mml56tank
weaponsound = sounds\pzvie\88mml56tgun.wav
# You can do ammocount for up to 4 different types
ammocount = 46
ammofile = 88mmkwk36ap.belt
ammocount2 = 46
ammofile2 = 88mmkwk36he.belt
ammofile3 = 88mmkwk36smoke.belt
#beltname is what shows in the text buffer
beltname = AP
beltname2 = HE
beltname3 = SMOKE
#Reload sound is the breech action
reloadsound = sounds\autoloader.wav
collidertype = front60deg
# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d_75mmcanon
hitmapcomponent2 = d_turretammo
hitmapcomponent3 = d_hullammo
ammoexplosioncomponent1 = d_maingunnrhead
ammoexplosioncomponent2 = d_gunnrhead
ammoexplosioncomponent3 = d_driverhead
ammoexplosioncomponent4 = d_tankcommanderhead
ammoexplosioncomponent5 = d_engine
ammoexplosioncomponent6 = d_fueltank
ammoexplosioncomponent7 = d_loaderhead

#damagelevel of zero or less means that level isn't used
damagelevel1 = 350000
damagelevel2 = 1500
damagelevel3 = 1500
damagelevel4 = 0

