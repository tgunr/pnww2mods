drivewheel2 = drivewheelright

[gearbox]
type = engine
subtype = gearbox
numforwardgears = 8
numreversegears = 1
gear1ratio = 40
gear2ratio = 36
gear3ratio = 33
gear4ratio = 31
gear5ratio = 20.2
gear6ratio = 17.9
gear7ratio = 13.8
gear8ratio = 10.6
reverse1ratio = 34.18261
#reverse1ratio = 121.1143
preselector = 1
propellercomponent = transmission

[clutch]
