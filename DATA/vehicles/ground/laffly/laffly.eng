#engine stats file for laffly s20 tl
[S20TL_6cylinder]
basehorsepower = 86
basehpalt = 0
basehprpm = 3200
basehppress = 1.0
basehpexhausttemp = 1000
idlethrottlepos = 0.1
idlerpm = 1000
fuelperhphour = 0.260
oilconsumptionperhour = 0
wepmaxpress = 1.0
milmaxpress = 1.0
weprpm = 4200
milrpm = 4200
climbrpm = 4200
econrpm = 4200

superchargertype = none
weptype = none

#criticalrpm is the rpm at which below this the engine might stall, also used for starting
