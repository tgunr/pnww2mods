<?xml version='1.0'?>
<vehicle manager="eztruck">
	<config>
		<param name="shiftdownrpms" value=".65"/>
		<param name="shiftuprpms" value=".97"/>
		<param name="acceltime" value="3000"/>
		<param name="shifttime" value="1000"/>
	</config>
	<!-- RAFTER'S CAMPAIGN TEST -->
	<ez level="1"> 
	<!-- EXTERNAL FORWARD VIEW -->
	<position name="external view" position="0" view="0" zoom="0">
		<camera offset="0,-6.5,3" focus="200">
			<elevation down="-30" up="20"/>
		</camera>
	</position>

	
	<position name="driver" position="1" view="1" zoom="0" covered="true"/>
		
	</ez>
		