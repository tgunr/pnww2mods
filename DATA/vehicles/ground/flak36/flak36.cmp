[88mm Gun]
type = weaponmount
criticalprimary = 1
usebombbay = 1
triggertype = primary
gunfiresmokelevel = 0.00
position = 2
selectornum = 1
confignum = 1
mountnum = 1
weapon = 88mml56
weaponsound = sounds\flak36\88mm.wav
reloadsound = sounds\autoloader.wav
ammocount = 40
ammofile = 88mml56.belt
beltname = AP
ammocount2 = 15
ammofile2 = 88mml56he.belt
beltname2 = HE
collidertype = front60deg
# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = o5_5
hitmapcomponent2 = o32_5
hitmapcomponent3 = o6_6
hitmapcomponent4 = d_gunbase
#damagelevel of zero or less means that level isn't used
ammoexplosioncomponent1 = d_gunhead
ammoexplosioncomponent2 = d_commhead
#damagelevel of zero or less means that level isn't used
damagelevel1 = 150000
damagelevel2 = 1500
damagelevel3 = 1500
damagelevel4 = 0

