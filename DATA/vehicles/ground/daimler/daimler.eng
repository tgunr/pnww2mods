#engine stats file for pziiif
[Daimler_6cyl]
basehorsepower = 140
basehpalt = 0
basehprpm = 3800
basehppress = 0.9
basehpexhausttemp = 1000
idlethrottlepos = 0.1
idlerpm = 900
fuelperhphour = 0.260
oilconsumptionperhour = 0
wepmaxpress = 1.0
milmaxpress = 1.0
weprpm = 4000
milrpm = 4000
climbrpm = 4000
econrpm = 4000

