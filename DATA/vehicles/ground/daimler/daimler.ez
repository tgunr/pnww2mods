<?xml version='1.0'?>
<vehicle reticle="reticles/camera" turret="2" manager="eztruck">
	<config>
		<param name="shiftdownrpms" value=".65"/>
		<param name="shiftuprpms" value=".97"/>
		<param name="acceltime" value="3000"/>
		<param name="shifttime" value="500"/>
		<param name="category" value="tank"/>
	</config>
	<position name="command" position="2" view="0" zoom="0" reticle="reticles/crosshairs">
		<camera offset="0,-6.5,3" focus="200" travrate="200" elevrate="150" minangle="-30" maxangle="20"/>
		<blocks input="turretraverse"/>
		<blocks input="turretelevate"/>
	</position>
	<position name="gunner" position="2" view="3" zoom="0"/>
	<position name="instruments" position="0" view="2" zoom="0"/>
</vehicle>
