[drivewheelleft]
type = gear
subtype = trackdrive
criticalsecondary = 1
#added for CC audit v1.13
gearnum = 2
mass = 50
wheelradius = 0.51
contactpointtype = tire
wheelrotationalinertia = 25
braketype = center
brakestrength = 100000
contactpointtype = tire
# Roll Coefficient Needs to be .02 for Wheeled vehicles
rollcoefficient = 0.02
strutspringstrength = 82000
strutshockstrength = 30000
strutshockreturnstrength = 800
#strutspringstrength = 50000
#strutshockstrength = 20000
#strutshockreturnstrength = 100
# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d_backleftwheel
hitmapcomponent2 = d_frontleftwheel
#damagelevel of zero or less means that level isn't used
damagelevel1 = 45000
damagelevel2 = 75000
damagelevel3 = 100000
damagelevel4 = 145328
visdamage = backleftwheel
visdamage = frontleftwheel
damagelevelfail = 145328

