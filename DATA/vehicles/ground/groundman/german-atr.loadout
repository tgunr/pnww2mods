#German infantry ATR loadout file
#added pistol to loadout 8th.Oct/05 -Doc.

# sounds available for the mounts
sound1 = sounds\troop\pzb39atr.wav
sound2 = sounds\troop\luger.wav
sound3 = sounds\troop\grenade-throw.wav
sound4 = sounds\troop\satchel-place.wav

loadout = 1

# Anti-tank rifle
mountnum = 1
mountsound = sound1
weapon = pzb39atr
maxoversupply = 5

# Pistol
mountnum = 2
mountsound = sound2
weapon = luger

# Smoke Grenade
mountnum = 3
mountsound = sound2
weapon = desmokegrenade

# AT Satchel
mountnum = 4
mountsound = sound4
weapon = satchelgeneric

# Knife
mountnum = 5
weapon = knifegeneric

# build tool
mountnum = 8
weapon = satchelgeneric

