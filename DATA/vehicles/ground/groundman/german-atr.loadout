#German infantry ATR loadout file
#added pistol to loadout 8th.Oct/05 -Doc.

# The ORDER of weapons MUST MATCH the VIZLOADOUT.XML order!
# Note the comments in that file. The "weapons" listed in Vizloadout 
# refer to the ANIMATION file names, which are often different.

# sounds available for the mounts
sound1 = sounds\troop\pzb39atr.wav
sound2 = sounds\troop\luger.wav
sound3 = sounds\troop\grenade-throw.wav

loadout = 1

# Anti-tank rifle
mountnum = 1
mountsound = sound1
weapon = pzb39atr
#maxoversupply = 5
maxoversupply = 15

# Pistol
mountnum = 2
mountsound = sound2
weapon = luger

# Smoke Grenade
mountnum = 3
mountsound = sound2
weapon = desmokegrenade

# Knife
mountnum = 4
weapon = knifegeneric

# build tool
mountnum = 8
weapon = satchelgeneric

