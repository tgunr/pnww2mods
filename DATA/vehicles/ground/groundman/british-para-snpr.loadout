 #British.loadout file

# sounds available for the mounts
sound1 = sounds\troop\mk4no1.wav
sound2 = sounds\troop\enfieldmk2no1.wav
sound3 = sounds\troop\grenade-throw.wav

loadout = 1

# Rifle
mountnum = 1
mountsound = sound1
weapon = mk4no1

# Pistol
mountnum = 2
mounsound = sound2
weapon = enfieldno2mk1

# Grenade
#mountnum = 2
#mountsound = sound2
#weapon = mills36mk1

# Smoke Grenade
mountnum = 3
mountsound = sound3
weapon = uk_smokegrenade
infresupply = .5

# Knife
mountnum = 4
weapon = knifegeneric

