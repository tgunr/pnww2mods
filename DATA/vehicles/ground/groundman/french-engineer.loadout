#British.loadout file

# sounds available for the mounts
sound1 = sounds\troop\lebel.wav
sound2 = sounds\troop\satchel-place.wav
sound3 = sounds\troop\grenade-throw.wav
sound4 = sounds\troop\grenade-throw.wav

loadout = 1

# Rifle
mountnum = 1
mountsound = sound1
weapon = mas36

# Satchel Charge
mountnum = 2
mountsound = sound2
weapon = satchelgeneric

# Grenade
mountnum = 3
mountsound = sound3
weapon = french_grenade

# Smoke Grenade
mountnum = 4
mountsound = sound4
weapon = fr_smokegrenade

# Knife
mountnum = 5
weapon = knifegeneric

# Bridge Repair
mountnum = 6
weapon = satchelgeneric

# build tool
mountnum = 7
weapon = satchelgeneric
