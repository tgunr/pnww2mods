#French infantry Light Mortar loadout file 

# sounds available for the mounts
sound1 = sounds\troop\frltmortar.wav
sound2 = sounds\troop\frltmortar.wav
sound3 = sounds\troop\lebel.wav

loadout = 1

# LightMortar HE
mountnum = 1
