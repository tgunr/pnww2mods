weapon = fr50mmmortar
maxoversupply = 5

# LightMortar Smoke
mountnum = 2
mountsound = sound2
weapon = fr50mmmortar

# Rifle
mountnum = 3
mountsound = sound3
weapon = mas36

# Knife
mountnum = 4
weapon = knifegeneric

