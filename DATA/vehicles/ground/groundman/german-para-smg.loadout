infresupply = .5

# Smoke Grenade
mountnum = 4
mountsound = sound4
weapon = desmokegrenade
infresupply = .5

# Knife
mountnum = 5
weapon = knifegeneric

# Satchel Charge HEAT
mountnum = 6
mountsound = sound6
weapon = germsatchel

# Ammo Box
mountnum = 7
