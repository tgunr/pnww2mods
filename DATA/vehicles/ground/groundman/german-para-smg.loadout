 #German.loadout file

# sounds available for the mounts
sound1 = sounds\troop\mp40.wav
sound2 = sounds\troop\luger.wav
sound3 = sounds\troop\grenade-throw.wav
sound4 = sounds\troop\grenade-throw.wav
sound6 = sounds\troop\satchel-place.wav

loadout = 1

# Rifle
mountnum = 1
mountsound = sound1
