 #British.loadout file

#options
#maxoversupply = 2 gives the weapon stockpile ability
#infresupply = .5 gives the weapon the ability to be resupplied with the ammo can

#maxoversupply = 2
# sounds available for the mounts
sound1 = sounds\troop\mk4no1.wav
sound2 = sounds\troop\grenade-throw.wav
sound3 = sounds\troop\grenade-throw.wav
sound6 = sounds\troop\satchel-place.wav

loadout = 1

# Rifle
mountnum = 1
mountsound = sound1
weapon = mk4no1

# Grenade
mountnum = 2
mountsound = sound2
weapon = mills36mk1
infresupply = .5

# Smoke Grenade
mountnum = 3
mountsound = sound3
weapon = uk_smokegrenade
infresupply = .5

# Knife
mountnum = 4
weapon = knifegeneric

# Satchel Charge
mountnum = 5
mountsound = sound6
weapon = satchelgeneric

# Satchel Charge
mountnum = 6
mountsound = sound6
weapon = satchelhighexplosive

# Ammo
mountnum = 7
weapon = satchelgeneric

# build tool
mountnum = 8
weapon = satchelgeneric