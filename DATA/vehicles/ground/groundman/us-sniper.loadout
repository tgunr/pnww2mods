# US sniper .loadout file

# sounds available for the mounts
sound1 = sounds\troop\Springfield03.wav
sound2 = sounds\troop\M1911.wav
sound3 = sounds\troop\grenade-throw.wav

loadout = 1

# Rifle
mountnum = 1
mountsound = sound1
weapon = springfld1903

# Pistol
mountnum = 2
mountsound = sound2
weapon = colt1911

# Smoke Grenade
mountnum = 3
mountsound = sound2
weapon = us_smokegrenade

# Knife
mountnum = 4
weapon = knifegeneric

# build tool
mountnum = 8
weapon = satchelgeneric
