#British infantry ATR loadout file
# added pistol to laodout Oct.8th/05 -Doc.

# sounds available for the mounts
sound1 = sounds\troop\boys55atr.wav
sound2 = sounds\troop\enfieldmk2no1.wav
sound3 = sounds\troop\grenade-throw.wav
sound4 = sounds\troop\grenade-throw.wav

loadout = 1

# Anti-tank rifle
mountnum = 1
mountsound = sound1
weapon = boys55atr
maxoversupply = 5

# Pistol
mountnum = 2
mounsound = sound2
weapon = enfieldno2mk1

# Grenade
mountnum = 3
mountsound = sound3
weapon = mills36mk1
infresupply = .5

# Smoke Grenade
mountnum = 4
mountsound = sound4
weapon = uk_smokegrenade
infresupply = .5

# Knife
mountnum = 5
weapon = knifegeneric

# build tool
mountnum = 6
weapon = satchelgeneric

