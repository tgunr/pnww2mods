#British infantry LMG loadout file

# sounds available for the mounts
sound1 = sounds\troop\bren.wav
sound2 = sounds\troop\enfieldmk2no1.wav
sound3 = sounds\troop\grenade-throw.wav

loadout = 1

# LightMachineGun
mountnum = 1
mountsound = sound1
weapon = brenmk1lmg
maxoversupply = 5

# Pistol
mountnum = 2
mounsound = sound2
weapon = enfieldno2mk1

# Smoke Grenade
mountnum = 3
mountsound = sound3
weapon = uk_smokegrenade
infresupply = .5

# Knife
mountnum = 4
weapon = knifegeneric

