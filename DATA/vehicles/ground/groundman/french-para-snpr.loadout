 #French.loadout file

# sounds available for the mounts
sound1 = sounds\troop\lebel.wav
sound2 = sounds\troop\m1935s.wav
sound3 = sounds\troop\grenade-throw.wav


loadout = 1

# Rifle
mountnum = 1
mountsound = sound1
weapon = lebel

# Pistol
mountnum = 2
mountsound = sound2
weapon = m1935s

# Smoke Grenade
mountnum = 3
mountsound = sound3
weapon = fr_smokegrenade
infresupply = .5

# Knife
mountnum = 4
weapon = knifegeneric

# build tool
mountnum = 5
weapon = satchelgeneric
