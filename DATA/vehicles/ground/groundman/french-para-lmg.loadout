#French infantry LMG loadout file 

# sounds available for the mounts
sound1 = sounds\troop\mas.wav
sound2 = sounds\troop\m1935s.wav
sound3 = sounds\troop\grenade-throw.wav

loadout = 1

# LightMachineGun
mountnum = 1
mountsound = sound1
weapon = fmc29lmg
maxoversupply = 5

# Pistol
mountnum = 2
mountsound = sound2
weapon = luger

# Smoke Grenade
mountnum = 3
mountsound = sound3
weapon = fr_smokegrenade
infresupply = .5

# Knife
mountnum = 4
weapon = knifegeneric

# build tool
mountnum = 8
weapon = satchelgeneric

