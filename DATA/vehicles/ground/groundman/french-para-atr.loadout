 #French.loadout file

# sounds available for the mounts
sound1 = sounds\troop\boys55atr.wav
sound2 = sounds\troop\m1935s.wav
sound3 = sounds\troop\grenade-throw.wav

loadout = 1

# Anti-tank rifle
mountnum = 1
mountsound = sound1
weapon = boys55atr
maxoversupply = 5

# Pistol
mountnum = 2
mountsound = sound2
weapon = m1935s

# Grenade
mountnum = 3
mountsound = sound3
weapon = french_grenade
maxoversupply = 2
infresupply = .5

# Smoke Grenade
mountnum = 4
mountsound = sound3
weapon = fr_smokegrenade
infresupply = .5

# Knife
mountnum = 5
weapon = knifegeneric

# build tool
mountnum = 8
weapon = satchelgeneric