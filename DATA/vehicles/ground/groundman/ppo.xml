<!--
	COLLIDER_NORAGDOLL		= 0,		// don't ragdoll here
	COLLIDER_TRN_GROUND		= 1,		// earth
	COLLIDER_TRN_BUSH		= 2,		// non-tree foliage
	COLLIDER_TRN_TREE		= 3,
	COLLIDER_TRN_WATER		= 4,
	COLLIDER_TRN_BUILDING	= 5,		// buildings
	COLLIDER_TRN_BRIDGE		= 6,		// bridges
	COLLIDER_TRN_CULTURAL	= 7,		// man made objects
	COLLIDER_VEH_TROOP		= 8,
	COLLIDER_VEH_GROUND		= 9,
	COLLIDER_VEH_AIR		= 10,
	COLLIDER_VEH_SEA		= 11,
	COLLIDER_AMMO			= 12,	// active in flight ammo
	COLLIDER_FPS			= 13,	// fps infantry collider for movement
	COLLIDER_CORPSE			= 14,    // duh
    COLLIDER_VEH_HULK		= 15,
	COLLIDER_DEBRIS			= 16,
	COLLIDER_WEAPON			= 17,
	COLLIDER_CAPTURE		= 18,
	COLLIDER_NOFIRE			= 19,
	COLLIDER_HEIGHTMAP		= 20,
	COLLIDER_WALK			= 21,
	COLLIDER_ENTERABLE		= 22,	// anything you can get in or under (disallow grass or rain in these areas)
	COLLIDER_TILE			= 23,	// a terrain replacement tile
	COLLIDER_BLANK			= 24,	// any blank terrain space (bbox where stuff can't be placed)
	COLLIDER_STO			= 25,	// sto objects
	COLLIDER_AREA			= 26,	// collider type used to differentiate this collider as one that detects other collider types
-->

<ppos>
	<defaults>
		<param name="rayadjust" value="0,0,0"/>
		<!-- bounding box in meters for checking objects against the avoid flags -->
		<param name="avoidance" value="1"/>
		<!-- degrees of tilt each ray can be off from the center ray (non-planar checks) -->
		<param name="raytolerance" value="20"/>
		<!-- degrees of tilt the object can be tilted in the world (world oriented tilt limitations) -->
		<param name="tilttolerance" value="45"/>
		<!-- how far in front the object displays -->
		<param name="viewoffset" value="8"/>
		<!-- degrees of rotation we draw the object at -->
		<param name="rotation" value="0"/>
		<!-- cooldown in milliseconds -->
		<param name="cooldown" value="120000"/>
		<!-- buildtime in milliseconds -->
		<param name="buildtime" value="30000"/>
		<!-- what we can build on (see above) -->
		<param name="buildflags" value="1,23"/>
		<!-- what we must avoid (see above) -->
		<param name="avoidflags" value="3,5,6,7,9,10,11,25"/>
		<!-- infantry surface ids (found in ground.csv) -->
		<param name="surfaceflags" value="0,1,3,4"/>
		<param name="allowinterior" value="false"/>
		<!-- radius in meters we must be away from trees (0 means don't check)  -->
		<param name="treecheck" value="0"/>
		<!-- max moving speed in order to build  -->
		<param name="maxspeed" value=".1"/>
		<!-- next 3 parameters follow these rules: -->
		<!-- positive means we must be further away than value -->
		<!-- negative means we must be closer than value -->
		<!-- distance any meters from enemy facility  -->
		<param name="enemyfacdist" value="0"/>
		<!-- distance any meters from friendly facility  -->
		<param name="friendlyfacdist" value="0"/>
		<!-- distance any meters from target  -->
		<param name="targetdist" value="0"/>
		<!-- texture list we cannot build on  -->
		<param name="badtextures" value="rails1,rails2,airbase1,airfield1,provinggroundairfield1"/>
		<!-- texture list we can build on -->
		<param name="oktextures" value="clear1"/>
		<!-- lifetime on the host -->
		<param name="timeout-minutes" value="240"/>
		<!-- identify whether ppo is spawnable or not -->
		<param name="spawnable" value="false"/>
		<!-- allow the following vehicle types to place ppos -->
		<param name="allowplace" value="9/3"/> <!--  Makes Engineers the default placers of PPOs -->
		<!-- allow the following classes to spawn from PPOs allowed to spawn vehicles -->
		<param name="allowspawn" value="9"/> <!--  Makes Troops default class allowed to spawn from PPO -->
	</defaults>
	
	<!-- ppos get an id starting at 1 and counting up in the order listed here -->
	<ppo name="ifp" description="Foxhole" sto-type="6">
		<param name="modelname" value="ppo_ifp_001"/>
		<param name="rayadjust" value="1,1,-.5"/>
		<param name="raytolerance" value="10"/>
		<param name="tilttolerance" value="40"/>
		<param name="rotation" value="180"/>
		<param name="viewoffset" value="2"/>
		<param name="buildtime" value="15000"/>
		<param name="surfaceflags" value="0,3"/>
		<param name="avoidance" value="1.5"/>
		<param name="timeout-minutes" value="15"/>
		<param name="allowplace" value="9"/>
		<param name="damage-threshold" value="5000"/>
		<param name="damage-capacity" value="5000"/> <!-- 1 Grenade -->
	</ppo>
	<ppo name="ge" description="Gun Emplacement" sto-type="6">
		<param name="modelname" value="atgunpitppo"/>
		<param name="avoidance" value="0.95"/>
		<param name="rayadjust" value="4,4,-.5"/>
		<param name="raytolerance" value="10"/>
		<param name="tilttolerance" value="20"/>
		<param name="enemyfacdist" value="175"/>
		<param name="rotation" value="90"/>
		<param name="cooldown" value="270000"/>
		<param name="buildtime" value="45000"/>
		<param name="viewoffset" value="6"/>
		<param name="treecheck" value="1"/>
		<param name="damage-threshold" value="251000"/> <!-- Mortar/HE+ -->
		<param name="damage-capacity" value="25000000"/> <!-- 1 Satchel, 25+ HE rounds -->
	</ppo>
	<ppo name="fmsp" description="Fortified Mobile Spawn" sto-type="7">
		<param name="modelname" value="fms"/>
		<param name="rayadjust" value=".75,1.5,0"/>
		<param name="raytolerance" value="10"/>
		<param name="tilttolerance" value="20"/>
		<param name="rotation" value="90"/>
		<param name="viewoffset" value="6"/>
		<param name="cooldown" value="0"/>
		<param name="buildtime" value="90000"/>
		<param name="enemyfacdist" value="400"/>
		<param name="targetdist" value="-3000"/>
		<param name="treecheck" value="4"/>
		<param name="spawnable" value="true"/>
		<param name="allowplace" value="6"/>
		<param name="denyplace" value="9"/>
		<param name="allowspawn" value="9/,7/1,7/3"/> <!-- Infantry and light guns -->
		<param name="timeout-minutes" value="0"/>
		<param name="damage-threshold" value="251000"/> <!-- Mortar/HE+ -->
		<param name="damage-capacity" value="100000000"/> <!-- 4 Satchel, 100+ HE rounds -->
	</ppo>
	<ppo name="afru" description="Ammunition Cache" sto-type="6">
		<param name="modelname" value="ammofru"/>
		<param name="rayadjust" value=".75,1.5,0"/>
		<param name="rotation" value="90"/>
		<param name="cooldown" value="300000"/>
		<param name="viewoffset" value="4"/>
		<param name="enemyfacdist" value="400"/>
		<param name="targetdist" value="-3000"/>
		<param name="treecheck" value="4"/>
		<param name="allowplace" value="6"/>
		<param name="denyplace" value="9"/>
		<param name="spawnable" value="false"/>
		<param name="timeout-minutes" value="20"/>
		<param name="damage-threshold" value="0"/>
		<param name="damage-capacity" value="20000"/> <!-- ~20 bullets, 2 grenades -->
	</ppo>
	<ppo name="cfru" description="Urban Mobile Spawn" sto-type="7">
		<param name="modelname" value="citymsp"/>
		<param name="surfaceflags" value="1"/>
		<param name="rayadjust" value=".75,1.5,0"/>
		<param name="rotation" value="90"/>
		<param name="viewoffset" value="4"/>
		<param name="cooldown" value="0"/>
		<param name="buildtime" value="90000"/>
		<param name="avoidflags" value="3,6,7,9,10,11,25"/>
		<param name="allowinterior" value="true"/>
		<param name="enemyfacdist" value="400"/>
		<param name="targetdist" value="-3000"/>
		<param name="treecheck" value="2"/>
		<param name="allowplace" value="6"/>
		<param name="denyplace" value="9"/>
		<param name="spawnable" value="true"/>
		<param name="timeout-minutes" value="0"/>
		<param name="damage-threshold" value="0"/>
		<param name="damage-capacity" value="20000"/> <!-- ~20 bullets, 2 grenades -->
	</ppo>
	<ppo name="sbag" description="Sandbags" sto-type="6">
		<param name="modelname" value="sandbags"/>
		<param name="allowplaceclass" value="9"/>
		<param name="rayadjust" value="1,1,-.5"/>
		<param name="raytolerance" value="10"/>
		<param name="tilttolerance" value="40"/>
		<param name="rotation" value="90"/>
		<param name="viewoffset" value="2"/>
		<param name="avoidance" value="0.5"/>
		<param name="allowplace" value="9/3,9/1"/>
		<param name="cooldown" value="75000"/>
		<param name="buildtime" value="20000"/>
		<!--NOTE: Takes x3 damage from most sources.-->
		<param name="damage-threshold" value="251000"/> <!-- Mortar/HE+ -->
		<param name="damage-capacity" value="8000000"/> <!-- 2-4 AP, 1-2 HE -->
	</ppo>
	<ppo name="ttrap" description="Tank Trap" sto-type="6">
		<param name="modelname" value="tanktrap_ppo"/>
		<param name="rayadjust" value="1,1,-.5"/>
		<param name="raytolerance" value="10"/>
		<param name="tilttolerance" value="40"/>
		<param name="rotation" value="180"/>
		<param name="enemyfacdist" value="100"/>
		<param name="cooldown" value="390000"/>
		<param name="viewoffset" value="2"/>
		<param name="avoidance" value="1"/>
		<param name="damage-threshold" value="10000000"/>
		<param name="damage-capacity" value="10000000"/> <!-- 1 Bomb/Satchel -->
	</ppo>
</ppos>
