#British infantry ATR loadout file
# added pistol to laodout Oct.8th/05 -Doc.

# sounds available for the mounts
sound1 = sounds\troop\boys55atr.wav
sound2 = sounds\troop\enfieldmk2no1.wav
sound3 = sounds\troop\grenade-throw.wav
sound4 = sounds\troop\xxxxxxxxxxxxxxxxx

loadout = 1

# Anti-tank rifle
mountnum = 1
mountsound = sound1
weapon = boys55atr
maxoversupply = 5

# Pistol
mountnum = 2
mounsound = sound2
weapon = enfieldno2mk1

# Smoke Grenade
mountnum = 3
mountsound = sound2
weapon = uk_smokegrenade

# Knife
mountnum = 4
weapon = knifegeneric

# AT Satchel
mountnum = 5
mountsound = xxxxxxxxxx
weapon = satchelgeneric

# build tool
mountnum = 8
weapon = satchelgeneric

