[tow-point]
usebombbay = 0
type = towpoint
subtype = none
x = 0 
y = -3.3
z = -.3
towtype = light

[haul_point]
type = haulpoint
subtype = none
# Where force is applied
x = 0.0
y = -3.3
z = 0.0
# force in Newtons
force = 12000
# Speed is m/s
# speed = 2.5 edited 6jan05 -Doc.
speed = 3.0
haulsound = sounds\push.wav

[tow_gear]
type = gear
subtype = wheel
x = 0.0
y = -3.3
z = -0
