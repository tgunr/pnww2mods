[25mm AA Gun]
type = weaponmount
criticalprimary = 1
usebombbay = 1
triggertype = primary
position = 2
selectornum = 1
confignum = 1
mountnum = 1
weapon = mle38_25mm
weaponsound = sounds\pziic\20mm.wav
reloadsound = sounds\mgreload.wav
ammocount = 450
ammofile = 25mm.belt
beltname = HE
#ammocount = 200
#ammofile = 25mm.belt
#beltname = AP
collidertype = front60deg
# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d_gun

#damagelevel of zero or less means that level isn't used
ammoexplosioncomponent1 = d_gunhead
ammoexplosioncomponent2 = d_comhead

#damagelevel of zero or less means that level isn't used
damagelevel1 = 150000
damagelevel2 = 1500
damagelevel3 = 1500
damagelevel4 = 0

[crew_gunner]
type = crew
criticalsecondary = 1
#changed for CC audit v1.13
crewposition = 2
hitmapcomponent1 = d_gunhead
hitmapcomponent2 = d_guntorso
hitmapcomponent3 = d_gunarms
hitmapcomponent4 = d_gunlegs

[crew_commander]
type = crew
criticalsecondary = 1
#changed for CC audit v1.13
#fixed for 1.34
crewposition = 1
hitmapcomponent1 = d_comhead
hitmapcomponent2 = d_comtorso
hitmapcomponent3 = d_comarms
hitmapcomponent4 = d_comlegs

