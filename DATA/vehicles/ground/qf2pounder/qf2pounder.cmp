# QF 2pounder

[tow-point]
usebombbay = 0
type = towpoint
subtype = none
x = 0 
y = -3.3
z = -.3
towtype = light

[haul_point]
type = haulpoint
subtype = none
# Where force is applied
x = 0.0
y = -3.3
z = 0.0
# force in Newtons
force = 12000
# Speed is m/s
# speed = 2.5 edited 6jan05 -Doc.
speed = 3.0
haulsound = sounds\push.wav

[tow_gear]
type = gear
subtype = wheel
x = 0.0
y = -3.3
z = -0
mass = 50
gearnum = 3
wheelradius = 0.127
strutspringstrength = 10000.0
strutshockstrength = 500.0
strutshockreturnstrength = 10.0
strutlength = 1.0
contactpointtype = tire
wheelrotationalinertia = 10
castorrotinertia = 15

[GeneralWeightBallast]
type = ballast
subtype = armor
x = 0
y = -.85
z = 0
#mass = 328
mass = 98
#mass = 8000
inertiapitch = 5488
inertiaroll = 2529
inertiayaw = 5488

[leftwheel]
type = gear
#type = ballast
subtype = wheel
gearnum = 1
mass = 50
wheelradius = 0.45
contactpointtype = tire
#contactpointtype = steel
wheelrotationalinertia = 15
#2.5939375
braketype = center
brakestrength = 12000
rollcoefficient = 0.02

strutspringstrength = 4000
strutshockstrength = 2000
strutshockreturnstrength = 200

# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d_leftwheel

#damagelevel of zero or less means that level isn't used
damagelevel1 = 4000
damagelevel2 = 20000
damagelevel3 = 45000
damagelevel4 = 60000


[rightwheel]
type = gear
#type = ballast
subtype = wheel
gearnum = 2
mass = 50
wheelradius = 0.45
contactpointtype = tire
wheelrotationalinertia = 15
braketype = center
brakestrength = 12000
rollcoefficient = 0.02

strutspringstrength = 4000
strutshockstrength = 2000
strutshockreturnstrength = 200

# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d_rightwheel
#damagelevel of zero or less means that level isn't used
damagelevel1 = 4000
damagelevel2 = 20000
damagelevel3 = 45000
damagelevel4 = 60000

[GeneralWeightBallast]
type = ballast
subtype = armor
x = 0
#y = -.85
y = 0.0
z = 0.15
#mass = 328
mass = 1228
#mass = 8000
#inertiapitch = 5488
#inertiaroll = 2529
#inertiayaw = 5488

inertiapitch = 15488
inertiaroll = 12529
inertiayaw = 15488

[40mm Gun]
type = weaponmount
usebombbay = 1
triggertype = primary
criticalprimary = 1
position = 2
selectornum = 1
confignum = 1
mountnum = 1
weapon = 40mml50
weaponsound = sounds\qf2pounder\2lbs.wav
reloadsound = sounds\autoloader.wav
#beltname is what shows in the text buffer
beltname = AP
ammocount = 70
ammofile = 40mml50.belt
beltname2 = HE
ammocount2 = 15
ammofile2 = 40mml50he.belt
gunfiresmokelevel = 0.00
collidertype = front60deg
# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
hitmapcomponent1 = d_gunmount
hitmapcomponent2 = d_ammo
#damagelevel of zero or less means that level isn't used
ammoexplosioncomponent1 = d_commanderhead
ammoexplosioncomponent2 = d_gunnerhead
#damagelevel of zero or less means that level isn't used
damagelevel1 = 150000
damagelevel2 = 1500
damagelevel3 = 1500
damagelevel4 = 0

[crew_commander]
type = crew
criticalsecondary = 1
#changed for CC audit v1.13
crewposition = 1
hitmapcomponent1 = d_commanderhead
hitmapcomponent2 = d_commandertorso
hitmapcomponent3 = d_commanderarms
hitmapcomponent4 = d_commanderlegs

[crew_gunner]
type = crew
criticalsecondary = 1
#changed for CC audit v1.13
crewposition = 2
hitmapcomponent1 = d_gunnerhead
hitmapcomponent2 = d_gunnertorso
hitmapcomponent3 = d_gunnerarms
hitmapcomponent4 = d_gunnerlegs

