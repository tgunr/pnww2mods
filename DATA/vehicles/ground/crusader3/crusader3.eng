#engine stats file for #British Cruiser MkVI Crusader MkIII A15
[nuffield_liberty]
basehorsepower = 340
basehpalt = 0
basehprpm = 1500
basehppress = 0.9
basehpexhausttemp = 1000
idlethrottlepos = 0.1
#idlerpm used only for downshifting purposes
idlerpm = 600
fuelperhphour = 0.260
oilconsumptionperhour = 0
wepmaxpress = 1.0
milmaxpress = 1.0
weprpm = 1600
milrpm = 1600
climbrpm = 1600
econrpm = 1600

superchargertype = none
weptype = none

#criticalrpm is the rpm at which below this the engine might stall, also used for starting
criticalrpm 150

#starterrpm is the rpm at which the starter motor will spin the engine at
starterrpm 100
#starterhp is the power of the starter motor
starterhp 20