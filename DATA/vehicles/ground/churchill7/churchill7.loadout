##British Churchill Mk VII.loadout file

# sounds available for the mounts
sound1 = sounds\m4a2\xgun.wav
sound2 = sounds\matilda2\xgun2.wav
sound3 = sounds\matilda2\xgun2.wav

loadout = 1

# Main Gun
mountnum = 1
mountobject = maingunmount
mountsound = sound1
weapon = 75mml40m3
weaponobject = genericgun1
recoilnum = 1
recoiltime = .2
shockdust = 1

# Coax Mount
mountnum = 2
mountobject = mgcoaxmount
mountsound = sound2
weapon = besa
weaponobject = genericgun1

# Bow Mount
mountnum = 3
mountobject = mghullmount
mountsound = sound2
weapon = besa
weaponobject = genericgun1