# modded on Oct.11/05 to comment out "neutral" vode calls in commander position (2)
# these stop commander rotating while buttoned in AFVs without pos.2 peroscopes - Doc. 
# Churchill Mk VII Turret file

#multicrewpos position, whichcrew
multicrewpos 1 1
multicrewpos 2 2
multicrewpos 3 2
multicrewpos 4 1

#driver
position = 1
gunsightfile = churchill7driver.gs
gunsightblocked = canopyopen

#Commander	
position = 2
elevationrate = 2
traverserate = 6
type = 360turret
gunsightfile = 8x30binoc.gs
# conditions are undeployed, depolyed, canopyopen, canopyclosed, hatchopen, hatchclosed
#neutral = canopyclosed
#neutraltraverse = 0
#neutralelevate = 0
gunsightblocked = canopyclosed

#Main gun and Coax
position = 3
elevationrate = 3
traverserate = 15
type = 360turret
gunsightfile = 75mm_MkV.gs
gunsightalignmentmountobject = maingunmount
gunsightalignmentrange = 1800

#turret sound variables
turrettraverse = turret/hydrolic_turret.wav
#turretelevate = turret/hand_turret_move.wav
turretgeneral = turret/turret_traverse_general.wav

# Bow Gunner
position = 4
elevationrate = 1
traverserate = 1
type = limitedturret
#type = flexible
gunsightalignmentmountobject = mghullmount
gunsightalignmentrange = 200
#gunsightblocked = canopyopen





