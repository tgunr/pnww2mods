#engine stats file for pziiif
[Fairmile_B_engine]
basehorsepower = 2240
basehpalt = 0
basehprpm = 1800
basehppress = 1.0
basehpexhausttemp = 1100
idlethrottlepos = 0.05
#idlerpm used only for downshifting purposes
idlerpm = 400
fuelperhphour = 0.260
oilconsumptionperhour = 0
wepmaxpress = 1.0
milmaxpress = 1.0
weprpm = 1800
milrpm = 1800
climbrpm = 1800
econrpm = 1800

superchargertype = none
weptype = none

#criticalrpm is the rpm at which below this the engine might stall, also used for starting
