# M6a3 HEAT round (bazooka)
# created June/22/11 - Doc.

type = rocket
diameter = .05
weight = 1.53
ammoweight = 1.53
velocity = 90
tracertime = 7.0
object = us_m9_he
explosive = 88714
# .2268 kg pentolite (50% PETN + 50% TNT) 
# divided by number of jets (13) = 88792
# .1134 kg PETN = 664524 j
# .1134 kg TNT = 488754 j
# total explosive = 1153275 j
# explosive = 88714 / shaped charge


fuzetime = 0.000
#selfdestructtime = 0.0
bc = 6.66
lifetime = 11.0
ricochetangle = 60
# modelspall = 1
penetrationconstant = 0.0000000011


# 125mm of armor penetrated at 0, because scaling is not used, value is 30 degrees off perpendicular
shapedchargepenmm = 85

dontdisplayfirstframe = 1

numshrapnelpieces = 400
# totalshrapnelmass = .0001
totalshrapnelmass = 1

explosionsoundnear = sounds\troop\grenade.wav
explosionsoundfar = sounds\smlfarexp.wav
nearfardistance = 150
hiteffect=bazookablast

#grenaderotaterate = 2

# new HE model variables
#
#  use_new_he .. set to 1 to enable (and set defaults for) the new HE model
#  nhe_diameter ..  sets the diameter of the shrapnel bits
#  nhe_weight .. sets the minimum weight for the shrapnel bits 
#  nhe_min_pen_const .. the PC of the shrapnel bit will never be less than this
#  nhe_ric_angle .. sets the ricochet angle of the shrapnel bits
#  nhe_energy_mult .. how much of the explosive energy is transferred to the shrapnel
#  nhe_min_pieces .. see nhe_max_pieces
#  nhe_max_pieces .. total number of shrapnel is linearly interpolated between min and max pieces
#  nhe_max_per_veh .. caps the number of shrapnel bits fired at each vehicle
#  note that "removed" shrapnel is accumulated, so if 300 could hit, and you had this at 100, the average mass would be multiplied by 3
#  nhe_add_speed .. kicker speed for shrapnel .. formula = (kicker + (rand(0,1) * energy speed))
#  nhe_timeout .. how long to project the shrapnel bits in the world (seconds)

use_new_he = 0
nhe_diameter = 0.008
nhe_weight = 0.005
nhe_min_pen_const = 0.0000001
nhe_ric_angle = 60
nhe_energy_mult = 1
nhe_min_pieces = 522
nhe_max_pieces = 522
nhe_max_per_veh = 100
nhe_add_speed = 100.0
nhe_timeout = 0.15
nhe_max_mass_mult = 1

