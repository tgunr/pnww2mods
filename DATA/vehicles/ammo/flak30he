nhe_min_pen_const = 0.00000025
nhe_ric_angle = 86.9999
nhe_energy_mult = 1
nhe_min_pieces = 88
nhe_max_pieces = 88
nhe_max_per_veh = 50
nhe_add_speed = 100.0
nhe_timeout = 0.033
nhe_max_mass_mult = 1