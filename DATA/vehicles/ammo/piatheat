# PIAT HEAT round: Mk IA
# created Sept/27/11 - Doc.


type = rocket
# round is actually ballistic after firing. might need to be type = mortar
diameter = .089
weight = 1.35
ammoweight = 1.35
velocity = 76
# 86 m/s was used previously. Source unknown.
# 76 m/s comes from 
# Innenministerium Nordrhein Westfalen, Ausgabe Oktober 1994, 
# "Bomb HE, Projector Infantry, Anti Tank" (German EOD)
tracertime = 0.05
object = uk_piat_he
explosive = 20293
# 0.335 kg (11.82 oz) of Pentolite = 11558340 j
# = 889103 j/shaped charge
# 0.05669 kg (2 oz.) of Pentolite  = 263809 j
# (Mk I, Mk II rounds: Pentolite)
# (Mk III rounds: RDX/TNT mix)
# Divided by number of shaped charge jets (13) = 20293 j


fuzetime = 0.000
#selfdestructtime = 11.0
bc = 6.66
lifetime = 11.0
ricochetangle = 50
modelspall = 1
penetrationconstant = 0.0000000011

# 115 mm penetration *average* for head-on hit.
# UK MoD Royal Armament Research & Development Establishment
# Report 2/84: Some Historical Aspects of the Development of Shaped Charges

# lower end penetration value (to scale it by angle) unknown.
shapedchargepenmm = 90
dontdisplayfirstframe = 1

numshrapnelpieces = 400
totalshrapnelmass = 1.0

explosionsoundnear = sounds\troop\grenade.wav
explosionsoundfar = sounds\smlfarexp.wav
nearfardistance = 150
hiteffect=bazookablast

#grenaderotaterate = 2

# new HE model variables
#
#  use_new_he .. set to 1 to enable (and set defaults for) the new HE model
#  nhe_diameter ..  sets the diameter of the shrapnel bits
#  nhe_weight .. sets the minimum weight for the shrapnel bits 
#  nhe_min_pen_const .. the PC of the shrapnel bit will never be less than this (formula is very complex though)
#  nhe_ric_angle .. sets the ricochet angle of the shrapnel bits
#  nhe_energy_mult .. how much of the explosive energy is transferred to the shrapnel
#  nhe_min_pieces .. see nhe_max_pieces
#  nhe_max_pieces .. total number of shrapnel is linearly interpolated between min and max pieces
#  nhe_max_per_veh .. caps the number of shrapnel bits fired at each vehicle (performance tuning)
#      note that "removed" shrapnel is accumulated, so if 300 could hit, and you had this at 100, the average mass would be multiplied by 3
#  nhe_add_speed .. kicker speed for the shrapnel bits .. formula is (kicker + (rand(0,1) * energy speed))
#  nhe_timeout .. how long to project the shrapnel bits in the world (seconds)

use_new_he = 0
nhe_diameter = 0.008
nhe_weight = 0.005
nhe_min_pen_const = 0.0000001
nhe_ric_angle = 60
nhe_energy_mult = 1
nhe_min_pieces = 522
nhe_max_pieces = 522
nhe_max_per_veh = 100
nhe_add_speed = 100.0
nhe_timeout = 0.15
nhe_max_mass_mult = 1
