# basic vehicle data file for bf109f2
# created Bf109F-2 out of Bf109F-1 - July'10 : Doc
physicsversion = 1
vehicletype = ww2propplane
vehiclename = bf109f2
vehicleobjectname = bf109f2
componentfile = bf109f2.cmp
enginefile = bf109f2.eng
airfoilfile = bf109f2.air
positionfile = bf109f2.pos
numberofflappositions= 1
# next 3 are in kph
aileronmaxspeed = 322
ruddermaxspeed = 270
elevatormaxspeed = 270
# next 3 are in mach speed
aileroncompressspeed = 0.77
ruddercompressspeed = 0.82
elevatorcompressspeed = 0.82
# response times sec (full force)
aileronresponsetime = 0.2
#elevatorresponsetime = 0.2 (altered for testing v1.29 beta)
elevatorresponsetime = 0.8
rudderresponsetime = 2.3
#rudderresponsetime = 0.5 (altered for testing v1.29 beta)
throttleresponsetime = 1.0

# tab effects, ratio of tab force at full tab deflection to total surface force
ailerontabratio = 0.1 
elevatortabratio = 0
ruddertabratio = 0.1

# opposing movement tab effects, ratio of tab force at full tab deflection to total surface force
aileronspringtabratio = 0
elevatorspringtabratio = 0
rudderspringtabratio = 0

# static tabs, e.g. the tabs that are set on the ground
# trim the plane for cruise flight, in an analysis FE
# and copy the trim settings into the following fields
ailerontabstatic = 0.077
elevatortabstatic = -0.654
ruddertabstatic = -0.23


# fx speeds
# 1/time
flapdeployspeed = 0.2
geardeployspeed = .1
canopyopenspeed = 0.3
hatchopenspeed = 0.5

# Sounds
stallsound = sounds\stall.wav
gearsound = sounds\hgear.wav
flapssound = sounds\pflaps.wav
windsound = sounds\wind.wav
leftslatsound = sounds\bf109e3\slats.wav
rightslatsound = sounds\bf109e3\slats.wav




