# bf109g6 Component Data file
[propeller]
# type is the component type
type = engine
# subtype is component specific
subtype = propeller
propairfoil = propeller
enginetype = db605am
criticalprimary = 1
# position of center of component in meters
x = 0.0
y = 2.8
z = -0.06
# mass in kg of component
mass = 170
# rotational inertia in kg*m^2
inertiapitch = 93.08
inertiaroll = 185
inertiayaw = 93.08
# attitude of component
attpitch = 0
attroll = 0
attyaw = 0
propellerdiameter = 3.008
# ideal is 1/pi for efficiency, Do not use for power
#Prop Planeform Eff.
propellerefficiency = 0.32
#Power Multipler. Affects Speed, Range from 0.6 to 1.0
proppowerefficiency = 0.89
#prop induced Drag. Affects Climb, Range from 1.0 to 1.9
# propinduceddragmult = 1.75
propinduceddragmult = 1
# area of prop
propellerarea = 1.0
# critical mach drag speed of prop
# propellermdiv = 0.76
# max aoa of the prop
# equals 10 times the maxcl
# maxcl is used for limiting prop "lift"
# propellermaxcl = 1.4
# propellermincl = -1.0
# how many deg/sec the prop can adjust pitch
propellerresponse = 5
# range of pitch angles, set to constant value for fixed-pitch props
propellermaxangle = 90
propellerminangle = 8
# propellerpowerefficiency = .8
enginenumber = 1
#flywheelrotinertia = 50
flywheelrotinertia = 3
governedprop = 1
enginesound = sounds\bf109e3\prop.wav
hitmapcomponent1 = d_prop
#damagelevel of zero or less means that level isn't used
damagelevel1 = 30000
damagelevel2 = 60000
damagelevel3 = 80000
damagelevel4 = 90000
visdamage = prop1
damagelevelfail = 90000

[left_root_mass]
type = ballast
x = -0.859
y = 0.216
z = -0.512
# mass in kg of component
mass = 72.42
# rotational inertia in kg*m^2
inertiapitch = 28.1
inertiaroll = 10.5
inertiayaw = 37.68
visdamage = lwing
damagelevelfail = 150000

[left_root]
# type is the component type
type = airfoil
# subtype is component specific
subtype = flap
criticalprimary = 1
# position of center of component in meters
x = -0.859
y = -0.052
z = -0.512
# mass in kg of component
mass = 0
# rotational inertia in kg*m^2
#inertiapitch = 28.1
#inertiaroll = 10.5
#inertiayaw = 37.68
# attitude of component
attpitch = 1.42
attroll = -7
attyaw = 0
# component specific data
airfoiltype = bf109e_root
area = 2.766
# for vortex points and sub wing components, use total wing span and overall wing aspect ratio 
wingspan = 9.88
# windchord is in meters, average chord for wing section
wingchord = 2.14
innerchord = 2.284
outerchord = 1.996
# aspectratio is used to "adjust" the drag at +- angles of attack
aspectratio = 6.0
# for ailerons, left is min, right is max for the stick
# for flaps, min is fully up, max is fully down
controlmin = 0
controlmax = 42
maxopenspeed = 250kph
maxclosespeed = 280kph
maxdamagespeed = 260kph
# airfoil blanking in degrees pitch and yaw
# blank1_pitchstart = -30
# blank1_pitchstartfull = -20
# blank1_pitchendfull = 30
# blank1_pitchend = 45
blank1_yawstart = 8
blank1_yawstartfull = 30
blank1_yawendfull = 160
blank1_yawend = 170
# flaps 60 degrees split
flappos1cl = 0.8 
flappos1cd = 0.05 
flappos1cm = -0.4
# propwash vortex effects
vortexcomponent = propeller
# how much of the propeller's propwash affects this component
vortexeffectpercent = 0.9
# offset for angled-velocity effects
# a value of zero means only backwash is factored in
# a value of one assumes one edge of the component
# is along the vortex axis of rotation
vortexoffset = -0.2
stallsound = 1
hitmapcomponent1 = d_leftinnerwing
hitmapcomponent2 = d_leftflap
#damagelevel of zero or less means that level isn't used
damagelevel1 = 30000
damagelevel2 = 90000
damagelevel3 = 125000
damagelevel4 = 150000
visdamage = lwing
damagelevelfail = 150000


