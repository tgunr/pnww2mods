# Fw190A4 component file created 19 Dec. 04 - Doc.

[propeller]
type = engine
propairfoil = propeller
subtype = propeller
enginetype = bmw801d2
criticalprimary = 1
x = 0
y = 1.957
z = 0
mass = 170.53
inertiapitch = 123.28
inertiaroll = 245.9
inertiayaw = 123.28
attpitch = 0
attroll = 0
attyaw = 0
# attyaw = -1
propellerdiameter = 3.3
# ideal is 1/pi for efficiency, Do not use for power
#Prop Planeform Eff.
propellerefficiency = 0.32 
#Power Multipler. Affects Speed, Range from 0.6 to 1.0
proppowerefficiency = 0.94
#prop induced Drag. Affects Climb, Range from 1.0 to 1.9
propinduceddragmult = 1.0
# area of prop
propellerarea = 0.82
# critical mach drag speed of prop
# propellermdiv = 0.76
# max aoa of the prop
# equals 10 times the maxcl
# maxcl is used for limiting prop "lift"
# propellermaxcl = 1.4
# propellermincl = -1.0
# how many deg/sec the prop can adjust pitch
propellerresponse = 3
# range of pitch angles, set to constant value for fixed-pitch props
propellermaxangle = 65
propellerminangle = 8
# propellerpowerefficiency = 1.0
enginenumber = 1
# flywheelrotinertia = 50
flywheelrotinertia = 3
governedprop = 1
enginesound = sounds\db7\prop.wav
hitmapcomponent1 = d_prop
#damagelevel of zero or less means that level isn't used
#damagelevel1 = 40000 (changed Sept. DM audit)
#damagelevel2 = 80000
#damagelevel3 = 160000
#damagelevel4 = 320000
damagelevel1 = 30000
damagelevel2 = 60000
damagelevel3 = 80000
damagelevel4 = 90000
visdamage = prop1
damagelevelfail = 90000

[left_root_mass]
subtype = ballast
# position of center of component in meters
x = -1.1826
y = -0.12
z = -0.34
mass = 73.211
# rotational inertia in kg*m^2
inertiapitch = 29.35
inertiaroll = 9.46
inertiayaw = 38.8
visdamage = lwing
damagelevelfail = 150000

[left_root]
# type is the component type
type = airfoil
# subtype is component specific
subtype = flap
criticalprimary = 1
# position of center of component in meters
x = -1.1826
y = -0.396
z = -0.34
# mass and inertias moved to left_root_mass
# mass = 0
# rotational inertia in kg*m^2
# inertiapitch = 22.5
# inertiaroll = 16.3
# inertiayaw = 21.0
# attitude of component
attpitch = 1.8
attroll = -5.6
attyaw = 0
# component specific data
airfoiltype = fw190a4root
# area and chords are for the relative component
area = 2.731
# windchord is in meters, average chord for wing section
wingchord = 2.193
innerchord = 2.349
outerchord = 2.038
# wingspan and aspect ratio numbers are for the entire wing structure.
wingspan = 10.5
# aspectratio is used to "adjust" the angle of attack
aspectratio = 6.03
# for ailerons, left is min, right is max for the stick
# for flaps, min is fully up, max is fully down
controlmin = 0
controlmax = 45
maxopenspeed = 280kph
maxclosespeed = 320kph
maxdamagespeed = 300kph
#blank1_pitchstart = -30
#blank1_pitchstartfull = -20
#blank1_pitchendfull = 30
#blank1_pitchend = 45
blank1_yawstart = 8
blank1_yawstartfull = 30
blank1_yawendfull = 160
blank1_yawend = 170
# flaps 60 degrees split
flappos1cl = .86
flappos1cd = .07097
flappos1cm = -0.507
#flappos1cl = 0.55 
#flappos1cd = 0.05
#flappos1cm = -0.25
# propwash vortex effects
vortexcomponent = propeller
# how much of the propeller's propwash affects this component
vortexeffectpercent = 0.9
# offset for angled-velocity effects
# a value of zero means only backwash is factored in
# a value of one assumes one edge of the component
# is along the vortex axis of rotation
vortexoffset = -0.3
stallsound = 1
hitmapcomponent1 = d_linnerwing
hitmapcomponent2 = d_lflap
#damagelevel of zero or less means that level isn't used
damagelevel1 = 30000
damagelevel2 = 90000
damagelevel3 = 125000
damagelevel4 = 150000
visdamage = lwing
damagelevelfail = 150000

