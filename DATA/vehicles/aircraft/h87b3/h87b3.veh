# basic vehicle data file for h87b3
physicsversion = 1
vehicletype = ww2propplane
vehiclename = h87b3
vehicleobjectname = h87b3
componentfile = h87b3.cmp
enginefile = h87b3.eng
airfoilfile = h87b3.air
positionfile = h87b3.pos
numberofflappositions= 1
# next 3 are in kph
aileronmaxspeed = 590
ruddermaxspeed = 430
elevatormaxspeed = 370
# next 3 are in mach speed
aileroncompressspeed = 0.73
ruddercompressspeed = 0.74
elevatorcompressspeed = 0.75
# response times sec (full force)
aileronresponsetime = 0.1
elevatorresponsetime = 0.80
#elevatorresponsetime = 0.20 (altered for v1.29 beta testing)
rudderresponsetime = 1.8
#rudderresponsetime = 0.10 (altered for v1.29 beta testing)
throttleresponsetime = 1.0

# static tabs, e.g. the tabs that are set on the ground
# trim the plane for cruise flight, in an analysis FE
# and copy the trim settings into the following fields
#ailerontabstatic = 0.038
#elevatortabstatic = 0.038
#ruddertabstatic = 0.019
ailerontabstatic = -0.016
elevatortabstatic = 0.849
ruddertabstatic = 0.08

# tab effects, ratio of tab force at full tab deflection to total surface force
ailerontabratio = 0.1 
elevatortabratio = 0.1
ruddertabratio = 0.1
# opposing movement tab effects, ratio of tab force at full tab deflection to total surface force
aileronspringtabratio = 0
elevatorspringtabratio = 0
rudderspringtabratio = 0

stallsound = sounds\stall.wav
gearsound = sounds\pgear.wav
flapssound = sounds\pflaps.wav
windsound = sounds\wind.wav

flapdeployspeed = 0.2
geardeployspeed = .1
canopyopenspeed = 0.3
hatchopenspeed = 0.5
