# h87b3(fom h81a2) Component Data file

[propeller]
type = engine
propairfoil = propeller
subtype = propeller
enginetype = V1650-1
criticalprimary = 1
x = 0.0
y = 3.3
z = 0.325
mass = 165
inertiapitch = 91.32
inertiaroll = 182.64
inertiayaw = 91.32
propellerdiameter = 3.35
# ideal is 1/pi for efficiency, Do not use for power
#Prop Planeform Eff.
propellerefficiency = 0.32 
#Power Multipler. Affects Speed, Range from 0.6 to 1.0
# proppowerefficiency = 1.0
proppowerefficiency = 0.9
#prop induced Drag. Affects Climb, Range from 1.0 to 1.9
# propinduceddragmult = 1.1
propinduceddragmult = 1.3
# area of prop (larger blades from H81)
propellerarea = 0.9
# critical mach drag speed of prop
# propellermdiv = 0.74
# max aoa of the prop
# equals 10 times the maxcl
# maxcl is used for limiting prop "lift"
# propellermaxcl = 1.4
# propellermincl = -1.0
# how many deg/sec the prop can adjust pitch
propellerresponse = 3
# range of pitch angles, set to constant value for fixed-pitch props
propellermaxangle = 65
propellerminangle = 8
# propellerpowerefficiency = 1.0
enginenumber = 1
# flywheelrotinertia = 50
flywheelrotinertia = 3
governedprop = 1
enginesound = sounds\h81a2\prop.wav
hitmapcomponent1 = d_prop
#damagelevel of zero or less means that level isn't used
#damagelevel1 = 40000 (changed Sept. DM audit)
#damagelevel2 = 80000
#damagelevel3 = 160000
#damagelevel4 = 320000
damagelevel1 = 30000
damagelevel2 = 60000
damagelevel3 = 80000
damagelevel4 = 90000
visdamage = prop1
damagelevelfail = 90000


