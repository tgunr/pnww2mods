blank1_yawstartfull = 30
blank1_yawendfull = 160
blank1_yawend = 170
# flaps 60 degrees split
flappos1cl = 0.55 
flappos1cd = 0.05
flappos1cm = -0.25
# propwash vortex effects
vortexcomponent = propeller
# how much of the propeller's propwash affects this component
vortexeffectpercent = 0.9
# offset for angled-velocity effects
# a value of zero means only backwash is factored in
# a value of one assumes one edge of the component
# is along the vortex axis of rotation
vortexoffset = -0.2
stallsound = 1
hitmapcomponent1 = d_leftinnerwing
hitmapcomponent2 = d_lflap
