up10degairfoil = clarkyh_15up10.pol
down10degairfoil = clarkyh_15down10.pol
stallfile = clarkyh_15.stall
compressibilityfile = clarkyh_15.compress

[hurri1ailob]
baseairfoil = clarkyh_13.pol
up10degairfoil = clarkyh_13up10.pol
down10degairfoil = clarkyh_13down10.pol
stallfile = clarkyh_13.stall
