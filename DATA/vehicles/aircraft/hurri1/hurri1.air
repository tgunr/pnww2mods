up10degairfoil = clarkyh_12.pol
down10degairfoil = clarkyh_12.pol
stallfile = clarkyh_12.stall
compressibilityfile = clarkyh_12.compress

[hurri1horizstab]
# Needs changed to a 0015
baseairfoil = 0014base.pol
up10degairfoil = 0014elevup10.pol
down10degairfoil = 0014elevdown10.pol
stallfile = 0014.stall
compressibilityfile = 0014.compress

[hurri1vertstab]
#needs to be a 0022
baseairfoil = 0010base.pol
up10degairfoil = 0010ruddup10.pol
down10degairfoil = 0010rudddown10.pol
stallfile = 0010.stall
