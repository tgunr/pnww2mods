#airfoils file for Hurri1

[propeller]
baseairfoil = propbase.pol
up10degairfoil = prop_up10.pol
down10degairfoil = prop_dn10.pol
stallfile = prop.stall
compressibilityfile = prop.compress

[hurri1root]
baseairfoil = clarkyh_19.pol
up10degairfoil = clarkyh_19.pol
down10degairfoil = clarkyh_19.pol
stallfile = clarkyh_19.stall
compressibilityfile = clarkyh_19.compress

[hurri1mid]
baseairfoil = clarkyh_17.pol
up10degairfoil = clarkyh_17.pol
down10degairfoil = clarkyh_17.pol
stallfile = clarkyh_17.stall
compressibilityfile = clarkyh_17.compress

[hurri1ailib]
