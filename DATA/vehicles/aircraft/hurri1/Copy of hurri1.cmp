# Hurri1 Component Data file
[propeller]
type = engine
propairfoil = hurri1root
subtype = propeller
enginetype = merlinII
x = 0.0
y = 2.032
z = 0.0
mass = 135
inertiapitch = 91.32
inertiaroll = 182.64
inertiayaw = 91.32
propellerdiameter = 3.323
# ideal is 1/pi for efficiency, Do not use for power
#Prop Planeform Eff.
propellerefficiency = 0.32 #speed perfect
#Power Multipler. Affects Speed, Range from 0.6 to 1.0
#proppowerefficiency = 0.73
proppowerefficiency = 0.93
#prop induced Drag. Affects Climb, Range from 1.0 to 1.9
# propinduceddragmult = 4.75
propinduceddragmult = 1.8
# area of prop
propellerarea = 0.9
# critical mach drag speed of prop
# propellermdiv = 0.76
# max aoa of the prop
# equals 10 times the maxcl
# maxcl is used for limiting prop "lift"
# propellermaxcl = 1.4
# propellermincl = -1.0
# how many deg/sec the prop can adjust pitch
propellerresponse = 3
# range of pitch angles, set to constant value for fixed-pitch props
propellermaxangle = 65
propellerminangle = 8
# propellerpowerefficiency = 1.0
enginenumber = 1
# flywheelrotinertia = 50
flywheelrotinertia = 3
governedprop = 1
enginesound = sounds\spit1\prop.wav
hitmapcomponent1 = d_blades
hitmapcomponent2 = d_spinner
#damagelevel of zero or less means that level isn't used
damagelevel1 = 40000
damagelevel2 = 80000
damagelevel3 = 160000
damagelevel4 = 320000

[left_root_mass]
subtype = ballast
# position of center of component in meters
x = -0.96
y = -0.48
z = -0.52
# mass in kg of component
mass = 37

[left_root]
# type is the component type
type = airfoil
# subtype is component specific
subtype = flap
# position of center of component in meters
x = -0.96
y = 0
z = -0.52
# mass in kg of component
# mass = 0
# rotational inertia in kg*m^2
