# how much of the propeller's propwash affects this component
vortexeffectpercent = 0.9
# offset for angled-velocity effects
# a value of zero means only backwash is factored in
# a value of one assumes one edge of the component
# is along the vortex axis of rotation
vortexoffset = -0.2
stallsound = 1
