# attitude of component
attpitch = 2
attroll = 0
attyaw = 0
# component specific data
airfoiltype = hurri1root
area = 2.53
# windchord is in meters, average chord for wing section
# wingchord = 2.565
wingspan = 12.19
wingchord = 2.59
innerchord = 2.88
outerchord = 2.4
# aspectratio is used to "adjust" the angle of attack
aspectratio = 6.22
# for ailerons, left is min, right is max for the stick
