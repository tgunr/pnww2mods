y = -2.579
z = -0.279
# mass in kg of component
mass = 0
# rotational inertia in kg*m^2
inertiapitch = 0
inertiaroll = 0
inertiayaw = 0
# attitude of component
attpitch = 2.1
attroll = -2
attyaw = 0
airfoiltype = bf110c_root
area = 4.7
# windchord is in meters, average chord for wing section
wingspan = 16.3
wingchord = 3.339
innerchord = 3.516
outerchord = 3.033
# aspectratio is used to "adjust" the angle of attack
aspectratio = 7.3
# for ailerons, left is min, right is max for the stick
# for flaps, min is fully up, max is fully down
controlmin = 0
controlmax = 50
maxopenspeed = 250kph
maxclosespeed = 280kph
maxdamagespeed = 260kph
# flaps 30 degrees split
flappos1cl = 0.66 
flappos1cd = 0.03
#flappos1cm = -0.66
flappos1cm = -0.2
# propwash vortex effects
vortexcomponent = propeller_left
# how much of the propeller's propwash affects this component
vortexeffectpercent = 0.3
# offset for angled-velocity effects
# a value of zero means only backwash is factored in
# a value of one assumes one edge of the component
# is along the vortex axis of rotation
vortexoffset = 0.2
stallsound = 1
