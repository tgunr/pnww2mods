[left_root]
# type is the component type
type = airfoil
# subtype is component specific
subtype = flap
criticalprimary = 1
# position of center of component in meters
x = -1.778
y = -0.483
z = -0.035
# mass in kg of component
mass = 0
# rotational inertia in kg*m^2
inertiapitch = 0
inertiaroll = 0
inertiayaw = 0
# attitude of component
attpitch = 2
attroll = 0
attyaw = 0
airfoiltype = c47root
area = 16.753
wingspan = 3.556
# wingchord is in meters, average chord for wing section
wingchord = 4.711
innerchord = 4.711
outerchord = 4.711
# aspectratio is used to "adjust" the angle of attack in some fashion...
# aspectratio = 9.12
aspectratio = 0.75
stallsound = 1
# for ailerons, left is min, right is max for the stick
# for flaps, min is fully up, max is fully down
controlmin = 0
controlmax = 45
# flap deployment speed limitations
maxopenspeed = 310kph
maxclosespeed = 340kph
maxdamagespeed = 320kph
flappos1cl = 0.68 
flappos1cd = 0.018 
flappos1cm = -0.11
# propwash vortex effects
vortexcomponent = propeller1
# how much of the propeller's propwash affects this component
vortexeffectpercent = 0.7
# offset for angled-velocity effects
# a value of zero means only backwash is factored in
# a value of one assumes one edge of the component
# is along the vortex axis of rotation
vortexoffset = 0.2
hitmapcomponent1 = d_linnerwing
hitmapcomponent2 = d_linnerflap
# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
#damagelevel of zero or less means that level isn't used
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
damagelevel1 = 60000
damagelevel2 = 120000
damagelevel3 = 200000
damagelevel4 = 400000


