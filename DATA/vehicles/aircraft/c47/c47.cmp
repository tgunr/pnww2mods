# c47 Component Data file created 09/29/05 -Hatch.

# NOTE:  all performance was tuned to a weight of 4225kg, although the plane
# is set to a base of 3890 in game, minus bomb
# NOTE: all this data is wrong, it's flyable, and that is about all that is correct - Doc (Jan.08)

[propeller1]
type = engine
propairfoil = propeller
subtype = propeller
enginetype = r1830-92
criticalprimary = 1
x = -2.83
y = 4.84
z = 0
mass = 170
inertiapitch = 142
inertiaroll = 280.37
inertiayaw = 142
propellerdiameter = 3.53
# ideal is 1/pi for efficiency, Do not use for power
#Prop Planeform Eff.
propellerefficiency = 0.32 #speed perfect
#Power Multipler. Affects Speed, Range from 0.6 to 1.0
proppowerefficiency = 0.85
#prop induced Drag. Affects Climb, Range from 1.0 to 1.9
propinduceddragmult = 1
# area of prop
propellerarea = 1.1
# critical mach drag speed of prop
# propellermdiv = 0.76
# max aoa of the prop
# equals 10 times the maxcl
# maxcl is used for limiting prop "lift"
# propellermaxcl = 1.4
# propellermincl = -1.0
# how many deg/sec the prop can adjust pitch
propellerresponse = 3
# range of pitch angles, set to constant value for fixed-pitch props
propellermaxangle = 88
propellerminangle = 8
# propellerpowerefficiency = 1.0
enginenumber = 1
# flywheelrotinertia = 50
flywheelrotinertia = 3
governedprop = 1
enginesound = sounds\h75\prop.wav
hitmapcomponent1 = d_prop1
#damagelevel of zero or less means that level isn't used
#damagelevel1 = 40000 (changed Sept. DM audit)
#damagelevel2 = 80000
#damagelevel3 = 160000
#damagelevel4 = 320000
damagelevel1 = 30000
damagelevel2 = 60000
damagelevel3 = 80000
damagelevel4 = 90000
visdamage = prop1
visdamageparent = engine1
damagelevelfail = 90000

