# ju87b Component Data file

# NOTE:  all performance was tuned to a weight of 4225kg, although the plane
# is set to a base of 3890 in game, minus bomb

[propeller]
type = engine
propairfoil = propeller
subtype = propeller
enginetype = jumo211da
criticalprimary = 1
x = 0
y = 2.88
z = 0
mass = 160
inertiapitch = 111.46
inertiaroll = 221.24
inertiayaw = 111.46
propellerdiameter = 3.32
# ideal is 1/pi for efficiency
propellerefficiency = 0.32
# area of prop
propellerarea = 0.945 
# critical mach drag speed of prop
#propellermdiv = 0.76
# max aoa of the prop
#Power Multipler. Affects Speed, Range from 0.6 to 1.0
proppowerefficiency = 1.0
#prop induced Drag. Affects Climb, Range from 1.0 to 1.9
propinduceddragmult = 0.9
# equals 10 times the maxcl
# maxcl is used for limiting prop "lift"
#propellermaxcl = 1.4
#propellermincl = -1.0
# how many deg/sec the prop can adjust pitch
propellerresponse = 5
# range of pitch angles, set to constant value for fixed-pitch props
propellermaxangle = 65
propellerminangle = 8
#propellercd = 0.010
#propellerpowerefficiency = -1.0
#propellerpowerefficiency = 1.5
enginenumber = 1
enginesound = sounds\ju87b\prop.wav
flywheelrotinertia = 3
governedprop = 1
#propcldragmult = 1.27
hitmapcomponent1 = d_spinner
hitmapcomponent2 = d_prop1
hitmapcomponent3 = d_prop2
hitmapcomponent4 = d_propb3
# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
#damagelevel of zero or less means that level isn't used
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
#damagelevel1 = 100000 (changed DM audit)
#damagelevel2 = 200000
#damagelevel3 = 300000
#damagelevel4 = 500000
damagelevel1 = 30000
damagelevel2 = 60000
damagelevel3 = 80000
damagelevel4 = 90000
visdamage = prop1
damagelevelfail = 90000

