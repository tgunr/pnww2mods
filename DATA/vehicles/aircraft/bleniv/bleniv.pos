# Blenheim Mk IV pos file
#revised 30th Nov. 05 to swap 250lb bombs for 500lb bombs - Doc.

# Pilot
position = 1
hatchclosedsoundvolume = 1.0
hatchopensoundvolume = 1.0
canopyclosedsoundvolume = 0.5
canopyopensoundvolume = 1.0
engineidlevol = 0.5
enginefullpowervol = 0.3
# hatchsound = sounds\hit1.wav
canopysound = sounds\canopy_open.wav
canopyclosesound = sounds\canopy_close.wav

# Bombardier
position = 2
hatchclosedsoundvolume = 1.0
hatchopensoundvolume = 1.0
canopyclosedsoundvolume = 0.5
canopyopensoundvolume = 1.0
engineidlevol = 0.5
enginefullpowervol = 0.3
# hatchsound = sounds\hit1.wav
canopysound = sounds\canopy_open.wav
canopyclosesound = sounds\canopy_close.wav

groupmsg 1 500lb BOMB
groupmsg 2 40lb BOMB
numberofsecondarygroups = 2
bombsight britmk9a

