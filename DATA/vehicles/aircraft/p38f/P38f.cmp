# P38f Component Data file

[propeller_left]
type = engine
subtype = propeller
propairfoil = propeller
enginetype = V1710-49
#criticalprimary = 1
x = -2.4
y = 2.44
z = 0
mass = 157.63
inertiapitch = 144.4
inertiaroll = 288.17
inertiayaw = 144.4
propellerdiameter = 3.5
# ideal is 1/pi for efficiency, Do not use for power
#Prop Planeform Eff.
propellerefficiency = 0.32
#Power Multipler. Affects Speed, Range from 0.6 to 1.0
proppowerefficiency = .82
#prop induced Drag. Affects Climb, Range from 1.0 to 1.9
propinduceddragmult = 1
# area of prop
propellerarea = 0.8
# critical mach drag speed of prop
# propellermdiv = 0.76
# how many deg/sec the prop can adjust pitch
propellerresponse = 5
# range of pitch angles, set to constant value for fixed-pitch props
propellermaxangle = 90
propellerminangle = 8
enginenumber = 1
flywheelrotinertia = 3
governedprop = 1
enginesound = sounds\bf110c\prop.wav
hitmapcomponent1 = d_prop1
#damagelevel of zero or less means that level isn't used
damagelevel1 = 30000
damagelevel2 = 60000
damagelevel3 = 80000
damagelevel4 = 90000
visdamage = prop1
#visdamageparent = engine1
damagelevelfail = 90100


