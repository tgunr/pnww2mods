# He111H2 Component Data file

[propeller_left]
type = engine
propairfoil = bleniv_mid
subtype = propeller
enginetype = jumo211a1
criticalprimary = 1
x = -2.64
y = 4.202
z = 0.0
mass = 160
inertiapitch = 111.46
inertiaroll = 221.24
inertiayaw = 111.46
propellerdiameter = 3.48
# ideal is 1/pi for efficiency
propellerefficiency = 0.32
# area of prop
propellerarea = 0.945
# critical mach drag speed of prop
#propellermdiv = 0.76
# max aoa of the prop
#Power Multipler. Affects Speed, Range from 0.6 to 1.0
proppowerefficiency = 1.03
#prop induced Drag. Affects Climb, Range from 1.0 to 1.9
propinduceddragmult = 1.0
# equals 10 times the maxcl
# maxcl is used for limiting prop "lift"
#propellermaxcl = 1.4
#propellermincl = -1.0
# how many deg/sec the prop can adjust pitch
propellerresponse = 5
# range of pitch angles, set to constant value for fixed-pitch props
propellermaxangle = 65
propellerminangle = 8
#propellercd = 0.010
#propellerpowerefficiency = -1.0
#propellerpowerefficiency = 1.5
enginenumber = 1
enginesound = sounds\bf110c\prop.wav
flywheelrotinertia = 3
governedprop = 1
#propcldragmult = 1.27
hitmapcomponent1 = dprop1
# for weapons, hitmapcomponent1 is the gun itself, 2-4 are the ammo
#damagelevel of zero or less means that level isn't used
# for weapons, damagelevel1 is the damage for the gun, damagelevel2 is the damage for the weapon
#damagelevel1 = 100000 (changed Sept. DM audit)
#damagelevel2 = 200000
#damagelevel3 = 300000
#damagelevel4 = 500000
damagelevel1 = 30000
damagelevel2 = 60000
damagelevel3 = 80000
damagelevel4 = 90000
visdamage = prop1
visdamageparent = engine1
damagelevelfail = 90000

