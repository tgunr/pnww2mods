# inertiaroll = 0
# inertiayaw = 0
# attitude of component
attpitch = 2
attroll = -4
attyaw = 0
airfoiltype = havoc1_root
area = 4.085
# windchord is in meters, average chord for wing section
wingspan = 18.69
wingchord = 3.3
innerchord = 3.46
outerchord = 3.14
# aspectratio is used to "adjust" the angle of attack
aspectratio = 8.07
# for ailerons, left is min, right is max for the stick
# for flaps, min is fully up, max is fully down
