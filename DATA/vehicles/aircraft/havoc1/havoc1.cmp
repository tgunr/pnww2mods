controlmax = 45
maxopenspeed = 250kph
maxclosespeed = 280kph
maxdamagespeed = 260kph
# flaps 30 degrees split
flappos1cl = 0.85 
flappos1cd = 0.10 
flappos1cm = -0.5
# propwash vortex effects
vortexcomponent = propeller_left
# how much of the propeller's propwash affects this component
vortexeffectpercent = 0.3
# offset for angled-velocity effects
# a value of zero means only backwash is factored in
