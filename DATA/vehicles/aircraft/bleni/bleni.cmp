# Bleni Component Data file

[propeller_left]
type = engine
propairfoil = bleniv_mid
subtype = propeller
enginetype = Mercury_XV
criticalprimary = 1
x = -2.4
y = 2.88
z = 0.0
mass = 154
inertiapitch = 91.32
inertiaroll = 182.64
inertiayaw = 91.32
propellerdiameter = 3.22
# ideal is 1/pi for efficiency, Do not use for power
#Prop Planeform Eff.
propellerefficiency = 0.32 #speed perfect
#Power Multipler. Affects Speed, Range from 0.6 to 1.0
#proppowerefficiency = 0.73
proppowerefficiency = 0.93
#prop induced Drag. Affects Climb, Range from 1.0 to 1.9
# propinduceddragmult = 4.75
propinduceddragmult = 1.9
# area of prop
propellerarea = 0.9
# critical mach drag speed of prop
# propellermdiv = 0.76
# max aoa of the prop
# equals 10 times the maxcl
# maxcl is used for limiting prop "lift"
# propellermaxcl = 1.4
# propellermincl = -1.0
# how many deg/sec the prop can adjust pitch
propellerresponse = 4
# range of pitch angles, set to constant value for fixed-pitch props
propellermaxangle = 65
propellerminangle = 8
# propellerpowerefficiency = 1.0
enginenumber = 1
# flywheelrotinertia = 50
flywheelrotinertia = 3
governedprop = 1
enginesound = sounds\bf110c\prop.wav
hitmapcomponent1 = dprop1
#damagelevel of zero or less means that level isn't used
#damagelevel1 = 40000 (changed Sept. DM audit)
#damagelevel2 = 80000
#damagelevel3 = 160000
#damagelevel4 = 320000
damagelevel1 = 30000
damagelevel2 = 60000
damagelevel3 = 80000
damagelevel4 = 90000
visdamage = prop1
visdamageparent = engine1
damagelevelfail = 90000

