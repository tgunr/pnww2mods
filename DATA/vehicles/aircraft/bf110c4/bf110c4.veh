# basic vehicle data file for Bf110c4
physicsversion = 1
vehicletype = ww2propplane
vehiclename = bf110c4
vehicleobjectname = bf110c-4
componentfile = bf110c4.cmp
enginefile = bf110c4.eng
airfoilfile = bf110c4.air
positionfile = bf110c4.pos
numberofflappositions= 1
# next 3 are in kph
aileronmaxspeed = 250
ruddermaxspeed = 250
elevatormaxspeed = 320
# next 3 are in mach speed
aileroncompressspeed = 0.71
ruddercompressspeed = 0.72
elevatorcompressspeed = 0.69
# response times sec (full force)
aileronresponsetime = 0.25
elevatorresponsetime = 0.80
#elevatorresponsetime = 1.25 (altered for v1.29 beta testing)
rudderresponsetime = 1.6
#rudderresponsetime = 0.30 (altered for v1.29 beta testing)
throttleresponsetime = 1.0

#rudder response adjusted for v1.29 beta - Doc.

# static tabs, e.g. the tabs that are set on the ground
# trim the plane for cruise flight, in an analysis FE
# and copy the trim settings into the following fields
ailerontabstatic = 0.059
elevatortabstatic = -0.087
ruddertabstatic = 0.069

# tab effects, ratio of tab force at full tab deflection to total surface force
ailerontabratio = 0.1 
elevatortabratio = 0.0
ruddertabratio = 0.1
# opposing movement tab effects, ratio of tab force at full tab deflection to total surface force
aileronspringtabratio = 0
elevatorspringtabratio = 0.1
rudderspringtabratio = 0

# Sounds
stallsound = sounds\stall.wav
gearsound = sounds\hgear.wav
flapssound = sounds\pflaps.wav
windsound = sounds\wind.wav
leftslatsound = sounds\bf109e3\slats.wav
rightslatsound = sounds\bf109e3\slats.wav

flapdeployspeed = 0.2
geardeployspeed = .1
canopyopenspeed = 0.3
hatchopenspeed = 0.5
