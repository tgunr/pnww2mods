# basic vehicle data file for D520
physicsversion = 1
vehicletype = ww2propplane
vehiclename = d520
vehicleobjectname = d520
componentfile = d520.cmp
enginefile = d520.eng
airfoilfile = d520.air
positionfile = d520.pos
numberofflappositions= 1
# next 3 are in kph
aileronmaxspeed = 400
ruddermaxspeed = 300
elevatormaxspeed = 350
# next 3 are in mach speed
aileroncompressspeed = 0.71
ruddercompressspeed = 0.71
elevatorcompressspeed = 0.71
# response times sec (full force)
aileronresponsetime = 0.4
elevatorresponsetime = 1.2
#elevatorresponsetime = 0.3 (altered for v1.29 beta)
rudderresponsetime = 1.6
#rudderresponsetime = 0.5 (altered for v1.29 beta)
throttleresponsetime = 1.0

# static tabs, e.g. the tabs that are set on the ground
# trim the plane for cruise flight, in an analysis FE
# and copy the trim settings into the following fields
ailerontabstatic = -0.02
elevatortabstatic = -0.050
ruddertabstatic = 0.042

# tab effects, ratio of tab force at full tab deflection to total surface force
ailerontabratio = 0.1 
elevatortabratio = 0.1
ruddertabratio = 0.1
# opposing movement tab effects, ratio of tab force at full tab deflection to total surface force
aileronspringtabratio = 0
elevatorspringtabratio = 0
rudderspringtabratio = 0

stallsound = sounds\stall.wav
gearsound = sounds\pgear.wav
flapssound = sounds\pflaps.wav
windsound = sounds\wind.wav

flapdeployspeed = 0.2
geardeployspeed = .1
canopyopenspeed = 0.3
hatchopenspeed = 0.5
