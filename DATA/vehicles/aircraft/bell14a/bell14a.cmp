# bell14a Component Data file

[propeller]
type = engine
propairfoil = propeller
subtype = propeller
enginetype = V1710-35
criticalprimary = 1
x = 0.0
y = 3.084
z = 0.0
mass = 181
inertiapitch = 91.32
inertiaroll = 182.64
inertiayaw = 91.32
attpitch = 0
attroll = 0
attyaw = 0
propellerdiameter = 3.124
# ideal is 1/pi for efficiency, Do not use for power
#Prop Planeform Eff.
propellerefficiency = 0.32 #speed perfect
#Power Multipler. Affects Speed, Range from 0.6 to 1.0
proppowerefficiency = 0.96
#prop induced Drag. Affects Climb, Range from 1.0 to 1.9
propinduceddragmult = 1
# area of prop
propellerarea = 0.9
# critical mach drag speed of prop
# propellermdiv = 0.76
# max aoa of the prop
# equals 10 times the maxcl
# maxcl is used for limiting prop "lift"
# propellermaxcl = 1.4
# propellermincl = -1.0
# how many deg/sec the prop can adjust pitch
propellerresponse = 3
# range of pitch angles, set to constant value for fixed-pitch props
propellermaxangle = 65
propellerminangle = 8
# propellerpowerefficiency = 1.0
enginenumber = 1
# flywheelrotinertia = 50
flywheelrotinertia = 3
governedprop = 1
enginesound = sounds\spit1\prop.wav
hitmapcomponent1 = d_prop
hitmapcomponent2 = d_transmission
#damagelevel of zero or less means that level isn't used
damagelevel1 = 30000
damagelevel2 = 60000
damagelevel3 = 80000
damagelevel4 = 90000
visdamage = prop1
damagelevelfail = 90000

