# basic vehicle data file for Hawker Hurricane MkIIb
physicsversion = 1
vehicletype = ww2propplane
vehiclename = hurri2b 
vehicleobjectname = hurri2b
componentfile = hurri2b.cmp
enginefile = hurri2b.eng
airfoilfile = hurri2b.air
positionfile = hurri2b.pos
numberofflappositions= 1
# next 3 are in kph
aileronmaxspeed = 300
ruddermaxspeed = 400
elevatormaxspeed = 300
# next 3 are in mach speed
aileroncompressspeed = 0.68
ruddercompressspeed = 0.69
elevatorcompressspeed = 0.68
# response times sec (full force)
aileronresponsetime = 0.05
elevatorresponsetime = 0.40
#elevatorresponsetime = 0.10 (altered for v1.29 beta testing)
rudderresponsetime = 1.7
#rudderresponsetime = 0.20 (altered for v1.29 beta testing)
throttleresponsetime = 1.0

# static tabs, e.g. the tabs that are set on the ground
# trim the plane for cruise flight, in an analysis FE
# and copy the trim settings into the following fields
ailerontabstatic = 0.082
elevatortabstatic = -0.148
ruddertabstatic = -0.34

# tab effects, ratio of tab force at full tab deflection to total surface force
ailerontabratio = 0.1 
elevatortabratio = 0.1
ruddertabratio = 0.2
# opposing movement tab effects, ratio of tab force at full tab deflection to total surface force
aileronspringtabratio = 0
elevatorspringtabratio = 0
rudderspringtabratio = 0

#fx speeds
# 1/time
flapdeployspeed = 0.2
geardeployspeed = .1
canopyopenspeed = 0.3
hatchopenspeed = 0.5

#primarygunsound = sounds\spit1\8x30cal.wav
primaryisautomatic = 1

stallsound = sounds\stall.wav
gearsound = sounds\pgear.wav
flapssound = sounds\pflaps.wav
windsound = sounds\wind.wav