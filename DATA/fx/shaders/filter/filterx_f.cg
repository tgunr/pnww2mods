struct appin
{
	float2 t0 : TEXCOORD0;
};

float4 main(appin IN,
            uniform sampler2D src) : COLOR
{
	// Hardcode offsets once determined.
	float texScaler = 1 / 389.119995;

	float4 gaussFilter[7];

	float4 color = float4(0.0,0.0,0.0,0.0);
   	
	gaussFilter[0] = float4(-3.0, 0.0, 0.0, 0.16131 * 0.58);
	gaussFilter[1] = float4(-2.0, 0.0, 0.0, 0.21297 * 0.58);
	gaussFilter[2] = float4(-1.0, 0.0, 0.0, 0.25159 * 0.58);
	gaussFilter[3] = float4( 0.0, 0.0, 0.0, 0.26596 * 0.58);
	gaussFilter[4] = float4( 1.0, 0.0, 0.0, 0.25159 * 0.58);
	gaussFilter[5] = float4( 2.0, 0.0, 0.0, 0.21297 * 0.58);
	gaussFilter[6] = float4( 3.0, 0.0, 0.0, 0.16131 * 0.58);
   
	int i;
	
	for(i = 0; i < 7; i++)
	{
		color += tex2D(src, float2(IN.t0.x + gaussFilter[i].x * texScaler,
		                           IN.t0.y + gaussFilter[i].y * texScaler)) * 
		                           gaussFilter[i].w;
	}
	   
	color.a = 1.0f;

	return color;
}