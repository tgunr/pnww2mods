#define USE_GAMMA
#undef USE_GAMMA

struct appin
{
    float2 t0 : TEXCOORD0;
    float2 t1 : TEXCOORD1;
};

float4 main(appin IN,
     	    uniform float exposure,
#ifdef USE_GAMMA
#else
	    uniform float4 fogcolor,
  	    uniform float4 effect,
#endif
            uniform samplerRECT base,
            uniform samplerRECT src) : COLOR
{
	float4 colorbase = texRECT(base, IN.t0);
	float4 blur  = texRECT(src, IN.t1);
	
	float4 color = colorbase + blur;
	
	// Add gamma correction
#ifdef USE_GAMMA
	color = pow(color, 0.85f);
#else
    	// Throw in fog haze and any effect color
	color = lerp(color, fogcolor, 0.10) * effect;
#endif	
	//color.rgb = 1.0 - exp(-exposure * color.rgb);
   	color.w = 1;
   	
   	return color;
}