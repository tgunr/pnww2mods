struct appin
{
    float4 position  : POSITION;
    float4 normal    : NORMAL;
    float4 color     : COLOR;
    float2 texcoord0 : TEXCOORD0;
    float4 fogcoord  : FOGCOORD;
};

struct vertout
{
    float4 position  : POSITION;
    float4 color     : COLOR;
    float2 texcoord0 : TEXCOORD0;
    float fogcoord   : FOG;
};

vertout main(appin IN,
             uniform float4x4 modelviewproj,
			 uniform float4 outsidecolor,
	         uniform float4 insidecolor)
{
	vertout OUT;

	OUT.position = mul(modelviewproj, IN.position);     

	float dist = distance(OUT.position.xyz, float3(0, 0, 0));
	 
	dist = dist > 1 ? 1 : dist;
	
	OUT.color = lerp(insidecolor, outsidecolor, dist);
	
	OUT.texcoord0 = IN.texcoord0;
	OUT.fogcoord = dot(modelviewproj[2], IN.position);

	return OUT;
}
