//-----------------------------------------------------------------------------
// Vertex shader for speed trees.
//-----------------------------------------------------------------------------
struct appin
{
    float4 position  : POSITION;
    float3 normal    : NORMAL;
    float4 color     : COLOR;
    float4 texcoord0 : TEXCOORD0;
    float4 texcoord1 : TEXCOORD1;
    float  fogcoord  : FOGCOORD;
};

struct vertout
{
    float4 position  : POSITION;
    float4 color     : COLOR;
    float4 texcoord0 : TEXCOORD0;
    float  fogcoord  : FOG;
};

/////////////////////////////////////////////////////////////////
// Function: main
// Description:
//////////////////////////////////////////////////////////////////
vertout main(appin IN, 
             uniform float4x4 mWind[4],
             uniform float4x4 mModelViewProj,
             uniform half4 globalAmbient,
             uniform half4 pos,
             uniform half4 Kd,
             uniform half3 sunpos,
             uniform half3 gunpos,
             uniform half3 bombpos,
             uniform half4 suncolor,
             uniform half4 guncolor,
             uniform half4 bombcolor,
             uniform half4 leafTable[32],
             uniform half lightAdjust)
{
    vertout OUT;

    half4 p = pos + IN.position;
    p.w = 1.0f;
    
    IN.position.w = 1.0f;
        
    half4 diffuse;
    half3 L;
    half diffuseLight;
          
    half oneminusadjust = 1.0f - lightAdjust;
      
    L = normalize(sunpos.xyz - IN.position.xyz);
       
    diffuseLight = max(dot(IN.normal, L), 0) * oneminusadjust + lightAdjust;
    diffuse = diffuseLight * suncolor;
    
	half gunattenuation = 3 / distance(gunpos.xyz, IN.position.xyz);
  
    L = normalize(gunpos.xyz - IN.position.xyz);
    diffuseLight = max(dot(IN.normal, L), 0) * oneminusadjust + lightAdjust;
    diffuse += diffuseLight * guncolor * gunattenuation;
    
	half bombattenuation = 4 / distance(bombpos.xyz, IN.position.xyz);

    L = normalize(bombpos.xyz - IN.position.xyz);
    diffuseLight = max(dot(IN.normal, L), 0) * oneminusadjust + lightAdjust;
    diffuse += diffuseLight * bombcolor * bombattenuation;
          
    diffuse *= Kd;
    
    ///////////////////////////
    // Wind
    //////////////////////////
    // multiply position by wind matrix
    half4 fullWind = mul(mWind[IN.texcoord1.x], IN.position);
    
    // Interpolate between no-wind and full-wind
    half4 diff = fullWind - IN.position;
   
    // Leaf corners
    half4 scaledCorner = IN.texcoord1.w * leafTable[IN.texcoord1.z];
       
    // Wind weight assigned to Y in texture coordinate 2 
    half4 weightedWind = diff * IN.texcoord1.y + p + scaledCorner;
    
    OUT.position = mul(mModelViewProj, weightedWind);
       
    OUT.color = globalAmbient + diffuse;
    OUT.texcoord0 = IN.texcoord0;
    OUT.texcoord0.w = 1;
    OUT.fogcoord = dot(mModelViewProj[2], weightedWind);
   
    return OUT;
}
