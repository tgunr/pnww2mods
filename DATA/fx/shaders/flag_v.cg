//-----------------------------------------------------------------------------
// Vertex shader for flag waving.
//-----------------------------------------------------------------------------
struct appin
{
    float4 position  : POSITION;
    float4 normal    : NORMAL;
    float4 color     : COLOR;
    float4 texcoord0 : TEXCOORD0;
    float4 fogcoord  : FOGCOORD;
};

struct vertout
{
    float4 position  : POSITION;
    float4 color     : COLOR;
    float4 texcoord0 : TEXCOORD0;
    float fogcoord   : FOG;
};

//-----------------------------------------------------------------------------
// IN                  = Incoming per-vertex data to be processed
// modelViewProjection = Combined model-view-projection matrix
// currentAngle        = A value that goes from 0 to 360 and repeats
//-----------------------------------------------------------------------------
vertout main(appin IN, 
             uniform float4x4 mViewProj,
             uniform half currentAngle,
             uniform half4 origin1,
             uniform half4 origin2,
             uniform half4 lightPos,
             uniform half4 lightCol,
             uniform half4 globalAmbient,
             uniform half4 Kd,
             uniform half4 rightDir,
             uniform half clothStiff)
{
	    vertout OUT;

	    half4 v = half4(IN.position.x, IN.position.y, IN.position.z, 1.0f);
          
    	half d1 = distance(origin1, v);
    	half d2 = distance(origin2, v);
    
    	// Clamp flag to origins
    	half d = d1 < d2 ? d1 * 0.06 : d2 * 0.06;
                                 
    	half angleX = v.x * clothStiff + currentAngle;
    	half angleY = v.y * clothStiff + currentAngle;

    	half x = sin(angleX) * d;
    	half y = sin(angleY) * d;
    
        // rightDir normalized on CPU
        
    	// Make v.x depend on y, v.y depend on x
    	v.x += y * rightDir.x;
    	v.y += x * rightDir.y;
    
    	half3 N = half3(IN.normal.x, IN.normal.y, IN.normal.z);

    	// Adjust normal
    	N.x += y * rightDir.x;
    	N.y += x * rightDir.y;
     
    	N = normalize(N);
               
    	// Diffuse Light
    	half4 lp = normalize(lightPos - IN.position);

    	half diffuseLight = max(dot(N, lp.xyz), 0);         
    	half4 diffuse = Kd * lightCol * diffuseLight;
    
    	OUT.color = diffuse + globalAmbient;
    	OUT.color.w = 1;
    	OUT.texcoord0 = IN.texcoord0;
    	OUT.position = mul(mViewProj, v);
       
    	OUT.fogcoord = dot(mViewProj[2], IN.position);
    
	    return OUT;
}
