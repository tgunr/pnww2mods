// define inputs from application
struct appin
{
    float4 Position     : POSITION;
    float4 Color        : COLOR;
    float2 TexCoord0    : TEXCOORD0;
    float4 fogcoord     : FOGCOORD;
};

// define outputs from vertex shader
struct vertout
{
    float4 HPosition    : POSITION;
    float4 Color        : COLOR;
    float2 TexCoord0    : TEXCOORD0;
    float4 fogcoord     : FOG;
};

struct Material
{
    float4 Ka;
    float4 Ke;
    float4 Ks;
    float4 Kd;
    float shininess;
};

float Wave(inout float h, 
           inout float4 N, 
           in float d, 
           in float4 p, 
           in float Time)
{   
    float wavepos = Time / 3.5;

    float dwave = wavepos - d;
    
    float cosVal;
    float sinVal;
	
    sincos(dwave * 40 , sinVal, cosVal);

    dwave = abs(dwave);
    
    h = (dwave < 0.15) ? sinVal / 0.5 : sinVal / exp(dwave + d);	
    h = d > (wavepos + 0.1) ? sinVal / 10 : h;
    h = d < (wavepos - 3) ? sinVal / 10 : h;
    h /= 100;	
   
    // Calculate vertex normal
    N.x = d > (wavepos + 0.1) ? cosVal / 1000 : p.x * ((cosVal / exp(dwave + d)));
    N.x = d < (wavepos - 2) ? cosVal / 1000 : N.x;
    N.y = d > (wavepos + 0.1) ? cosVal / 1000 : p.y * ((cosVal / exp(dwave + d)));
    N.y = d < (wavepos - 2) ? cosVal / 1000 : N.y;
    N.z = 1.0; 
    N.w = 1.0;
	
    return h;
}

void computeLight(in Material M,
                  in float4 lightPos,
                  in float4 lightColor,
                  in float4 eyePos,
                  in float4 normal,
                  in float4 vertexPos,
                  out float4 diffuse,
                  out float4 specular)
{
    float4 L = normalize(lightPos - vertexPos);
  
    float diffuseLight = max(dot(normal, L), 0);
   
    diffuse = lightColor * M.Kd * diffuseLight;

    float4 V = normalize(eyePos - vertexPos);
    float4 H = normalize(L + V);
    
    float specularLight = pow(max(dot(normal, H), 0), M.shininess);

    if(diffuseLight <= 0) specularLight = 0;

    specular = lightColor * M.Ks * specularLight;
}

/*--------------------------------------------------------------------------
[DCF] Modified for use of multiple sprite textures
[DCF] Modified for alpha fades
[DCF] Modified for lighting
---------------------------------------------------------------------------*/
vertout main(appin IN,
             uniform float alpha,
             uniform float4 center,
             uniform float4 startTime,
             uniform float4 elapsedTime,
             uniform float4 globalAmb,
             uniform float4 Ka,
             uniform float4 Kd,
             uniform float4 Ke,
             uniform float4 Ks,
             uniform float4 eyePos,
             uniform float4 lightPos,
             uniform float4 lightCol,
             uniform float4 uv,
             uniform float4x4 mModelViewProj,
             uniform float4x4 mModelView,
             uniform float4x4 mModelViewIT)
{
    vertout OUT;

    float4 N;
    float h;
    
    Material M;
    M.Ka = Ka;
    M.Kd = Kd;
    M.Ke = Ke;
    M.Ks = Ks;
    M.shininess = 10;

    float4 p = IN.Position;
    
    float diff = (elapsedTime.x - startTime.x) * 0.001;
    float d = distance(center, p);

    Wave(h, N, d, p, diff);

    OUT.HPosition = mul(mModelViewProj, float4(p.x, 
                                               p.y,
                                               h,
                                               p.w));
    
    N = normalize(N);
      
    // Compute reflection vector
    float4 texCoord = p - 2 * dot(p, N) * N;

    // u1 = uv.x
    // v1 = uv.y
    // u2 = uv.z
    // v2 = uv.w
    
    // [DCF] Modified for use of multiple sprite textures on one texture
    OUT.TexCoord0.x = uv.x + texCoord.x * (uv.z - uv.x);
    OUT.TexCoord0.y = uv.y + texCoord.y * (uv.w - uv.y);

    // [DCF] Modified for lighting and alpha fades
    float4 ambient = globalAmb * Ka;
    float4 emissive = Ke;
    float4 diffuse;
    float4 specular;

    computeLight(M, lightPos, lightCol, eyePos, N, p, diffuse, specular);
    
    OUT.Color = ambient + emissive + diffuse + specular;
    OUT.Color.a = alpha - d;
    
    if(OUT.Color.a < 0) OUT.Color.a = 0;
    
    OUT.fogcoord.x = dot(mModelViewProj[2], p);
    
    return OUT;
}