<?xml version="1.0" encoding="utf-8"?>
<glslprograms>
  <!--=================================================================-->
  <program name ="coasteffect">
    <shaders>
      <vertexshader>scenarios/terrain/doggreen/coasteffect.vert</vertexshader>
      <fragmentshader>scenarios/terrain/doggreen/coasteffect.frag</fragmentshader>
    </shaders>
    <uniform name="src1" type="sampler2d" unit="0" onetimeapply="true"></uniform>
    <uniform name="src2" type="sampler2d" unit="1" onetimeapply="true"></uniform>
    <uniform name="src3" type="sampler2d" unit="2" onetimeapply="true"></uniform>
    <uniform name="alpha" type="float"></uniform>
  </program>
  <!--=================================================================-->
  <program name ="doggreen_coast">
    <shaders>
      <vertexshader>scenarios/terrain/doggreen/coast.vert</vertexshader>
      <fragmentshader>fx/shaders/GLSL/utility/fogutility.frag</fragmentshader>
      <fragmentshader>fx/shaders/GLSL/utility/lightutility.frag</fragmentshader>
      <fragmentshader>scenarios/terrain/doggreen/coast.frag</fragmentshader>
    </shaders>
    <uniform name="refr" type="sampler2d" unit="0" onetimeapply="true"></uniform>
    <uniform name="src2" type="sampler2d" unit="1" onetimeapply="true"></uniform>
    <uniform name="refl" type="sampler2d" unit="2" onetimeapply="true"></uniform>
    <uniform name="surf" type="sampler2d" unit="3" onetimeapply="true"></uniform>
    <uniform name="height" type="sampler2d" unit="4" onetimeapply="true"></uniform>
    <uniform name="time" type="float"></uniform>
    <uniform name="alpha" type="float" onetimeappy="true"></uniform>
  </program>
  <!--=================================================================-->
  <program name ="doggreen_spdgrass">
    <shaders>
      <vertexshader>fx/shaders/GLSL/grass/spdgrass.vert</vertexshader>
      <fragmentshader>fx/shaders/GLSL/utility/fogutility.frag</fragmentshader>
      <fragmentshader>fx/shaders/GLSL/utility/lightutility.frag</fragmentshader>
      <fragmentshader>scenarios/terrain/doggreen/spdgrass.frag</fragmentshader>
    </shaders>
    <uniform name="src1" type="sampler2d" unit="0" onetimeapply="true"></uniform>
    <uniform name="origin" type="float_vec3"></uniform>
    <uniform name="alphatest" type="float"></uniform>
    <uniform name="uv" type="float_vec2" numelements="64" onetimeapply="true"></uniform>
  </program>
  <!--=================================================================-->
  <program name ="doggreen_spdgrassshadow">
    <shaders>
      <vertexshader>fx/shaders/GLSL/grass/spdgrassshadow.vert</vertexshader>
      <fragmentshader>fx/shaders/GLSL/utility/fogutility.frag</fragmentshader>
      <fragmentshader>fx/shaders/GLSL/utility/lightutility.frag</fragmentshader>
      <fragmentshader>scenarios/terrain/doggreen/spdgrassshadow.frag</fragmentshader>
    </shaders>
    <uniform name="src1" type="sampler2d" unit="0" onetimeapply="true"></uniform>
    <uniform name="src2" type="sampler2dshadow" unit="1" onetimeapply="true"></uniform>
    <uniform name="origin" type="float_vec3"></uniform>
    <uniform name="scale" type="float"></uniform>
    <uniform name="shadowambient" type="float_vec3"></uniform>
    <uniform name="alphatest" type="float"></uniform>
    <uniform name="uv" type="float_vec2" numelements="64" onetimeapply="true"></uniform>
  </program>
  <!--=================================================================-->
  <program name ="doggreen_ocean">
    <shaders>
      <vertexshader>fx/shaders/GLSL/water/ocean/ocean.vert</vertexshader>
      <fragmentshader>fx/shaders/GLSL/utility/fogutility.frag</fragmentshader>
      <fragmentshader>fx/shaders/GLSL/utility/lightutility.frag</fragmentshader>
      <fragmentshader>scenarios/terrain/doggreen/ocean.frag</fragmentshader>
    </shaders>
    <uniform name="src2" type="sampler2d" unit="0" onetimeapply="true"></uniform>
    <uniform name="refl" type="sampler2d" unit="1" onetimeapply="true"></uniform>
    <uniform name="surf" type="sampler2d" unit="2" onetimeapply="true"></uniform>
    <uniform name="time" type="float"></uniform>
  </program>
</glslprograms>