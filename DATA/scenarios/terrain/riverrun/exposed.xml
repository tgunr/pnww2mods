<?xml version="1.0" encoding="utf-8"?>
<!-- values are 0 based -->
<exposed>
  <trees>
    <!-- weight the higher the number the less dense -->
    <redweight>25</redweight>
    <greenweight>10</greenweight>
    <blueweight>40</blueweight>
    <redtypeint>3 4 5 6 7 8 3 4</redtypeint>
    <greentypeint>15 15 17 18</greentypeint>
    <bluetypeint>19 0 1 2 1 1 0 0 1 19</bluetypeint>
    <!-- Color clamped between 0 - 255 -->
    <!-- Example: redclamp 240 will clamp red mask trees to red color >= 240 -->
    <!-- The higher the clamp, the less number of trees placed-->
    <redclamp>100</redclamp>
    <grnclamp>150</grnclamp>
    <bluclamp>200</bluclamp>
  </trees>
  <grass>
    <!-- The higher the weight, the lest dense -->
    <greenweight>5</greenweight>
    <blueweight>20</blueweight>
    <redweight>0</redweight>
    <redtypeint>0 1 2 3</redtypeint>
    <greentypeint>4 5 6 7</greentypeint>
    <bluetypeint>8 9 10 11</bluetypeint>
    <!-- Color clamped between 0 - 255 -->
    <!-- Example: redclamp 100 will clamp red mask grass to red color >= 100 -->
    <!-- The higher the clamp, the less number of blades placed-->
    <redclamp>175</redclamp>
    <grnclamp>175</grnclamp>
    <bluclamp>200</bluclamp>
    <!-- default is 1.0 -->
    <redscale>0.3</redscale>
    <grnscale>0.85</grnscale>
    <bluscale>1.3</bluscale>
  </grass>
  <!-- Clutter that uses FLTs -->
  <objectclutter name="cluttermask.dds">
    <!-- weight the higher the number the less dense -->
    <redweight>5</redweight>
    <greenweight>60</greenweight>
    <blueweight>1</blueweight>
    <!-- Color clamped between 0 - 255 -->
    <redclamp>90</redclamp>
    <grnclamp>240</grnclamp>
    <bluclamp>10</bluclamp>
    <!-- clutter FLT object for specific color -->
    <redtypestring>blumaine1c</redtypestring>
    <greentypestring>haystack_outside</greentypestring>
    <bluetypestring>null</bluetypestring>
    <!--== random rotate (-# #) -->
    <redparams>300</redparams>
    <greenparams>300</greenparams>
    <blueparams>300</blueparams>
  </objectclutter>
  <fogparams>
    <start>-50.0</start>
    <end>1400.0</end>
  </fogparams>
  <terraintile name ="maintile">
    <shader>multimaskshadow</shader>
    <layer0 name="layer0.dds">
      <multitexture>512</multitexture>
      <material>grass</material>
    </layer0>
    <layer1 name="layer1.dds">
      <multitexture>200</multitexture>
      <material>rock</material>
    </layer1>
    <layer2 name="layer2.dds">
      <multitexture>512</multitexture>
      <material>dirt</material>
    </layer2>
    <layer3 name="layer3.dds">
      <multitexture>1000</multitexture>
      <material>dirt</material>
    </layer3>
    <blendmask>masks.dds</blendmask>
  </terraintile>
</exposed>
