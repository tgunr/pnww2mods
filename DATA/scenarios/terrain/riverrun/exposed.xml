<?xml version="1.0" encoding="utf-8"?>
<!-- values are 0 based -->
<exposed>
  <trees>
    <!-- weight the higher the number the less dense -->
    <redweight>77</redweight>
    <greenweight>5</greenweight>
    <blueweight>90</blueweight>
    <redtypeint>3 4 5 6 7 8 3 4</redtypeint>
    <greentypeint>15 15 17 18</greentypeint>
    <bluetypeint>0 1 2 1 1 19</bluetypeint>
    <!-- Color clamped between 0 - 255 -->
    <!-- Example: redclamp 240 will clamp red mask trees to red color >= 240 -->
    <!-- The higher the clamp, the less number of trees placed-->
    <redclamp>240</redclamp>
    <grnclamp>240</grnclamp>
    <bluclamp>240</bluclamp>
  </trees>
  <grass>
    <!-- The higher the weight, the lest dense -->
    <greenweight>0</greenweight>
    <blueweight>15</blueweight>
    <redweight>0</redweight>
    <!-- Color clamped between 0 - 255 -->
    <!-- Example: redclamp 100 will clamp red mask grass to red color >= 100 -->
    <!-- The higher the clamp, the less number of blades placed-->
    <redclamp>125</redclamp>
    <grnclamp>175</grnclamp>
    <bluclamp>100</bluclamp>
    <!-- default is 1.0 -->
    <redscale>0.50</redscale>
    <grnscale>1.0</grnscale>
    <bluscale>2.5</bluscale>
  </grass>
  <terrainmaterials>
    <!-- Keep in ascending order (layer0, layer1, layer2...etc)-->
    <!-- These are texture names included in grounds.csv -->
    <!-- If there is no texture with the wanted effect, a new texture will need to be added to grounds.csv -->
    <!-- Or modify one already in use (i.e., grass1 can be modified since it's no longer in use) -->
    <!-- These materials are used for effects and walk sounds -->
    <layer0>grass1</layer0>
    <layer1>rubble</layer1>
    <layer2>dirt01</layer2>
    <layer3>tent</layer3>
  </terrainmaterials>
  <!-- Clutter that uses FLTs -->
  <objectclutter>
  <!-- weight the higher the number the less dense -->
    <redweight>1</redweight>
    <greenweight>85</greenweight>
    <blueweight>90</blueweight>
	<!-- Color clamped between 0 - 255 -->
    <redclamp>240</redclamp>
    <grnclamp>240</grnclamp>
    <bluclamp>240</bluclamp>
    <!-- clutter FLT object for specific color -->
    <redtypestring>blumaine1c</redtypestring>
    <greentypestring>facgun1c</greentypestring>
    <bluetypestring>msp</bluetypestring>
  </objectclutter>
</exposed>
