<?xml version="1.0" encoding="utf-8"?>
<!-- values are 0 based -->
<exposed>
  <trees name="treemask.dds">
    <!-- weight the higher the number the less dense -->
    <redweight>25</redweight>
    <greenweight>10</greenweight>
    <blueweight>30</blueweight>
    <redtypeint>3 4 5 6 7 8 3 4</redtypeint>
    <greentypeint>15 15 17 18</greentypeint>
    <bluetypeint>19 0 1 2 1 1 0 0 1 19</bluetypeint>
    <!-- Color clamped between 0 - 255 -->
    <!-- Example: redclamp 240 will clamp red mask trees to red color >= 240 -->
    <!-- The higher the clamp, the less number of trees placed-->
    <redclamp>100</redclamp>
    <grnclamp>150</grnclamp>
    <bluclamp>150</bluclamp>
  </trees>
  <grass name="grassmask.dds">
    <!-- The higher the weight, the less dense -->
    <greenweight>10</greenweight>
    <blueweight>25</blueweight>
    <redweight>1</redweight>
    <redtypeint>13</redtypeint>
    <greentypeint>0 1 12</greentypeint>
    <bluetypeint>4 5 5</bluetypeint>
    <!-- Color clamped between 0 - 255 -->
    <!-- Example: redclamp 100 will clamp red mask grass to red color >= 100 -->
    <!-- The higher the clamp, the less number of blades placed-->
    <redclamp>240</redclamp>
    <grnclamp>240</grnclamp>
    <bluclamp>100</bluclamp>
    <!-- default is 1.0 -->
    <redscale>0.8</redscale>
    <grnscale>1.8</grnscale>
    <bluscale>0.8</bluscale>
  </grass>
    <!-- Clutter that uses FLTs -->
  <objectclutter name="cluttermask.dds">
    <!-- weight the higher the number the less dense -->
    <redweight>150</redweight>
    <greenweight>75</greenweight>
    <blueweight>15</blueweight>
	<!-- Color clamped between 0 - 255 -->
    <redclamp>200</redclamp>
    <grnclamp>200</grnclamp>
    <bluclamp>200</bluclamp>
    <!-- clutter FLT object for specific color -->
    <redtypestring>dangersign</redtypestring>
    <greentypestring>haystack_outside</greentypestring>
    <bluetypestring>tanktrap</bluetypestring>
	    <!--== random rotate (-# #) -->
    <redparams>45</redparams>
    <greenparams>180</greenparams>
    <blueparams>180</blueparams>
  </objectclutter>
    <fogparams>
    <start>-50.0</start>
    <end>1400.0</end>
  </fogparams>
  <terraintile name ="maintile">
    <shader>multimaskshadow</shader>
    <treemask>treemask.dds</treemask>
    <grassmask>grassmask.dds</grassmask>
    <cluttermask>cluttermask.dds</cluttermask>
    <splatmask>splat1.dds</splatmask>
    <blendmask name="mask1.dds">
      <layer0 name="layer0.dds">
        <multitexture>200</multitexture>
        <material>grass</material>
      </layer0>
      <layer1 name="layer1.dds">
        <multitexture>248</multitexture>
        <material>grass</material>
      </layer1>
      <layer2 name="layer2.dds">
        <multitexture>400</multitexture>
        <material>dirt</material>
      </layer2>
      <layer3 name="layer3.dds">
        <multitexture>200</multitexture>
        <material>dirt</material>
      </layer3>
      <layer4 name="layer4.dds">
        <multitexture>300</multitexture>
        <material>dirt</material>
      </layer4>
    </blendmask>
    <blendmask name="mask2.dds">
	      <layer0 name="layer5.dds">
        <multitexture>200</multitexture>
        <material>dirt</material>
      </layer0>
      <layer1 name="layer6.dds">
        <multitexture>200</multitexture>
        <material>grass</material>
      </layer1>
	        <layer2 name="layer7.dds">
        <multitexture>300</multitexture>
        <material>rock</material>
      </layer2>
    </blendmask>
</terraintile>
</exposed>

