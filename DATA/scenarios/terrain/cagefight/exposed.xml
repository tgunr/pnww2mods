<!-- THIS SECTION DEFINES THE FOG USED IN THE SCENARIO -->

<!-- START value is relative distance from the player where fog begins -->
<!-- END value is relative distance from the player where fog ends -->
  
  <fogparams>
    <start>-50.0</start>
    <end>2000.0</end>
  </fogparams>
  
<!-- THIS SECTION DEFINES THE MASKS USED FOR EACH TERRAIN TILE IN THE SCENARIO -->
<!-- Each terrain tile can have up to two blendmasks applied -->
<!-- Each terrain tile can have up to two cluttermasks applied -->
<!-- END value is relative distance from the player where fog ends -->

<!-- terraintile name value is the file name (no extension) of the the terrain .flt found in data/terrain directory -->
  <terraintile name ="maintile">
    <shader>multimaskshadow</shader>
	
<!-- TREEMASK value is the file name of the .dds file found in scenario/terrain/scenarioname directory --> 	
    <treemask>treemask.dds</treemask>
<!-- GRASSMASK value is the file name of the .dds file found in scenario/terrain/scenarioname directory -->	
    <grassmask>grassmask.dds</grassmask>
<!-- CLUTTERMASK value is the file name of the .dds file found in scenario/terrain/scenarioname directory -->	
    <!-- <cluttermask>cluttermask.dds</cluttermask>
	<cluttermask>cluttermask2.dds</cluttermask> -->
	
<!-- SPLATMASK is a .dds texture used by 2D grass to pickup color blend values -->
<!-- SPLATMASK value is the file name of the .dds file found in scenario/terrain/scenarioname directory -->	
    <splatmask>splat1.dds</splatmask>
<!-- BLENDMASK value is the file name of the .dds file found in scenario/terrain/scenarioname directory -->
<!-- Each blendmask can have up to 4 channels (R,G,B,A) each with a unique, corresponding texture -->
    <blendmask name="mask1.dds">
<!-- LAYER# NAME value defines the .dds texture used for the R,G,B, or A channel of the blendmask -->
<!-- LAYER0 is the base texture applied to every terrain .flt and is not specified in the .dds blendmask -->	
      <layer0 name="layer0.dds">
<!-- MULTITEXTURE value effects the scale of the .dds texture for the layer. The higher the value, the more times the textures will tile across the terrain -->	  
        <multitexture>200</multitexture>
<!-- MATERIAL value is used by the game engine for special effects and sounds -->		
        <material>grass</material>
      </layer0>
	  
      <layer1 name="layer1.dds">
        <multitexture>300</multitexture>
        <material>dirt</material>
      </layer1>
	  
      <layer2 name="layer2.dds">
        <multitexture>300</multitexture>
        <material>dirt</material>
      </layer2>
	  
      <layer3 name="layer3.dds">
        <multitexture>200</multitexture>
        <material>dirt</material>
      </layer3>
	  
      <!-- <layer4 name="layer4.dds">
        <multitexture>300</multitexture>
        <material>dirt</material>
      </layer4> -->
	  
    </blendmask>
	
	
