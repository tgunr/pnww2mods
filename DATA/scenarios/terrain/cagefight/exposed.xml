<?xml version="1.0" encoding="utf-8"?>
<!-- values are 0 based -->
<exposed>

<!-- THIS SECTION DEFINES THE TREES USED IN THE SCENARIO -->
 
<!-- WEIGHT value 0-100, the Lower the value, the Higher the density -->
<!-- each channel in the mask can be specified R,G,B -->
<!-- TYPE value is the value that corresponds to data in the trees.xml file found in scenario/terrain/scenarioname directory -->
<!-- CLAMP value 0-255, a value of 255 means trees will only draw where the mask color value is 100% white -->

 <trees name="treemask.dds">
 
    <redweight>30</redweight>
    <greenweight>30</greenweight>
    <blueweight>30</blueweight>
   
	<redtypeint>0</redtypeint>
    <greentypeint>0</greentypeint>
    <bluetypeint>0</bluetypeint>

    <redclamp>50</redclamp>
    <grnclamp>50</grnclamp>
    <bluclamp>200</bluclamp>
	
  </trees>
  
  
<!-- THIS SECTION DEFINES THE GRASS USED IN THE SCENARIO -->

<!-- WEIGHT value 0-100, the Lower the value, the Higher the density -->
<!-- each channel in the mask can be specified R,G,B -->
<!-- TYPE value is the value that corresponds to a segment on radialclutter.dds in the scenario/terrain/scenarioname directory -->
<!-- CLAMP value 0-255, a value of 255 means grass will only draw where the mask color value is 100% white -->
<!-- SCALE value is 0-? and scales the size of grass specified -->
  
  <grass name="grassmask.dds">

    <redweight>1</redweight>
	<greenweight>1</greenweight>
    <blueweight>1</blueweight>
	
    <redtypeint>13</redtypeint>
    <greentypeint>0 1 12</greentypeint>
    <bluetypeint>4 5 5</bluetypeint>

    <redclamp>100</redclamp>
    <grnclamp>100</grnclamp>
    <bluclamp>100</bluclamp>

    <redscale>0.8</redscale>
    <grnscale>1.8</grnscale>
    <bluscale>0.8</bluscale>
	
  </grass>
  
  
<!-- THIS SECTION DEFINES THE CLUTTER USED IN THE SCENARIO -->
<!-- Clutter objects are .flts found in data/terrain directory -->

<!-- WEIGHT value 0-100, the Lower the value, the Higher the density -->
<!-- each channel in the mask can be specified R,G,B -->
<!-- TYPESTRING value is the filename (no extension) of an .flt found in data/terrain directory -->
<!-- CLAMP value 0-255, a value of 255 means grass will only draw where the mask color value is 100% white -->
<!-- PARAMS value 0-360 (+/-), a random X rotation of each clutter object -->

