<!-- type controls which lua script is run to manage this scenario -->
<scenario script="deathmatch">
	<!-- 
		these config variables are scenario type dependent and
		are injected directly into the controlling lua script
	-->
	<config>
		<param name="duration" value="30"/>
		<param name="kills" value="50"/>
	</config>
	<!-- terrain handling: map and offset are optional -->
	<terrain> <!-- map="riverrrun" offset="100,20,0" -->
		<!-- where we can spawn at -->
		<spawns>
			<!-- allies -->
			<spawn group="alliedtroops" position="234814,3015342,97" rotation="-2.43"/>
			<spawn group="alliedtroops" position="234849,3015904,101" rotation="-.85"/>
			<spawn group="alliedtroops" position="234783,3015528,97" rotation="2.95"/>
			<spawn group="alliedvehicles" position="234751,3015414,96" rotation="0"/>
			<!-- axis -->
			<spawn group="axistroops" position="235077,3015789,96" rotation="1.96"/>
			<spawn group="axistroops" position="235091,3015678,96" rotation="-3.02"/>
			<spawn group="axistroops" position="235069,3015431,96.2" rotation="1.86"/>
			<spawn group="axisvehicles" position="235129,3015695,96.2" rotation="0"/>
		</spawns>
		<!-- additional objects to place in the world -->
		<objects>
			<!-- object file="garage1c" position="" rotation=""/ -->
		</objects>
		<!-- additional cloned vehicles for atmosphere -->
		<clones>
			<clone id="charb1" position="" rotation=""/>
		</clones>
		<!-- additional atmospheric effects: smoke, fires, sounds -->
		<effects>
			<effect type="emitter" name="largefactorysmoke" position="235171,3016042,96"/>
			<effect type="emitter" name="largefactorysmoke" position="235061,3015798,101"/>
			<!-- effect type="sound" name="ambientfighting1"/ -->
			<!-- effect type="recording" name="bomberflyby1"/ -->
		</effects>
		<!-- terrain masks: trees, water, textures -->
		<layers>
			<layer type="tree" file=""/>
			<layer type="grass" file=""/>
			<layer type="texture" file=""/>
		</layers>
		<!-- terrain masks: trees, water, textures -->
		<waypoints>
			<waypoint side="1" label="attack"/>
			<waypoint side="2" label="attack"/>
		</waypoints>
		<!-- restricted areas; handlers are lua functions defined in the scenario type lua script -->
		<areas>
			<area handler="OnBoundary">
				<point position="234629.11,3015264.47,96.00"/>
				<point position="234932.88,3015281.62,96.00"/>
				<point position="234940.26,3015797.31,101.00"/>
				<point position="235057.71,3015797.48,101.04"/>
				<point position="235057.14,3015351.79,96.00"/>
				<point position="235125.44,3015259.79,96.00"/>
				<point position="235182.92,3015241.17,96.00"/>
				<point position="235199.36,3015292.67,96.00"/>
				<point position="235205.98,3015951.67,96.25"/>
				<point position="235100.51,3015944.46,96.00"/>
				<point position="235059.00,3015859.61,96.00"/>
				<point position="235057.86,3015803.38,101.01"/>
				<point position="234939.60,3015803.28,101.00"/>
				<point position="234888.45,3016002.83,101.00"/>
				<point position="234824.66,3015955.69,99.00"/>
				<point position="234799.51,3015609.69,96.14"/>
				<point position="234649.22,3015486.32,103.22"/>
				<point position="234629.11,3015264.47,96.00"/>
			</area>
		</areas>
	</terrain>
	<!-- 
		the commands block allows you to run dot commands at various points in the process
		each block is simply a set of slash commands one per line and are run in the order they
		appear here; the slash or dot is optional
	-->
	<commands>
		<onstart>
			<!-- these dot commands are run when a player joins a scenario -->
		</onstart>
		<onspawn>
			<!-- these dot commands are run when a player spawns -->
		</onspawn>
		<ondespawn>
			<!-- these dot commands are run when a player despawns -->
		</ondespawn>
		<onstop>
			<!-- these dot commands are run when a player leaves a scenario -->
		</onstop>
	</commands>
	<!-- 
		the vehicles block controls what vehicles can be spawned
		
		vehicle masks are defined like IP addresess...as dotted quads and
		are based on the following members in this order:
		
		country.category.class.type
		
		an asterisk (*) can be placed in any field and is the default for
		any defined mask
		
		countries:
		1 - england
		3 - france
		4 - germany
		
		categories:
		1 - aircraft
		2 - ground vehicle
		3 - sea vehicle
		4 - infantry
		
		classes:
		1 - bombers
		2 - fighters
		4 - tank
		5 - artillery
		6 - truck
		7 - gun
		9 - troop
		14 - para
		12 - riverine
		13 - sea
		
		* invidiual vehicles can be specified vehicle by its id
		
		example:
		
		<vehicle country="*" category="*" class="9" type="*" spawn="spawngroupname"/>
		<vehicle id="bedford" spawn="spawngroupname"/>
	-->
	<vehicles>
		<vehicle country="1" class="9" spawn="alliedtroops"/>
		<vehicle country="1" class="6" spawn="alliedvehicles"/>
		<vehicle country="1" class="7" spawn="alliedvehicles"/>
		<vehicle country="4" class="9" spawn="axistroops"/>
		<vehicle country="4" class="6" spawn="axisvehicles"/>
		<vehicle country="4" class="7" spawn="axisvehicles"/>
	</vehicles>
</scenario>
